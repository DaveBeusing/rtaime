	"copyright": "Copyright (c) Dave Beusing <david.beusing@gmail.com>.",
	"schemaVersion": "1.0",
	"productName": "rtaime",
	"sdkVersion": "10.0.401",
	"targetFrameworks": [
		"net10.0",
		"net10.0-windows"
	],
	"contracts": {
		"AI": [
			"1.0"
		],
		"Control": [
			"1.0"
		],
		"Media": [
			"1.0"
		],
		"Provider": [
			"1.0"
		],
		"Runtime": [
			"1.0"
		]
	},
	"ipc": {
		"protocolVersions": [
			"1.0"
		],
		"schemaSet": "schemas/ipc/v1"
	},
	"hosts": [
		{
			"name": "rtaime",
			"targetFramework": "net10.0",
			"outputPath": "src/Hosts/rtaime.AppHost/bin/{configuration}/net10.0"
		},
		{
			"name": "rtaime.ControlHost",
			"targetFramework": "net10.0",
			"outputPath": "src/Hosts/rtaime.ControlHost/bin/{configuration}/net10.0"
		},
		{
			"name": "rtaime.RuntimeHost",
			"targetFramework": "net10.0",
			"outputPath": "src/Hosts/rtaime.RuntimeHost/bin/{configuration}/net10.0"
		},
		{
			"name": "rtaime.AIHost",
			"targetFramework": "net10.0",
			"outputPath": "src/Hosts/rtaime.AIHost/bin/{configuration}/net10.0"
		},
		{
			"name": "rtaime.Operator",
			"targetFramework": "net10.0-windows",
			"outputPath": "src/Hosts/rtaime.Operator/bin/{configuration}/net10.0-windows"
		}
	],
	"hardwareQualification": [
		{
			"requirement": "CUDA_GPU_EXECUTION",
			"status": "UNVERIFIED"
		},
		{
			"requirement": "GPU_FRAME_LATENCY",
			"status": "UNVERIFIED"
		},
		{
			"requirement": "GPU_SURFACE_LIFETIME",
			"status": "UNVERIFIED"
		},
		{
			"requirement": "PROFESSIONAL_MEDIA_IO",
			"status": "UNVERIFIED"
		},
		{
			"requirement": "SUSTAINED_FRAME_CADENCE",
			"status": "UNVERIFIED"
		},
		{
			"requirement": "DROPPED_FRAME_BEHAVIOR",
			"status": "UNVERIFIED"
		},
		{
			"requirement": "SYSTEM_TELEMETRY_CONTINUITY",
			"status": "UNVERIFIED"
		},
		{
			"requirement": "TIMING_REFERENCE_LOCK",
			"status": "UNVERIFIED"
		},
		{
			"requirement": "AUDIO_VIDEO_SYNCHRONIZATION",
			"status": "UNVERIFIED"
		},
		{
			"requirement": "RECOVERY_UNDER_LOAD",
			"status": "UNVERIFIED"
		},
		{
			"requirement": "PHYSICAL_END_TO_END_LATENCY",
			"status": "UNVERIFIED"
		},
		{
			"requirement": "LONG_SOAK_STABILITY",
			"status": "UNVERIFIED"
		}
	]
}
