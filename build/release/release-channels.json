      "tagPattern": "^v(?<version>(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)-preview\\.[1-9][0-9]*)$",
      "allowedSignerClasses": [
        "TEST_EPHEMERAL",
        "EXTERNAL_CONTROLLED"
      ],
      "requireTrustedProductionKey": false,
      "publicationEligible": true
    },
    "STABLE": {
      "releaseStage": "STABLE",
