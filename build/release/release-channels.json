      "publicationEligible": true
    },
    "RC": {
      "releaseStage": "RELEASE_CANDIDATE",
      "tagRequired": true,
      "versionPattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)-rc\\.[1-9][0-9]*$",
      "tagPattern": "^v(?<version>(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)-rc\\.[1-9][0-9]*)$",
      "allowedSignerClasses": [
        "EXTERNAL_CONTROLLED"
      ],
      "requireTrustedProductionKey": true,
