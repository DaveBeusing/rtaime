<Project>
  <PropertyGroup>
    <RtaimeTargetFramework>net10.0</RtaimeTargetFramework>
    <RtaimeWindowsTargetFramework>net10.0-windows</RtaimeWindowsTargetFramework>

    <TargetFramework Condition="'$(TargetFramework)' == ''">$(RtaimeTargetFramework)</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>

    <RtaimeIsTestProject Condition="'$(RtaimeIsTestProject)' == ''">false</RtaimeIsTestProject>
  </PropertyGroup>
</Project>
