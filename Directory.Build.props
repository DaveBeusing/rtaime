<Project>
	<PropertyGroup>
		<RtaimeTargetFramework>net10.0</RtaimeTargetFramework>
		<RtaimeWindowsTargetFramework>net10.0-windows</RtaimeWindowsTargetFramework>
		<VersionPrefix>0.5.40</VersionPrefix>
		<RtaimeProductVersion Condition="'$(RtaimeProductVersion)' == ''">$(VersionPrefix)-dev</RtaimeProductVersion>
		<RtaimeReleaseStage Condition="'$(RtaimeReleaseStage)' == ''">DEV</RtaimeReleaseStage>
		<AssemblyVersion>0.1.0.0</AssemblyVersion>
		<FileVersion>0.1.0.0</FileVersion>
		<IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>

		<TargetFramework Condition="'$(TargetFramework)' == ''">$(RtaimeTargetFramework)</TargetFramework>
		<Version Condition="'$(Version)' == ''">$(RtaimeProductVersion)</Version>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<PlatformTarget>x64</PlatformTarget>
		<Deterministic>true</Deterministic>
		<ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>

		<RtaimeIsTestProject Condition="'$(RtaimeIsTestProject)' == ''">false</RtaimeIsTestProject>
	</PropertyGroup>
</Project>
