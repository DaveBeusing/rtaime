<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>$(RtaimeWindowsTargetFramework)</TargetFramework>
		<UseWPF>true</UseWPF>
		<ApplicationManifest>app.manifest</ApplicationManifest>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Vortice.Direct3D9" />
		<PackageReference Include="Vortice.Direct3D11" />
		<PackageReference Include="Vortice.DXGI" />
		<PackageReference Include="Vortice.Wpf" />
		<PackageReference Include="Vortice.D3DCompiler" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\rtaime.Core\rtaime.Core.csproj" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\Client\rtaime.Client\rtaime.Client.csproj" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="rtaime.Tests.Operator" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="..\..\..\docs\VorticeWpfInteropLicense.txt" Link="VorticeWpfInteropLicense.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
	</ItemGroup>

	<ItemGroup>
		<None Update="DemoAssets\**\*">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</None>
	</ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\..\..\docs\OperatorCommandsAndShortcuts.md" LogicalName="OperatorHelp.OperatorCommandsAndShortcuts.md" />
    <EmbeddedResource Include="..\..\..\docs\MediaLibraryAssetBrowser.md" LogicalName="OperatorHelp.MediaLibraryAssetBrowser.md" />
    <EmbeddedResource Include="..\..\..\docs\OperatorWorkspaces.md" LogicalName="OperatorHelp.OperatorWorkspaces.md" />
    <EmbeddedResource Include="..\..\..\docs\DurableShowProjectState.md" LogicalName="OperatorHelp.DurableShowProjectState.md" />
    <EmbeddedResource Include="..\..\..\docs\ShowPreflightAndActivity.md" LogicalName="OperatorHelp.ShowPreflightAndActivity.md" />
    <EmbeddedResource Include="..\..\..\docs\WindowsProductionLifecycle.md" LogicalName="OperatorHelp.WindowsProductionLifecycle.md" />
  </ItemGroup>
</Project>
