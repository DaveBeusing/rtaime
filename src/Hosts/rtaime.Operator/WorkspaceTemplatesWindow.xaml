<Window x:Class="rtaime.Operator.WorkspaceTemplatesWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:rtaime.Operator.Controls"
    Title="Workspace layout templates" Width="560" Height="520" MinWidth="400" MinHeight="400"
    Background="{DynamicResource OperatorBackgroundBrush}" Foreground="{DynamicResource OperatorTextBrush}"
    KeyboardNavigation.TabNavigation="Cycle" WindowStartupLocation="CenterOwner">
    <controls:RtaimeScrollViewer>
        <StackPanel Margin="16">
            <TextBlock Text="WORKSPACE LAYOUT TEMPLATES" Style="{StaticResource OperatorSectionTitle}" />
            <TextBlock Style="{StaticResource OperatorLabel}" TextWrapping="Wrap" Margin="0,8">
                <Run Text="PROGRAM " /><Run Text="{Binding Owner.DataContext.ProgramSourceName, Mode=OneWay, RelativeSource={RelativeSource AncestorType=Window}}" />
                <Run Text=" · " /><Run Text="{Binding Owner.DataContext.ConnectionState, Mode=OneWay, RelativeSource={RelativeSource AncestorType=Window}}" />
            </TextBlock>
            <TextBlock Style="{StaticResource OperatorLabel}"><Run Text="Capture current " /><Run Text="{Binding SelectedWorkspace, Mode=OneWay}" /><Run Text=" workspace" /></TextBlock>
            <controls:RtaimeTextBox x:Name="TemplateNameBox" Text="{Binding TemplateName, UpdateSourceTrigger=PropertyChanged}" MaxLength="64" Margin="0,8" AutomationProperties.Name="New workspace template name" ToolTip="Unique name, at most 64 characters. Up to 16 layouts are retained." />
            <controls:RtaimeButton Content="Save new template" Command="{Binding SaveTemplateCommand}" IsCompact="True" AutomationProperties.Name="Save current workspace as a new template" />
            <controls:RtaimeComboBox x:Name="TemplateSelection" ItemsSource="{Binding WorkspaceTemplates}" SelectedItem="{Binding SelectedTemplate}" DisplayMemberPath="Name" Margin="0,12,0,8" AutomationProperties.Name="Saved workspace layout template" />
            <TextBlock Style="{StaticResource OperatorLabel}" Margin="0,0,0,8"><Run Text="Apply destination: " /><Run Text="{Binding SelectedTemplate.Workspace, Mode=OneWay}" /></TextBlock>
            <WrapPanel>
                <controls:RtaimeButton Content="Apply" Command="{Binding ApplyTemplateCommand}" IsCompact="True" Margin="0,0,6,6" AutomationProperties.Name="Apply selected layout template" ToolTip="Switch to the template workspace and restore its layout. Production is unchanged." />
                <controls:RtaimeButton Content="Delete" Command="{Binding DeleteTemplateCommand}" IsCompact="True" Margin="0,0,6,6" AutomationProperties.Name="Delete selected local layout template" />
                <controls:RtaimeButton Content="Import…" Command="{Binding ImportTemplateCommand}" IsCompact="True" Margin="0,0,6,6" AutomationProperties.Name="Import workspace layout template" />
                <controls:RtaimeButton Content="Export…" Command="{Binding ExportTemplateCommand}" IsCompact="True" AutomationProperties.Name="Export selected workspace layout template" />
            </WrapPanel>
            <TextBlock Text="{Binding TemplateStatus}" TextWrapping="Wrap" Style="{StaticResource OperatorLabel}" Margin="0,8" AutomationProperties.LiveSetting="Polite" />
            <TextBlock Text="Templates contain layout preferences only. Import adds a template; Apply is a separate action. Escape closes this window." TextWrapping="Wrap" Style="{StaticResource OperatorLabel}" />
        </StackPanel>
    </controls:RtaimeScrollViewer>
</Window>
