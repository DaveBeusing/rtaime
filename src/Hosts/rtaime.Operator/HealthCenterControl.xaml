<UserControl x:Class="rtaime.Operator.HealthCenterControl"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:rtaime.Operator.Controls"
	Background="Transparent"
	Foreground="{DynamicResource OperatorTextBrush}">

	<UserControl.Resources>
		<Style x:Key="HealthCenterStateBadge" TargetType="Border">
			<Setter Property="Padding" Value="7,3" />
			<Setter Property="CornerRadius" Value="3" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="BorderBrush" Value="{DynamicResource OperatorBorderBrush}" />
			<Setter Property="Background" Value="{DynamicResource OperatorRaisedSurfaceBrush}" />
			<Style.Triggers>
				<Trigger Property="Tag" Value="HEALTHY">
					<Setter Property="BorderBrush" Value="{DynamicResource OperatorHealthyBrush}" />
				</Trigger>
				<Trigger Property="Tag" Value="WARNING">
					<Setter Property="BorderBrush" Value="{DynamicResource OperatorWarningBrush}" />
				</Trigger>
				<Trigger Property="Tag" Value="DEGRADED">
					<Setter Property="BorderBrush" Value="{DynamicResource OperatorWarningBrush}" />
				</Trigger>
				<Trigger Property="Tag" Value="RECOVERING">
					<Setter Property="BorderBrush" Value="{DynamicResource OperatorWarningBrush}" />
				</Trigger>
				<Trigger Property="Tag" Value="FAILED">
					<Setter Property="BorderBrush" Value="{DynamicResource OperatorErrorBrush}" />
				</Trigger>
				<Trigger Property="Tag" Value="NOT READY">
					<Setter Property="BorderBrush" Value="{DynamicResource OperatorErrorBrush}" />
				</Trigger>
			</Style.Triggers>
		</Style>
	</UserControl.Resources>

	<Grid>
		
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="12" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<controls:RtaimeStatePlaceholder
					State="{Binding WorkspaceStates.Health.State, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
					Title="{Binding WorkspaceStates.Health.Title, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
					Detail="{Binding WorkspaceStates.Health.Detail, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
					Panel.ZIndex="60"
					Margin="10" />

		<Border Grid.Row="0" Style="{StaticResource OperatorPanel}" Padding="14" Margin="0,0,0,10">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>
				<StackPanel>
					<TextBlock Text="HEALTH CENTER" Style="{StaticResource OperatorSectionTitle}" FontSize="{StaticResource OperatorFontSizeSubheading}" />
					<TextBlock Text="SYSTEM · INCIDENTS &amp; RECOVERY" Style="{StaticResource OperatorLabel}" Margin="0,3,0,0" />
					<TextBlock
						Text="{Binding OverallSummary}"
						Style="{StaticResource OperatorLabel}"
						TextWrapping="Wrap"
						Margin="0,5,0,0"
						MaxWidth="780" />
					<WrapPanel Margin="0,9,0,0" KeyboardNavigation.TabNavigation="Continue">
						<controls:RtaimeButton Content="SHOW CHECKS" IsCompact="True"
							Command="{Binding OpenShowChecksCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
							Margin="0,0,5,4" AutomationProperties.Name="Open show preflight and active notification review" />
						<controls:RtaimeButton Content="PROCESSING · AI" IsCompact="True"
							Command="{Binding Shell.SelectWorkspaceCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
							CommandParameter="AI" Margin="0,0,5,4"
							AutomationProperties.Name="Open governed AI Processing workspace" />
						<controls:RtaimeButton Content="PREFERENCES · SETTINGS" IsCompact="True"
							Command="{Binding Shell.SelectWorkspaceCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
							CommandParameter="SETTINGS" Margin="0,0,5,4"
							AutomationProperties.Name="Open system preferences workspace" />
						<controls:RtaimeButton Content="ADVANCED TOOLS · COMMANDS" IsCompact="True"
							Command="{Binding OpenCommandPaletteCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
							Margin="0,0,5,4" AutomationProperties.Name="Open searchable advanced commands and workspace tools" />
					</WrapPanel>
				</StackPanel>
				<StackPanel Grid.Column="1" HorizontalAlignment="Right">
					<TextBlock Text="PRODUCTION READINESS" Style="{StaticResource OperatorLabel}" HorizontalAlignment="Right" Margin="0,0,0,4" />
					<Border Style="{StaticResource HealthCenterStateBadge}" Tag="{Binding OverallState}" HorizontalAlignment="Right">
						<TextBlock Text="{Binding OverallState}" FontWeight="Bold" FontSize="{StaticResource OperatorFontSizeBody}" />
					</Border>
					<TextBlock Text="{Binding ProductionReadiness}" Style="{StaticResource OperatorLabel}" HorizontalAlignment="Right" Margin="0,5,0,0" />
				</StackPanel>
			</Grid>
		</Border>

		<StackPanel Grid.Row="1" Margin="0,0,0,2">
			<DockPanel LastChildFill="True" Margin="0,0,0,5">
				<controls:RtaimeButton Content="{Binding TelemetryOverviewAction}"
					Command="{Binding ToggleTelemetryOverviewCommand}" IsCompact="True"
					DockPanel.Dock="Right" MinHeight="28" Margin="8,0,0,0"
					AutomationProperties.Name="Show or hide detailed health telemetry overview" />
				<TextBlock Text="DIAGNOSTICS · TELEMETRY ON DEMAND"
					Style="{StaticResource OperatorLabel}" VerticalAlignment="Center" />
			</DockPanel>
		<controls:RtaimeListBox
			ItemsSource="{Binding Overview}"
			SelectedItem="{Binding SelectedSubsystem, Mode=TwoWay}"
			Background="Transparent"
			BorderThickness="0"
			MaxHeight="205"
			ScrollViewer.HorizontalScrollBarVisibility="Disabled"
			ScrollViewer.VerticalScrollBarVisibility="Auto"
			AutomationProperties.Name="Health Center detailed telemetry overview">
			<controls:RtaimeListBox.Style>
				<Style TargetType="{x:Type controls:RtaimeListBox}"
					BasedOn="{StaticResource {x:Type controls:RtaimeListBox}}">
					<Setter Property="Visibility" Value="Collapsed" />
					<Style.Triggers>
						<DataTrigger Binding="{Binding TelemetryOverviewVisible}" Value="True">
							<Setter Property="Visibility" Value="Visible" />
						</DataTrigger>
					</Style.Triggers>
				</Style>
			</controls:RtaimeListBox.Style>
			<controls:RtaimeListBox.ItemsPanel>
				<ItemsPanelTemplate>
					<WrapPanel />
				</ItemsPanelTemplate>
			</controls:RtaimeListBox.ItemsPanel>
			<controls:RtaimeListBox.ItemTemplate>
				<DataTemplate>
					<Border
						Width="{Binding Shell.HealthOverviewCardWidth, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
						MinHeight="94"
						Margin="0,0,8,8"
						Padding="10"
						BorderThickness="1"
						BorderBrush="{DynamicResource OperatorBorderBrush}"
						Background="{DynamicResource OperatorRaisedSurfaceBrush}">
						<StackPanel>
							<DockPanel>
								<TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
								<Border Style="{StaticResource HealthCenterStateBadge}" Tag="{Binding State}" DockPanel.Dock="Right" Margin="8,0,0,0">
									<TextBlock Text="{Binding State}" FontSize="{StaticResource OperatorFontSizeFinePrint}" FontWeight="Bold" />
								</Border>
							</DockPanel>
							<TextBlock
								Text="{Binding Detail}"
								Style="{StaticResource OperatorLabel}"
								TextWrapping="Wrap"
								TextTrimming="CharacterEllipsis"
								MaxHeight="44"
								Margin="0,7,0,0" />
						</StackPanel>
					</Border>
				</DataTemplate>
			</controls:RtaimeListBox.ItemTemplate>
		</controls:RtaimeListBox>
		</StackPanel>

		<Grid Grid.Row="3">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="{Binding Shell.HealthSidebarWidth, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
				<ColumnDefinition Width="10" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>

			<Border Grid.Column="0" Style="{StaticResource OperatorPanel}" Padding="10">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
					</Grid.RowDefinitions>
					<DockPanel Margin="0,0,0,8">
						<TextBlock Text="SUBSYSTEMS" Style="{StaticResource OperatorSectionTitle}" />
						<StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
							<TextBlock Text="Healthy " Style="{StaticResource OperatorLabel}" />
							<TextBlock Text="{Binding HealthyCount}" Style="{StaticResource OperatorLabel}" />
						</StackPanel>
					</DockPanel>
					<StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
						<TextBlock Text="Attention " Style="{StaticResource OperatorLabel}" />
						<TextBlock Text="{Binding AttentionCount}" FontWeight="SemiBold" />
						<TextBlock Text="  ·  Failed " Style="{StaticResource OperatorLabel}" />
						<TextBlock Text="{Binding FailedCount}" FontWeight="SemiBold" />
					</StackPanel>
					<TextBlock Grid.Row="2" Text="ACTIVE INCIDENTS" Style="{StaticResource OperatorLabel}" Margin="0,2,0,5" />
					<controls:RtaimeListBox
						Grid.Row="3"
						ItemsSource="{Binding Attention}"
						SelectedItem="{Binding SelectedSubsystem, Mode=TwoWay}"
						Background="Transparent"
						BorderThickness="0"
						MaxHeight="150"
						Margin="0,0,0,10"
						ScrollViewer.HorizontalScrollBarVisibility="Disabled"
						ScrollViewer.VerticalScrollBarVisibility="Auto"
						AutomationProperties.Name="Health Center active incidents">
						<controls:RtaimeListBox.ItemTemplate>
							<DataTemplate>
								<Grid Margin="5,4">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="Auto" />
									</Grid.ColumnDefinitions>
									<StackPanel>
										<TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
										<TextBlock Text="{Binding ProgramImpact}" Style="{StaticResource OperatorLabel}" FontSize="{StaticResource OperatorFontSizeMicro}" TextWrapping="Wrap" />
									</StackPanel>
									<Border Grid.Column="1" Style="{StaticResource HealthCenterStateBadge}" Tag="{Binding State}" VerticalAlignment="Center">
										<TextBlock Text="{Binding State}" FontSize="{StaticResource OperatorFontSizeFinePrint}" FontWeight="Bold" />
									</Border>
								</Grid>
							</DataTemplate>
						</controls:RtaimeListBox.ItemTemplate>
					</controls:RtaimeListBox>
					<TextBlock Grid.Row="4" Text="ALL SUBSYSTEMS" Style="{StaticResource OperatorLabel}" Margin="0,0,0,5" />
					<controls:RtaimeListBox
						Grid.Row="5"
						ItemsSource="{Binding Subsystems}"
						SelectedItem="{Binding SelectedSubsystem, Mode=TwoWay}"
						Background="Transparent"
						BorderThickness="0"
						ScrollViewer.HorizontalScrollBarVisibility="Disabled"
						ScrollViewer.VerticalScrollBarVisibility="Auto"
						AutomationProperties.Name="Health Center subsystem list">
						<controls:RtaimeListBox.ItemTemplate>
							<DataTemplate>
								<Grid Margin="5,5">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="Auto" />
									</Grid.ColumnDefinitions>
									<StackPanel>
										<TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
										<TextBlock Text="{Binding Category}" Style="{StaticResource OperatorLabel}" FontSize="{StaticResource OperatorFontSizeMicro}" />
									</StackPanel>
									<Border Grid.Column="1" Style="{StaticResource HealthCenterStateBadge}" Tag="{Binding State}" VerticalAlignment="Center">
										<TextBlock Text="{Binding State}" FontSize="{StaticResource OperatorFontSizeMicro}" FontWeight="Bold" />
									</Border>
								</Grid>
							</DataTemplate>
						</controls:RtaimeListBox.ItemTemplate>
					</controls:RtaimeListBox>
				</Grid>
			</Border>

			<Border Grid.Column="2" Style="{StaticResource OperatorPanel}" Padding="14">
				<controls:RtaimeScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" AutomationProperties.Name="Incident evidence and recovery">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
					</Grid.RowDefinitions>

					<Grid Grid.Row="0">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
						<StackPanel>
							<TextBlock Text="{Binding SelectedSubsystem.DisplayName}" Style="{StaticResource OperatorSectionTitle}" FontSize="{StaticResource OperatorFontSizeWorkspaceHeader}" />
							<TextBlock Text="{Binding SelectedSubsystem.Category}" Style="{StaticResource OperatorLabel}" Margin="0,3,0,0" />
						</StackPanel>
						<Border Grid.Column="1" Style="{StaticResource HealthCenterStateBadge}" Tag="{Binding SelectedSubsystem.State}" VerticalAlignment="Top">
							<TextBlock Text="{Binding SelectedSubsystem.State}" FontWeight="Bold" />
						</Border>
					</Grid>

					<Grid Grid.Row="1" Margin="0,14,0,0">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>
						<StackPanel>
							<TextBlock Text="STATE FIRST PROJECTED" Style="{StaticResource OperatorLabel}" />
							<TextBlock Text="{Binding SelectedSubsystem.FirstObserved}" TextWrapping="Wrap" Style="{StaticResource OperatorValue}" Margin="0,3,0,0" />
						</StackPanel>
						<StackPanel Grid.Column="1">
							<TextBlock Text="LAST PROJECTED" Style="{StaticResource OperatorLabel}" />
							<TextBlock Text="{Binding SelectedSubsystem.LastObserved}" TextWrapping="Wrap" Style="{StaticResource OperatorValue}" Margin="0,3,0,0" />
						</StackPanel>
					</Grid>

					<Border Grid.Row="2" Margin="0,14,0,0" Padding="10" BorderThickness="1" BorderBrush="{DynamicResource OperatorBorderBrush}">
						<StackPanel>
							<TextBlock Text="LAST SUCCESSFUL CHECK" Style="{StaticResource OperatorLabel}" Margin="0,0,0,5" />
							<TextBlock Text="{Binding SelectedSubsystem.LastSuccessfulCheck}" TextWrapping="Wrap" Margin="0,0,0,12" />
							<TextBlock Text="PROGRAM IMPACT" Style="{StaticResource OperatorLabel}" Margin="0,0,0,5" />
							<TextBlock Text="{Binding SelectedSubsystem.ProgramImpact}" FontWeight="SemiBold" TextWrapping="Wrap" />
							<TextBlock Text="EVIDENCE SOURCE" Style="{StaticResource OperatorLabel}" Margin="0,12,0,5" />
							<TextBlock Text="{Binding SelectedSubsystem.EvidenceSource}" TextWrapping="Wrap" />
							<TextBlock Text="EVIDENCE AVAILABILITY / FRESHNESS" Style="{StaticResource OperatorLabel}" Margin="0,12,0,5" />
							<TextBlock Text="{Binding SelectedSubsystem.EvidenceStatus}" TextWrapping="Wrap" />
							<TextBlock Text="CURRENT EVIDENCE" Style="{StaticResource OperatorLabel}" Margin="0,12,0,5" />
							<TextBlock Text="{Binding SelectedSubsystem.Detail}" TextWrapping="Wrap" />
							<TextBlock Text="RECOMMENDED SAFE NEXT ACTION" Style="{StaticResource OperatorLabel}" Margin="0,12,0,5" />
							<TextBlock Text="{Binding SelectedSubsystem.RecoveryStatus}" TextWrapping="Wrap" />
							<controls:RtaimeButton
								Content="{Binding SelectedSubsystem.RecoveryActionLabel}"
								Command="{Binding RecoverCommand}"
								AutomationProperties.Name="Synchronize authoritative Control state"
								HorizontalAlignment="Left"
								Margin="0,10,0,0"
								MinHeight="28"
								Padding="10,3">
								<controls:RtaimeButton.Style>
									<Style TargetType="{x:Type controls:RtaimeButton}" BasedOn="{StaticResource {x:Type controls:RtaimeButton}}">
										<Setter Property="Visibility" Value="Visible" />
										<Style.Triggers>
											<DataTrigger Binding="{Binding SelectedSubsystem.CanRecover}" Value="False">
												<Setter Property="Visibility" Value="Collapsed" />
											</DataTrigger>
										</Style.Triggers>
									</Style>
								</controls:RtaimeButton.Style>
							</controls:RtaimeButton>
						</StackPanel>
					</Border>

					<controls:RtaimeListBox
						Grid.Row="4"
						ItemsSource="{Binding SelectedSubsystem.Metrics}"
						Background="Transparent"
						BorderThickness="0"
						IsHitTestVisible="False"
						Margin="0,12,0,0"
						MaxHeight="160"
						ScrollViewer.HorizontalScrollBarVisibility="Disabled"
						AutomationProperties.Name="Selected subsystem metrics on demand">
						<controls:RtaimeListBox.Style>
							<Style TargetType="{x:Type controls:RtaimeListBox}"
								BasedOn="{StaticResource {x:Type controls:RtaimeListBox}}">
								<Setter Property="Visibility" Value="Collapsed" />
								<Style.Triggers>
									<DataTrigger Binding="{Binding TechnicalDetailsVisible}" Value="True">
										<Setter Property="Visibility" Value="Visible" />
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</controls:RtaimeListBox.Style>
						<controls:RtaimeListBox.ItemTemplate>
							<DataTemplate>
								<DockPanel Margin="5,3">
									<TextBlock Text="{Binding Label}" Style="{StaticResource OperatorLabel}" />
									<TextBlock Text="{Binding Value}" Style="{StaticResource OperatorValue}" FontWeight="SemiBold" DockPanel.Dock="Right" />
								</DockPanel>
							</DataTemplate>
						</controls:RtaimeListBox.ItemTemplate>
					</controls:RtaimeListBox>

					<StackPanel Grid.Row="3" Margin="0,12,0,0">
						<TextBlock Text="ADVANCED TOOLS · DIAGNOSTICS"
							Style="{StaticResource OperatorSectionTitle}" Margin="0,0,0,8" />
						<WrapPanel Margin="0,0,0,8">
							<controls:RtaimeButton Content="COPY INCIDENT SUMMARY" Command="{Binding CopyIncidentSummaryCommand}" MinHeight="28" Padding="10,3" Margin="0,0,8,6" AutomationProperties.Name="Copy redacted incident summary" />
							<controls:RtaimeButton Content="{Binding Startup.SupportBundleActionLabel, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Command="{Binding Startup.ExportSupportBundleCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" MinHeight="28" Padding="10,3" Margin="0,0,0,6" AutomationProperties.Name="Export diagnostics support bundle from Health Center" />
						</WrapPanel>
						<TextBlock Text="{Binding DiagnosticActionStatus}" TextWrapping="Wrap" Style="{StaticResource OperatorLabel}" AutomationProperties.LiveSetting="Polite" Margin="0,0,0,6" />
						<TextBlock Text="{Binding Startup.DiagnosticActionStatus, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" TextWrapping="Wrap" Style="{StaticResource OperatorLabel}" Margin="0,0,0,6" />
						<controls:RtaimeButton
							Content="{Binding TechnicalDetailsAction}"
							Command="{Binding ToggleTechnicalDetailsCommand}"
							HorizontalAlignment="Left"
							MinHeight="28"
							Padding="10,3"
							AutomationProperties.Name="Show or hide technical logs and subsystem metrics" />
						<Border Margin="0,8,0,0" Padding="10" BorderThickness="1" BorderBrush="{DynamicResource OperatorBorderBrush}">
							<Border.Style>
								<Style TargetType="Border">
									<Setter Property="Visibility" Value="Collapsed" />
									<Style.Triggers>
										<DataTrigger Binding="{Binding TechnicalDetailsVisible}" Value="True">
											<Setter Property="Visibility" Value="Visible" />
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</Border.Style>
							<StackPanel>
								<TextBlock Text="TECHNICAL EVIDENCE · OBSERVATION ONLY"
									Style="{StaticResource OperatorLabel}" Margin="0,0,0,6" />
								<TextBlock Text="{Binding SelectedSubsystem.TechnicalDetail}" Style="{StaticResource OperatorLabel}" TextWrapping="Wrap" />
								<TextBlock Text="{Binding ProductBuildIdentity, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
									Style="{StaticResource OperatorLabel}" Margin="0,7,0,0"
									AutomationProperties.Name="Operator product version and build identity" />
							</StackPanel>
						</Border>
					</StackPanel>
				</Grid>
				</controls:RtaimeScrollViewer>
			</Border>
		</Grid>
	</Grid>
</UserControl>
