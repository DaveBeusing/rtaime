<UserControl x:Class="rtaime.Operator.ProductionMacroControl"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:rtaime.Operator.Controls"
	Loaded="OnLoaded"
	AutomationProperties.Name="Production Macros">
	<Grid Margin="0,5,0,0">
		<controls:RtaimeTabControl Background="Transparent" BorderThickness="0">
			<controls:RtaimeTabItem Header="RUN">
				<Grid Margin="0,5,0,0">
					<Grid.RowDefinitions>
						<RowDefinition Height="30" />
						<RowDefinition Height="*" />
						<RowDefinition Height="30" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>
					<Grid>
						<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="4" /><ColumnDefinition Width="64" /></Grid.ColumnDefinitions>
						<controls:RtaimeComboBox
							ItemsSource="{Binding Macros}"
							SelectedItem="{Binding SelectedMacro, Mode=TwoWay}"
							DisplayMemberPath="Name"
							AutomationProperties.Name="Production Macro selection" />
						<controls:RtaimeButton Grid.Column="2" Content="REFRESH" Command="{Binding RefreshCommand}" IsCompact="True" />
					</Grid>
					<controls:RtaimeListBox Grid.Row="1"
						ItemsSource="{Binding SelectedMacro.Actions}"
						SelectedItem="{Binding SelectedAction, Mode=TwoWay}"
						Background="Transparent"
						BorderThickness="0"
						ScrollViewer.VerticalScrollBarVisibility="Auto"
						AutomationProperties.Name="Production Macro actions">
						<controls:RtaimeListBox.ItemTemplate>
							<DataTemplate>
								<Grid Height="30" Margin="3,1">
									<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
									<TextBlock Text="{Binding Summary}" FontSize="{StaticResource OperatorFontSizeMicro}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
									<TextBlock Grid.Column="1" Text="{Binding Kind}" Style="{StaticResource OperatorLabel}" FontSize="{StaticResource OperatorFontSizeMicro}" VerticalAlignment="Center" />
								</Grid>
							</DataTemplate>
						</controls:RtaimeListBox.ItemTemplate>
					</controls:RtaimeListBox>
					<Grid Grid.Row="2" Margin="0,4,0,0">
						<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="4" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
						<controls:RtaimeButton
							Content="RUN"
							Command="{Binding RunCommand}"
							IsCompact="True"
							Background="{DynamicResource OperatorAccentBrush}"
							BorderBrush="{DynamicResource OperatorAccentBrush}"
							Foreground="{DynamicResource OperatorBackgroundBrush}"
							ToolTip="Execute the selected bounded Macro through authoritative ControlHost commands." />
						<controls:RtaimeButton Grid.Column="2" Content="CANCEL" Command="{Binding CancelCommand}" IsCompact="True" />
					</Grid>
					<Border Grid.Row="3"
						Margin="0,6,0,0"
						Padding="6,4"
						Background="{DynamicResource OperatorAlternateSurfaceBrush}"
						BorderBrush="{DynamicResource OperatorBorderBrush}"
						BorderThickness="1"
						CornerRadius="{DynamicResource OperatorRadiusControl}">
						<StackPanel>
							<DockPanel>
								<controls:RtaimeStatusBadge Status="{x:Static controls:RtaimeStatusKind.Neutral}" Content="{Binding State}" ShowIndicator="True" />
								<TextBlock DockPanel.Dock="Right" Text="{Binding StorageLabel}" Style="{StaticResource OperatorLabel}" FontSize="{StaticResource OperatorFontSizeMicro}" />
							</DockPanel>
							<TextBlock Text="{Binding Status}" Style="{StaticResource OperatorLabel}" FontSize="{StaticResource OperatorFontSizeMicro}" TextWrapping="Wrap" Margin="0,3,0,0" />
							<TextBlock FontSize="{StaticResource OperatorFontSizeMicro}" Margin="0,2,0,0">
								<Run Text="CURRENT · " /><Run Text="{Binding CurrentAction}" />
							</TextBlock>
							<TextBlock FontSize="{StaticResource OperatorFontSizeMicro}">
								<Run Text="LAST CONFIRMED · " /><Run Text="{Binding LastCompletedAction}" />
							</TextBlock>
							<TextBlock Text="{Binding Failure}" Foreground="{DynamicResource OperatorWarningBrush}" FontSize="{StaticResource OperatorFontSizeMicro}" TextWrapping="Wrap" />
							<StackPanel Orientation="Horizontal" Margin="0,4,0,0">
								<controls:RtaimeButton Content="RESUME" Command="{Binding ResumeRecoveryCommand}" IsCompact="True" Margin="0,0,4,0" />
								<controls:RtaimeButton Content="CANCEL RECOVERY" Command="{Binding CancelRecoveryCommand}" IsCompact="True" />
							</StackPanel>
						</StackPanel>
					</Border>
				</Grid>
			</controls:RtaimeTabItem>

			<controls:RtaimeTabItem Header="EDIT">
				<controls:RtaimeScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
					<StackPanel Margin="0,5,2,0">
						<Grid>
							<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="4" /><ColumnDefinition Width="60" /></Grid.ColumnDefinitions>
							<controls:RtaimeComboBox ItemsSource="{Binding Macros}" SelectedItem="{Binding SelectedMacro, Mode=TwoWay}" DisplayMemberPath="Name" />
							<controls:RtaimeButton Grid.Column="2" Content="NEW" Command="{Binding NewMacroCommand}" IsCompact="True" />
						</Grid>
						<TextBlock Text="MACRO NAME" Style="{StaticResource OperatorLabel}" Margin="0,4,0,0" />
						<controls:RtaimeTextBox Text="{Binding SelectedMacro.Name, UpdateSourceTrigger=PropertyChanged}" IsCompact="True" />
						<TextBlock Text="DESCRIPTION" Style="{StaticResource OperatorLabel}" Margin="0,4,0,0" />
						<controls:RtaimeTextBox Text="{Binding SelectedMacro.Description, UpdateSourceTrigger=PropertyChanged}" IsCompact="True" />

						<TextBlock Text="ACTIONS" Style="{StaticResource OperatorLabel}" Margin="0,5,0,0" />
						<controls:RtaimeListBox Height="72"
							ItemsSource="{Binding SelectedMacro.Actions}"
							SelectedItem="{Binding SelectedAction, Mode=TwoWay}"
							Background="Transparent"
							BorderBrush="{DynamicResource OperatorBorderBrush}"
							BorderThickness="1"
							ScrollViewer.VerticalScrollBarVisibility="Auto">
							<controls:RtaimeListBox.ItemTemplate>
								<DataTemplate>
									<TextBlock Text="{Binding Summary}" Margin="5,2" FontSize="{StaticResource OperatorFontSizeMicro}" TextTrimming="CharacterEllipsis" />
								</DataTemplate>
							</controls:RtaimeListBox.ItemTemplate>
						</controls:RtaimeListBox>

						<controls:RtaimeComboBox Margin="0,4,0,0" ItemsSource="{Binding ActionKinds}" SelectedItem="{Binding NewActionKind, Mode=TwoWay}" AutomationProperties.Name="Production Macro action kind" />
						<TextBlock Text="{Binding ActionInputHint}" Style="{StaticResource OperatorLabel}" FontSize="{StaticResource OperatorFontSizeMicro}" Margin="0,2,0,0" TextWrapping="Wrap" />
						<controls:RtaimeTextBox Text="{Binding PrimaryReference, UpdateSourceTrigger=PropertyChanged}" IsCompact="True" Margin="0,3,0,0" AutomationProperties.Name="Primary Macro action reference" />
						<controls:RtaimeTextBox Text="{Binding SecondaryReference, UpdateSourceTrigger=PropertyChanged}" IsCompact="True" Margin="0,3,0,0" AutomationProperties.Name="Secondary Macro action reference" />
						<Grid Margin="0,3,0,0">
							<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="4" /><ColumnDefinition Width="72" /><ColumnDefinition Width="4" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
							<controls:RtaimeTextBox Text="{Binding FrameValue, UpdateSourceTrigger=PropertyChanged}" IsCompact="True" AutomationProperties.Name="Macro action frame value" />
							<controls:RtaimeComboBox Grid.Column="2" ItemsSource="{Binding AudioRoutingModes}" SelectedItem="{Binding AudioRoutingMode, Mode=TwoWay}" ToolTip="Audio routing mode: 1 FOLLOW_VIDEO, 2 BREAKAWAY." />
							<controls:RtaimeCheckBox Grid.Column="4" Content="VISIBLE" IsChecked="{Binding VisibilityValue, Mode=TwoWay}" VerticalAlignment="Center" />
						</Grid>
						<Grid Margin="0,4,0,0">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" /><ColumnDefinition Width="3" /><ColumnDefinition Width="*" /><ColumnDefinition Width="3" />
								<ColumnDefinition Width="*" /><ColumnDefinition Width="3" /><ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<controls:RtaimeButton Content="+ ACTION" Command="{Binding AddActionCommand}" IsCompact="True" />
							<controls:RtaimeButton Grid.Column="2" Content="REMOVE" Command="{Binding RemoveActionCommand}" IsCompact="True" />
							<controls:RtaimeButton Grid.Column="4" Content="↑" Command="{Binding MoveActionUpCommand}" IsCompact="True" />
							<controls:RtaimeButton Grid.Column="6" Content="↓" Command="{Binding MoveActionDownCommand}" IsCompact="True" />
						</Grid>
						<Grid Margin="0,4,0,0">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" /><ColumnDefinition Width="3" /><ColumnDefinition Width="*" /><ColumnDefinition Width="3" /><ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<controls:RtaimeButton Content="VALIDATE" Command="{Binding ValidateMacroCommand}" IsCompact="True" />
							<controls:RtaimeButton Grid.Column="2" Content="SAVE" Command="{Binding SaveMacroCommand}" IsCompact="True" />
							<controls:RtaimeButton Grid.Column="4" Content="DELETE" Command="{Binding DeleteMacroCommand}" IsCompact="True" />
						</Grid>
					</StackPanel>
				</controls:RtaimeScrollViewer>
			</controls:RtaimeTabItem>
		</controls:RtaimeTabControl>
	</Grid>
</UserControl>
