<UserControl x:Class="rtaime.Operator.SequenceTimelineControl"
    x:Name="SequenceRoot"
    Tag="{Binding}"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:rtaime.Operator.Controls"
    xmlns:local="clr-namespace:rtaime.Operator"
    xmlns:contracts="clr-namespace:rtaime.Control.Contracts;assembly=rtaime.Control.Contracts"
    MinHeight="0"
    Focusable="True"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True"
    Loaded="OnLoaded"
    PreviewKeyDown="OnPreviewKeyDown"
    PreviewMouseWheel="OnMouseWheel"
    PreviewMouseMove="OnCapturedMouseMove"
    PreviewMouseLeftButtonUp="OnCapturedMouseUp"
    LostMouseCapture="OnCapturedMouseCaptureLost">
    <UserControl.Resources>
        <SolidColorBrush x:Key="SequenceVideoBrush" Color="{StaticResource OperatorColorTimeline}" />
        <SolidColorBrush x:Key="SequenceAudioBrush" Color="{StaticResource OperatorColorAudio}" />
        <SolidColorBrush x:Key="SequenceGraphicsBrush" Color="{StaticResource OperatorColorGraphics}" />
        <Style x:Key="SequenceClipSurface" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SequenceVideoBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Opacity" Value="0.88" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static contracts:SequenceMediaKind.Audio}">
                    <Setter Property="Background" Value="{StaticResource SequenceAudioBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static contracts:SequenceMediaKind.Graphics}">
                    <Setter Property="Background" Value="{StaticResource SequenceGraphicsBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Selected}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource OperatorAccentBrush}" />
                    <Setter Property="BorderThickness" Value="2" />
                    <Setter Property="Opacity" Value="1" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Pending}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource OperatorAccentBrush}" />
                    <Setter Property="Opacity" Value="0.72" />
                    <Setter Property="BorderThickness" Value="2" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Invalid}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource OperatorErrorBrush}" />
                    <Setter Property="Opacity" Value="0.45" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Enabled}" Value="False">
                    <Setter Property="Opacity" Value="0.4" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Every menu resolves the existing editor instance from its placement target. -->
        <controls:RtaimeContextMenu x:Key="SequenceEditActionsMenu" x:Shared="False"
            DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
            <controls:RtaimeMenuItem Header="Split selected clip at edit cursor · B"
                Command="{Binding SplitCommand}" AutomationProperties.Name="Split selected sequence clip"
                ToolTip="{Binding SelectedStatus}" ToolTipService.ShowOnDisabled="True" />
            <controls:RtaimeMenuItem Header="Delete selected clip · Delete"
                Command="{Binding DeleteCommand}" AutomationProperties.Name="Delete selected sequence clip"
                ToolTip="{Binding SelectedStatus}" ToolTipService.ShowOnDisabled="True" />
            <controls:RtaimeMenuItem Header="Ripple delete selected clip"
                Command="{Binding RippleDeleteCommand}" AutomationProperties.Name="Ripple delete selected sequence clip"
                ToolTip="{Binding SelectedStatus}" ToolTipService.ShowOnDisabled="True" />
            <controls:RtaimeMenuSeparator />
            <controls:RtaimeMenuItem Header="Copy selected clip · Ctrl+C"
                Command="{Binding CopyCommand}" AutomationProperties.Name="Copy selected sequence clip"
                ToolTip="{Binding SelectedStatus}" ToolTipService.ShowOnDisabled="True" />
            <controls:RtaimeMenuItem Header="Paste at local cursor · Ctrl+V"
                Command="{Binding PasteCommand}" AutomationProperties.Name="Paste sequence clip at edit cursor"
                ToolTip="{Binding Feedback}" ToolTipService.ShowOnDisabled="True" />
            <controls:RtaimeMenuItem Header="Link selected clips"
                Command="{Binding LinkCommand}" AutomationProperties.Name="Link selected sequence clips"
                ToolTip="{Binding SelectedStatus}" ToolTipService.ShowOnDisabled="True" />
            <controls:RtaimeMenuItem Header="Unlink selected clip group"
                Command="{Binding UnlinkCommand}" AutomationProperties.Name="Unlink selected sequence clip group"
                ToolTip="{Binding SelectedStatus}" ToolTipService.ShowOnDisabled="True" />
            <controls:RtaimeMenuItem Header="Cut / dissolve / crossfade transition"
                Command="{Binding TransitionCommand}" AutomationProperties.Name="Insert validated sequence transition"
                ToolTip="{Binding SelectedStatus}" ToolTipService.ShowOnDisabled="True" />
            <controls:RtaimeMenuSeparator />
            <controls:RtaimeMenuItem Header="Undo saved sequence edit · Ctrl+Z"
                Command="{Binding UndoCommand}" AutomationProperties.Name="Undo persisted ControlHost sequence edit"
                ToolTip="ControlHost authoring history, not a local cursor undo and never a Program TAKE." />
            <controls:RtaimeMenuItem Header="Redo saved sequence edit · Ctrl+Y"
                Command="{Binding RedoCommand}" AutomationProperties.Name="Redo persisted ControlHost sequence edit"
                ToolTip="ControlHost authoring history; does not replay Program." />
            <controls:RtaimeMenuItem Header="Discard retained local drag draft"
                Command="{Binding DiscardDraftCommand}" AutomationProperties.Name="Discard retained sequence drag draft"
                ToolTip="{Binding GestureLabel}" ToolTipService.ShowOnDisabled="True" />
        </controls:RtaimeContextMenu>
        <controls:RtaimeContextMenu x:Key="SequenceTrackActionsMenu" x:Shared="False"
            DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
            <controls:RtaimeMenuItem Header="Toggle selected track enabled state"
                Command="{Binding ToggleTrackEnabledCommand}" AutomationProperties.Name="Toggle saved sequence track enabled state"
                ToolTip="Select a clip belonging to the track first; persists through ControlHost." ToolTipService.ShowOnDisabled="True" />
            <controls:RtaimeMenuItem Header="Toggle selected track mute"
                Command="{Binding ToggleTrackMuteCommand}" AutomationProperties.Name="Toggle saved sequence track mute"
                ToolTip="Select a clip belonging to the track first; persists through ControlHost." ToolTipService.ShowOnDisabled="True" />
            <controls:RtaimeMenuSeparator />
            <controls:RtaimeMenuItem Header="Previous visible tracks"
                Command="{Binding PreviousTracksCommand}" AutomationProperties.Name="Page preceding sequence tracks" />
            <controls:RtaimeMenuItem Header="Next visible tracks"
                Command="{Binding NextTracksCommand}" AutomationProperties.Name="Page next sequence tracks" />
        </controls:RtaimeContextMenu>
        <controls:RtaimeContextMenu x:Key="SequenceToolsActionsMenu" x:Shared="False"
            DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
            <controls:RtaimeMenuItem Header="Generate observed audio waveform"
                Command="{Binding WaveformCommand}" AutomationProperties.Name="Request real PCM waveform for selected audio"
                ToolTip="{Binding WaveformStatus}" ToolTipService.ShowOnDisabled="True" />
            <controls:RtaimeMenuSeparator />
            <controls:RtaimeMenuItem Header="Zoom in · Ctrl++"
                Command="{Binding ZoomInCommand}" AutomationProperties.Name="Zoom sequence timeline in" />
            <controls:RtaimeMenuItem Header="Zoom out · Ctrl+-"
                Command="{Binding ZoomOutCommand}" AutomationProperties.Name="Zoom sequence timeline out" />
            <controls:RtaimeMenuItem Header="Scroll timeline earlier"
                Command="{Binding ScrollBackwardCommand}" AutomationProperties.Name="Scroll sequence timeline earlier" />
            <controls:RtaimeMenuItem Header="Scroll timeline later"
                Command="{Binding ScrollForwardCommand}" AutomationProperties.Name="Scroll sequence timeline later" />
        </controls:RtaimeContextMenu>
        <controls:RtaimeContextMenu x:Key="SequencePlayoutActionsMenu" x:Shared="False"
            DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
            <controls:RtaimeMenuItem Header="Cue prepared native shuttle to local edit cursor"
                Command="{Binding Playout.CueCommand}" AutomationProperties.Name="Explicitly cue native sequence shuttle"
                ToolTip="Only the explicit CUE command seeks; local editing never seeks Program."
                ToolTipService.ShowOnDisabled="True" />
            <controls:RtaimeMenuItem Header="Observe native Preview readiness"
                Command="{Binding Playout.ObserveCommand}" AutomationProperties.Name="Observe native Preview readiness"
                ToolTip="{Binding Playout.OutputEvidence}" ToolTipService.ShowOnDisabled="True" />
        </controls:RtaimeContextMenu>
    </UserControl.Resources>
    <Border Background="{DynamicResource OperatorSurfaceBrush}"
        BorderBrush="{DynamicResource OperatorBorderBrush}"
        BorderThickness="1" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="43" />
                <RowDefinition Height="35" />
                <RowDefinition Height="29" />
                <RowDefinition Height="27" />
                <RowDefinition Height="*" />
                <RowDefinition Height="26" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Background="{DynamicResource OperatorTopBarBrush}" Margin="7,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="210" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="SEQUENCE" Style="{StaticResource OperatorSectionTitle}"
                    VerticalAlignment="Center" Margin="0,0,10,0" />
                <controls:RtaimeComboBox Grid.Column="1"
                    ItemsSource="{Binding Sequences}"
                    SelectedItem="{Binding SelectedSummary, Mode=TwoWay}"
                    DisplayMemberPath="Name"
                    Margin="0,5,7,5"
                    ToolTip="Choose an actual saved sequence. No local fake tracks."
                    AutomationProperties.Name="Saved multitrack sequence" />
                <controls:RtaimeButton Grid.Column="2" Content="REFRESH"
                    Command="{Binding RefreshCommand}" IsCompact="True" Margin="0,6,5,6"
                    AutomationProperties.Name="Refresh saved sequence catalogue" />
                <controls:RtaimeButton Grid.Column="3" Content="LOAD"
                    Command="{Binding LoadCommand}" IsCompact="True" Margin="0,6,5,6"
                    AutomationProperties.Name="Load selected saved sequence" />
                <controls:RtaimeButton Grid.Column="4" Content="+ NEW"
                    Command="{Binding CreateCommand}" IsCompact="True" Margin="0,6,8,6"
                    AutomationProperties.Name="Create a saved multitrack sequence" 
                    ToolTip="Save a new sequence with two video and two audio tracks through ControlHost." />
                <StackPanel Grid.Column="5" Orientation="Vertical"
                    VerticalAlignment="Center">
                    <TextBlock Text="{Binding SequenceName}" Style="{StaticResource OperatorValue}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding RevisionLabel}" Style="{StaticResource OperatorLabel}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>

            <DockPanel Grid.Row="1" Background="{DynamicResource OperatorTimelineTrackOverlayBrush}"
                LastChildFill="True">
                <controls:RtaimeToggleButton DockPanel.Dock="Left" Content="PLAYOUT"
                    IsChecked="{Binding PlayoutToolbarVisible, Mode=TwoWay}"
                    IsCompact="True" MinWidth="72" Margin="7,3,6,3"
                    ToolTip="Switch between saved-sequence editing and explicit native Preview/Program playout. No automatic Take."
                    AutomationProperties.Name="Show native sequence playout commands" />
                <Grid>
                    <!-- A bounded non-scrolling edit header preserves tool, cursor and viewport space. -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="7,2">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PlayoutToolbarVisible}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <controls:RtaimeButton Content="SELECT" Command="{Binding SelectToolCommand}"
                            IsCompact="True" Margin="0,0,3,0" ToolTip="V · Select without changing clips."
                            AutomationProperties.Name="Select sequence editor tool" />
                        <controls:RtaimeButton Content="MOVE" Command="{Binding MoveToolCommand}"
                            IsCompact="True" Margin="0,0,3,0" ToolTip="M · Drag clip body to move linked clips."
                            AutomationProperties.Name="Move sequence editor tool" />
                        <controls:RtaimeButton Content="TRIM" Command="{Binding TrimToolCommand}"
                            IsCompact="True" Margin="0,0,5,0" ToolTip="T · Drag start or end handles."
                            AutomationProperties.Name="Trim sequence editor tool" />
                        <TextBlock Text="{Binding ToolLabel}" Style="{StaticResource OperatorLabel}"
                            VerticalAlignment="Center" Margin="0,0,7,0" TextTrimming="CharacterEllipsis"
                            ToolTip="{Binding ToolLabel}" />
                        <controls:RtaimeButton Content="FIT" Command="{Binding FitCommand}"
                            IsCompact="True" Margin="0,0,7,0" ToolTip="Fit the saved sequence to the edit viewport."
                            AutomationProperties.Name="Fit sequence editor view" />
                        <controls:RtaimeButton x:Name="SequenceEditActionsButton" Content="EDIT" Tag="{Binding}"
                            IsCompact="True" Margin="0,0,3,0" Click="OnSequenceActionsClick"
                            ContextMenu="{StaticResource SequenceEditActionsMenu}"
                            AutomationProperties.Name="Sequence clip editing and saved history actions"
                            ToolTip="Split, delete, copy, paste, link, transitions and saved Undo/Redo. Shift+F10 opens selected actions." />
                        <controls:RtaimeButton x:Name="SequenceTrackActionsButton" Content="TRACK" Tag="{Binding}"
                            IsCompact="True" Margin="0,0,3,0" Click="OnSequenceActionsClick"
                            ContextMenu="{StaticResource SequenceTrackActionsMenu}"
                            AutomationProperties.Name="Sequence track enable, mute and paging actions"
                            ToolTip="Track enable and mute are persisted authoring edits." />
                        <controls:RtaimeButton x:Name="SequenceToolsActionsButton" Content="TOOLS" Tag="{Binding}"
                            IsCompact="True" Click="OnSequenceActionsClick"
                            ContextMenu="{StaticResource SequenceToolsActionsMenu}"
                            AutomationProperties.Name="Sequence waveform, zoom and scroll actions"
                            ToolTip="{Binding WaveformStatus}" />
                    </StackPanel>
                    <DockPanel LastChildFill="True">
                        <DockPanel.Style>
                            <Style TargetType="DockPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PlayoutToolbarVisible}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DockPanel.Style>
                        <controls:RtaimeButton DockPanel.Dock="Right" Content="TAKE"
                            Command="{Binding Playout.TakeCommand}" IsCompact="True"
                            MinWidth="53" Margin="3,3,7,3"
                            ToolTip="Commit the one armed, source/revision-fenced Program transaction. Never automatic."
                            AutomationProperties.Name="Take confirmed native sequence to Program" />
                        <controls:RtaimeButton DockPanel.Dock="Right" Content="ARM"
                            Command="{Binding Playout.ArmCommand}" IsCompact="True"
                            MinWidth="48" Margin="3,3"
                            ToolTip="Arm one Take transaction only after real Preview output was observed."
                            AutomationProperties.Name="Arm native sequence Take" />
                        <controls:RtaimeButton DockPanel.Dock="Right" Content="RELEASE"
                            Command="{Binding Playout.CancelCommand}" IsCompact="True"
                            Margin="3,3" ToolTip="Explicit cancellation of native preparation; Program remains unchanged."
                            AutomationProperties.Name="Cancel native sequence preparation" />
                        <controls:RtaimeButton DockPanel.Dock="Right" Content="RECOVER TAKE"
                            Command="{Binding Playout.RecoverCommand}" IsCompact="True"
                            Margin="3,3" ToolTip="Resolve only the original ambiguous Program successor; never automatically retry."
                            AutomationProperties.Name="Recover ambiguous native sequence Take" />
                        <controls:RtaimeScrollViewer HorizontalScrollBarVisibility="Auto"
                            VerticalScrollBarVisibility="Disabled">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,1">
                                <controls:RtaimeButton Content="PREPARE" Command="{Binding Playout.PrepareCommand}"
                                    IsCompact="True" Margin="0,2,4,2" ToolTip="Admit the exact saved revision and current RuntimeHost epoch." />
                                <controls:RtaimeButton Content="PREVIEW" Command="{Binding Playout.ActivatePreviewCommand}"
                                    IsCompact="True" Margin="0,2,4,2" ToolTip="Bind the prepared native source to the existing confirmed Preview route." />
                                <controls:RtaimeButton Content="PLAY" Command="{Binding Playout.PlayCommand}"
                                    IsCompact="True" Margin="0,2,3,2" ToolTip="Play admitted native shuttle. Use OBSERVE to verify actual Preview frames." />
                                <controls:RtaimeButton Content="PAUSE" Command="{Binding Playout.PauseCommand}"
                                    IsCompact="True" Margin="0,2,3,2" />
                                <controls:RtaimeButton Content="STOP" Command="{Binding Playout.StopCommand}"
                                    IsCompact="True" Margin="0,2,6,2" />
                                <controls:RtaimeButton x:Name="SequencePlayoutActionsButton" Content="PLAYOUT TOOLS" Tag="{Binding}"
                                    ContextMenu="{StaticResource SequencePlayoutActionsMenu}"
                                    Click="OnSequenceActionsClick" IsCompact="True" Margin="0,2,5,2"
                                    AutomationProperties.Name="Explicit cue and observation commands"
                                    ToolTip="{Binding Playout.Detail}" />
                            </StackPanel>
                        </controls:RtaimeScrollViewer>
                    </DockPanel>
                </Grid>
            </DockPanel>

            <Grid Grid.Row="2" Margin="7,2,7,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Feedback}" Style="{StaticResource OperatorLabel}"
                    TextTrimming="CharacterEllipsis" ToolTip="{Binding Feedback}"
                    VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                    <TextBlock Text="{Binding GestureLabel}" Style="{StaticResource OperatorLabel}"
                        TextTrimming="CharacterEllipsis" ToolTip="{Binding GestureLabel}" />
                    <TextBlock Text="{Binding Playout.NativeOwner}" FontSize="{StaticResource OperatorFontSizeMicro}"
                        Foreground="{DynamicResource OperatorSecondaryTextBrush}" TextTrimming="CharacterEllipsis"
                        ToolTip="{Binding Playout.OutputEvidence}" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding Playout.Status}" VerticalAlignment="Center"
                    Foreground="{DynamicResource OperatorWarningBrush}"
                    ToolTip="{Binding Playout.Detail}"
                    AutomationProperties.Name="Observed native sequence output state"
                    FontWeight="SemiBold" Margin="10,0,0,0"/>
            </Grid>

            <Grid Grid.Row="3" Background="{DynamicResource OperatorTimelineTrackOverlayBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="7,0,0,0">
                    <controls:RtaimeToggleButton Content="SNAP" IsChecked="{Binding Snapping, Mode=TwoWay}"
                        IsCompact="True" ToolTip="Snap to real saved clip and transition edges." />
                    <TextBlock Text="{Binding EditCursorLabel}" Style="{StaticResource OperatorTimecode}"
                        VerticalAlignment="Center" Margin="7,0,0,0" />
                </StackPanel>
                <Border Grid.Column="1" Background="Transparent" MouseLeftButtonDown="OnRulerClick"
                    x:Name="SequenceRuler"
                    SizeChanged="OnViewportSizeChanged"
                    ToolTip="Click to position local edit cursor. No Preview/Program seek.">
                    <Grid ClipToBounds="True">
                        <ItemsControl ItemsSource="{Binding RulerMarks}" IsHitTestVisible="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><Canvas Height="26" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="{x:Type ContentPresenter}">
                                    <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="1" Height="13" Background="{DynamicResource OperatorSecondaryTextBrush}" />
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource OperatorLabel}"
                                            Margin="4,0,9,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Canvas IsHitTestVisible="False">
                            <Border Canvas.Left="{Binding CursorLeft}" Width="2" Height="26"
                                Background="{DynamicResource OperatorAccentBrush}" Opacity="{Binding CursorRulerOpacity}" />
                        </Canvas>
                        <TextBlock Text="{Binding Zoom, StringFormat=ZOOM {0:0}×}"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Background="{DynamicResource OperatorTimelineTrackOverlayBrush}"
                            Style="{StaticResource OperatorLabel}" Margin="0,0,5,0"
                            IsHitTestVisible="False" />
                    </Grid>
                </Border>
            </Grid>

            <Grid x:Name="SequenceTrackViewport" Grid.Row="4" ClipToBounds="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <controls:RtaimeScrollViewer x:Name="SequenceTrackScroll" Grid.ColumnSpan="2"
                    VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                    ScrollChanged="OnTrackScrollChanged">
                    <ItemsControl ItemsSource="{Binding VisibleRows}"
                        SnapsToDevicePixels="True">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="42" ClipToBounds="True">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" BorderBrush="{DynamicResource OperatorBorderBrush}"
                                        BorderThickness="0,0,1,1"
                                        Background="{DynamicResource OperatorSurfaceBrush}" Padding="8,2"
                                        Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType={x:Type local:SequenceTimelineControl}}}"
                                        ContextMenu="{StaticResource SequenceTrackActionsMenu}"
                                        ContextMenuOpening="OnTrackActionsOpening">
                                        <DockPanel VerticalAlignment="Center" LastChildFill="True">
                                            <TextBlock Text="{Binding Kind}" DockPanel.Dock="Right"
                                                Style="{StaticResource OperatorLabel}" Margin="5,0,0,0"/>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource OperatorValue}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock Style="{StaticResource OperatorLabel}">
                                                    <Run Text="LAYER " /><Run Text="{Binding Layer}" />
                                                    <Run Text=" · ENABLED " /><Run Text="{Binding Enabled}" />
                                                    <Run Text=" · MUTE " /><Run Text="{Binding Muted}" />
                                                </TextBlock>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                    <Border Grid.Column="1" Background="{DynamicResource OperatorTimelineTrackOverlayBrush}"
                                        BorderBrush="{DynamicResource OperatorBorderBrush}" BorderThickness="0,0,0,1"
                                        x:Name="SequenceTrackCanvasArea" ClipToBounds="True"
                                        AllowDrop="True" DragOver="OnTrackDragOver" Drop="OnTrackDrop"
                                        ToolTip="Drop an online catalogue video/audio asset onto a saved matching track to create a persisted clip.">
                                        <ItemsControl ItemsSource="{Binding Clips}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Canvas Height="42" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemContainerStyle>
                                                <Style TargetType="{x:Type ContentPresenter}">
                                                    <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                                    <Setter Property="Canvas.Top" Value="0" />
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Width="{Binding Width}" Height="38"
                                                        Style="{StaticResource SequenceClipSurface}" Margin="0,2,0,0"
                                                        ToolTip="{Binding Id}"
                                                        Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType={x:Type local:SequenceTimelineControl}}}"
                                                        ContextMenu="{StaticResource SequenceEditActionsMenu}"
                                                        ContextMenuOpening="OnClipActionsOpening"
                                                        MouseLeftButtonDown="OnClipMouseDown" MouseMove="OnClipPointerMoved">
                                                        <Grid ClipToBounds="True">
                                                            <TextBlock Text="{Binding AssetId}" Margin="7,1,7,0"
                                                                FontSize="{StaticResource OperatorFontSizeCompact}" TextTrimming="CharacterEllipsis"
                                                                Foreground="{DynamicResource OperatorTextBrush}" />
                                                            <local:SequenceWaveformGlyph
                                                                Presentation="{Binding Waveform}" Height="22"
                                                                VerticalAlignment="Bottom"
                                                                IsHitTestVisible="False" Margin="3,0,3,2" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </controls:RtaimeScrollViewer>
                <Canvas Grid.Column="1" IsHitTestVisible="False" ClipToBounds="True">
                    <Border Canvas.Left="{Binding CursorLeft}" Width="1"
                        Height="{Binding ElementName=SequenceTrackViewport, Path=ActualHeight}"
                        Background="{DynamicResource OperatorAccentBrush}" Opacity="{Binding CursorTrackOpacity}" />
                </Canvas>
            </Grid>

            <Grid Grid.Row="5" Margin="8,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <controls:RtaimeButton Content="TRACKS ▲" Command="{Binding PreviousTracksCommand}"
                    IsCompact="True" Margin="0,1,5,1"
                    ToolTip="Show preceding saved tracks without realizing offscreen tracks." />
                <controls:RtaimeButton Grid.Column="1" Content="TRACKS ▼" Command="{Binding NextTracksCommand}"
                    IsCompact="True" Margin="0,1,8,1"
                    ToolTip="Show next saved tracks without realizing offscreen tracks." />
                <TextBlock Grid.Column="2" Text="{Binding SelectedStatus}"
                    TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                    ToolTip="{Binding SelectedStatus}" Style="{StaticResource OperatorLabel}" />
            </Grid>
        </Grid>
    </Border>
</UserControl>