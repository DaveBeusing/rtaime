<UserControl x:Class="rtaime.Operator.OperatorMultiviewControl"
	x:Name="Root"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	MinHeight="360"
	AutomationProperties.Name="Live production multiview">
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="170" />
			<RowDefinition Height="8" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<DockPanel Grid.Row="0" Margin="0,0,0,8">
			<StackPanel Orientation="Horizontal">
				<TextBlock Text="LIVE MULTIVIEW" Style="{StaticResource OperatorSectionTitle}" VerticalAlignment="Center" />
				<Border Style="{StaticResource OperatorStatusBadge}" Margin="8,0,0,0">
					<TextBlock Text="{Binding SourceGridPreset, ElementName=Root}" FontWeight="SemiBold" />
				</Border>
			</StackPanel>
			<StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
				<TextBlock Text="{Binding DisplayedSourceSummary, ElementName=Root}" Style="{StaticResource OperatorLabel}" VerticalAlignment="Center" Margin="0,0,10,0" />
				<TextBlock Text="Double-click tile for large view · selection never routes" Style="{StaticResource OperatorLabel}" VerticalAlignment="Center" />
			</StackPanel>
		</DockPanel>

		<Grid Grid.Row="1">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="8" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>

			<Border Grid.Column="0"
				BorderBrush="{DynamicResource OperatorPreviewBrush}"
				BorderThickness="2"
				Background="Black"
				MouseDoubleClick="PreviewTile_MouseDoubleClick">
				<Grid>
					<Image Source="{Binding PreviewImage, ElementName=Root}" Stretch="Uniform" SnapsToDevicePixels="True" />
					<Border VerticalAlignment="Top" HorizontalAlignment="Left" Background="#D0000000" Padding="8,4">
						<TextBlock Text="PVW · PREVIEW" Foreground="{DynamicResource OperatorPreviewBrush}" FontWeight="Bold" />
					</Border>
					<Border VerticalAlignment="Bottom" Background="#D0000000" Padding="8,4">
						<DockPanel>
							<TextBlock Text="{Binding PreviewState, ElementName=Root}" Foreground="White" FontWeight="SemiBold" />
							<TextBlock Text="MONITOR" Foreground="{DynamicResource OperatorMutedTextBrush}" DockPanel.Dock="Right" />
						</DockPanel>
					</Border>
				</Grid>
			</Border>

			<Border Grid.Column="2"
				BorderBrush="{DynamicResource OperatorProgramBrush}"
				BorderThickness="2"
				Background="Black"
				MouseDoubleClick="ProgramTile_MouseDoubleClick">
				<Grid>
					<Image Source="{Binding ProgramImage, ElementName=Root}" Stretch="Uniform" SnapsToDevicePixels="True" />
					<Border VerticalAlignment="Top" HorizontalAlignment="Left" Background="#D0000000" Padding="8,4">
						<TextBlock Text="PGM · PROGRAM" Foreground="{DynamicResource OperatorProgramBrush}" FontWeight="Bold" />
					</Border>
					<Border VerticalAlignment="Bottom" Background="#D0000000" Padding="8,4">
						<DockPanel>
							<TextBlock Text="{Binding ProgramState, ElementName=Root}" Foreground="White" FontWeight="SemiBold" />
							<TextBlock Text="MONITOR" Foreground="{DynamicResource OperatorMutedTextBrush}" DockPanel.Dock="Right" />
						</DockPanel>
					</Border>
				</Grid>
			</Border>
		</Grid>

		<Border Grid.Row="3"
			Background="{DynamicResource OperatorBackgroundBrush}"
			BorderBrush="{DynamicResource OperatorBorderBrush}"
			BorderThickness="1"
			Padding="4">
			<Grid>
				<ListBox
					ItemsSource="{Binding DisplayedSources, ElementName=Root}"
					SelectedItem="{Binding SelectedSource, ElementName=Root, Mode=TwoWay}"
					Background="Transparent"
					BorderThickness="0"
					ScrollViewer.HorizontalScrollBarVisibility="Disabled"
					ScrollViewer.VerticalScrollBarVisibility="Auto"
					ItemContainerStyle="{StaticResource OperatorSourceItem}"
					AutomationProperties.Name="Live multiview sources">
					<ListBox.ItemsPanel>
						<ItemsPanelTemplate>
							<UniformGrid Columns="{Binding SourceGridColumns, ElementName=Root}" />
						</ItemsPanelTemplate>
					</ListBox.ItemsPanel>
					<ListBox.ItemTemplate>
						<DataTemplate>
							<Border MinHeight="132"
								Margin="3"
								Background="Black"
								BorderBrush="{DynamicResource OperatorBorderBrush}"
								BorderThickness="1"
								MouseDoubleClick="SourceTile_MouseDoubleClick"
								ToolTip="{Binding ThumbnailFormat}">
								<Grid>
									<Image Source="{Binding Thumbnail}" Stretch="UniformToFill" SnapsToDevicePixels="True" />

									<Border VerticalAlignment="Top" Background="#D0000000" Padding="6,4">
										<Grid>
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="*" />
												<ColumnDefinition Width="Auto" />
											</Grid.ColumnDefinitions>
											<StackPanel>
												<TextBlock Text="{Binding Name}" Foreground="White" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
												<TextBlock Text="{Binding Format}" Foreground="#D8FFFFFF" FontSize="10" TextTrimming="CharacterEllipsis" />
											</StackPanel>
											<StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
												<Border Margin="4,0,0,0">
													<Border.Style>
														<Style TargetType="Border" BasedOn="{StaticResource OperatorPreviewTally}">
															<Setter Property="Visibility" Value="Collapsed" />
															<Style.Triggers>
																<DataTrigger Binding="{Binding IsPreview}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
															</Style.Triggers>
														</Style>
													</Border.Style>
													<TextBlock Text="PVW" Foreground="{DynamicResource OperatorPreviewBrush}" FontSize="10" FontWeight="Bold" />
												</Border>
												<Border Margin="4,0,0,0">
													<Border.Style>
														<Style TargetType="Border" BasedOn="{StaticResource OperatorProgramTally}">
															<Setter Property="Visibility" Value="Collapsed" />
															<Style.Triggers>
																<DataTrigger Binding="{Binding IsProgram}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
															</Style.Triggers>
														</Style>
													</Border.Style>
													<TextBlock Text="PGM" Foreground="{DynamicResource OperatorProgramBrush}" FontSize="10" FontWeight="Bold" />
												</Border>
											</StackPanel>
										</Grid>
									</Border>

									<Border Background="#B0000000" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="10,6">
										<Border.Style>
											<Style TargetType="Border">
												<Setter Property="Visibility" Value="Collapsed" />
												<Style.Triggers>
													<DataTrigger Binding="{Binding Health}" Value="LOST"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
													<DataTrigger Binding="{Binding Health}" Value="ERROR"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
													<DataTrigger Binding="{Binding Health}" Value="FAILED"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
													<DataTrigger Binding="{Binding Health}" Value="OFFLINE"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
												</Style.Triggers>
											</Style>
										</Border.Style>
										<StackPanel>
											<TextBlock Text="SOURCE UNAVAILABLE" Foreground="{DynamicResource OperatorErrorBrush}" FontWeight="Bold" HorizontalAlignment="Center" />
											<TextBlock Text="{Binding Health}" Foreground="White" HorizontalAlignment="Center" />
										</StackPanel>
									</Border>

									<Border VerticalAlignment="Bottom" Background="#D0000000" Padding="6,4">
										<Grid>
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="*" />
												<ColumnDefinition Width="70" />
											</Grid.ColumnDefinitions>
											<StackPanel>
												<TextBlock Text="{Binding StateDetail}" Foreground="White" FontSize="10" TextTrimming="CharacterEllipsis" />
												<TextBlock Text="{Binding Health, StringFormat=HEALTH {0}}" Foreground="#D8FFFFFF" FontSize="9" />
											</StackPanel>
											<Grid Grid.Column="1" Margin="7,0,0,0">
												<Grid.RowDefinitions>
													<RowDefinition Height="*" />
													<RowDefinition Height="2" />
													<RowDefinition Height="*" />
												</Grid.RowDefinitions>
												<ProgressBar Grid.Row="0" Minimum="0" Maximum="1" Value="{Binding AudioLeftPeak, Mode=OneWay}" Style="{StaticResource OperatorMeter}" Height="5" />
												<ProgressBar Grid.Row="2" Minimum="0" Maximum="1" Value="{Binding AudioRightPeak, Mode=OneWay}" Style="{StaticResource OperatorMeter}" Height="5" />
												<Border Grid.RowSpan="3" BorderBrush="{DynamicResource OperatorErrorBrush}" BorderThickness="1">
													<Border.Style>
														<Style TargetType="Border">
															<Setter Property="Visibility" Value="Collapsed" />
															<Style.Triggers><DataTrigger Binding="{Binding AudioClipping}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
														</Style>
													</Border.Style>
												</Border>
											</Grid>
										</Grid>
									</Border>
								</Grid>
							</Border>
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>

				<Border x:Name="ExpandedPreviewOverlay"
					Visibility="Collapsed"
					Background="#F211151B"
					BorderBrush="{DynamicResource OperatorAccentBrush}"
					BorderThickness="2"
					Panel.ZIndex="20"
					Padding="10">
					<Grid>
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="*" />
							<RowDefinition Height="Auto" />
						</Grid.RowDefinitions>
						<DockPanel Margin="0,0,0,8">
							<TextBlock x:Name="ExpandedTitle" Style="{StaticResource OperatorSectionTitle}" />
							<Button Content="CLOSE"
								Click="CloseExpanded_Click"
								Style="{StaticResource OperatorButton}"
								Padding="8,3"
								DockPanel.Dock="Right" />
						</DockPanel>
						<Border Grid.Row="1" Background="Black">
							<Image x:Name="ExpandedImage" Stretch="Uniform" SnapsToDevicePixels="True" />
						</Border>
						<TextBlock x:Name="ExpandedDetail" Grid.Row="2" Style="{StaticResource OperatorLabel}" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" />
					</Grid>
				</Border>
			</Grid>
		</Border>
	</Grid>
</UserControl>