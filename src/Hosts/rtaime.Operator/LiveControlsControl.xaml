<UserControl x:Class="rtaime.Operator.LiveControlsControl"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:rtaime.Operator.Controls"
	AutomationProperties.Name="Live production controls">
	<UserControl.Resources>
		<Style x:Key="LiveSection" TargetType="Border">
			<Setter Property="Background" Value="{DynamicResource OperatorSurfaceBrush}" />
			<Setter Property="BorderBrush" Value="{DynamicResource OperatorBorderBrush}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="CornerRadius" Value="{DynamicResource OperatorRadiusPanel}" />
			<Setter Property="Padding" Value="10" />
			<Setter Property="Margin" Value="0,0,0,6" />
		</Style>
		<Style x:Key="LiveLayerRow" TargetType="Border">
			<Setter Property="Height" Value="38" />
			<Setter Property="Background" Value="{DynamicResource OperatorRaisedSurfaceBrush}" />
			<Setter Property="BorderBrush" Value="{DynamicResource OperatorBorderBrush}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="CornerRadius" Value="{DynamicResource OperatorRadiusControl}" />
			<Setter Property="Padding" Value="7,0" />
		</Style>
		<Style x:Key="LiveAlertRow" TargetType="Border">
			<Setter Property="MinHeight" Value="42" />
			<Setter Property="Background" Value="{DynamicResource OperatorRaisedSurfaceBrush}" />
			<Setter Property="BorderBrush" Value="{DynamicResource OperatorBorderBrush}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="CornerRadius" Value="{DynamicResource OperatorRadiusControl}" />
			<Setter Property="Padding" Value="7,4" />
			<Setter Property="Margin" Value="0,0,0,3" />
		</Style>
	</UserControl.Resources>

	<Grid Background="{DynamicResource OperatorPanelBrush}">
		<Grid.RowDefinitions>
			<RowDefinition Height="40" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<Border Grid.Row="0"
			Background="{DynamicResource OperatorAlternateSurfaceBrush}"
			BorderBrush="{DynamicResource OperatorBorderBrush}"
			BorderThickness="1,0,0,1"
			Padding="10,0">
			<Grid>
				<TextBlock Text="LIVE CONTROLS" Style="{StaticResource OperatorSectionTitle}" VerticalAlignment="Center" />
				<controls:RtaimeIconButton
					IconData="{StaticResource RtaimeIconChevronRightGeometry}"
					Command="{Binding Shell.ToggleRightPanelCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
					Width="26"
					Height="26"
					HorizontalAlignment="Right"
					VerticalAlignment="Center"
					ToolTip="Collapse Live Controls" />
			</Grid>
		</Border>

		<controls:RtaimeScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="10">
			<StackPanel>
				<Border Style="{StaticResource LiveSection}">
					<StackPanel>
						<TextBlock Text="TRANSITIONS" Style="{StaticResource OperatorSectionTitle}" Margin="0,0,0,8" />

						<Grid Margin="0,0,0,4">
							<Grid.ColumnDefinitions><ColumnDefinition Width="76" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
							<TextBlock Text="Selected" Style="{StaticResource OperatorLabel}" VerticalAlignment="Center" />
							<TextBlock Grid.Column="1" Text="{Binding SelectedSource.Name, TargetNullValue=No selection}" FontSize="{StaticResource OperatorFontSizeCaption}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
						</Grid>
						<Grid Margin="0,0,0,4">
							<Grid.ColumnDefinitions><ColumnDefinition Width="76" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
							<TextBlock Text="NEXT / PVW" Foreground="{DynamicResource OperatorPreviewBrush}" FontSize="{StaticResource OperatorFontSizeCompact}" FontWeight="Bold" VerticalAlignment="Center" />
							<TextBlock Grid.Column="1" Text="{Binding PreviewSourceName}" FontSize="{StaticResource OperatorFontSizeCaption}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
						</Grid>
						<Grid Margin="0,0,0,8">
							<Grid.ColumnDefinitions><ColumnDefinition Width="76" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
							<TextBlock Text="LIVE / PGM" Foreground="{DynamicResource OperatorProgramBrush}" FontSize="{StaticResource OperatorFontSizeCompact}" FontWeight="Bold" VerticalAlignment="Center" />
							<TextBlock Grid.Column="1" Text="{Binding ProgramSourceName}" FontSize="{StaticResource OperatorFontSizeCaption}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
						</Grid>

						<Grid Margin="0,0,0,6">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="4" />
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="4" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<controls:RtaimeButton Grid.Column="0"
								Content="SET PVW"
								Command="{Binding SetPreviewCommand}"
								IsCompact="True"
								AutomationProperties.Name="Set selected source on Preview only"
								ToolTip="{Binding SetPreviewDetail}" ToolTipService.ShowOnDisabled="True" />
							<controls:RtaimeButton Grid.Column="2"
								Content="CUT"
								Command="{Binding CutCommand}"
								AutomationProperties.Name="Cut confirmed Preview source to Program"
								IsCompact="True"
								Background="{DynamicResource OperatorAccentBrush}"
								BorderBrush="{DynamicResource OperatorAccentBrush}"
								Foreground="{DynamicResource OperatorBackgroundBrush}"
								ToolTip="{Binding PreviewTakeDetail}" ToolTipService.ShowOnDisabled="True" />
							<controls:RtaimeButton Grid.Column="4"
								Content="AUTO"
								Command="{Binding DissolveCommand}"
								AutomationProperties.Name="Dissolve confirmed Preview source to Program"
								IsCompact="True"
								ToolTip="{Binding PreviewTakeDetail}" ToolTipService.ShowOnDisabled="True" />
						</Grid>

						<TextBlock Text="{Binding LiveTakeEvidence}" Style="{StaticResource OperatorLabel}" Margin="0,6,0,2"
							TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="Authoritative LIVE Take evidence" />
						<TextBlock Text="{Binding CommitStatus, StringFormat={}CONTROL {0}}" Style="{StaticResource OperatorLabel}"
							TextWrapping="Wrap" ToolTip="Control confirmation is distinct from executed, presented and externally delivered Program." />
						<TextBlock Text="{Binding LastError}" Style="{StaticResource OperatorLabel}" TextWrapping="Wrap"
							Margin="0,2,0,0" ToolTip="Previous production request detail; do not retry an uncertain request without synchronization." />
						<controls:RtaimeButton Content="SHOW TAKE DETAILS" Click="ToggleSecondaryDetails_Click" Tag="TakeDetails"
                            AutomationProperties.Name="Show take details" IsCompact="True" HorizontalAlignment="Left"
                            Margin="0,5,0,0" ToolTip="View duration draft and observed Rundown context; opening does not TAKE." />
                        <StackPanel x:Name="TakeDetails" Visibility="Collapsed" Margin="0,6,0,0">
						<Grid>
							<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="76" /></Grid.ColumnDefinitions>
							<TextBlock Text="{Binding PreviewTakeDetail}" TextWrapping="Wrap" Style="{StaticResource OperatorLabel}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
							<controls:RtaimeTextBox Grid.Column="1"
								Text="{Binding TransitionFrames, UpdateSourceTrigger=PropertyChanged}"
								Height="30" AutomationProperties.Name="AUTO transition duration in frames"
								ToolTip="AUTO duration in frames; at least two frames required. CUT ignores this draft." />
						</Grid>
						<Border Background="{DynamicResource OperatorRaisedSurfaceBrush}" BorderBrush="{DynamicResource OperatorBorderBrush}"
							BorderThickness="1" CornerRadius="{DynamicResource OperatorRadiusControl}" Padding="6" Margin="0,8,0,0">
							<StackPanel>
								<TextBlock Text="NEXT RUNDOWN · OBSERVED, NOT TAKEN" Style="{StaticResource OperatorLabel}"
									FontWeight="SemiBold" />
								<TextBlock Text="{Binding Rundown.PendingNext, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
									Style="{StaticResource OperatorValue}" TextTrimming="CharacterEllipsis" ToolTip="Rundown GO and Scene TAKE use their own authoritative commands." />
								<TextBlock Text="{Binding Rundown.NextItemStatus, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
									Style="{StaticResource OperatorLabel}" TextWrapping="Wrap" />
							</StackPanel>
						</Border>
                        </StackPanel>
					</StackPanel>
				</Border>

                <Border Style="{StaticResource LiveSection}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,5" LastChildFill="False">
                            <TextBlock Text="STREAM &amp; RECORD" Style="{StaticResource OperatorSectionTitle}" />
                            <controls:RtaimeStatusBadge
                                Status="{x:Static controls:RtaimeStatusKind.Neutral}"
                                Content="{Binding RecordingStatus}"
                                ShowIndicator="False" DockPanel.Dock="Right"
                                AutomationProperties.Name="Confirmed Program recording state" />
                        </DockPanel>
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="Program recording elapsed" Style="{StaticResource OperatorLabel}" />
                            <controls:RtaimeTimecode DockPanel.Dock="Right" Content="{Binding RecordingElapsed}"
                                HorizontalContentAlignment="Right" />
                        </DockPanel>
                        <TextBlock Text="{Binding RecordingError}" Style="{StaticResource OperatorLabel}"
                            TextWrapping="Wrap" Foreground="{DynamicResource OperatorWarningBrush}"
                            AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="Recording failure detail" />
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,7">
                            <controls:RtaimeButton Content="START REC" Command="{Binding StartRecordingCommand}"
                                IsCompact="True" MinWidth="144" AutomationProperties.Name="Start Program recording"
                                ToolTip="Request a governed Program recording start; availability and destination are checked before execution."
                                ToolTipService.ShowOnDisabled="True">
                                <controls:RtaimeButton.Style>
                                    <Style TargetType="{x:Type controls:RtaimeButton}" BasedOn="{StaticResource {x:Type controls:RtaimeButton}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RecordingStatus}" Value="RECORDING">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RecordingStatus}" Value="FINALIZING">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </controls:RtaimeButton.Style>
                            </controls:RtaimeButton>
                            <controls:RtaimeButton Content="STOP REC" Command="{Binding StopRecordingCommand}"
                                IsCompact="True" MinWidth="144" AutomationProperties.Name="Stop active Program recording"
                                Background="{DynamicResource OperatorErrorBrush}" BorderBrush="{DynamicResource OperatorErrorBrush}"
                                Foreground="{DynamicResource OperatorOverlayTextBrush}"
                                ToolTip="Request stop and finalization of the active Program recording. Does not prove a finalized file until confirmed."
                                ToolTipService.ShowOnDisabled="True">
                                <controls:RtaimeButton.Style>
                                    <Style TargetType="{x:Type controls:RtaimeButton}" BasedOn="{StaticResource {x:Type controls:RtaimeButton}}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RecordingStatus}" Value="RECORDING">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </controls:RtaimeButton.Style>
                            </controls:RtaimeButton>
                        </StackPanel>
                        <TextBlock Text="{Binding RecordingActiveProfile, StringFormat=Active recording profile: {0}}"
                            Style="{StaticResource OperatorLabel}" TextTrimming="CharacterEllipsis"
                            ToolTip="{Binding RecordingActiveProfile}" />

                        <DockPanel Margin="0,8,0,2">
                            <TextBlock Text="LOCAL CLEAN PROGRAM" Style="{StaticResource OperatorLabel}" FontWeight="SemiBold" />
                            <TextBlock DockPanel.Dock="Right"
                                Text="{Binding ProgramOutput.RunState, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                Style="{StaticResource OperatorValue}" AutomationProperties.Name="Local clean monitoring state" />
                        </DockPanel>
                        <controls:RtaimeButton Content="SHOW CLEAN MONITORING" Click="ToggleSecondaryDetails_Click"
                            Tag="MonitoringDetails" AutomationProperties.Name="Show clean monitoring" IsCompact="True"
                            HorizontalAlignment="Left" ToolTip="Local clean viewing controls; this is not external network or physical output." />
                        <StackPanel x:Name="MonitoringDetails" Visibility="Collapsed" Margin="0,5,0,3">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="4" /><ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <controls:RtaimeButton Grid.Column="0" Content="OPEN CLEAN"
                                    Command="{Binding ProgramOutput.StartCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                    IsCompact="True" AutomationProperties.Name="Open local Clean Program monitoring" />
                                <controls:RtaimeButton Grid.Column="2" Content="STOP CLEAN"
                                    Command="{Binding ProgramOutput.StopCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                    IsCompact="True" AutomationProperties.Name="Stop local Clean Program monitoring" />
                            </Grid>
                        </StackPanel>

                        <TextBlock Text="NETWORK TRANSMISSION" Style="{StaticResource OperatorLabel}"
                            FontWeight="SemiBold" Margin="0,10,0,3" />
                        <Grid Margin="0,0,0,4" ToolTip="{Binding OutputHealth.ProgramTransmissionDetail, RelativeSource={RelativeSource AncestorType={x:Type Window}}}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Program send" Style="{StaticResource OperatorLabel}" />
                            <controls:RtaimeStatusBadge Grid.Column="1" Content="{Binding OutputHealth.ProgramTransmissionState, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                ShowIndicator="True" AutomationProperties.Name="Program network transmission evidence" />
                        </Grid>
                        <Grid Margin="0,0,0,3" ToolTip="{Binding OutputHealth.AuxTransmissionDetail, RelativeSource={RelativeSource AncestorType={x:Type Window}}}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Aux send" Style="{StaticResource OperatorLabel}" />
                            <controls:RtaimeStatusBadge Grid.Column="1" Content="{Binding OutputHealth.AuxTransmissionState, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                ShowIndicator="True" AutomationProperties.Name="Aux network transmission evidence" />
                        </Grid>
                        <controls:RtaimeButton Content="SHOW TRANSMISSION DETAILS" Click="ToggleSecondaryDetails_Click"
                            Tag="TransmissionDetails" AutomationProperties.Name="Show transmission details" IsCompact="True"
                            HorizontalAlignment="Left" ToolTip="Provider send evidence, separate from Clean Program and physical scan-out." />
                        <StackPanel x:Name="TransmissionDetails" Visibility="Collapsed" Margin="0,5,0,0">
                            <TextBlock Text="{Binding OutputHealth.ProgramTransmissionDetail, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                Style="{StaticResource OperatorLabel}" TextWrapping="Wrap" Margin="0,0,0,5"
                                AutomationProperties.Name="Program provider transmission detail" />
                            <TextBlock Text="{Binding OutputHealth.AuxTransmissionDetail, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                Style="{StaticResource OperatorLabel}" TextWrapping="Wrap" Margin="0,0,0,5"
                                AutomationProperties.Name="Aux provider transmission detail" />
                            <TextBlock Text="Observed network send is not proof of physical display output or recording-file finalization."
                                Style="{StaticResource OperatorLabel}" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Border>

				<Border Style="{StaticResource LiveSection}">
					<StackPanel>
						<DockPanel Margin="0,0,0,8">
							<TextBlock Text="LAYER STACK (PGM)" Style="{StaticResource OperatorSectionTitle}" />
							<controls:RtaimeStatusBadge
								Status="{x:Static controls:RtaimeStatusKind.Program}"
								Content="{Binding GraphicsState}"
								ShowIndicator="False"
								DockPanel.Dock="Right" />
						</DockPanel>

						<Border Style="{StaticResource LiveLayerRow}">
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="26" />
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="Auto" />
								</Grid.ColumnDefinitions>
								<TextBlock Text="01" Style="{StaticResource OperatorLabel}" FontFamily="{DynamicResource OperatorTimecodeFontFamily}" VerticalAlignment="Center" />
								<StackPanel Grid.Column="1" VerticalAlignment="Center">
									<TextBlock Text="{Binding GraphicsAssetName}" FontSize="{StaticResource OperatorFontSizeCaption}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
									<TextBlock Text="{Binding GraphicsDimensions}" Style="{StaticResource OperatorLabel}" FontSize="{StaticResource OperatorFontSizeMicro}" />
								</StackPanel>
								<controls:RtaimeStatusBadge Grid.Column="2"
									Status="{x:Static controls:RtaimeStatusKind.Program}"
									Content="{Binding GraphicsVisible, StringFormat=VISIBLE {0}}"
									ShowIndicator="False"
									VerticalAlignment="Center" />
							</Grid>
						</Border>

                        <TextBlock Text="{Binding CompositingLayers.Count, StringFormat=Confirmed compositing layers: {0}}"
                            Style="{StaticResource OperatorLabel}" Margin="0,4,0,0" />
                        <controls:RtaimeButton Content="SHOW LAYER SETTINGS" Click="ToggleSecondaryDetails_Click" Tag="LayerDetails"
                            AutomationProperties.Name="Show layer settings" IsCompact="True" HorizontalAlignment="Left"
                            Margin="0,5,0,0" ToolTip="Inspect confirmed layer rows and request a governed graphics visibility change." />
                        <StackPanel x:Name="LayerDetails" Visibility="Collapsed" Margin="0,6,0,0">
                        <ItemsControl ItemsSource="{Binding CompositingLayers}" Margin="0,4,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource LiveLayerRow}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding LayerId}" Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding Visible, StringFormat=VISIBLE {0}}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
						<controls:RtaimeButton
							Content="SHOW / HIDE CURRENT LAYER"
							Command="{Binding ToggleGraphicsCommand}"
							IsCompact="True"
							Margin="0,6,0,0"
							ToolTip="Reuse the existing governed graphics visibility command." />
						<TextBlock
							Text="Confirmed layers below. Edit the layer stack in Compositing."
							Style="{StaticResource OperatorLabel}"
							FontSize="{StaticResource OperatorFontSizeMicro}"
							TextWrapping="Wrap"
							Margin="0,5,0,0" />
                        </StackPanel>
					</StackPanel>
				</Border>

                				<Border Style="{StaticResource LiveSection}" Margin="0">
					<StackPanel>
						<DockPanel Margin="0,0,0,6" LastChildFill="False">
                            <TextBlock Text="ALERTS &amp; NOTIFICATIONS" Style="{StaticResource OperatorSectionTitle}" />
                            <TextBlock Text="{Binding Notifications.ActiveProblems.Count, RelativeSource={RelativeSource AncestorType={x:Type Window}}, StringFormat={}ACTIVE {0}}"
                                Style="{StaticResource OperatorLabel}" DockPanel.Dock="Right"
                                AutomationProperties.Name="Persistent operator problem count" />
                        </DockPanel>

						<controls:RtaimeAlertRow
							SubsystemName="Engine"
							State="{Binding EngineLifecycleState}"
							EvidenceState="{Binding EngineHealth}"
							Detail="{Binding EngineLifecycleDetail}" />

						<controls:RtaimeAlertRow
							SubsystemName="Runtime"
							State="{Binding RuntimeHealth}"
							EvidenceState="{Binding RuntimeHealth}"
							Detail="{Binding AffectedComponent}" />

						<controls:RtaimeAlertRow
							SubsystemName="Media"
							State="{Binding MediaHealth}"
							EvidenceState="{Binding MediaHealth}"
							Detail="Production media subsystem" />

						<ItemsControl
							ItemsSource="{Binding Notifications.ActiveProblems, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
							AutomationProperties.Name="Persistent operator problems">
							<ItemsControl.ItemTemplate>
								<DataTemplate>
									<Border Style="{StaticResource LiveAlertRow}">
										<StackPanel>
											<DockPanel>
												<TextBlock
													Text="{Binding AffectedComponent}"
													FontSize="{StaticResource OperatorFontSizeCompact}"
													FontWeight="Bold" />
												<StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
													<TextBlock Text="{Binding Condition}" Style="{StaticResource OperatorLabel}" FontSize="{StaticResource OperatorFontSizeMicro}" />
													<TextBlock Text=" " />
													<TextBlock Text="{Binding OccurrenceLabel}" Style="{StaticResource OperatorLabel}" FontSize="{StaticResource OperatorFontSizeMicro}" />
												</StackPanel>
											</DockPanel>
											<TextBlock
												Text="{Binding Title}"
												FontSize="{StaticResource OperatorFontSizeCaption}"
												FontWeight="SemiBold"
												TextWrapping="Wrap"
												Margin="0,3,0,0" />
											<TextBlock
												Text="{Binding Detail}"
												Style="{StaticResource OperatorLabel}"
												FontSize="{StaticResource OperatorFontSizeMicro}"
												TextWrapping="Wrap"
												Margin="0,3,0,0" />
											<TextBlock
												Text="{Binding ProductionImpact}"
												Style="{StaticResource OperatorLabel}"
												FontSize="{StaticResource OperatorFontSizeMicro}"
												TextWrapping="Wrap"
												Margin="0,3,0,0" />
											<TextBlock
												Text="{Binding OperatorAction}"
												Foreground="{DynamicResource OperatorWarningBrush}"
												FontSize="{StaticResource OperatorFontSizeMicro}"
												TextWrapping="Wrap"
												Margin="0,3,0,0" />
											<controls:RtaimeButton
												Content="{Binding TechnicalDetailsActionLabel}"
												Command="{Binding ToggleTechnicalDetailsCommand}"
												IsCompact="True"
												HorizontalAlignment="Left"
												Margin="0,5,0,0">
												<controls:RtaimeButton.Style>
													<Style TargetType="{x:Type controls:RtaimeButton}" BasedOn="{StaticResource {x:Type controls:RtaimeButton}}">
														<Style.Triggers>
															<DataTrigger Binding="{Binding HasTechnicalDetail}" Value="False">
																<Setter Property="Visibility" Value="Collapsed" />
															</DataTrigger>
														</Style.Triggers>
													</Style>
												</controls:RtaimeButton.Style>
											</controls:RtaimeButton>
											<Border
												Background="{DynamicResource OperatorAlternateSurfaceBrush}"
												BorderBrush="{DynamicResource OperatorBorderBrush}"
												BorderThickness="1"
												CornerRadius="{DynamicResource OperatorRadiusControl}"
												Padding="6"
												Margin="0,5,0,0">
												<Border.Style>
													<Style TargetType="Border">
														<Setter Property="Visibility" Value="Collapsed" />
														<Style.Triggers>
															<DataTrigger Binding="{Binding IsTechnicalDetailsVisible}" Value="True">
																<Setter Property="Visibility" Value="Visible" />
															</DataTrigger>
														</Style.Triggers>
													</Style>
												</Border.Style>
												<TextBlock
													Text="{Binding TechnicalDetail}"
													Style="{StaticResource OperatorLabel}"
													FontFamily="{DynamicResource OperatorTimecodeFontFamily}"
													FontSize="{StaticResource OperatorFontSizeMicro}"
													TextWrapping="Wrap" />
											</Border>
										</StackPanel>
									</Border>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</StackPanel>
				</Border>
			</StackPanel>
		</controls:RtaimeScrollViewer>
	</Grid>
</UserControl>
