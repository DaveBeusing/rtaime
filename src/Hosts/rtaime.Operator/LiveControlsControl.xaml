<UserControl x:Class="rtaime.Operator.LiveControlsControl"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	MinWidth="240"
	AutomationProperties.Name="Live production controls">
	<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
		<StackPanel>
			<DockPanel Margin="0,0,0,10">
				<TextBlock Text="LIVE CONTROLS" Style="{StaticResource OperatorSectionTitle}" />
				<Button Content="›"
					Command="{Binding Shell.ToggleRightPanelCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
					Style="{StaticResource OperatorButton}"
					MinWidth="30"
					MinHeight="26"
					Padding="6,2"
					DockPanel.Dock="Right"
					ToolTip="Collapse Live Controls" />
			</DockPanel>

			<Border Style="{StaticResource OperatorPanel}" Margin="0,0,0,10">
				<StackPanel>
					<TextBlock Text="ROUTING / TAKE" Style="{StaticResource OperatorLabel}" Margin="0,0,0,8" />
					<DockPanel Margin="0,0,0,5">
						<TextBlock Text="Selected" Style="{StaticResource OperatorLabel}" />
						<TextBlock Text="{Binding SelectedSource.Name, TargetNullValue=No selection}" Style="{StaticResource OperatorValue}" FontWeight="SemiBold" DockPanel.Dock="Right" TextTrimming="CharacterEllipsis" MaxWidth="180" />
					</DockPanel>
					<DockPanel Margin="0,0,0,5">
						<TextBlock Text="PVW / next" Style="{StaticResource OperatorLabel}" />
						<TextBlock Text="{Binding PreviewSourceName}" Foreground="{DynamicResource OperatorPreviewBrush}" FontWeight="SemiBold" DockPanel.Dock="Right" TextTrimming="CharacterEllipsis" MaxWidth="180" />
					</DockPanel>
					<DockPanel Margin="0,0,0,9">
						<TextBlock Text="PGM / live" Style="{StaticResource OperatorLabel}" />
						<TextBlock Text="{Binding ProgramSourceName}" Foreground="{DynamicResource OperatorProgramBrush}" FontWeight="SemiBold" DockPanel.Dock="Right" TextTrimming="CharacterEllipsis" MaxWidth="180" />
					</DockPanel>
					<Button Content="SET SELECTED → PREVIEW  Ctrl+P"
						Command="{Binding SetPreviewCommand}"
						Style="{StaticResource OperatorAccentButton}"
						Margin="0,0,0,6"
						ToolTip="Selection is non-destructive. This explicit command changes Preview." />
					<Grid>
						<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="6" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
						<Button Grid.Column="0" Content="CUT  Ctrl+Enter" Command="{Binding CutCommand}" Style="{StaticResource OperatorProgramButton}" />
						<Button Grid.Column="2" Content="AUTO  Enter" Command="{Binding DissolveCommand}" Style="{StaticResource OperatorButton}" />
					</Grid>
					<Grid Margin="0,9,0,0">
						<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="80" /></Grid.ColumnDefinitions>
						<StackPanel>
							<TextBlock Text="TRANSITION" Style="{StaticResource OperatorLabel}" />
							<TextBlock Text="CUT / DISSOLVE" Style="{StaticResource OperatorValue}" />
						</StackPanel>
						<StackPanel Grid.Column="1">
							<TextBlock Text="FRAMES" Style="{StaticResource OperatorLabel}" />
							<TextBox Text="{Binding TransitionFrames, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource OperatorTextBox}" />
						</StackPanel>
					</Grid>
					<TextBlock Text="{Binding TransitionStatus}" Style="{StaticResource OperatorLabel}" Margin="0,5,0,0" />
				</StackPanel>
			</Border>

			<Border Style="{StaticResource OperatorPanel}" Margin="0,0,0,10">
				<StackPanel>
					<DockPanel Margin="0,0,0,8">
						<TextBlock Text="LAYER / SCENE STACK" Style="{StaticResource OperatorLabel}" />
						<Border Style="{StaticResource OperatorStatusBadge}" DockPanel.Dock="Right"><TextBlock Text="{Binding GraphicsState}" FontWeight="Bold" /></Border>
					</DockPanel>
					<TextBlock Text="{Binding GraphicsAssetName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
					<TextBlock Text="{Binding GraphicsDimensions}" Style="{StaticResource OperatorLabel}" Margin="0,2,0,7" />
					<DockPanel Margin="0,0,0,7">
						<TextBlock Text="Committed visibility" Style="{StaticResource OperatorLabel}" />
						<TextBlock Text="{Binding GraphicsVisible}" Style="{StaticResource OperatorValue}" DockPanel.Dock="Right" />
					</DockPanel>
					<Button Content="SHOW / HIDE CURRENT LAYER"
						Command="{Binding ToggleGraphicsCommand}"
						Style="{StaticResource OperatorProgramButton}"
						ToolTip="Reuse the existing governed graphics visibility command." />
					<TextBlock Text="Dedicated multi-scene activation is not exposed by the current V1 contracts."
						Style="{StaticResource OperatorLabel}" TextWrapping="Wrap" Margin="0,7,0,0" />
				</StackPanel>
			</Border>

			<Border Style="{StaticResource OperatorPanel}" Margin="0,0,0,10">
				<StackPanel>
					<DockPanel Margin="0,0,0,8">
						<TextBlock Text="OUTPUT / RECORD" Style="{StaticResource OperatorLabel}" />
						<Border Style="{StaticResource OperatorStatusBadge}" DockPanel.Dock="Right">
							<TextBlock Text="{Binding RecordingStatus}" FontWeight="Bold" />
						</Border>
					</DockPanel>
					<DockPanel Margin="0,0,0,6">
						<TextBlock Text="Clean Program" Style="{StaticResource OperatorLabel}" />
						<TextBlock Text="{Binding ProgramOutput.RunState, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Style="{StaticResource OperatorValue}" DockPanel.Dock="Right" />
					</DockPanel>
					<DockPanel Margin="0,0,0,8">
						<TextBlock Text="Recording" Style="{StaticResource OperatorLabel}" />
						<TextBlock Text="{Binding RecordingElapsed}" Style="{StaticResource OperatorTimecode}" DockPanel.Dock="Right" />
					</DockPanel>
					<Grid Margin="0,0,0,6">
						<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="5" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
						<Button Grid.Column="0" Content="START REC" Command="{Binding StartRecordingCommand}" Style="{StaticResource OperatorAccentButton}" />
						<Button Grid.Column="2" Content="STOP REC" Command="{Binding StopRecordingCommand}" Style="{StaticResource OperatorProgramButton}" ToolTip="Explicitly stop and finalize the active Program recording." />
					</Grid>
					<Grid>
						<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="5" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
						<Button Grid.Column="0" Content="OPEN CLEAN" Command="{Binding ProgramOutput.StartCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Style="{StaticResource OperatorButton}" />
						<Button Grid.Column="2" Content="STOP CLEAN" Command="{Binding ProgramOutput.StopCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Style="{StaticResource OperatorButton}" />
					</Grid>
					<Border Style="{StaticResource OperatorStatusBadge}" Margin="0,8,0,0">
						<TextBlock Text="STREAM / EXTERNAL ON AIR · UNVERIFIED" Style="{StaticResource OperatorLabel}" FontWeight="SemiBold" />
					</Border>
				</StackPanel>
			</Border>

			<Border Style="{StaticResource OperatorPanel}">
				<StackPanel>
					<DockPanel Margin="0,0,0,8">
						<TextBlock Text="LIVE ALERTS" Style="{StaticResource OperatorLabel}" />
						<Border Style="{StaticResource OperatorLifecycleBadge}" Tag="{Binding EngineLifecycleState}" DockPanel.Dock="Right">
							<TextBlock Text="{Binding EngineLifecycleState}" FontWeight="Bold" />
						</Border>
					</DockPanel>
					<DockPanel Margin="0,0,0,5">
						<TextBlock Text="Engine" Style="{StaticResource OperatorLabel}" />
						<TextBlock Text="{Binding EngineHealth}" Style="{StaticResource OperatorValue}" DockPanel.Dock="Right" />
					</DockPanel>
					<DockPanel Margin="0,0,0,5">
						<TextBlock Text="Runtime" Style="{StaticResource OperatorLabel}" />
						<TextBlock Text="{Binding RuntimeHealth}" Style="{StaticResource OperatorValue}" DockPanel.Dock="Right" />
					</DockPanel>
					<DockPanel Margin="0,0,0,5">
						<TextBlock Text="Media" Style="{StaticResource OperatorLabel}" />
						<TextBlock Text="{Binding MediaHealth}" Style="{StaticResource OperatorValue}" DockPanel.Dock="Right" />
					</DockPanel>
					<DockPanel Margin="0,0,0,8">
						<TextBlock Text="Affected" Style="{StaticResource OperatorLabel}" />
						<TextBlock Text="{Binding AffectedComponent}" Style="{StaticResource OperatorValue}" DockPanel.Dock="Right" />
					</DockPanel>
					<TextBlock Text="{Binding EngineLifecycleDetail}" Style="{StaticResource OperatorLabel}" TextWrapping="Wrap" />
					<Border Margin="0,8,0,0" Padding="7,5" BorderBrush="{DynamicResource OperatorErrorBrush}" BorderThickness="1">
						<Border.Style>
							<Style TargetType="Border">
								<Setter Property="Visibility" Value="Visible" />
								<Style.Triggers>
									<DataTrigger Binding="{Binding LastError}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
									<DataTrigger Binding="{Binding LastError}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
								</Style.Triggers>
							</Style>
						</Border.Style>
						<StackPanel>
							<TextBlock Text="ERROR · OPERATOR / CONTROL" Foreground="{DynamicResource OperatorErrorBrush}" FontWeight="Bold" />
							<TextBlock Text="{Binding LastError}" TextWrapping="Wrap" Margin="0,3,0,0" />
						</StackPanel>
					</Border>
					<TextBlock Text="{Binding RecordingError}" Foreground="{DynamicResource OperatorErrorBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
				</StackPanel>
			</Border>
		</StackPanel>
	</ScrollViewer>
</UserControl>