<UserControl x:Class="rtaime.Operator.LiveControlsControl"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:rtaime.Operator.Controls"
	MinWidth="320"
	AutomationProperties.Name="Live production controls">
	<UserControl.Resources>
		<Style x:Key="LiveSection" TargetType="Border">
			<Setter Property="Background" Value="{DynamicResource OperatorSurfaceBrush}" />
			<Setter Property="BorderBrush" Value="{DynamicResource OperatorBorderBrush}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="CornerRadius" Value="{DynamicResource OperatorRadiusPanel}" />
			<Setter Property="Padding" Value="10" />
			<Setter Property="Margin" Value="0,0,0,6" />
		</Style>
		<Style x:Key="LiveLayerRow" TargetType="Border">
			<Setter Property="Height" Value="38" />
			<Setter Property="Background" Value="{DynamicResource OperatorRaisedSurfaceBrush}" />
			<Setter Property="BorderBrush" Value="{DynamicResource OperatorBorderBrush}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="CornerRadius" Value="{DynamicResource OperatorRadiusControl}" />
			<Setter Property="Padding" Value="7,0" />
		</Style>
		<Style x:Key="LiveAlertRow" TargetType="Border">
			<Setter Property="MinHeight" Value="42" />
			<Setter Property="Background" Value="{DynamicResource OperatorRaisedSurfaceBrush}" />
			<Setter Property="BorderBrush" Value="{DynamicResource OperatorBorderBrush}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="CornerRadius" Value="{DynamicResource OperatorRadiusControl}" />
			<Setter Property="Padding" Value="7,4" />
			<Setter Property="Margin" Value="0,0,0,3" />
		</Style>
	</UserControl.Resources>

	<Grid Background="{DynamicResource OperatorPanelBrush}">
		<Grid.RowDefinitions>
			<RowDefinition Height="40" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<Border Grid.Row="0"
			Background="{DynamicResource OperatorAlternateSurfaceBrush}"
			BorderBrush="{DynamicResource OperatorBorderBrush}"
			BorderThickness="1,0,0,1"
			Padding="10,0">
			<Grid>
				<TextBlock Text="LIVE CONTROLS" Style="{StaticResource OperatorSectionTitle}" VerticalAlignment="Center" />
				<controls:RtaimeIconButton
					IconData="{StaticResource RtaimeIconChevronRightGeometry}"
					Command="{Binding Shell.ToggleRightPanelCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
					Width="26"
					Height="26"
					HorizontalAlignment="Right"
					VerticalAlignment="Center"
					ToolTip="Collapse Live Controls" />
			</Grid>
		</Border>

		<controls:RtaimeScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="10">
			<StackPanel>
				<Border Style="{StaticResource LiveSection}">
					<StackPanel>
						<TextBlock Text="TRANSITIONS" Style="{StaticResource OperatorSectionTitle}" Margin="0,0,0,8" />

						<Grid Margin="0,0,0,4">
							<Grid.ColumnDefinitions><ColumnDefinition Width="76" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
							<TextBlock Text="Selected" Style="{StaticResource OperatorLabel}" VerticalAlignment="Center" />
							<TextBlock Grid.Column="1" Text="{Binding SelectedSource.Name, TargetNullValue=No selection}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
						</Grid>
						<Grid Margin="0,0,0,4">
							<Grid.ColumnDefinitions><ColumnDefinition Width="76" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
							<TextBlock Text="NEXT" Foreground="{DynamicResource OperatorPreviewBrush}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" />
							<TextBlock Grid.Column="1" Text="{Binding PreviewSourceName}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
						</Grid>
						<Grid Margin="0,0,0,8">
							<Grid.ColumnDefinitions><ColumnDefinition Width="76" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
							<TextBlock Text="LIVE" Foreground="{DynamicResource OperatorProgramBrush}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" />
							<TextBlock Grid.Column="1" Text="{Binding ProgramSourceName}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
						</Grid>

						<Grid Margin="0,0,0,6">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="4" />
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="4" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<controls:RtaimeButton Grid.Column="0"
								Content="SET NEXT"
								Command="{Binding SetPreviewCommand}"
								IsCompact="True"
								ToolTip="Route the selected source to Preview." />
							<controls:RtaimeButton Grid.Column="2"
								Content="TAKE"
								Command="{Binding CutCommand}"
								IsCompact="True"
								Background="{DynamicResource OperatorAccentBrush}"
								BorderBrush="{DynamicResource OperatorAccentBrush}"
								Foreground="{DynamicResource OperatorBackgroundBrush}"
								ToolTip="Take the confirmed Preview source to Program." />
							<controls:RtaimeButton Grid.Column="4"
								Content="AUTO"
								Command="{Binding DissolveCommand}"
								IsCompact="True"
								ToolTip="Dissolve the confirmed Preview source to Program." />
						</Grid>

						<Grid>
							<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="76" /></Grid.ColumnDefinitions>
							<TextBlock Text="{Binding TransitionStatus}" Style="{StaticResource OperatorLabel}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
							<controls:RtaimeTextBox Grid.Column="1"
								Text="{Binding TransitionFrames, UpdateSourceTrigger=PropertyChanged}"
								Height="30"
								ToolTip="Dissolve duration in frames." />
						</Grid>
					</StackPanel>
				</Border>

				<Border Style="{StaticResource LiveSection}">
					<StackPanel>
						<DockPanel Margin="0,0,0,8">
							<TextBlock Text="LAYER STACK (PGM)" Style="{StaticResource OperatorSectionTitle}" />
							<controls:RtaimeStatusBadge
								Status="{x:Static controls:RtaimeStatusKind.Program}"
								Content="{Binding GraphicsState}"
								ShowIndicator="False"
								DockPanel.Dock="Right" />
						</DockPanel>

						<Border Style="{StaticResource LiveLayerRow}">
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="26" />
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="Auto" />
								</Grid.ColumnDefinitions>
								<TextBlock Text="01" Style="{StaticResource OperatorLabel}" FontFamily="{DynamicResource OperatorTimecodeFontFamily}" VerticalAlignment="Center" />
								<StackPanel Grid.Column="1" VerticalAlignment="Center">
									<TextBlock Text="{Binding GraphicsAssetName}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
									<TextBlock Text="{Binding GraphicsDimensions}" Style="{StaticResource OperatorLabel}" FontSize="9" />
								</StackPanel>
								<controls:RtaimeStatusBadge Grid.Column="2"
									Status="{x:Static controls:RtaimeStatusKind.Program}"
									Content="{Binding GraphicsVisible, StringFormat=VISIBLE {0}}"
									ShowIndicator="False"
									VerticalAlignment="Center" />
							</Grid>
						</Border>

						<controls:RtaimeButton
							Content="SHOW / HIDE CURRENT LAYER"
							Command="{Binding ToggleGraphicsCommand}"
							IsCompact="True"
							Margin="0,6,0,0"
							ToolTip="Reuse the existing governed graphics visibility command." />
						<TextBlock
							Text="Additional PGM layer rows remain unavailable until governed layer-stack semantics exist."
							Style="{StaticResource OperatorLabel}"
							FontSize="9"
							TextWrapping="Wrap"
							Margin="0,5,0,0" />
					</StackPanel>
				</Border>

				<Border Style="{StaticResource LiveSection}">
					<StackPanel>
						<DockPanel Margin="0,0,0,8">
							<TextBlock Text="STREAM &amp; RECORD" Style="{StaticResource OperatorSectionTitle}" />
							<controls:RtaimeStatusBadge
								Status="{x:Static controls:RtaimeStatusKind.Neutral}"
								Content="{Binding RecordingStatus}"
								ShowIndicator="False"
								DockPanel.Dock="Right" />
						</DockPanel>

						<Grid Margin="0,0,0,5">
							<Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
							<TextBlock Text="Clean Program" Style="{StaticResource OperatorLabel}" />
							<TextBlock Grid.Column="1" Text="{Binding ProgramOutput.RunState, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" HorizontalAlignment="Right" FontWeight="SemiBold" />
						</Grid>
						<Grid Margin="0,0,0,8">
							<Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
							<TextBlock Text="Recording" Style="{StaticResource OperatorLabel}" />
							<controls:RtaimeTimecode Grid.Column="1" Content="{Binding RecordingElapsed}" HorizontalContentAlignment="Right" />
						</Grid>

						<Grid Margin="0,0,0,5">
							<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="4" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
							<controls:RtaimeButton Grid.Column="0"
								Content="START REC"
								Command="{Binding StartRecordingCommand}"
								IsCompact="True" />
							<controls:RtaimeButton Grid.Column="2"
								Content="STOP REC"
								Command="{Binding StopRecordingCommand}"
								IsCompact="True"
								Background="{DynamicResource OperatorErrorBrush}"
								BorderBrush="{DynamicResource OperatorErrorBrush}"
								Foreground="White"
								ToolTip="Stop and finalize active Program recording." />
						</Grid>
						<Grid>
							<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="4" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
							<controls:RtaimeButton Grid.Column="0"
								Content="OPEN CLEAN"
								Command="{Binding ProgramOutput.StartCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
								IsCompact="True" />
							<controls:RtaimeButton Grid.Column="2"
								Content="STOP CLEAN"
								Command="{Binding ProgramOutput.StopCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
								IsCompact="True" />
						</Grid>
						<controls:RtaimeStatusBadge
							Status="{x:Static controls:RtaimeStatusKind.Warning}"
							Content="STREAM / EXTERNAL ON AIR · UNVERIFIED"
							ShowIndicator="True"
							Margin="0,7,0,0"
							HorizontalAlignment="Stretch" />
					</StackPanel>
				</Border>

				<Border Style="{StaticResource LiveSection}" Margin="0">
					<StackPanel>
						<TextBlock Text="ALERTS &amp; NOTIFICATIONS" Style="{StaticResource OperatorSectionTitle}" Margin="0,0,0,6" />

						<controls:RtaimeAlertRow
							SubsystemName="Engine"
							State="{Binding EngineLifecycleState}"
							EvidenceState="{Binding EngineHealth}"
							Detail="{Binding EngineLifecycleDetail}" />

						<controls:RtaimeAlertRow
							SubsystemName="Runtime"
							State="{Binding RuntimeHealth}"
							EvidenceState="{Binding RuntimeHealth}"
							Detail="{Binding AffectedComponent}" />

						<controls:RtaimeAlertRow
							SubsystemName="Media"
							State="{Binding MediaHealth}"
							EvidenceState="{Binding MediaHealth}"
							Detail="Production media subsystem" />

						<ItemsControl
							ItemsSource="{Binding Notifications.ActiveProblems, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
							AutomationProperties.Name="Persistent operator problems">
							<ItemsControl.ItemTemplate>
								<DataTemplate>
									<Border Style="{StaticResource LiveAlertRow}">
										<StackPanel>
											<DockPanel>
												<TextBlock
													Text="{Binding AffectedComponent}"
													FontSize="10"
													FontWeight="Bold" />
												<StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
													<TextBlock Text="{Binding Condition}" Style="{StaticResource OperatorLabel}" FontSize="9" />
													<TextBlock Text=" " />
													<TextBlock Text="{Binding OccurrenceLabel}" Style="{StaticResource OperatorLabel}" FontSize="9" />
												</StackPanel>
											</DockPanel>
											<TextBlock
												Text="{Binding Title}"
												FontSize="11"
												FontWeight="SemiBold"
												TextWrapping="Wrap"
												Margin="0,3,0,0" />
											<TextBlock
												Text="{Binding Detail}"
												Style="{StaticResource OperatorLabel}"
												FontSize="9"
												TextWrapping="Wrap"
												Margin="0,3,0,0" />
											<TextBlock
												Text="{Binding ProductionImpact}"
												Style="{StaticResource OperatorLabel}"
												FontSize="9"
												TextWrapping="Wrap"
												Margin="0,3,0,0" />
											<TextBlock
												Text="{Binding OperatorAction}"
												Foreground="{DynamicResource OperatorWarningBrush}"
												FontSize="9"
												TextWrapping="Wrap"
												Margin="0,3,0,0" />
											<controls:RtaimeButton
												Content="{Binding TechnicalDetailsActionLabel}"
												Command="{Binding ToggleTechnicalDetailsCommand}"
												IsCompact="True"
												HorizontalAlignment="Left"
												Margin="0,5,0,0">
												<controls:RtaimeButton.Style>
													<Style TargetType="{x:Type controls:RtaimeButton}" BasedOn="{StaticResource {x:Type controls:RtaimeButton}}">
														<Style.Triggers>
															<DataTrigger Binding="{Binding HasTechnicalDetail}" Value="False">
																<Setter Property="Visibility" Value="Collapsed" />
															</DataTrigger>
														</Style.Triggers>
													</Style>
												</controls:RtaimeButton.Style>
											</controls:RtaimeButton>
											<Border
												Background="{DynamicResource OperatorAlternateSurfaceBrush}"
												BorderBrush="{DynamicResource OperatorBorderBrush}"
												BorderThickness="1"
												CornerRadius="{DynamicResource OperatorRadiusControl}"
												Padding="6"
												Margin="0,5,0,0">
												<Border.Style>
													<Style TargetType="Border">
														<Setter Property="Visibility" Value="Collapsed" />
														<Style.Triggers>
															<DataTrigger Binding="{Binding IsTechnicalDetailsVisible}" Value="True">
																<Setter Property="Visibility" Value="Visible" />
															</DataTrigger>
														</Style.Triggers>
													</Style>
												</Border.Style>
												<TextBlock
													Text="{Binding TechnicalDetail}"
													Style="{StaticResource OperatorLabel}"
													FontFamily="{DynamicResource OperatorTimecodeFontFamily}"
													FontSize="9"
													TextWrapping="Wrap" />
											</Border>
										</StackPanel>
									</Border>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</StackPanel>
				</Border>
			</StackPanel>
		</controls:RtaimeScrollViewer>
	</Grid>
</UserControl>
