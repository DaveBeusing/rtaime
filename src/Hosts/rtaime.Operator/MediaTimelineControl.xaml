<UserControl x:Class="rtaime.Operator.MediaTimelineControl"
	x:Name="TimelineRoot"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
	xmlns:local="clr-namespace:rtaime.Operator"
	MinHeight="330"
	Focusable="True"
	UseLayoutRounding="True"
	SnapsToDevicePixels="True"
	PreviewKeyDown="Timeline_PreviewKeyDown">
	<UserControl.Resources>
		<local:TimelineFrameToCanvasLeftConverter x:Key="TimelineFrameToCanvasLeftConverter" />
		<local:TimelineItemWidthConverter x:Key="TimelineItemWidthConverter" />
	</UserControl.Resources>

	<Border Style="{StaticResource OperatorPanel}">
		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="28" />
				<RowDefinition Height="*" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>

			<Grid Grid.Row="0" Margin="0,0,0,8">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>
				<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
					<TextBlock Text="LAYERED TIMELINE" Style="{StaticResource OperatorSectionTitle}" />
					<Border Margin="10,0,0,0" Padding="7,2" CornerRadius="4" Background="{DynamicResource OperatorRaisedSurfaceBrush}">
						<TextBlock Text="{Binding TransportState}" Style="{StaticResource OperatorLabel}" />
					</Border>
					<Border Margin="6,0,0,0" Padding="7,2" CornerRadius="4" Background="{DynamicResource OperatorRaisedSurfaceBrush}">
						<TextBlock Text="{Binding SnapStatus}" Style="{StaticResource OperatorLabel}" />
					</Border>
					<TextBlock Text="SEEK PENDING" Foreground="{DynamicResource OperatorWarningBrush}" FontSize="11" FontWeight="Bold" Margin="10,3,0,0">
						<TextBlock.Style>
							<Style TargetType="TextBlock">
								<Setter Property="Visibility" Value="Collapsed" />
								<Style.Triggers>
									<DataTrigger Binding="{Binding HasPendingSeek}" Value="True">
										<Setter Property="Visibility" Value="Visible" />
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</TextBlock.Style>
					</TextBlock>
					<TextBlock Text="INVALID IN/OUT" Foreground="{DynamicResource OperatorWarningBrush}" FontSize="11" FontWeight="Bold" Margin="10,3,0,0">
						<TextBlock.Style>
							<Style TargetType="TextBlock">
								<Setter Property="Visibility" Value="Collapsed" />
								<Style.Triggers>
									<DataTrigger Binding="{Binding HasInvalidRange}" Value="True">
										<Setter Property="Visibility" Value="Visible" />
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</TextBlock.Style>
					</TextBlock>
				</StackPanel>

				<StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
					<TextBlock Text="{Binding CurrentTimecode}" Style="{StaticResource OperatorTimecode}" FontSize="17" Margin="0,0,12,0" VerticalAlignment="Center" />
					<Button Content="◀ CUE" Command="{Binding PreviousCueCommand}" Style="{StaticResource OperatorButton}" Padding="8,4" Margin="0,0,4,0" ToolTip="Jump to previous cue (Page Up)." />
					<Button Content="CUE ▶" Command="{Binding NextCueCommand}" Style="{StaticResource OperatorButton}" Padding="8,4" Margin="0,0,10,0" ToolTip="Jump to next cue (Page Down)." />
					<Button Content="−" Command="{Binding ZoomOutCommand}" Style="{StaticResource OperatorButton}" Width="28" Padding="4" />
					<TextBlock Text="{Binding ZoomLabel}" Style="{StaticResource OperatorValue}" Width="42" TextAlignment="Center" VerticalAlignment="Center" />
					<Button Content="+" Command="{Binding ZoomInCommand}" Style="{StaticResource OperatorButton}" Width="28" Padding="4" />
					<Button Content="FIT" Command="{Binding FitCommand}" Style="{StaticResource OperatorButton}" Padding="8,4" Margin="4,0,8,0" />
					<CheckBox Content="SNAP" IsChecked="{Binding SnapEnabled, Mode=TwoWay}" VerticalAlignment="Center" FontWeight="SemiBold" />
				</StackPanel>
			</Grid>

			<Grid Grid.Row="1" Margin="0,0,0,4">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="112" />
					<ColumnDefinition Width="*" />
				</Grid.ColumnDefinitions>
				<TextBlock Grid.Column="0" Text="{Binding VisibleRangeLabel}" Style="{StaticResource OperatorLabel}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
				<Border Grid.Column="1" Background="{DynamicResource OperatorRaisedSurfaceBrush}" BorderBrush="{DynamicResource OperatorBorderBrush}" BorderThickness="1,1,1,0" ClipToBounds="True">
					<ItemsControl ItemsSource="{Binding RulerTicks}">
						<ItemsControl.ItemsPanel>
							<ItemsPanelTemplate>
								<Canvas />
							</ItemsPanelTemplate>
						</ItemsControl.ItemsPanel>
						<ItemsControl.ItemContainerStyle>
							<Style TargetType="ContentPresenter">
								<Setter Property="Canvas.Left">
									<Setter.Value>
										<MultiBinding Converter="{StaticResource TimelineFrameToCanvasLeftConverter}">
											<Binding Path="Frame" />
											<Binding Path="DataContext.VisibleStartFrame" RelativeSource="{RelativeSource AncestorType={x:Type local:MediaTimelineControl}}" />
											<Binding Path="DataContext.VisibleEndFrame" RelativeSource="{RelativeSource AncestorType={x:Type local:MediaTimelineControl}}" />
											<Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType={x:Type ItemsControl}}" />
										</MultiBinding>
									</Setter.Value>
								</Setter>
							</Style>
						</ItemsControl.ItemContainerStyle>
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<StackPanel>
									<Border Width="1" Height="6" Background="{DynamicResource OperatorBorderBrush}" />
									<TextBlock Text="{Binding Timecode}" Style="{StaticResource OperatorLabel}" FontSize="9" Margin="-18,1,0,0" />
								</StackPanel>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</Border>
			</Grid>

			<Grid Grid.Row="2"
				x:Name="TimelineWorkspace"
				ClipToBounds="True"
				PreviewMouseLeftButtonDown="TimelineWorkspace_PreviewMouseLeftButtonDown"
				PreviewMouseMove="TimelineWorkspace_PreviewMouseMove"
				PreviewMouseLeftButtonUp="TimelineWorkspace_PreviewMouseLeftButtonUp"
				PreviewMouseWheel="TimelineWorkspace_PreviewMouseWheel"
				automation:AutomationProperties.Name="Layered media timeline"
				automation:AutomationProperties.HelpText="{Binding AccessibilityDescription}">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="112" />
					<ColumnDefinition Width="*" />
				</Grid.ColumnDefinitions>

				<ItemsControl x:Name="TrackRows" Grid.ColumnSpan="2" ItemsSource="{Binding Tracks}">
					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<Grid Height="34" Margin="0,0,0,2">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="112" />
									<ColumnDefinition Width="*" />
								</Grid.ColumnDefinitions>
								<Border Grid.Column="0" Background="{DynamicResource OperatorRaisedSurfaceBrush}" BorderBrush="{DynamicResource OperatorBorderBrush}" BorderThickness="1" Padding="7,0">
									<TextBlock Text="{Binding Label}" Style="{StaticResource OperatorLabel}" FontWeight="SemiBold" VerticalAlignment="Center" />
								</Border>
								<Border Grid.Column="1" Background="#16000000" BorderBrush="{DynamicResource OperatorBorderBrush}" BorderThickness="0,1,1,1" ClipToBounds="True">
									<Grid>
										<ItemsControl ItemsSource="{Binding Items}">
											<ItemsControl.ItemsPanel>
												<ItemsPanelTemplate>
													<Canvas />
												</ItemsPanelTemplate>
											</ItemsControl.ItemsPanel>
											<ItemsControl.ItemContainerStyle>
												<Style TargetType="ContentPresenter">
													<Setter Property="Canvas.Left">
														<Setter.Value>
															<MultiBinding Converter="{StaticResource TimelineFrameToCanvasLeftConverter}">
																<Binding Path="StartFrame" />
																<Binding Path="DataContext.VisibleStartFrame" RelativeSource="{RelativeSource AncestorType={x:Type local:MediaTimelineControl}}" />
																<Binding Path="DataContext.VisibleEndFrame" RelativeSource="{RelativeSource AncestorType={x:Type local:MediaTimelineControl}}" />
																<Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType={x:Type ItemsControl}}" />
															</MultiBinding>
														</Setter.Value>
													</Setter>
													<Setter Property="Width">
														<Setter.Value>
															<MultiBinding Converter="{StaticResource TimelineItemWidthConverter}">
																<Binding Path="StartFrame" />
																<Binding Path="DurationFrames" />
																<Binding Path="DataContext.VisibleStartFrame" RelativeSource="{RelativeSource AncestorType={x:Type local:MediaTimelineControl}}" />
																<Binding Path="DataContext.VisibleEndFrame" RelativeSource="{RelativeSource AncestorType={x:Type local:MediaTimelineControl}}" />
																<Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType={x:Type ItemsControl}}" />
															</MultiBinding>
														</Setter.Value>
													</Setter>
												</Style>
											</ItemsControl.ItemContainerStyle>
											<ItemsControl.ItemTemplate>
												<DataTemplate>
													<Border Height="28"
														Margin="1,2"
														Padding="7,0"
														CornerRadius="3"
														Background="{DynamicResource OperatorAccentBrush}"
														Opacity="0.78"
														PreviewMouseLeftButtonDown="TimelineItem_PreviewMouseLeftButtonDown"
														ToolTip="{Binding Status}">
														<Grid>
															<Grid.ColumnDefinitions>
																<ColumnDefinition Width="*" />
																<ColumnDefinition Width="Auto" />
															</Grid.ColumnDefinitions>
															<TextBlock Text="{Binding Label}" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
															<TextBlock Grid.Column="1" Text="{Binding Status}" Foreground="White" FontSize="9" VerticalAlignment="Center" Margin="8,0,0,0" />
														</Grid>
													</Border>
												</DataTemplate>
											</ItemsControl.ItemTemplate>
										</ItemsControl>

										<ItemsControl ItemsSource="{Binding DataContext.Cues, RelativeSource={RelativeSource AncestorType={x:Type local:MediaTimelineControl}}}">
											<ItemsControl.Style>
												<Style TargetType="ItemsControl">
													<Setter Property="Visibility" Value="Collapsed" />
													<Style.Triggers>
														<DataTrigger Binding="{Binding IsCueTrack}" Value="True">
															<Setter Property="Visibility" Value="Visible" />
														</DataTrigger>
													</Style.Triggers>
												</Style>
											</ItemsControl.Style>
											<ItemsControl.ItemsPanel>
												<ItemsPanelTemplate>
													<Canvas />
												</ItemsPanelTemplate>
											</ItemsControl.ItemsPanel>
											<ItemsControl.ItemContainerStyle>
												<Style TargetType="ContentPresenter">
													<Setter Property="Canvas.Left">
														<Setter.Value>
															<MultiBinding Converter="{StaticResource TimelineFrameToCanvasLeftConverter}">
																<Binding Path="Frame" />
																<Binding Path="DataContext.VisibleStartFrame" RelativeSource="{RelativeSource AncestorType={x:Type local:MediaTimelineControl}}" />
																<Binding Path="DataContext.VisibleEndFrame" RelativeSource="{RelativeSource AncestorType={x:Type local:MediaTimelineControl}}" />
																<Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType={x:Type ItemsControl}}" />
															</MultiBinding>
														</Setter.Value>
													</Setter>
												</Style>
											</ItemsControl.ItemContainerStyle>
											<ItemsControl.ItemTemplate>
												<DataTemplate>
													<Button Content="{Binding Name, StringFormat=▼ {0}}"
														Style="{StaticResource OperatorButton}"
														Padding="5,2"
														MinWidth="46"
														MaxWidth="140"
														FontSize="9"
														PreviewMouseLeftButtonDown="Cue_PreviewMouseLeftButtonDown"
														ToolTip="{Binding Timecode}" />
												</DataTemplate>
											</ItemsControl.ItemTemplate>
										</ItemsControl>
									</Grid>
								</Border>
							</Grid>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>

				<Grid x:Name="TimelineContentArea" Grid.Column="1" Background="Transparent" IsHitTestVisible="False">
					<Canvas x:Name="TimelineOverlay" ClipToBounds="True">
						<Border Width="2"
							Height="{Binding ActualHeight, ElementName=TrackRows}"
							Background="{DynamicResource OperatorProgramBrush}">
							<Canvas.Left>
								<MultiBinding Converter="{StaticResource TimelineFrameToCanvasLeftConverter}">
									<Binding Path="DisplayFrame" />
									<Binding Path="VisibleStartFrame" />
									<Binding Path="VisibleEndFrame" />
									<Binding Path="ActualWidth" ElementName="TimelineOverlay" />
								</MultiBinding>
							</Canvas.Left>
						</Border>

						<Border Width="5"
							Height="{Binding ActualHeight, ElementName=TrackRows}"
							Background="{DynamicResource OperatorAccentBrush}"
							Opacity="0.7">
							<Border.Style>
								<Style TargetType="Border">
									<Setter Property="Visibility" Value="Collapsed" />
									<Style.Triggers>
										<DataTrigger Binding="{Binding HasInPoint}" Value="True">
											<Setter Property="Visibility" Value="Visible" />
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</Border.Style>
							<Canvas.Left>
								<MultiBinding Converter="{StaticResource TimelineFrameToCanvasLeftConverter}">
									<Binding Path="InPointFrame" />
									<Binding Path="VisibleStartFrame" />
									<Binding Path="VisibleEndFrame" />
									<Binding Path="ActualWidth" ElementName="TimelineOverlay" />
								</MultiBinding>
							</Canvas.Left>
						</Border>

						<Border Width="5"
							Height="{Binding ActualHeight, ElementName=TrackRows}"
							Background="{DynamicResource OperatorWarningBrush}"
							Opacity="0.7">
							<Border.Style>
								<Style TargetType="Border">
									<Setter Property="Visibility" Value="Collapsed" />
									<Style.Triggers>
										<DataTrigger Binding="{Binding HasOutPoint}" Value="True">
											<Setter Property="Visibility" Value="Visible" />
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</Border.Style>
							<Canvas.Left>
								<MultiBinding Converter="{StaticResource TimelineFrameToCanvasLeftConverter}">
									<Binding Path="OutPointFrame" />
									<Binding Path="VisibleStartFrame" />
									<Binding Path="VisibleEndFrame" />
									<Binding Path="ActualWidth" ElementName="TimelineOverlay" />
								</MultiBinding>
							</Canvas.Left>
						</Border>
					</Canvas>
				</Grid>
			</Grid>

			<Grid Grid.Row="3" Margin="112,7,0,7">
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>
				<ScrollBar Grid.Row="0"
					Orientation="Horizontal"
					Minimum="0"
					Maximum="{Binding ScrollMaximum}"
					Value="{Binding ScrollValue, Mode=TwoWay}"
					ViewportSize="{Binding VisibleFrameCount}"
					LargeChange="{Binding ScrollLargeChange}"
					SmallChange="1"
					IsEnabled="{Binding IsLoaded}" />
				<Grid Grid.Row="1" Margin="0,5,0,0">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>
					<TextBlock Text="{Binding DisplayFrame, StringFormat=Frame {0:N0}}" Style="{StaticResource OperatorLabel}" />
					<StackPanel Grid.Column="1" Orientation="Horizontal">
						<TextBlock Text="{Binding FrameRate, StringFormat={}{0} fps}" Style="{StaticResource OperatorLabel}" Margin="0,0,16,0" />
						<TextBlock Text="REMAINING" Style="{StaticResource OperatorLabel}" Margin="0,0,7,0" />
						<TextBlock Text="{Binding RemainingTimecode}" Style="{StaticResource OperatorTimecode}" FontSize="11" />
					</StackPanel>
				</Grid>
			</Grid>

			<Grid Grid.Row="4">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="6" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="6" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="6" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="*" />
				</Grid.ColumnDefinitions>
				<Button Grid.Column="0" Content="|◀  HOME" Command="{Binding JumpToStartCommand}" Style="{StaticResource OperatorButton}" Padding="9,5" />
				<Button Grid.Column="2" Content="◀  -1 FRAME" Command="{Binding StepBackwardCommand}" Style="{StaticResource OperatorButton}" Padding="9,5" />
				<Button Grid.Column="4" Content="+1 FRAME  ▶" Command="{Binding StepForwardCommand}" Style="{StaticResource OperatorButton}" Padding="9,5" />
				<Button Grid.Column="6" Content="END  ▶|" Command="{Binding JumpToEndCommand}" Style="{StaticResource OperatorButton}" Padding="9,5" />
				<TextBlock Grid.Column="7"
					Text="Drag empty track space to seek · drag IN/OUT markers by their frame positions · PageUp/PageDown cue"
					Style="{StaticResource OperatorLabel}"
					HorizontalAlignment="Right"
					VerticalAlignment="Center" />
			</Grid>
		</Grid>
	</Border>
</UserControl>
