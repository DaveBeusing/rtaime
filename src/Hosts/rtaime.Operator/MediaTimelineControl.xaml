<UserControl x:Class="rtaime.Operator.MediaTimelineControl"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
	MinHeight="142"
	Focusable="False">
	<Border Style="{StaticResource OperatorPanel}">
		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>

			<Grid Grid.Row="0" Margin="0,0,0,10">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>
				<StackPanel Orientation="Horizontal">
					<TextBlock Text="MEDIA TIMELINE" Style="{StaticResource OperatorSectionTitle}" />
					<Border Margin="10,0,0,0" Padding="7,2" CornerRadius="4" Background="{DynamicResource OperatorRaisedSurfaceBrush}">
						<TextBlock Text="{Binding TransportState}" Style="{StaticResource OperatorLabel}" />
					</Border>
					<TextBlock Text="SEEK PENDING" Foreground="{DynamicResource OperatorWarningBrush}" FontSize="11" FontWeight="Bold" Margin="10,3,0,0">
						<TextBlock.Style>
							<Style TargetType="TextBlock">
								<Setter Property="Visibility" Value="Collapsed" />
								<Style.Triggers>
									<DataTrigger Binding="{Binding HasPendingSeek}" Value="True">
										<Setter Property="Visibility" Value="Visible" />
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</TextBlock.Style>
					</TextBlock>
				</StackPanel>
				<TextBlock Grid.Column="1" Text="{Binding FrameRate, StringFormat={}{0} fps}" Style="{StaticResource OperatorLabel}" VerticalAlignment="Center" />
			</Grid>

			<Grid Grid.Row="1" Margin="0,0,0,5">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>
				<TextBlock Text="{Binding CurrentTimecode}" FontFamily="Consolas" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
				<Grid Grid.Column="1" Height="34" VerticalAlignment="Center">
					<ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPercent}" Height="5" VerticalAlignment="Center" Background="{DynamicResource OperatorRaisedSurfaceBrush}" Foreground="{DynamicResource OperatorAccentBrush}" IsHitTestVisible="False" />
					<Slider x:Name="TimelineSlider"
						Minimum="0"
						Maximum="{Binding SliderMaximum}"
						Value="{Binding SliderValue, Mode=OneWay}"
						IsEnabled="{Binding CanSeek}"
						IsMoveToPointEnabled="True"
						TickFrequency="1"
						SmallChange="1"
						LargeChange="10"
						Background="Transparent"
						VerticalAlignment="Center"
						PreviewMouseLeftButtonDown="TimelineSlider_PreviewMouseLeftButtonDown"
						PreviewMouseMove="TimelineSlider_PreviewMouseMove"
						PreviewMouseLeftButtonUp="TimelineSlider_PreviewMouseLeftButtonUp"
						PreviewKeyDown="TimelineSlider_PreviewKeyDown"
						automation:AutomationProperties.Name="Media timeline seeker"
						automation:AutomationProperties.HelpText="{Binding AccessibilityDescription}" />
				</Grid>
				<TextBlock Grid.Column="2" Text="{Binding DurationTimecode}" FontFamily="Consolas" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,0,0" />
			</Grid>

			<Grid Grid.Row="2" Margin="0,0,0,10">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>
				<TextBlock Text="{Binding DisplayFrame, StringFormat=Frame {0:N0}}" Style="{StaticResource OperatorLabel}" />
				<TextBlock Grid.Column="1" Text="REMAINING" Style="{StaticResource OperatorLabel}" Margin="0,0,8,0" />
				<TextBlock Grid.Column="2" Text="{Binding RemainingTimecode}" FontFamily="Consolas" FontSize="12" FontWeight="SemiBold" />
			</Grid>

			<Grid Grid.Row="3">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="8" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="8" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="8" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="*" />
				</Grid.ColumnDefinitions>
				<Button Grid.Column="0" Content="|◀  HOME" Command="{Binding JumpToStartCommand}" Style="{StaticResource OperatorButton}" Padding="10,6" />
				<Button Grid.Column="2" Content="◀  -1 FRAME" Command="{Binding StepBackwardCommand}" Style="{StaticResource OperatorButton}" Padding="10,6" />
				<Button Grid.Column="4" Content="+1 FRAME  ▶" Command="{Binding StepForwardCommand}" Style="{StaticResource OperatorButton}" Padding="10,6" />
				<Button Grid.Column="6" Content="END  ▶|" Command="{Binding JumpToEndCommand}" Style="{StaticResource OperatorButton}" Padding="10,6" />
				<TextBlock Grid.Column="7" Text="Click or drag to seek · ←/→ frame · Home/End clip boundaries" Style="{StaticResource OperatorLabel}" HorizontalAlignment="Right" VerticalAlignment="Center" />
			</Grid>
		</Grid>
	</Border>
</UserControl>
