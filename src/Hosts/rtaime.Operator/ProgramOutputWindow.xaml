<Window x:Class="rtaime.Operator.ProgramOutputWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:rtaime.Operator.Controls"
	Title="rtaime Program Output"
	Width="960"
	Height="540"
	MinWidth="320"
	MinHeight="180"
	Background="Black"
	WindowStartupLocation="Manual"
	ShowActivated="False"
	ShowInTaskbar="True"
	UseLayoutRounding="True"
	SnapsToDevicePixels="True">
	<Grid Background="Black" ClipToBounds="True">
		<Image Source="{Binding ProgramImage}"
			Stretch="Uniform"
			HorizontalAlignment="Stretch"
			VerticalAlignment="Stretch"
			SnapsToDevicePixels="True"
			RenderOptions.BitmapScalingMode="HighQuality" />
		<controls:GpuMonitorPresentationSurface
			GpuFrame="{Binding ProgramGpuFrame}"
			StandaloneFit="True"
			HorizontalAlignment="Center"
			VerticalAlignment="Center"
			Panel.ZIndex="10" />
	</Grid>
</Window>
