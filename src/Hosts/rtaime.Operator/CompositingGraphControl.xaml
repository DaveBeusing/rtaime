<UserControl x:Class="rtaime.Operator.CompositingGraphControl"
	x:Name="Root"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:rtaime.Operator.Controls"
	xmlns:local="clr-namespace:rtaime.Operator"
	MinHeight="0"
	Focusable="True"
	UseLayoutRounding="True"
	SnapsToDevicePixels="True">
	<UserControl.Resources>
		<SolidColorBrush x:Key="GraphBackgroundBrush" Color="{StaticResource OperatorColorDiagnosticSurface}" />
		<SolidColorBrush x:Key="GraphMinorGridBrush" Color="{StaticResource OperatorColorGraphSurface}" />
		<SolidColorBrush x:Key="GraphMajorGridBrush" Color="{StaticResource OperatorColorGraphSurfaceRaised}" />
		<SolidColorBrush x:Key="GraphConnectionBrush" Color="{StaticResource OperatorColorBorderStrong}" />
		<SolidColorBrush x:Key="GraphSourceBrush" Color="{StaticResource OperatorColorTimeline}" />
		<SolidColorBrush x:Key="GraphRoutingBrush" Color="{StaticResource OperatorColorAccent}" />
		<SolidColorBrush x:Key="GraphTransformBrush" Color="{StaticResource OperatorColorWarning}" />
		<SolidColorBrush x:Key="GraphCompositeBrush" Color="{StaticResource OperatorColorGraphics}" />
		<SolidColorBrush x:Key="GraphOutputBrush" Color="{StaticResource OperatorColorHealthy}" />
		<SolidColorBrush x:Key="GraphRecorderBrush" Color="{StaticResource OperatorColorError}" />

		<Style x:Key="GraphToolbarButton" TargetType="{x:Type controls:RtaimeButton}" BasedOn="{StaticResource {x:Type controls:RtaimeButton}}">
			<Setter Property="Height" Value="26" />
			<Setter Property="Padding" Value="8,0" />
			<Setter Property="Margin" Value="0,0,5,0" />
			<Setter Property="IsCompact" Value="True" />
		</Style>

		<Style x:Key="GraphNodeBorder" TargetType="{x:Type Border}">
			<Setter Property="Width" Value="214" />
			<Setter Property="Height" Value="116" />
			<Setter Property="Padding" Value="10" />
			<Setter Property="Background" Value="{DynamicResource OperatorRaisedSurfaceBrush}" />
			<Setter Property="BorderBrush" Value="{DynamicResource OperatorBorderStrongBrush}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="CornerRadius" Value="4" />
			<Setter Property="SnapsToDevicePixels" Value="True" />
			<Style.Triggers>
				<DataTrigger Binding="{Binding IsDegraded}" Value="True">
					<Setter Property="BorderBrush" Value="{DynamicResource OperatorWarningBrush}" />
				</DataTrigger>
				<DataTrigger Binding="{Binding IsError}" Value="True">
					<Setter Property="BorderBrush" Value="{DynamicResource OperatorErrorBrush}" />
				</DataTrigger>
				<DataTrigger Binding="{Binding IsSelected}" Value="True">
					<Setter Property="Background" Value="{DynamicResource OperatorSelectionSurfaceBrush}" />
					<Setter Property="BorderBrush" Value="{DynamicResource OperatorAccentBrush}" />
					<Setter Property="BorderThickness" Value="2" />
				</DataTrigger>
			</Style.Triggers>
		</Style>

		<Style x:Key="GraphCategoryAccent" TargetType="{x:Type Border}">
			<Setter Property="Background" Value="{StaticResource GraphSourceBrush}" />
			<Style.Triggers>
				<DataTrigger Binding="{Binding KindLabel}" Value="ROUTING"><Setter Property="Background" Value="{StaticResource GraphRoutingBrush}" /></DataTrigger>
				<DataTrigger Binding="{Binding KindLabel}" Value="TRANSFORM"><Setter Property="Background" Value="{StaticResource GraphTransformBrush}" /></DataTrigger>
				<DataTrigger Binding="{Binding KindLabel}" Value="COMPOSITE"><Setter Property="Background" Value="{StaticResource GraphCompositeBrush}" /></DataTrigger>
				<DataTrigger Binding="{Binding KindLabel}" Value="OUTPUT"><Setter Property="Background" Value="{StaticResource GraphOutputBrush}" /></DataTrigger>
				<DataTrigger Binding="{Binding KindLabel}" Value="RECORDER"><Setter Property="Background" Value="{StaticResource GraphRecorderBrush}" /></DataTrigger>
			</Style.Triggers>
		</Style>

		<DrawingBrush x:Key="GraphGridBrush"
			TileMode="Tile"
			Viewport="0,0,96,96"
			ViewportUnits="Absolute"
			Viewbox="0,0,96,96"
			ViewboxUnits="Absolute"
			Stretch="None">
			<DrawingBrush.Drawing>
				<DrawingGroup>
					<GeometryDrawing Brush="{StaticResource GraphBackgroundBrush}" Geometry="M0,0 H96 V96 H0 Z" />
					<GeometryDrawing Geometry="M24,0 V96 M48,0 V96 M72,0 V96 M0,24 H96 M0,48 H96 M0,72 H96">
						<GeometryDrawing.Pen><Pen Brush="{StaticResource GraphMinorGridBrush}" Thickness="1" /></GeometryDrawing.Pen>
					</GeometryDrawing>
					<GeometryDrawing Geometry="M0,0 H96 M0,0 V96 M96,0 V96 M0,96 H96">
						<GeometryDrawing.Pen><Pen Brush="{StaticResource GraphMajorGridBrush}" Thickness="1" /></GeometryDrawing.Pen>
					</GeometryDrawing>
				</DrawingGroup>
			</DrawingBrush.Drawing>
		</DrawingBrush>
	</UserControl.Resources>

	<Grid>
		
		<Grid.RowDefinitions>
			<RowDefinition Height="42" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<controls:RtaimeStatePlaceholder
					State="{Binding WorkspaceStates.Compositing.State, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
					Title="{Binding WorkspaceStates.Compositing.Title, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
					Detail="{Binding WorkspaceStates.Compositing.Detail, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
					Panel.ZIndex="60"
					Margin="10" />

		<Border Grid.Row="0"
			Background="{DynamicResource OperatorAlternateSurfaceBrush}"
			BorderBrush="{DynamicResource OperatorBorderBrush}"
			BorderThickness="0,0,0,1"
			Padding="8,0">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>

				<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
					<controls:RtaimeButton Content="SELECT" Command="{Binding SelectModeCommand}">
						<controls:RtaimeButton.Style>
							<Style TargetType="{x:Type controls:RtaimeButton}" BasedOn="{StaticResource GraphToolbarButton}">
								<Style.Triggers>
									<DataTrigger Binding="{Binding IsSelectMode}" Value="True">
										<Setter Property="Background" Value="{DynamicResource OperatorAccentSurfaceBrush}" />
										<Setter Property="BorderBrush" Value="{DynamicResource OperatorAccentBrush}" />
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</controls:RtaimeButton.Style>
					</controls:RtaimeButton>
					<controls:RtaimeButton Content="PAN" Command="{Binding PanModeCommand}">
						<controls:RtaimeButton.Style>
							<Style TargetType="{x:Type controls:RtaimeButton}" BasedOn="{StaticResource GraphToolbarButton}">
								<Style.Triggers>
									<DataTrigger Binding="{Binding IsPanMode}" Value="True">
										<Setter Property="Background" Value="{DynamicResource OperatorAccentSurfaceBrush}" />
										<Setter Property="BorderBrush" Value="{DynamicResource OperatorAccentBrush}" />
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</controls:RtaimeButton.Style>
					</controls:RtaimeButton>
					<Border Width="1" Height="18" Background="{DynamicResource OperatorBorderBrush}" Margin="1,0,7,0" />
					<controls:RtaimeButton Content="FIT" Command="{Binding FitCommand}" Style="{StaticResource GraphToolbarButton}" ToolTip="Fit the complete graph into the current viewport." />
					<controls:RtaimeButton Content="100%" Command="{Binding ResetViewCommand}" Style="{StaticResource GraphToolbarButton}" ToolTip="Reset presentation zoom to 100 percent." />
					<controls:RtaimeButton Content="AUTO LAYOUT" Command="{Binding AutoLayoutCommand}" Style="{StaticResource GraphToolbarButton}" ToolTip="Restore the deterministic presentation layout without changing Runtime routing." />
				</StackPanel>

				<TextBlock Grid.Column="1"
					Text="COMPOSITING GRAPH"
					Style="{StaticResource OperatorSectionTitle}"
					HorizontalAlignment="Center"
					VerticalAlignment="Center" />

				<StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
					<controls:RtaimeStatusBadge
						Status="{x:Static controls:RtaimeStatusKind.Neutral}"
						Content="READ-ONLY TOPOLOGY"
						ShowIndicator="False"
						Margin="0,0,6,0"
						ToolTip="Runtime topology rewiring is not exposed by the current authoritative capability." />
					<controls:RtaimeStatusBadge
						Status="{x:Static controls:RtaimeStatusKind.Selection}"
						Content="{Binding ZoomLabel}"
						ShowIndicator="False" />
				</StackPanel>
			</Grid>
		</Border>

		<Grid x:Name="GraphViewport"
			Grid.Row="1"
			Background="{StaticResource GraphGridBrush}"
			ClipToBounds="True"
			MouseWheel="OnGraphMouseWheel"
			MouseDown="OnGraphMouseDown"
			MouseMove="OnGraphMouseMove"
			MouseUp="OnGraphMouseUp"
			MouseLeave="OnGraphMouseLeave"
			SizeChanged="OnGraphSizeChanged">
			<Canvas x:Name="GraphWorld"
				Width="{Binding CanvasWidth}"
				Height="{Binding CanvasHeight}"
				HorizontalAlignment="Left"
				VerticalAlignment="Top"
				CacheMode="BitmapCache">
				<Canvas.RenderTransform>
					<TransformGroup>
						<ScaleTransform ScaleX="{Binding Zoom}" ScaleY="{Binding Zoom}" />
						<TranslateTransform X="{Binding PanX}" Y="{Binding PanY}" />
					</TransformGroup>
				</Canvas.RenderTransform>

				<ItemsControl ItemsSource="{Binding Connections}"
					Width="{Binding CanvasWidth}"
					Height="{Binding CanvasHeight}"
					IsHitTestVisible="False">
					<ItemsControl.ItemsPanel>
						<ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
					</ItemsControl.ItemsPanel>
					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<Canvas Width="{Binding DataContext.CanvasWidth, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
								Height="{Binding DataContext.CanvasHeight, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}">
								<Path Data="{Binding Geometry}" StrokeThickness="2" Opacity="{Binding Opacity}">
									<Path.Style>
										<Style TargetType="{x:Type Path}">
											<Setter Property="Stroke" Value="{StaticResource GraphConnectionBrush}" />
											<Style.Triggers>
												<DataTrigger Binding="{Binding IsActive}" Value="True">
													<Setter Property="Stroke" Value="{DynamicResource OperatorAccentBrush}" />
													<Setter Property="Opacity" Value="1" />
												</DataTrigger>
											</Style.Triggers>
										</Style>
									</Path.Style>
								</Path>
								<Polygon Points="{Binding ArrowPoints}" Opacity="{Binding Opacity}">
									<Polygon.Style>
										<Style TargetType="{x:Type Polygon}">
											<Setter Property="Fill" Value="{StaticResource GraphConnectionBrush}" />
											<Style.Triggers>
												<DataTrigger Binding="{Binding IsActive}" Value="True">
													<Setter Property="Fill" Value="{DynamicResource OperatorAccentBrush}" />
													<Setter Property="Opacity" Value="1" />
												</DataTrigger>
											</Style.Triggers>
										</Style>
									</Polygon.Style>
								</Polygon>
							</Canvas>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>

				<ItemsControl ItemsSource="{Binding Nodes}"
					Width="{Binding CanvasWidth}"
					Height="{Binding CanvasHeight}">
					<ItemsControl.ItemsPanel>
						<ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
					</ItemsControl.ItemsPanel>
					<ItemsControl.ItemContainerStyle>
						<Style TargetType="{x:Type ContentPresenter}">
							<Setter Property="Canvas.Left" Value="{Binding X}" />
							<Setter Property="Canvas.Top" Value="{Binding Y}" />
						</Style>
					</ItemsControl.ItemContainerStyle>
					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<controls:RtaimeButton
								Command="{Binding DataContext.SelectNodeCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
								CommandParameter="{Binding}"
								Background="Transparent"
								BorderBrush="Transparent"
								BorderThickness="0"
								Padding="0"
								HorizontalContentAlignment="Stretch"
								VerticalContentAlignment="Stretch"
								ToolTip="Select node and project its observed state into the Inspector.">
								<Border Style="{StaticResource GraphNodeBorder}">
									<Grid>
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="4" />
											<ColumnDefinition Width="*" />
										</Grid.ColumnDefinitions>
										<Border Grid.Column="0" Style="{StaticResource GraphCategoryAccent}" Margin="-10,-10,8,-10" CornerRadius="3,0,0,3" />
										<Grid Grid.Column="1">
											<Grid.RowDefinitions>
												<RowDefinition Height="Auto" />
												<RowDefinition Height="*" />
												<RowDefinition Height="Auto" />
											</Grid.RowDefinitions>

											<DockPanel>
												<controls:RtaimeStatusBadge
													DockPanel.Dock="Right"
													Status="{x:Static controls:RtaimeStatusKind.Neutral}"
													Content="{Binding Status}"
													ShowIndicator="False"
													Margin="6,0,0,0" />
												<StackPanel>
													<TextBlock Text="{Binding RoleLabel}" Style="{StaticResource OperatorLabel}" FontSize="{StaticResource OperatorFontSizeMicro}" FontWeight="Bold" />
													<TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="{StaticResource OperatorFontSizeBody}" TextTrimming="CharacterEllipsis" MaxWidth="116" />
												</StackPanel>
											</DockPanel>

											<TextBlock Grid.Row="1"
												Text="{Binding Detail}"
												Style="{StaticResource OperatorLabel}"
												FontSize="{StaticResource OperatorFontSizeCompact}"
												TextWrapping="Wrap"
												TextTrimming="CharacterEllipsis"
												MaxHeight="30"
												Margin="0,5,0,4" />

											<Grid Grid.Row="2">
												<Grid.ColumnDefinitions>
													<ColumnDefinition Width="*" />
													<ColumnDefinition Width="10" />
													<ColumnDefinition Width="*" />
												</Grid.ColumnDefinitions>
												<StackPanel>
													<StackPanel Orientation="Horizontal">
														<Ellipse Width="7" Height="7" Fill="{DynamicResource OperatorSecondaryTextBrush}" Margin="-3,1,5,0" />
														<TextBlock Text="IN" Style="{StaticResource OperatorLabel}" FontSize="{StaticResource OperatorFontSizeFinePrint}" />
													</StackPanel>
													<TextBlock Text="{Binding InputPorts}" FontSize="{StaticResource OperatorFontSizeMicro}" TextTrimming="CharacterEllipsis" />
												</StackPanel>
												<StackPanel Grid.Column="2" HorizontalAlignment="Right">
													<StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
														<TextBlock Text="OUT" Style="{StaticResource OperatorLabel}" FontSize="{StaticResource OperatorFontSizeFinePrint}" Margin="0,0,5,0" />
														<Ellipse Width="7" Height="7" Fill="{DynamicResource OperatorSecondaryTextBrush}" Margin="0,1,-3,0" />
													</StackPanel>
													<TextBlock Text="{Binding OutputPorts}" FontSize="{StaticResource OperatorFontSizeMicro}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Right" />
												</StackPanel>
											</Grid>
										</Grid>
									</Grid>
								</Border>
							</controls:RtaimeButton>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</Canvas>

			<Border HorizontalAlignment="Left"
				VerticalAlignment="Bottom"
				Margin="10"
				Style="{StaticResource OperatorGraphOverlay}">
				<TextBlock Text="Wheel: zoom · Pan mode / middle mouse: move · Node click: inspect" Style="{StaticResource OperatorLabel}" FontSize="{StaticResource OperatorFontSizeMicro}" />
			</Border>
		</Grid>
	</Grid>
</UserControl>
