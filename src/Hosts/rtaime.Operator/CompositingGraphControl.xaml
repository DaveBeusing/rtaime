<UserControl x:Class="rtaime.Operator.CompositingGraphControl"
	x:Name="Root"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:rtaime.Operator.Controls"
	xmlns:local="clr-namespace:rtaime.Operator"
	MinHeight="0"
	Focusable="True"
	UseLayoutRounding="True"
	SnapsToDevicePixels="True"
    controls:OperatorControlPresentation.Enabled="True" PreviewKeyDown="OnWorkspaceKeyDown"
    SizeChanged="OnWorkspaceSizeChanged" Loaded="OnWorkspaceLoaded" Unloaded="OnWorkspaceUnloaded">
	<UserControl.Resources>
        <Style x:Key="GraphLabel" TargetType="TextBlock" BasedOn="{StaticResource OperatorLabel}">
            <Style.Triggers><DataTrigger Binding="{Binding Path=(controls:OperatorControlPresentation.HighContrast), RelativeSource={RelativeSource AncestorType={x:Type local:CompositingGraphControl}}}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
            </DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="GraphPanel" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource OperatorSurfaceBrush}" />
            <Style.Triggers><DataTrigger Binding="{Binding Path=(controls:OperatorControlPresentation.HighContrast), RelativeSource={RelativeSource AncestorType={x:Type local:CompositingGraphControl}}}" Value="True">
                <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
            </DataTrigger></Style.Triggers>
        </Style>

		<SolidColorBrush x:Key="GraphBackgroundBrush" Color="{StaticResource OperatorColorDiagnosticSurface}" />
		<SolidColorBrush x:Key="GraphMinorGridBrush" Color="{StaticResource OperatorColorGraphSurface}" />
		<SolidColorBrush x:Key="GraphMajorGridBrush" Color="{StaticResource OperatorColorGraphSurfaceRaised}" />
		<SolidColorBrush x:Key="GraphConnectionBrush" Color="{StaticResource OperatorColorBorderStrong}" />
		<SolidColorBrush x:Key="GraphSourceBrush" Color="{StaticResource OperatorColorTimeline}" />
		<SolidColorBrush x:Key="GraphRoutingBrush" Color="{StaticResource OperatorColorAccent}" />
		<SolidColorBrush x:Key="GraphTransformBrush" Color="{StaticResource OperatorColorWarning}" />
		<SolidColorBrush x:Key="GraphCompositeBrush" Color="{StaticResource OperatorColorGraphics}" />
		<SolidColorBrush x:Key="GraphOutputBrush" Color="{StaticResource OperatorColorHealthy}" />
		<SolidColorBrush x:Key="GraphRecorderBrush" Color="{StaticResource OperatorColorError}" />

		<Style x:Key="GraphToolbarButton" TargetType="{x:Type controls:RtaimeButton}" BasedOn="{StaticResource {x:Type controls:RtaimeButton}}">
			<Setter Property="Height" Value="26" />
			<Setter Property="Padding" Value="8,0" />
			<Setter Property="Margin" Value="0,0,5,0" />
			<Setter Property="IsCompact" Value="True" />
		</Style>

		<Style x:Key="GraphNodeBorder" TargetType="{x:Type Border}">
			<Setter Property="Width" Value="214" />
			<Setter Property="Height" Value="116" />
			<Setter Property="Padding" Value="10" />
			<Setter Property="Background" Value="{DynamicResource OperatorRaisedSurfaceBrush}" />
			<Setter Property="BorderBrush" Value="{DynamicResource OperatorBorderStrongBrush}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="CornerRadius" Value="4" />
			<Setter Property="SnapsToDevicePixels" Value="True" />
			<Style.Triggers>
				<DataTrigger Binding="{Binding IsDegraded}" Value="True">
					<Setter Property="BorderBrush" Value="{DynamicResource OperatorWarningBrush}" />
				</DataTrigger>
				<DataTrigger Binding="{Binding IsError}" Value="True">
					<Setter Property="BorderBrush" Value="{DynamicResource OperatorErrorBrush}" />
				</DataTrigger>
				<DataTrigger Binding="{Binding IsSelected}" Value="True">
					<Setter Property="Background" Value="{DynamicResource OperatorSelectionSurfaceBrush}" />
					<Setter Property="BorderBrush" Value="{DynamicResource OperatorAccentBrush}" />
					<Setter Property="BorderThickness" Value="2" />
				</DataTrigger>
			                <DataTrigger Binding="{Binding Path=(controls:OperatorControlPresentation.HighContrast), RelativeSource={RelativeSource AncestorType={x:Type local:CompositingGraphControl}}}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
		</Style>

		<Style x:Key="GraphCategoryAccent" TargetType="{x:Type Border}">
			<Setter Property="Background" Value="{StaticResource GraphSourceBrush}" />
			<Style.Triggers>
				<DataTrigger Binding="{Binding KindLabel}" Value="ROUTING"><Setter Property="Background" Value="{StaticResource GraphRoutingBrush}" /></DataTrigger>
				<DataTrigger Binding="{Binding KindLabel}" Value="LAYER"><Setter Property="Background" Value="{StaticResource GraphCompositeBrush}" /></DataTrigger>
				<DataTrigger Binding="{Binding KindLabel}" Value="TRANSFORM"><Setter Property="Background" Value="{StaticResource GraphTransformBrush}" /></DataTrigger>
				<DataTrigger Binding="{Binding KindLabel}" Value="COMPOSITE"><Setter Property="Background" Value="{StaticResource GraphCompositeBrush}" /></DataTrigger>
				<DataTrigger Binding="{Binding KindLabel}" Value="OUTPUT"><Setter Property="Background" Value="{StaticResource GraphOutputBrush}" /></DataTrigger>
				<DataTrigger Binding="{Binding KindLabel}" Value="RECORDER"><Setter Property="Background" Value="{StaticResource GraphRecorderBrush}" /></DataTrigger>
			</Style.Triggers>
		</Style>

		<DrawingBrush x:Key="GraphGridBrush"
			TileMode="Tile"
			Viewport="0,0,96,96"
			ViewportUnits="Absolute"
			Viewbox="0,0,96,96"
			ViewboxUnits="Absolute"
			Stretch="None">
			<DrawingBrush.Drawing>
				<DrawingGroup>
					<GeometryDrawing Brush="{StaticResource GraphBackgroundBrush}" Geometry="M0,0 H96 V96 H0 Z" />
					<GeometryDrawing Geometry="M24,0 V96 M48,0 V96 M72,0 V96 M0,24 H96 M0,48 H96 M0,72 H96">
						<GeometryDrawing.Pen><Pen Brush="{StaticResource GraphMinorGridBrush}" Thickness="1" /></GeometryDrawing.Pen>
					</GeometryDrawing>
					<GeometryDrawing Geometry="M0,0 H96 M0,0 V96 M96,0 V96 M0,96 H96">
						<GeometryDrawing.Pen><Pen Brush="{StaticResource GraphMajorGridBrush}" Thickness="1" /></GeometryDrawing.Pen>
					</GeometryDrawing>
				</DrawingGroup>
			</DrawingBrush.Drawing>
		</DrawingBrush>
        <!-- One command surface for graph chrome, selected layers and selected nodes. -->
        <controls:RtaimeContextMenu x:Key="GraphActionsMenu" x:Shared="False"
            DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
            <controls:RtaimeMenuItem Header="Reset zoom to 100%" Command="{Binding ResetViewCommand}"
                AutomationProperties.Name="Reset graph zoom to 100 percent" ToolTip="Presentation only; Program is unchanged." />
            <controls:RtaimeMenuItem Header="Auto layout" Command="{Binding AutoLayoutCommand}"
                AutomationProperties.Name="Auto layout graph nodes" ToolTip="Restore local node positions without changing production routing." />
            <controls:RtaimeMenuSeparator />
            <controls:RtaimeMenuItem Header="Selected object" IsEnabled="False"
                AutomationProperties.Name="Selected object actions" ToolTip="{Binding SelectionEvidence}" />
            <controls:RtaimeMenuItem Header="Move selected layer up (draft)" Command="{Binding MoveSelectedLayerUpCommand}"
                AutomationProperties.Name="Stage selected layer earlier" ToolTip="{Binding SelectionEvidence}" ToolTipService.ShowOnDisabled="True" />
            <controls:RtaimeMenuItem Header="Move selected layer down (draft)" Command="{Binding MoveSelectedLayerDownCommand}"
                AutomationProperties.Name="Stage selected layer later" ToolTip="{Binding SelectionEvidence}" ToolTipService.ShowOnDisabled="True" />
            <controls:RtaimeMenuItem Header="Toggle layer visibility (draft)" Command="{Binding ToggleSelectedLayerCommand}"
                AutomationProperties.Name="Stage selected layer visibility" ToolTip="{Binding SelectionEvidence}" ToolTipService.ShowOnDisabled="True" />
            <controls:RtaimeMenuItem Header="Decrease layer opacity (draft)" Command="{Binding DecreaseSelectedLayerOpacityCommand}"
                AutomationProperties.Name="Decrease selected layer draft opacity" ToolTip="{Binding SelectionEvidence}" ToolTipService.ShowOnDisabled="True" />
            <controls:RtaimeMenuItem Header="Increase layer opacity (draft)" Command="{Binding IncreaseSelectedLayerOpacityCommand}"
                AutomationProperties.Name="Increase selected layer draft opacity" ToolTip="{Binding SelectionEvidence}" ToolTipService.ShowOnDisabled="True" />
            <controls:RtaimeMenuSeparator />
            <controls:RtaimeMenuItem Header="Stage selected FX earlier" Command="{Binding MoveProcessingEarlierDraftCommand}"
                AutomationProperties.Name="Stage selected FX earlier" ToolTip="{Binding FxOrderEvidence}" ToolTipService.ShowOnDisabled="True" />
            <controls:RtaimeMenuItem Header="Stage selected FX later" Command="{Binding MoveProcessingLaterDraftCommand}"
                AutomationProperties.Name="Stage selected FX later" ToolTip="{Binding FxOrderEvidence}" ToolTipService.ShowOnDisabled="True" />
            <controls:RtaimeMenuItem Header="Apply FX order draft" Command="{Binding ApplyProcessingOrderDraftCommand}"
                AutomationProperties.Name="Apply FX order draft" ToolTip="{Binding FxOrderEvidence}" ToolTipService.ShowOnDisabled="True" />
            <controls:RtaimeMenuItem Header="Discard FX order draft" Command="{Binding DiscardProcessingOrderDraftCommand}"
                AutomationProperties.Name="Discard FX order draft" ToolTip="{Binding FxOrderEvidence}" ToolTipService.ShowOnDisabled="True" />
            <controls:RtaimeMenuSeparator />
            <controls:RtaimeMenuItem Header="Apply selected layer draft" Command="{Binding ApplyLayerDraftCommand}"
                AutomationProperties.Name="Apply selected layer state draft" ToolTip="{Binding SelectionEvidence}" ToolTipService.ShowOnDisabled="True" />
            <controls:RtaimeMenuItem Header="Review selected layer draft" Command="{Binding ReviewLayerDraftCommand}"
                IsEnabled="{Binding SelectedLayerRow.CanReviewStateDraft}"
                AutomationProperties.Name="Review selected layer state draft" ToolTip="{Binding SelectionEvidence}" ToolTipService.ShowOnDisabled="True" />
            <controls:RtaimeMenuItem Header="Discard selected layer draft" Command="{Binding DiscardLayerDraftCommand}"
                IsEnabled="{Binding SelectedLayerRow.HasStateDraft}"
                AutomationProperties.Name="Discard selected layer state draft" ToolTip="{Binding SelectionEvidence}" ToolTipService.ShowOnDisabled="True" />
            <controls:RtaimeMenuItem Header="Apply layer order draft" Command="{Binding ApplyOrderDraftCommand}"
                AutomationProperties.Name="Apply layer order draft" ToolTip="{Binding OrderEvidence}" ToolTipService.ShowOnDisabled="True" />
            <controls:RtaimeMenuItem Header="Discard layer order draft" Command="{Binding DiscardOrderDraftCommand}"
                AutomationProperties.Name="Discard layer order draft" ToolTip="{Binding OrderEvidence}" />
        </controls:RtaimeContextMenu>

	</UserControl.Resources>

	<Grid>
		
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<controls:RtaimeStatePlaceholder
					State="{Binding WorkspaceStates.Compositing.State, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
					Title="{Binding WorkspaceStates.Compositing.Title, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
					Detail="{Binding WorkspaceStates.Compositing.Detail, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
					Panel.ZIndex="60"
					Margin="10" />

        <Border Grid.Row="0"
            Background="{DynamicResource OperatorAlternateSurfaceBrush}"
            BorderBrush="{DynamicResource OperatorBorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="8,4" MinHeight="38">
            <DockPanel LastChildFill="True">
                <controls:RtaimeStatusBadge DockPanel.Dock="Right" Content="{Binding ZoomLabel}"
                    Status="{x:Static controls:RtaimeStatusKind.Selection}" ShowIndicator="False"
                    VerticalAlignment="Center" Margin="6,0,0,0"
                    AutomationProperties.Name="Graph zoom percentage" />
                <WrapPanel VerticalAlignment="Center">
                    <controls:RtaimeButton Content="LAYERS" Command="{Binding ToggleLayerListCommand}"
                        Style="{StaticResource GraphToolbarButton}"
                        AutomationProperties.Name="Toggle compositing layer list"
                        ToolTip="Show or hide the confirmed layer list." />
                    <controls:RtaimeToggleButton Content="ADVANCED GRAPH"
                        IsChecked="{Binding ShowAdvancedGraph, Mode=TwoWay}" IsCompact="True"
                        Margin="0,0,6,0" AutomationProperties.Name="Toggle advanced compositing graph"
                        ToolTip="Inspect the bounded graph without changing Program." />
                    <StackPanel Orientation="Horizontal">
                        <StackPanel.Style><Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers><DataTrigger Binding="{Binding ShowAdvancedGraph}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger></Style.Triggers>
                        </Style></StackPanel.Style>
                        <controls:RtaimeButton Content="SELECT" Command="{Binding SelectModeCommand}"
                            AutomationProperties.Name="Select nodes in the compositing graph">
                            <controls:RtaimeButton.Style><Style TargetType="{x:Type controls:RtaimeButton}" BasedOn="{StaticResource GraphToolbarButton}">
                                <Style.Triggers><DataTrigger Binding="{Binding IsSelectMode}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource OperatorAccentSurfaceBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource OperatorAccentBrush}" />
                                </DataTrigger></Style.Triggers>
                            </Style></controls:RtaimeButton.Style>
                        </controls:RtaimeButton>
                        <controls:RtaimeButton Content="PAN" Command="{Binding PanModeCommand}"
                            AutomationProperties.Name="Pan compositing graph">
                            <controls:RtaimeButton.Style><Style TargetType="{x:Type controls:RtaimeButton}" BasedOn="{StaticResource GraphToolbarButton}">
                                <Style.Triggers><DataTrigger Binding="{Binding IsPanMode}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource OperatorAccentSurfaceBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource OperatorAccentBrush}" />
                                </DataTrigger></Style.Triggers>
                            </Style></controls:RtaimeButton.Style>
                        </controls:RtaimeButton>
                        <controls:RtaimeButton Content="FIT" Command="{Binding FitCommand}"
                            Style="{StaticResource GraphToolbarButton}"
                            AutomationProperties.Name="Fit compositing graph to viewport"
                            ToolTip="Fit the graph to the available viewport." />
                    </StackPanel>
                    <controls:RtaimeButton x:Name="GraphActionsButton" Content="MORE" Click="OnGraphActionsClick"
                        Tag="{Binding}" ContextMenu="{StaticResource GraphActionsMenu}"
                        Style="{StaticResource GraphToolbarButton}"
                        AutomationProperties.Name="More graph and selected object actions"
                        ToolTip="Open advanced graph commands and actions for the selected object. Shift+F10 or Menu key also opens this menu." />
                </WrapPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Padding="6" Style="{StaticResource GraphPanel}">
            <StackPanel>
                <TextBlock Text="{Binding SceneDeclaration}" Style="{StaticResource GraphLabel}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding LayerStackOverview}" Style="{StaticResource GraphLabel}"
                    FontWeight="SemiBold" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite" />
                <TextBlock Text="{Binding RuntimeEvidence}" Style="{StaticResource GraphLabel}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding WorkspaceNotice}" Style="{StaticResource GraphLabel}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding RuntimeRevisionEvidence}" Style="{StaticResource GraphLabel}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding TopologyEvidence}" Style="{StaticResource GraphLabel}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding FxOrderEvidence}" Style="{StaticResource GraphLabel}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
        <!-- Draft decisions remain visible even when the layer list or graph is collapsed. -->
        <Border x:Name="GraphDraftFooter" Grid.Row="2" Padding="6,3"
            BorderBrush="{DynamicResource OperatorBorderBrush}" BorderThickness="0,1,0,1">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource GraphPanel}">
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding HasUnresolvedLayerDrafts, ElementName=Root}" Value="False" />
                                <Condition Binding="{Binding HasFxOrderDraft}" Value="False" />
                                <Condition Binding="{Binding OrderEvidence}" Value="RUNTIME ORDER · CONFIRMED" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Collapsed" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <Grid Margin="0,2">
                    <Grid.Style><Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers><DataTrigger Binding="{Binding HasUnresolvedLayerDrafts, ElementName=Root}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger></Style.Triggers>
                    </Style></Grid.Style>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding LayerCommandStatus}" Style="{StaticResource GraphLabel}"
                            TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectionEvidence}"
                            AutomationProperties.LiveSetting="Polite" />
                        <controls:RtaimeScrollViewer MaxHeight="52" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Layers}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate><DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,8,0">
                                        <StackPanel.Style><Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers><DataTrigger Binding="{Binding HasStateDraft}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger></Style.Triggers>
                                        </Style></StackPanel.Style>
                                        <controls:RtaimeButton Content="{Binding Title}"
                                            Command="{Binding DataContext.SelectNodeCommand, ElementName=Root}" CommandParameter="{Binding}"
                                            IsCompact="True" AutomationProperties.Name="{Binding Title}"
                                            ToolTip="Select this unresolved layer draft for Apply, Review or Discard." />
                                        <TextBlock Text="{Binding DraftEvidence}" Style="{StaticResource GraphLabel}"
                                            VerticalAlignment="Center" Margin="5,0,0,0"
                                            ToolTip="{Binding DraftEvidence}" TextTrimming="CharacterEllipsis" MaxWidth="215" />
                                    </StackPanel>
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </controls:RtaimeScrollViewer>
                    </StackPanel>
                    <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                        <controls:RtaimeButton Content="APPLY LAYER" Command="{Binding ApplyLayerDraftCommand}"
                            Style="{StaticResource GraphToolbarButton}"
                            AutomationProperties.Name="Apply selected layer state draft" ToolTip="{Binding SelectionEvidence}" />
                        <controls:RtaimeButton Content="REVIEW" Command="{Binding ReviewLayerDraftCommand}"
                            IsEnabled="{Binding SelectedLayerRow.CanReviewStateDraft}"
                            Style="{StaticResource GraphToolbarButton}"
                            AutomationProperties.Name="Review selected layer draft" ToolTip="{Binding SelectionEvidence}" />
                        <controls:RtaimeButton Content="DISCARD" Command="{Binding DiscardLayerDraftCommand}"
                            IsEnabled="{Binding SelectedLayerRow.HasStateDraft}"
                            Style="{StaticResource GraphToolbarButton}"
                            AutomationProperties.Name="Discard selected layer state draft" ToolTip="{Binding SelectionEvidence}" />
                    </WrapPanel>
                </Grid>
                <Grid Margin="0,2">
                    <Grid.Style><Style TargetType="Grid">
                        <Style.Triggers><DataTrigger Binding="{Binding OrderEvidence}" Value="RUNTIME ORDER · CONFIRMED">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger></Style.Triggers>
                    </Style></Grid.Style>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding OrderEvidence}" Style="{StaticResource GraphLabel}"
                        VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                        ToolTip="{Binding OrderEvidence}" AutomationProperties.LiveSetting="Polite" />
                    <WrapPanel Grid.Column="1">
                        <controls:RtaimeButton Content="APPLY ORDER" Command="{Binding ApplyOrderDraftCommand}"
                            Style="{StaticResource GraphToolbarButton}" AutomationProperties.Name="Apply layer order draft" />
                        <controls:RtaimeButton Content="DISCARD ORDER" Command="{Binding DiscardOrderDraftCommand}"
                            Style="{StaticResource GraphToolbarButton}" AutomationProperties.Name="Discard layer order draft" />
                    </WrapPanel>
                </Grid>
                <Grid Margin="0,2">
                    <Grid.Style><Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers><DataTrigger Binding="{Binding HasFxOrderDraft}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger></Style.Triggers>
                    </Style></Grid.Style>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding FxOrderEvidence}" Style="{StaticResource GraphLabel}"
                        VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                        ToolTip="{Binding FxOrderEvidence}" AutomationProperties.LiveSetting="Polite" />
                    <WrapPanel Grid.Column="1">
                        <controls:RtaimeButton Content="APPLY FX" Command="{Binding ApplyProcessingOrderDraftCommand}"
                            Style="{StaticResource GraphToolbarButton}" AutomationProperties.Name="Apply FX order draft" />
                        <controls:RtaimeButton Content="DISCARD FX" Command="{Binding DiscardProcessingOrderDraftCommand}"
                            Style="{StaticResource GraphToolbarButton}" AutomationProperties.Name="Discard FX order draft" />
                    </WrapPanel>
                </Grid>
            </StackPanel>
        </Border>
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="{Binding AdvancedGraphColumnWidth}" /></Grid.ColumnDefinitions>
            <Border Width="{Binding LayerPanelWidth}" Padding="6">
                <Border.Style><Style TargetType="Border" BasedOn="{StaticResource GraphPanel}"><Style.Triggers>
                    <DataTrigger Binding="{Binding ShowLayers}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                </Style.Triggers></Style></Border.Style>
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel>
                        <controls:RtaimeTextBox x:Name="LayerSearch" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search compositing layers and nodes" ToolTip="Search layers and nodes. F3 focuses search; filtering never clears selection." Margin="0,0,0,4" />
                        <TextBlock Text="{Binding OrderEvidence}" Style="{StaticResource GraphLabel}" TextWrapping="Wrap" />
                        <WrapPanel>
                            <controls:RtaimeButton Content="APPLY ORDER" Command="{Binding ApplyOrderDraftCommand}" IsCompact="True" />
                            <controls:RtaimeButton Content="UNDO ORDER" Command="{Binding DiscardOrderDraftCommand}" IsCompact="True" />
                        </WrapPanel>
                    </StackPanel>
                    <controls:RtaimeListBox x:Name="LayerList" Grid.Row="1" ItemsSource="{Binding Layers}" SelectionMode="Extended"
                        SelectionChanged="OnLayerSelectionChanged" AllowDrop="True" Drop="OnLayerDrop"
                        PreviewMouseLeftButtonDown="OnLayerDragStart" PreviewMouseMove="OnLayerDragMove"
                        VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                        ScrollViewer.CanContentScroll="True" HorizontalContentAlignment="Stretch"
                        AutomationProperties.Name="Confirmed layers, Control or Shift selects common-property review">
                        <controls:RtaimeListBox.ItemContainerStyle>
                            <Style TargetType="{x:Type controls:RtaimeListBoxItem}" BasedOn="{StaticResource {x:Type controls:RtaimeListBoxItem}}">
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType={x:Type local:CompositingGraphControl}}}" />
                                <Setter Property="ContextMenu" Value="{StaticResource GraphActionsMenu}" />
                                <EventSetter Event="ContextMenuOpening" Handler="OnSelectedObjectContextOpening" />
                                <Style.Triggers><DataTrigger Binding="{Binding MatchesSearch}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                            </Style>
                        </controls:RtaimeListBox.ItemContainerStyle>
                        <controls:RtaimeListBox.ItemTemplate><DataTemplate>
                            <StackPanel Margin="0,3" ToolTip="{Binding Id}">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding LayerEvidence}" Style="{StaticResource GraphLabel}" TextWrapping="Wrap" MaxHeight="56" />
                                <TextBlock Text="{Binding LayerEffectEvidence}" Style="{StaticResource GraphLabel}"
                                    TextTrimming="CharacterEllipsis" ToolTip="{Binding LayerEffectEvidence}" />
                                <TextBlock Text="{Binding DraftEvidence}" ToolTip="{Binding DraftEvidence}"
                                    TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource GraphLabel}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasStateDraft}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource OperatorAccentBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding StateConflict}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource OperatorWarningBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SourceChanged}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource OperatorErrorBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding Status}" Style="{StaticResource GraphLabel}"
                                    TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}" />
                                <controls:RtaimeButton Content="EXPAND / COLLAPSE" Command="{Binding DataContext.CollapseLayerCommand, ElementName=Root}" CommandParameter="{Binding}" IsCompact="True" />
                            </StackPanel>
                        </DataTemplate></controls:RtaimeListBox.ItemTemplate>
                    </controls:RtaimeListBox>
                    <controls:RtaimeScrollViewer Grid.Row="2" MaxHeight="230" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectionEvidence}" Style="{StaticResource GraphLabel}" TextWrapping="Wrap" />
                            <controls:RtaimeCheckBox IsEnabled="{Binding CanStageLayerDraft}" Content="Draft visibility" IsChecked="{Binding SelectedLayerRow.VisibleDraft}" AutomationProperties.Name="Local visibility draft" />
                            <controls:RtaimeNumericField IsEnabled="{Binding CanStageLayerDraft}" x:Name="LayerOpacityEditor" Value="{Binding SelectedLayerRow.OpacityDraft, Mode=TwoWay}" Definition="{Binding OpacityDefinition}" InputValidityChanged="OnLayerInputValidityChanged" AutomationProperties.Name="Local opacity draft, zero to 255" />
                            <WrapPanel>
                                <controls:RtaimeButton Content="APPLY" Command="{Binding ApplyLayerDraftCommand}" IsCompact="True" />
                                <controls:RtaimeButton Content="DISCARD" Command="{Binding DiscardLayerDraftCommand}" IsCompact="True" />
                                <controls:RtaimeButton Content="REVIEW" Command="{Binding ReviewLayerDraftCommand}"
                                    IsEnabled="{Binding SelectedLayerRow.CanReviewStateDraft}" IsCompact="True"
                                    ToolTip="Reconcile a same-content draft after a newer Runtime revision. Replaced content must be discarded." />
                                <controls:RtaimeButton Content="RECALL SCENE" Command="{Binding RecallSceneCommand}" IsCompact="True" />
                            </WrapPanel>
                        </StackPanel>
                    </controls:RtaimeScrollViewer>
                </Grid>
            </Border>

		<Grid x:Name="GraphViewport"
			Grid.Column="1"
            Tag="{Binding}" ContextMenu="{StaticResource GraphActionsMenu}"
			ClipToBounds="True"
			MouseWheel="OnGraphMouseWheel"
			MouseDown="OnGraphMouseDown"
			MouseMove="OnGraphMouseMove"
			MouseUp="OnGraphMouseUp"
			MouseLeave="OnGraphMouseLeave"
            IsVisibleChanged="OnGraphVisibilityChanged"
			SizeChanged="OnGraphSizeChanged">
            <Grid.Style><Style TargetType="Grid">
                <Setter Property="Background" Value="{StaticResource GraphGridBrush}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding ShowAdvancedGraph}" Value="False">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Path=(controls:OperatorControlPresentation.HighContrast), RelativeSource={RelativeSource AncestorType={x:Type local:CompositingGraphControl}}}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style></Grid.Style>

			<Canvas x:Name="GraphWorld"
				Width="{Binding CanvasWidth}"
				Height="{Binding CanvasHeight}"
				HorizontalAlignment="Left"
				VerticalAlignment="Top"
				CacheMode="BitmapCache">
				<Canvas.RenderTransform>
					<TransformGroup>
						<ScaleTransform ScaleX="{Binding Zoom}" ScaleY="{Binding Zoom}" />
						<TranslateTransform X="{Binding PanX}" Y="{Binding PanY}" />
					</TransformGroup>
				</Canvas.RenderTransform>

				<ItemsControl ItemsSource="{Binding VisibleConnections}"
					Width="{Binding CanvasWidth}"
					Height="{Binding CanvasHeight}">
					<ItemsControl.ItemsPanel>
						<ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
					</ItemsControl.ItemsPanel>
					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<Canvas Width="{Binding DataContext.CanvasWidth, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
								Height="{Binding DataContext.CanvasHeight, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}">
								<Path Data="{Binding Geometry}" StrokeThickness="2" Opacity="{Binding Opacity}">
									<Path.Style>
										<Style TargetType="{x:Type Path}">
											<Setter Property="Stroke" Value="{StaticResource GraphConnectionBrush}" />
											<Style.Triggers>
												<DataTrigger Binding="{Binding IsActive}" Value="True">
													<Setter Property="Stroke" Value="{DynamicResource OperatorAccentBrush}" />
													<Setter Property="Opacity" Value="1" />
												</DataTrigger>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="Stroke" Value="{DynamicResource OperatorFocusBrush}" />
                                            <Setter Property="StrokeThickness" Value="4" />
                                            <Setter Property="Opacity" Value="1" />
                                        </DataTrigger>
											</Style.Triggers>
										</Style>
									</Path.Style>
								</Path>
								<!-- The hit target has no effect on confirmed signal geometry. -->
                                <Path Data="{Binding Geometry}" Stroke="Transparent" StrokeThickness="14"
                                    Focusable="True" Cursor="Hand" ToolTip="{Binding Description}"
                                    AutomationProperties.Name="{Binding Description}"
                                    PreviewMouseLeftButtonDown="OnConnectionSelect"
                                    PreviewKeyDown="OnConnectionKeyDown" />
                                <Polygon Points="{Binding ArrowPoints}" Opacity="{Binding Opacity}">
									<Polygon.Style>
										<Style TargetType="{x:Type Polygon}">
											<Setter Property="Fill" Value="{StaticResource GraphConnectionBrush}" />
											<Style.Triggers>
												<DataTrigger Binding="{Binding IsActive}" Value="True">
													<Setter Property="Fill" Value="{DynamicResource OperatorAccentBrush}" />
													<Setter Property="Opacity" Value="1" />
												</DataTrigger>
											</Style.Triggers>
										</Style>
									</Polygon.Style>
								</Polygon>
							</Canvas>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>

				<ItemsControl ItemsSource="{Binding VisibleNodes}"
					Width="{Binding CanvasWidth}"
					Height="{Binding CanvasHeight}">
					<ItemsControl.ItemsPanel>
						<ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
					</ItemsControl.ItemsPanel>
					<ItemsControl.ItemContainerStyle>
						<Style TargetType="{x:Type ContentPresenter}">
							<Setter Property="Canvas.Left" Value="{Binding X}" />
							<Setter Property="Canvas.Top" Value="{Binding Y}" />
						</Style>
					</ItemsControl.ItemContainerStyle>
					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<controls:RtaimeButton
								Command="{Binding DataContext.SelectNodeCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
								CommandParameter="{Binding}"
								Background="Transparent"
								BorderBrush="Transparent"
								BorderThickness="0"
								Padding="0"
								HorizontalContentAlignment="Stretch"
								VerticalContentAlignment="Stretch"
								ToolTip="{Binding CapabilityLabel}" AutomationProperties.Name="{Binding Id}" PreviewMouseLeftButtonDown="OnNodeSelectionModifiers"
                                PreviewMouseMove="OnNodeDragMove" PreviewMouseLeftButtonUp="OnNodeDragEnd" LostMouseCapture="OnNodeDragLostCapture"
                                Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType={x:Type local:CompositingGraphControl}}}"
                                ContextMenu="{StaticResource GraphActionsMenu}" ContextMenuOpening="OnSelectedObjectContextOpening">
								<Border Style="{StaticResource GraphNodeBorder}">
									<Grid>
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="4" />
											<ColumnDefinition Width="*" />
										</Grid.ColumnDefinitions>
										<Border Grid.Column="0" Style="{StaticResource GraphCategoryAccent}" Margin="-10,-10,8,-10" CornerRadius="3,0,0,3" />
										<Grid Grid.Column="1">
											<Grid.RowDefinitions>
												<RowDefinition Height="Auto" />
												<RowDefinition Height="*" />
												<RowDefinition Height="Auto" />
											</Grid.RowDefinitions>

											<DockPanel>
												<controls:RtaimeStatusBadge
													DockPanel.Dock="Right"
													Status="{x:Static controls:RtaimeStatusKind.Neutral}"
													Content="{Binding Status}"
													ShowIndicator="False"
													Margin="6,0,0,0" />
												<StackPanel>
													<TextBlock Text="{Binding RoleLabel}" Style="{StaticResource GraphLabel}" FontSize="{StaticResource OperatorFontSizeMicro}" FontWeight="Bold" />
													<TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="{StaticResource OperatorFontSizeBody}" TextTrimming="CharacterEllipsis" MaxWidth="116" />
												</StackPanel>
											</DockPanel>

											<StackPanel Grid.Row="1" Margin="0,3,0,4">
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource GraphLabel}"
                                                    FontSize="{StaticResource OperatorFontSizeCompact}" TextWrapping="Wrap"
                                                    TextTrimming="CharacterEllipsis" MaxHeight="28" />
                                                <TextBlock Text="{Binding CapabilityLabel}" Style="{StaticResource GraphLabel}"
                                                    FontSize="{StaticResource OperatorFontSizeFinePrint}"
                                                    TextTrimming="CharacterEllipsis" ToolTip="{Binding CapabilityLabel}" />
                                            </StackPanel>

											<Grid Grid.Row="2">
												<Grid.ColumnDefinitions>
													<ColumnDefinition Width="*" />
													<ColumnDefinition Width="10" />
													<ColumnDefinition Width="*" />
												</Grid.ColumnDefinitions>
												<StackPanel>
													<StackPanel Orientation="Horizontal">
														<Ellipse Width="7" Height="7" Fill="{DynamicResource OperatorSecondaryTextBrush}" Margin="-3,1,5,0" />
														<TextBlock Text="IN" Style="{StaticResource GraphLabel}" FontSize="{StaticResource OperatorFontSizeFinePrint}" />
													</StackPanel>
													<TextBlock Text="{Binding InputPorts}" FontSize="{StaticResource OperatorFontSizeMicro}" TextTrimming="CharacterEllipsis" />
												</StackPanel>
												<StackPanel Grid.Column="2" HorizontalAlignment="Right">
													<StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
														<TextBlock Text="OUT" Style="{StaticResource GraphLabel}" FontSize="{StaticResource OperatorFontSizeFinePrint}" Margin="0,0,5,0" />
														<Ellipse Width="7" Height="7" Fill="{DynamicResource OperatorSecondaryTextBrush}" Margin="0,1,-3,0" />
													</StackPanel>
													<TextBlock Text="{Binding OutputPorts}" FontSize="{StaticResource OperatorFontSizeMicro}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Right" />
												</StackPanel>
											</Grid>
										</Grid>
									</Grid>
								</Border>
							</controls:RtaimeButton>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</Canvas>

			<Border HorizontalAlignment="Left"
				VerticalAlignment="Bottom"
				Margin="10"
				Style="{StaticResource OperatorGraphOverlay}">
				<StackPanel MaxWidth="420">
                    <TextBlock Text="Wheel zoom · middle mouse pan · Alt+drag local node · Ctrl+arrows nudge · Enter inspect link"
                        Style="{StaticResource GraphLabel}" FontSize="{StaticResource OperatorFontSizeMicro}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ConnectionEvidence}" Style="{StaticResource GraphLabel}"
                        FontSize="{StaticResource OperatorFontSizeMicro}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding LayoutEvidence}" Style="{StaticResource GraphLabel}"
                        FontSize="{StaticResource OperatorFontSizeMicro}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
			</Border>
		</Grid>
        </Grid>
	</Grid>
</UserControl>
