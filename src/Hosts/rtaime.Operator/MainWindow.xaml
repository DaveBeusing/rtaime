							<DockPanel><TextBlock Text="Observed" Style="{StaticResource OperatorLabel}" /><TextBlock Text="{Binding HealthObserved}" Style="{StaticResource OperatorLabel}" DockPanel.Dock="Right" /></DockPanel>
