					</Border>

					<Border Style="{StaticResource OperatorPanel}" Margin="0,0,0,14">
						<StackPanel>
							<TextBlock Text="MONITORING" Style="{StaticResource OperatorSectionTitle}" Margin="0,0,0,12" />
