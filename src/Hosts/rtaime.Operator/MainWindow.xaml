								SelectedItem="{Binding ProgramOutput.SelectedDisplay, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Mode=TwoWay}"
								DisplayMemberPath="Label"
								MinHeight="32"
								Margin="0,0,0,8" />
							<Grid Margin="0,0,0,8">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="6" />
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="6" />
									<ColumnDefinition Width="*" />
								</Grid.ColumnDefinitions>
								<controls:RtaimeButton Grid.Column="0" Content="START OUTPUT" Command="{Binding ProgramOutput.StartCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Background="{DynamicResource OperatorProgramSurfaceBrush}" BorderBrush="{DynamicResource OperatorProgramBrush}" ToolTip="Open clean Program monitoring on the selected display without changing physical Program output." />
								<controls:RtaimeButton Grid.Column="2" Content="STOP OUTPUT" Command="{Binding ProgramOutput.StopCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"  ToolTip="Close the clean Program feed." />
								<controls:RtaimeButton Grid.Column="4" Content="{Binding ProgramOutput.FullscreenAction, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Command="{Binding ProgramOutput.ToggleFullscreenCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Background="{DynamicResource OperatorAccentSurfaceBrush}" BorderBrush="{DynamicResource OperatorAccentBrush}" ToolTip="Toggle the clean feed between fullscreen and windowed presentation." />
							</Grid>
							<DockPanel Margin="0,0,0,6">
								<TextBlock Text="State" Style="{StaticResource OperatorLabel}" />
								<TextBlock Text="{Binding ProgramOutput.RunState, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Style="{StaticResource OperatorValue}" FontWeight="SemiBold" DockPanel.Dock="Right" />
							</DockPanel>
							<DockPanel Margin="0,0,0,8">
								<TextBlock Text="Mode" Style="{StaticResource OperatorLabel}" />
								<TextBlock Text="{Binding ProgramOutput.Mode, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Style="{StaticResource OperatorValue}" DockPanel.Dock="Right" />
							</DockPanel>
							<TextBlock Text="{Binding ProgramOutput.Detail, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Style="{StaticResource OperatorLabel}" TextWrapping="Wrap" />
							<TextBlock Text="Clean Program is a monitoring presentation of the existing Runtime-derived Program image; it is not the physical Program output path." Style="{StaticResource OperatorLabel}" TextWrapping="Wrap" Margin="0,6,0,0" />
						</StackPanel>
					</Border>

					<Border Style="{StaticResource OperatorPanel}" Margin="0,0,0,14"
						Visibility="{Binding Shell.GraphicsVisibility, RelativeSource={RelativeSource AncestorType={x:Type Window}}}">
						<StackPanel>
							<DockPanel Margin="0,0,0,12">
								<TextBlock Text="GRAPHICS / OVERLAY" Style="{StaticResource OperatorSectionTitle}" />
								<Border Style="{StaticResource OperatorStatusBadge}" DockPanel.Dock="Right"><TextBlock Text="{Binding GraphicsState}" FontWeight="Bold" /></Border>
							</DockPanel>
							<TextBlock Text="{Binding GraphicsAssetName}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
							<DockPanel Margin="0,3,0,12">
								<TextBlock Text="PNG / RGBA asset" Style="{StaticResource OperatorLabel}" />
								<TextBlock Text="{Binding GraphicsDimensions}" Style="{StaticResource OperatorValue}" DockPanel.Dock="Right" />
							</DockPanel>
							<Grid Margin="0,0,0,10">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="8" />
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="8" />
									<ColumnDefinition Width="*" />
								</Grid.ColumnDefinitions>
								<StackPanel Grid.Column="0">
									<TextBlock Text="X %" Style="{StaticResource OperatorLabel}" />
									<controls:RtaimeTextBox Text="{Binding GraphicsPositionX, UpdateSourceTrigger=PropertyChanged}"  />
								</StackPanel>
								<StackPanel Grid.Column="2">
									<TextBlock Text="Y %" Style="{StaticResource OperatorLabel}" />
									<controls:RtaimeTextBox Text="{Binding GraphicsPositionY, UpdateSourceTrigger=PropertyChanged}"  />
								</StackPanel>
								<StackPanel Grid.Column="4">
									<TextBlock Text="SCALE" Style="{StaticResource OperatorLabel}" />
									<controls:RtaimeTextBox Text="{Binding GraphicsScale, UpdateSourceTrigger=PropertyChanged}"  />
								</StackPanel>
							</Grid>
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="6" />
									<ColumnDefinition Width="*" />
								</Grid.ColumnDefinitions>
								<controls:RtaimeButton Grid.Column="0" Content="LOAD PNG" Command="{Binding LoadGraphicsCommand}" Background="{DynamicResource OperatorAccentSurfaceBrush}" BorderBrush="{DynamicResource OperatorAccentBrush}" />
								<controls:RtaimeButton Grid.Column="2" Content="APPLY POSITION" Command="{Binding ApplyGraphicsCommand}"  />
							</Grid>
							<Grid Margin="0,6,0,0">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="6" />
									<ColumnDefinition Width="*" />
								</Grid.ColumnDefinitions>
								<controls:RtaimeButton Grid.Column="0" Content="SHOW / HIDE" Command="{Binding ToggleGraphicsCommand}" Background="{DynamicResource OperatorProgramSurfaceBrush}" BorderBrush="{DynamicResource OperatorProgramBrush}" />
								<controls:RtaimeButton Grid.Column="2" Content="CLEAR" Command="{Binding ClearGraphicsCommand}"  />
							</Grid>
							<TextBlock Text="Graphics are composited in RuntimeHost after the transition and before Program monitoring / recording." Style="{StaticResource OperatorLabel}" TextWrapping="Wrap" Margin="0,10,0,0" />
						</StackPanel>
					</Border>

					<Border Style="{StaticResource OperatorPanel}" Margin="0,0,0,14"
						Visibility="{Binding Shell.AudioVisibility, RelativeSource={RelativeSource AncestorType={x:Type Window}}}">
						<StackPanel>
							<DockPanel Margin="0,0,0,12">
								<TextBlock Text="AUDIO / AFV" Style="{StaticResource OperatorSectionTitle}" />
								<Border Style="{StaticResource OperatorStatusBadge}" DockPanel.Dock="Right">
									<TextBlock Text="{Binding AudioHealth}" FontWeight="Bold" />
								</Border>
							</DockPanel>
							<DockPanel Margin="0,0,0,8">
								<TextBlock Text="AFV follows Program" Style="{StaticResource OperatorLabel}" />
								<TextBlock Text="{Binding AudioAfvSourceName}" Style="{StaticResource OperatorValue}" FontWeight="SemiBold" DockPanel.Dock="Right" TextTrimming="CharacterEllipsis" />
							</DockPanel>
							<DockPanel Margin="0,0,0,10">
								<TextBlock Text="Meter transport" Style="{StaticResource OperatorLabel}" />
								<TextBlock Text="{Binding AudioMeterStatus}" Style="{StaticResource OperatorValue}" DockPanel.Dock="Right" />
							</DockPanel>
							<Grid Margin="0,0,0,3">
								<Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /><ColumnDefinition Width="48" /></Grid.ColumnDefinitions>
								<TextBlock Text="L" Style="{StaticResource OperatorLabel}" VerticalAlignment="Center" />
								<controls:RtaimeMetricBar Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding AudioLeftPeak, Mode=OneWay}" Height="4" Foreground="{DynamicResource OperatorAudioBrush}" VerticalAlignment="Center" />
								<TextBlock Grid.Column="2" Text="{Binding AudioLeftPeak, StringFormat={}{0:P0}}" Style="{StaticResource OperatorLabel}" HorizontalAlignment="Right" />
							</Grid>
							<Grid Margin="0,0,0,10">
								<Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /><ColumnDefinition Width="48" /></Grid.ColumnDefinitions>
								<TextBlock Text="R" Style="{StaticResource OperatorLabel}" VerticalAlignment="Center" />
								<controls:RtaimeMetricBar Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding AudioRightPeak, Mode=OneWay}" Height="4" Foreground="{DynamicResource OperatorAudioBrush}" VerticalAlignment="Center" />
								<TextBlock Grid.Column="2" Text="{Binding AudioRightPeak, StringFormat={}{0:P0}}" Style="{StaticResource OperatorLabel}" HorizontalAlignment="Right" />
							</Grid>
							<DockPanel Margin="0,0,0,10">
								<TextBlock Text="MASTER" Style="{StaticResource OperatorLabel}" />
								<TextBlock Text="{Binding AudioPeakPercent}" Style="{StaticResource OperatorValue}" FontWeight="SemiBold" DockPanel.Dock="Right" />
							</DockPanel>
							<controls:RtaimeMetricBar Minimum="0" Maximum="1" Value="{Binding AudioMasterPeak, Mode=OneWay}" Height="4" Foreground="{DynamicResource OperatorAudioBrush}" Margin="0,0,0,12" />
							<controls:RtaimeListBox ItemsSource="{Binding AudioInputs}" SelectedItem="{Binding SelectedAudioInput}" Style="{StaticResource RtaimeSourceBank}" MaxHeight="190" Margin="0,0,0,10">
								<controls:RtaimeListBox.ItemContainerStyle><StaticResource ResourceKey="OperatorSourceItem" /></controls:RtaimeListBox.ItemContainerStyle>
								<controls:RtaimeListBox.ItemTemplate>
									<DataTemplate>
										<StackPanel>
											<DockPanel>
												<TextBlock Text="{Binding SourceName}" Style="{StaticResource OperatorValue}" FontWeight="SemiBold" />
												<TextBlock Text="{Binding AfvLabel}" Style="{StaticResource OperatorLabel}" DockPanel.Dock="Right" />
											</DockPanel>
											<DockPanel Margin="0,4,0,4">
												<TextBlock Text="{Binding SourceType}" Style="{StaticResource OperatorLabel}" />
												<TextBlock Text="{Binding Health}" Style="{StaticResource OperatorLabel}" DockPanel.Dock="Right" />
											</DockPanel>
											<Grid>
												<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="6" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
												<controls:RtaimeMetricBar Grid.Column="0" Minimum="0" Maximum="1" Value="{Binding LeftPeak, Mode=OneWay}" Height="4" Foreground="{DynamicResource OperatorAudioBrush}" />
												<controls:RtaimeMetricBar Grid.Column="2" Minimum="0" Maximum="1" Value="{Binding RightPeak, Mode=OneWay}" Height="4" Foreground="{DynamicResource OperatorAudioBrush}" />
											</Grid>
										</StackPanel>
									</DataTemplate>
								</controls:RtaimeListBox.ItemTemplate>
							</controls:RtaimeListBox>
							<Grid Margin="0,0,0,8">
								<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
								<StackPanel Grid.Column="0">
									<TextBlock Text="Selected gain 0.0–4.0x" Style="{StaticResource OperatorLabel}" />
									<controls:RtaimeTextBox Text="{Binding SelectedAudioInput.Gain, UpdateSourceTrigger=PropertyChanged}"  />
								</StackPanel>
								<StackPanel Grid.Column="2">
									<TextBlock Text="Confirmed mute" Style="{StaticResource OperatorLabel}" />
									<TextBlock Text="{Binding SelectedAudioInput.Muted}" Style="{StaticResource OperatorValue}" Margin="0,8,0,0" />
								</StackPanel>
							</Grid>
							<Grid>
								<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="6" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
								<controls:RtaimeButton Grid.Column="0" Content="APPLY GAIN" Command="{Binding ApplyAudioGainCommand}" Background="{DynamicResource OperatorAccentSurfaceBrush}" BorderBrush="{DynamicResource OperatorAccentBrush}" />
								<controls:RtaimeButton Grid.Column="2" Content="{Binding SelectedAudioInput.MuteActionLabel}" Command="{Binding ToggleAudioMuteCommand}"  />
							</Grid>
							<DockPanel Margin="0,10,0,0">
								<TextBlock Text="Clip audio" Style="{StaticResource OperatorLabel}" />
								<TextBlock Text="{Binding ClipAudioStatus}" Style="{StaticResource OperatorLabel}" DockPanel.Dock="Right" TextTrimming="CharacterEllipsis" MaxWidth="230" />
							</DockPanel>
							<TextBlock Text="Meters are RuntimeHost observations; no WPF-generated meter animation is used." Style="{StaticResource OperatorLabel}" TextWrapping="Wrap" Margin="0,8,0,0" />
						</StackPanel>
					</Border>

					<Border Style="{StaticResource OperatorPanel}" Margin="0,0,0,14"
						Visibility="{Binding Shell.RecordingVisibility, RelativeSource={RelativeSource AncestorType={x:Type Window}}}">
						<StackPanel>
							<DockPanel Margin="0,0,0,12">
								<TextBlock Text="PROGRAM RECORDING" Style="{StaticResource OperatorSectionTitle}" />
								<Border Style="{StaticResource OperatorStatusBadge}" DockPanel.Dock="Right">
									<StackPanel Orientation="Horizontal">
										<TextBlock Text="REC · " FontWeight="Bold" />
										<TextBlock Text="{Binding RecordingStatus}" FontWeight="Bold" />
									</StackPanel>
								</Border>
							</DockPanel>
							<TextBlock Text="{Binding RecordingElapsed}" Style="{StaticResource OperatorTimecode}" FontSize="24" FontWeight="Bold" Margin="0,0,0,12" />
							<TextBlock Text="DESTINATION" Style="{StaticResource OperatorLabel}" />
							<controls:RtaimeTextBox Text="{Binding RecordingDestination, UpdateSourceTrigger=PropertyChanged}"  Margin="0,4,0,10" />
							<TextBlock Text="FILE NAME" Style="{StaticResource OperatorLabel}" />
							<controls:RtaimeTextBox Text="{Binding RecordingFileName, UpdateSourceTrigger=PropertyChanged}"  Margin="0,4,0,10" />
							<Grid Margin="0,0,0,10">
								<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="6" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
								<controls:RtaimeButton Grid.Column="0" Content="START REC" Command="{Binding StartRecordingCommand}" Background="{DynamicResource OperatorProgramSurfaceBrush}" BorderBrush="{DynamicResource OperatorProgramBrush}" ToolTip="Start recording confirmed Program video/audio/graphics." />
								<controls:RtaimeButton Grid.Column="2" Content="STOP REC" Command="{Binding StopRecordingCommand}"  ToolTip="Stop and finalize the active Program recording." />
							</Grid>
							<DockPanel Margin="0,0,0,6">
								<TextBlock Text="Samples" Style="{StaticResource OperatorLabel}" />
								<TextBlock Text="{Binding RecordingStatistics}" Style="{StaticResource OperatorLabel}" DockPanel.Dock="Right" />
							</DockPanel>
							<TextBlock Text="Final file" Style="{StaticResource OperatorLabel}" />
							<TextBlock Text="{Binding RecordingFinalPath}" Style="{StaticResource OperatorValue}" TextWrapping="Wrap" Margin="0,4,0,0" />
							<TextBlock Text="{Binding RecordingError}" Foreground="{DynamicResource OperatorErrorBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
						</StackPanel>
					</Border>

					<Border Style="{StaticResource OperatorPanel}" Margin="0,0,0,14"
						Visibility="{Binding Shell.AIVisibility, RelativeSource={RelativeSource AncestorType={x:Type Window}}}">
						<StackPanel>
							<DockPanel Margin="0,0,0,12">
								<TextBlock Text="AI / PERSON SEGMENTATION" Style="{StaticResource OperatorSectionTitle}" />
								<Border Style="{StaticResource OperatorStatusBadge}" DockPanel.Dock="Right">
									<TextBlock Text="{Binding AIStatus}" FontWeight="Bold" />
								</Border>
							</DockPanel>
							<TextBlock Text="{Binding AIFeature}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />
							<DockPanel Margin="0,0,0,6"><TextBlock Text="Enabled" Style="{StaticResource OperatorLabel}" /><TextBlock Text="{Binding AIEnabled}" Style="{StaticResource OperatorValue}" DockPanel.Dock="Right" /></DockPanel>
							<DockPanel Margin="0,0,0,6"><TextBlock Text="Provider" Style="{StaticResource OperatorLabel}" /><TextBlock Text="{Binding AIProvider}" Style="{StaticResource OperatorValue}" DockPanel.Dock="Right" TextTrimming="CharacterEllipsis" MaxWidth="230" /></DockPanel>
							<DockPanel Margin="0,0,0,6"><TextBlock Text="Inference Time" Style="{StaticResource OperatorLabel}" /><TextBlock Text="{Binding AIInferenceTime}" Style="{StaticResource OperatorTimecode}" DockPanel.Dock="Right" /></DockPanel>
							<DockPanel Margin="0,0,0,6"><TextBlock Text="Person Regions" Style="{StaticResource OperatorLabel}" /><TextBlock Text="{Binding AIPersonRegions}" Style="{StaticResource OperatorValue}" FontWeight="SemiBold" DockPanel.Dock="Right" /></DockPanel>
							<DockPanel Margin="0,0,0,6"><TextBlock Text="Confidence" Style="{StaticResource OperatorLabel}" /><TextBlock Text="{Binding AIConfidence}" Style="{StaticResource OperatorValue}" DockPanel.Dock="Right" /></DockPanel>
							<DockPanel Margin="0,0,0,10"><TextBlock Text="Synchronization" Style="{StaticResource OperatorLabel}" /><TextBlock Text="{Binding AISynchronization}" Style="{StaticResource OperatorLabel}" DockPanel.Dock="Right" /></DockPanel>
							<Grid>
								<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="6" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
								<controls:RtaimeButton Grid.Column="0" Content="AI ON" Command="{Binding EnableAIShowcaseCommand}" Background="{DynamicResource OperatorAccentSurfaceBrush}" BorderBrush="{DynamicResource OperatorAccentBrush}" ToolTip="Enable the governed Person Segmentation Highlight through AIHost." />
								<controls:RtaimeButton Grid.Column="2" Content="AI OFF" Command="{Binding DisableAIShowcaseCommand}"  ToolTip="Disable the AI showcase effect without interrupting Program." />
							</Grid>
							<TextBlock Text="{Binding AIError}" Foreground="{DynamicResource OperatorWarningBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
							<TextBlock Text="Inference executes in AIHost. RuntimeHost applies only synchronized segmentation results; failure falls back to clean Program." Style="{StaticResource OperatorLabel}" TextWrapping="Wrap" Margin="0,8,0,0" />
						</StackPanel>
					</Border>

					<Border Style="{StaticResource OperatorPanel}"
						Visibility="{Binding Shell.OperatorStateVisibility, RelativeSource={RelativeSource AncestorType={x:Type Window}}}">
						<StackPanel>
							<TextBlock Text="OPERATOR STATE" Style="{StaticResource OperatorSectionTitle}" Margin="0,0,0,12" />
							<DockPanel Margin="0,0,0,8"><TextBlock Text="Command" Style="{StaticResource OperatorLabel}" /><TextBlock Text="{Binding CommandStatus}" Style="{StaticResource OperatorValue}" FontWeight="SemiBold" DockPanel.Dock="Right" /></DockPanel>
														<DockPanel Margin="0,0,0,8"><TextBlock Text="Commit" Style="{StaticResource OperatorLabel}" /><TextBlock Text="{Binding CommitStatus}" Style="{StaticResource OperatorValue}" DockPanel.Dock="Right" /></DockPanel>
														<DockPanel Margin="0,0,0,8"><TextBlock Text="Transition" Style="{StaticResource OperatorLabel}" /><TextBlock Text="{Binding TransitionStatus}" Style="{StaticResource OperatorValue}" DockPanel.Dock="Right" /></DockPanel>
							<TextBlock Text="{Binding LastEvent}" Style="{StaticResource OperatorLabel}" TextWrapping="Wrap" />
						</StackPanel>
					</Border>
				</StackPanel>
			</Grid>
						</controls:RtaimeScrollViewer>
			</Grid>
			<controls:RtaimeSplitter Grid.Column="3" IsEnabled="{Binding Shell.WorkspacePanelResizeEnabled, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Style="{StaticResource RtaimeVerticalSplitter}" DragCompleted="OnLayoutSplitterDragCompleted" ToolTip="Resize Media / tool panel. Use arrow keys while focused." AutomationProperties.Name="Resize left workspace panel" />
			<Grid Grid.RowSpan="2" Grid.Column="6">
				<local:OperatorInspectorControl
					x:Name="RightInspectorRegion"
					Visibility="{Binding Shell.InspectorVisibility, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
					Inspector="{Binding MediaPool, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
					ControlState="{Binding}"
					MediaDeck="{Binding MediaDeck, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
					QuickControls="{Binding QuickControls, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
					CollapseCommand="{Binding Shell.ToggleRightPanelCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
				<local:LiveControlsControl
					Visibility="{Binding Shell.LiveControlsVisibility, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
			</Grid>
		<controls:RtaimeSplitter Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="3" Height="{Binding Shell.LowerSplitterHeight, ElementName=RootWindow}" VerticalAlignment="Top" Panel.ZIndex="5" ResizeBehavior="PreviousAndCurrent" Visibility="{Binding Shell.TimelineRegionVisibility, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Style="{StaticResource RtaimeHorizontalSplitter}" DragCompleted="OnLayoutSplitterDragCompleted" ToolTip="Resize timeline / lower workspace. Use arrow keys while focused." AutomationProperties.Name="Resize lower workspace panel" />
		<Border x:Name="LowerTimelineRegion"
			Grid.Row="1"
			Grid.Column="2"
			Grid.ColumnSpan="3"
			Style="{StaticResource OperatorShellRegion}"
			Padding="0"
			CornerRadius="0"
			Margin="0"
			ClipToBounds="True"
			Visibility="{Binding Shell.TimelineRegionVisibility, RelativeSource={RelativeSource AncestorType={x:Type Window}}}">
			<local:MediaTimelineControl
				AllowDrop="True"
				DragOver="OnTimelineDragOver"
				Drop="OnTimelineDrop"
				DataContext="{Binding Timeline, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
		</Border>

		<Border x:Name="BottomTransportRegion"
			Grid.Row="1"
			Grid.Column="2"
			Grid.ColumnSpan="3"
			Visibility="Collapsed"
			IsHitTestVisible="False" />
		</Grid>

		<Border x:Name="StartupOverlay"
			Grid.RowSpan="2"
			Panel.ZIndex="100"
			Background="{DynamicResource OperatorSurfaceBrush}"
			BorderBrush="{DynamicResource OperatorBorderBrush}"
			BorderThickness="1">
			<Border.Style>
				<Style TargetType="Border">
					<Setter Property="Visibility" Value="Visible" />
					<Style.Triggers>
						<DataTrigger Binding="{Binding StartupComplete}" Value="True">
							<Setter Property="Visibility" Value="Collapsed" />
						</DataTrigger>
					</Style.Triggers>
				</Style>
			</Border.Style>
			<Grid MaxWidth="820"
				HorizontalAlignment="Center"
				VerticalAlignment="Center"
				Margin="36">
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>

				<StackPanel>
					<Border x:Name="StartupBrandPulse"
						Background="Transparent"
						HorizontalAlignment="Center">
						<ContentControl ContentTemplate="{StaticResource RtaimeBrandHeroLockupTemplate}" />
					</Border>
					<TextBlock
						Text="Production-grade real-time AI media platform."
						Style="{StaticResource OperatorLabel}"
						HorizontalAlignment="Center"
						Margin="0,10,0,20" />
					<TextBlock
						Text="{Binding Startup.ActiveStageName, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
						FontSize="18"
						FontWeight="SemiBold"
						TextAlignment="Center"
						HorizontalAlignment="Center" />
					<TextBlock
						Text="{Binding Startup.Summary, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
						Style="{StaticResource OperatorLabel}"
						TextAlignment="Center"
						TextWrapping="Wrap"
						MaxWidth="690"
						Margin="0,5,0,18" />
				</StackPanel>

				<controls:RtaimeListBox
					Grid.Row="1"
					ItemsSource="{Binding Startup.Stages, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
					Background="Transparent"
					BorderThickness="0"
					IsHitTestVisible="False"
					Focusable="False"
					ScrollViewer.HorizontalScrollBarVisibility="Disabled"
					ScrollViewer.VerticalScrollBarVisibility="Auto"
					MaxHeight="390"
					AutomationProperties.Name="Application startup lifecycle">
					<controls:RtaimeListBox.ItemTemplate>
						<DataTemplate>
							<Border Padding="10,8"
								Margin="0,0,0,5"
								BorderThickness="1">
								<Border.Style>
									<Style TargetType="Border">
										<Setter Property="BorderBrush" Value="{DynamicResource OperatorBorderBrush}" />
										<Setter Property="Background" Value="{DynamicResource OperatorBackgroundBrush}" />
										<Style.Triggers>
											<DataTrigger Binding="{Binding IsActive}" Value="True">
												<Setter Property="BorderBrush" Value="{DynamicResource OperatorAccentBrush}" />
												<Setter Property="Background" Value="{DynamicResource OperatorAccentSurfaceBrush}" />
											</DataTrigger>
										</Style.Triggers>
									</Style>
								</Border.Style>
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="112" />
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="150" />
									</Grid.ColumnDefinitions>
									<Grid.RowDefinitions>
										<RowDefinition Height="Auto" />
										<RowDefinition Height="Auto" />
										<RowDefinition Height="Auto" />
									</Grid.RowDefinitions>
									<Border
										Grid.RowSpan="2"
										Style="{StaticResource OperatorLifecycleBadge}"
										Tag="{Binding Status}"
										HorizontalAlignment="Left"
										VerticalAlignment="Center"
										MinWidth="92">
										<TextBlock Text="{Binding Status}" FontSize="10" FontWeight="Bold" TextAlignment="Center" />
									</Border>
									<TextBlock
										Grid.Column="1"
										Text="{Binding DisplayName}"
										FontWeight="SemiBold"
										FontSize="13" />
									<TextBlock
										Grid.Column="2"
										Text="{Binding StatusSummary}"
										Style="{StaticResource OperatorLabel}"
										HorizontalAlignment="Right" />
									<TextBlock
										Grid.Row="1"
										Grid.Column="1"
										Grid.ColumnSpan="2"
										Text="{Binding StatusText}"
										Style="{StaticResource OperatorLabel}"
										TextWrapping="Wrap"
										Margin="0,2,0,0" />
									<StackPanel
										Grid.Row="2"
										Grid.Column="1"
										Grid.ColumnSpan="2"
										Margin="0,5,0,0">
										<StackPanel.Style>
											<Style TargetType="StackPanel">
												<Setter Property="Visibility" Value="Collapsed" />
												<Style.Triggers>
													<DataTrigger
														Binding="{Binding Startup.DetailsVisible, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
														Value="True">
														<Setter Property="Visibility" Value="Visible" />
													</DataTrigger>
												</Style.Triggers>
											</Style>
										</StackPanel.Style>
										<TextBlock Text="{Binding TechnicalDetail}" Style="{StaticResource OperatorLabel}" FontSize="9" TextWrapping="Wrap" />
										<TextBlock Text="{Binding FailureReason}" Foreground="{DynamicResource OperatorErrorBrush}" FontSize="10" TextWrapping="Wrap" />
									</StackPanel>
								</Grid>
							</Border>
						</DataTemplate>
					</controls:RtaimeListBox.ItemTemplate>
				</controls:RtaimeListBox>

				<Grid Grid.Row="2" Margin="0,12,0,0">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>
					<controls:RtaimeButton
						Grid.Column="0"
						Content="{Binding Startup.DetailsAction, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
						Command="{Binding Startup.ToggleDetailsCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
						MinHeight="28"
						Padding="10,3"
						AutomationProperties.Name="Toggle startup technical details" />
					<StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
						<TextBlock Text="Observed " Style="{StaticResource OperatorLabel}" />
						<TextBlock
							Text="{Binding Startup.ObservedAt, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
							Style="{StaticResource OperatorLabel}" />
					</StackPanel>
				</Grid>

				<Border Grid.Row="3" Margin="0,8,0,0" Padding="10,8" BorderThickness="1" BorderBrush="{DynamicResource OperatorBorderBrush}">
					<Border.Style>
						<Style TargetType="Border">
							<Setter Property="Visibility" Value="Collapsed" />
							<Style.Triggers>
								<DataTrigger
									Binding="{Binding Startup.DetailsVisible, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
									Value="True">
									<Setter Property="Visibility" Value="Visible" />
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</Border.Style>
					<StackPanel>
						<TextBlock Text="APPHOST LIFECYCLE EVIDENCE" Style="{StaticResource OperatorSectionTitle}" Margin="0,0,0,4" />
						<TextBlock
							Text="{Binding Startup.EvidencePath, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
							Style="{StaticResource OperatorLabel}"
							TextWrapping="Wrap" />
						<TextBlock
							Text="Visible startup states are projections of AppHost and qualified host readiness. No synthetic percentage progress is generated."
							Style="{StaticResource OperatorLabel}"
							TextWrapping="Wrap"
							Margin="0,5,0,0" />
					</StackPanel>
				</Border>
			</Grid>
		</Border>
	</Grid>
</Window>
