<Window x:Class="rtaime.Operator.MainWindow"
	x:Name="RootWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="clr-namespace:rtaime.Operator"
	Title="rtaime Operator"
	Width="1600"
	Height="900"
	MinWidth="1100"
	MinHeight="640"
	Background="{DynamicResource OperatorBackgroundBrush}"
	Foreground="{DynamicResource OperatorTextBrush}"
	FontFamily="{StaticResource OperatorFontFamily}"
	UseLayoutRounding="True"
	SnapsToDevicePixels="True"
	TextOptions.TextFormattingMode="Display"
	TextOptions.TextRenderingMode="ClearType"
	KeyboardNavigation.TabNavigation="Cycle"
	KeyboardNavigation.ControlTabNavigation="Cycle"
	WindowStartupLocation="CenterScreen">

	<Grid Margin="{StaticResource OperatorWindowPadding}">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="{Binding Shell.LowerSplitterHeight, ElementName=RootWindow}" />
			<RowDefinition Height="{Binding Shell.LowerRowHeight, ElementName=RootWindow, Mode=TwoWay}" MinHeight="0" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<Border x:Name="TopBar" Grid.Row="0" Style="{StaticResource OperatorTopBar}" Margin="0,0,0,6">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>
				<StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
					<TextBlock Text="rtaime" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" />
					<TextBlock Text="  |  V1 Production" Style="{StaticResource OperatorLabel}" VerticalAlignment="Center" />
				</StackPanel>
				<StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
					<Border Style="{StaticResource OperatorLifecycleBadge}" Tag="{Binding EngineLifecycleState}" ToolTip="{Binding EngineLifecycleDetail}" AutomationProperties.Name="Engine lifecycle status">
						<StackPanel Orientation="Horizontal"><TextBlock Text="ENGINE " FontWeight="SemiBold" /><TextBlock Text="{Binding EngineLifecycleState}" FontWeight="Bold" /></StackPanel>
					</Border>
					<Border Style="{StaticResource OperatorStatusBadge}" Margin="6,0,0,0"><TextBlock Text="{Binding ConnectionState}" FontWeight="Bold" /></Border>
				</StackPanel>
				<StackPanel Grid.Column="2" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
					<TextBlock Text="TC " Style="{StaticResource OperatorLabel}" VerticalAlignment="Center" />
					<TextBlock Text="{Binding MediaDeck.Current, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Style="{StaticResource OperatorTimecode}" VerticalAlignment="Center" />
				</StackPanel>
				<StackPanel Grid.Column="3" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
					<TextBlock Text="{Binding CurrentFormat}" Style="{StaticResource OperatorValue}" VerticalAlignment="Center" />
					<Border Style="{StaticResource OperatorStatusBadge}" Margin="10,0,0,0"><StackPanel Orientation="Horizontal"><TextBlock Text="REC " FontWeight="SemiBold" /><TextBlock Text="{Binding RecordingStatus}" FontWeight="Bold" /></StackPanel></Border>
				</StackPanel>
				<StackPanel Grid.Column="4" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
					<Button Content="Open Demo Production" Command="{Binding DemoProduction.OpenCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Style="{StaticResource OperatorProgramButton}" MinHeight="28" Padding="8,3" Margin="0,0,6,0" ToolTip="Prepare the deterministic showcase state. Preview remains under operator TAKE control." AutomationProperties.Name="Open Demo Production" />
					<Button x:Name="SynchronizeButton" Content="SYNC  F5" Command="{Binding SynchronizeCommand}" Style="{StaticResource OperatorAccentButton}" MinHeight="28" Padding="8,3" ToolTip="Synchronize authoritative ControlHost state (F5)." AutomationProperties.Name="Synchronize authoritative state" />
				</StackPanel>
				<StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="14,0">
					<Border Style="{StaticResource OperatorStatusBadge}" Margin="0,0,6,0">
						<TextBlock Text="{Binding Shell.WorkspaceTitle, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" FontWeight="Bold" />
					</Border>
					<Button Content="LIVE" Command="{Binding Shell.SelectWorkspaceCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" CommandParameter="LIVE" Style="{StaticResource OperatorButton}" MinHeight="28" Padding="7,3" Margin="0,0,3,0" ToolTip="Live operation workspace" />
					<Button Content="EDIT" Command="{Binding Shell.SelectWorkspaceCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" CommandParameter="EDIT" Style="{StaticResource OperatorButton}" MinHeight="28" Padding="7,3" Margin="0,0,3,0" ToolTip="Timeline-focused editing workspace" />
					<Button Content="MEDIA" Command="{Binding Shell.SelectWorkspaceCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" CommandParameter="MEDIA" Style="{StaticResource OperatorButton}" MinHeight="28" Padding="7,3" Margin="0,0,3,0" ToolTip="Media preparation workspace" />
					<Button Content="GRAPHICS" Command="{Binding Shell.SelectWorkspaceCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" CommandParameter="GRAPHICS" Style="{StaticResource OperatorButton}" MinHeight="28" Padding="7,3" Margin="0,0,3,0" ToolTip="Graphics composition workspace" />
					<Button Content="SYSTEM" Command="{Binding Shell.SelectWorkspaceCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" CommandParameter="SYSTEM" Style="{StaticResource OperatorButton}" MinHeight="28" Padding="7,3" ToolTip="Operational status workspace" />
				</StackPanel>
				<StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
					<Button Content="TOOLS" Command="{Binding Shell.ToggleLeftPanelCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Style="{StaticResource OperatorButton}" MinHeight="28" Padding="8,3" Margin="0,0,5,0" />
					<Button Content="INSPECTOR" Command="{Binding Shell.ToggleRightPanelCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Style="{StaticResource OperatorButton}" MinHeight="28" Padding="8,3" Margin="0,0,5,0" />
					<Button Content="{Binding Shell.CenterModeLabel, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Command="{Binding Shell.ToggleCenterMaximizeCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Style="{StaticResource OperatorButton}" MinHeight="28" Padding="8,3" Margin="0,0,5,0" />
					<Button Content="{Binding Shell.FullscreenLabel, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Command="{Binding Shell.ToggleFullscreenCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Style="{StaticResource OperatorButton}" MinHeight="28" Padding="8,3" Margin="0,0,5,0" />
					<Button Content="SAVE LAYOUT" Command="{Binding Shell.SaveLayoutCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Style="{StaticResource OperatorButton}" MinHeight="28" Padding="8,3" Margin="0,0,5,0" ToolTip="Save presentation layout for the active workspace." />
					<Button Content="LAYOUT RESET" Command="{Binding Shell.ResetLayoutCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Style="{StaticResource OperatorButton}" MinHeight="28" Padding="8,3" Margin="0,0,5,0" ToolTip="Restore the canonical layout for the active workspace." />
					<Button Content="HELP" Click="OnHelpClick" Style="{StaticResource OperatorButton}" MinHeight="28" Padding="8,3" />
				</StackPanel>
			</Grid>
		</Border>

		<Grid Grid.Row="1" ClipToBounds="True">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="{Binding Shell.LeftColumnWidth, ElementName=RootWindow, Mode=TwoWay}" MinWidth="0" />
				<ColumnDefinition Width="{Binding Shell.LeftSplitterWidth, ElementName=RootWindow}" />
				<ColumnDefinition Width="*" MinWidth="420" />
				<ColumnDefinition Width="{Binding Shell.RightSplitterWidth, ElementName=RootWindow}" />
				<ColumnDefinition Width="{Binding Shell.RightColumnWidth, ElementName=RootWindow, Mode=TwoWay}" MinWidth="0" />
			</Grid.ColumnDefinitions>

			<Border x:Name="LeftToolRegion" Grid.Column="0" Style="{StaticResource OperatorShellRegion}" Margin="0,0,6,0"
				Visibility="{Binding Shell.LeftRegionVisibility, RelativeSource={RelativeSource AncestorType={x:Type Window}}}">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>

					<DockPanel Margin="0,0,0,10">
						<TextBlock Text="MEDIA" Style="{StaticResource OperatorSectionTitle}" />
						<Button Content="‹" Command="{Binding Shell.ToggleLeftPanelCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Style="{StaticResource OperatorButton}" MinWidth="30" MinHeight="26" Padding="6,2" DockPanel.Dock="Right" ToolTip="Collapse Media Pool" />
					</DockPanel>

					<StackPanel Grid.Row="1" Margin="0,0,0,8">
						<Grid Margin="0,0,0,6">
							<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="6" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
							<TextBox Grid.Column="0"
								Text="{Binding MediaPool.SearchText, RelativeSource={RelativeSource AncestorType={x:Type Window}}, UpdateSourceTrigger=PropertyChanged}"
								Style="{StaticResource OperatorTextBox}"
								ToolTip="Search loaded resource metadata"
								AutomationProperties.Name="Media Pool search" />
							<Button Grid.Column="2"
								Content="+ IMPORT"
								Command="{Binding MediaPool.ImportCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
								Style="{StaticResource OperatorAccentButton}"
								Padding="8,3"
								ToolTip="Open local media through the existing Media Deck import path." />
						</Grid>
						<Grid>
							<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="6" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
							<ComboBox Grid.Column="0"
								ItemsSource="{Binding MediaPool.Categories, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
								SelectedItem="{Binding MediaPool.SelectedCategory, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Mode=TwoWay}"
								ToolTip="Resource category" />
							<ComboBox Grid.Column="2"
								ItemsSource="{Binding MediaPool.Filters, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
								SelectedItem="{Binding MediaPool.SelectedFilter, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Mode=TwoWay}"
								ToolTip="Resource state/type filter" />
						</Grid>
						<StackPanel Orientation="Horizontal" Margin="0,6,0,0">
							<Button Content="GRID"
								Command="{Binding MediaPool.GridViewCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
								Style="{StaticResource OperatorButton}" MinHeight="26" Padding="8,2" Margin="0,0,5,0" />
							<Button Content="LIST"
								Command="{Binding MediaPool.ListViewCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
								Style="{StaticResource OperatorButton}" MinHeight="26" Padding="8,2" />
							<TextBlock Text="{Binding MediaPool.ViewModeLabel, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
								Style="{StaticResource OperatorLabel}" VerticalAlignment="Center" Margin="10,0,0,0" />
						</StackPanel>
					</StackPanel>

					<Grid Grid.Row="2">
						<ListBox ItemsSource="{Binding MediaPool.FilteredItems, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
							SelectedItem="{Binding MediaPool.SelectedItem, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Mode=TwoWay}"
							ItemContainerStyle="{StaticResource OperatorSourceItem}"
							PreviewMouseLeftButtonDown="OnMediaPoolPreviewMouseLeftButtonDown"
							PreviewMouseMove="OnMediaPoolPreviewMouseMove"
							AutomationProperties.Name="Media Pool grid">
							<ListBox.Style>
								<Style TargetType="{x:Type ListBox}" BasedOn="{StaticResource OperatorSourceBank}">
									<Setter Property="Visibility" Value="Collapsed" />
									<Style.Triggers>
										<DataTrigger Binding="{Binding MediaPool.IsGridView, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="True">
											<Setter Property="Visibility" Value="Visible" />
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</ListBox.Style>
							<ListBox.ItemsPanel>
								<ItemsPanelTemplate><WrapPanel IsItemsHost="True" /></ItemsPanelTemplate>
							</ListBox.ItemsPanel>
							<ListBox.ItemTemplate>
								<DataTemplate>
									<Border Width="142" MinHeight="118" Padding="7" Margin="0,0,6,6" BorderThickness="1" BorderBrush="{DynamicResource OperatorBorderBrush}">
										<StackPanel>
											<Border Height="52" Background="{DynamicResource OperatorBackgroundBrush}" Margin="0,0,0,5">
												<Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
											</Border>
											<DockPanel>
												<TextBlock Text="{Binding Category}" Style="{StaticResource OperatorLabel}" />
												<TextBlock Text="{Binding State}" Style="{StaticResource OperatorLabel}" DockPanel.Dock="Right" TextTrimming="CharacterEllipsis" MaxWidth="68" />
											</DockPanel>
											<TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="0,5,0,3" TextTrimming="CharacterEllipsis" />
											<TextBlock Text="{Binding Detail}" Style="{StaticResource OperatorLabel}" TextTrimming="CharacterEllipsis" />
											<TextBlock Text="{Binding Format}" Style="{StaticResource OperatorLabel}" TextTrimming="CharacterEllipsis" />
										</StackPanel>
									</Border>
								</DataTemplate>
							</ListBox.ItemTemplate>
						</ListBox>

						<ListBox ItemsSource="{Binding MediaPool.FilteredItems, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
							SelectedItem="{Binding MediaPool.SelectedItem, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Mode=TwoWay}"
							ItemContainerStyle="{StaticResource OperatorSourceItem}"
							PreviewMouseLeftButtonDown="OnMediaPoolPreviewMouseLeftButtonDown"
							PreviewMouseMove="OnMediaPoolPreviewMouseMove"
							AutomationProperties.Name="Media Pool list">
							<ListBox.Style>
								<Style TargetType="{x:Type ListBox}" BasedOn="{StaticResource OperatorSourceBank}">
									<Setter Property="Visibility" Value="Visible" />
									<Style.Triggers>
										<DataTrigger Binding="{Binding MediaPool.IsGridView, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="True">
											<Setter Property="Visibility" Value="Collapsed" />
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</ListBox.Style>
							<ListBox.ItemTemplate>
								<DataTemplate>
									<Grid Margin="2">
										<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
										<StackPanel>
											<TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
											<TextBlock Text="{Binding Detail}" Style="{StaticResource OperatorLabel}" TextTrimming="CharacterEllipsis" />
										</StackPanel>
										<StackPanel Grid.Column="1" HorizontalAlignment="Right">
											<TextBlock Text="{Binding Category}" Style="{StaticResource OperatorLabel}" HorizontalAlignment="Right" />
											<TextBlock Text="{Binding State}" Style="{StaticResource OperatorLabel}" HorizontalAlignment="Right" />
										</StackPanel>
									</Grid>
								</DataTemplate>
							</ListBox.ItemTemplate>
						</ListBox>

						<TextBlock Text="{Binding MediaPool.EmptyState, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
							TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12">
							<TextBlock.Style>
								<Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource OperatorLabel}">
									<Setter Property="Visibility" Value="Visible" />
									<Style.Triggers>
										<DataTrigger Binding="{Binding MediaPool.HasItems, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="True">
											<Setter Property="Visibility" Value="Collapsed" />
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</TextBlock.Style>
						</TextBlock>
					</Grid>

					<TextBlock Grid.Row="3"
						Text="Selection, search and filtering are Operator UI context only. Production changes still require existing commands and confirmed state."
						Style="{StaticResource OperatorLabel}" TextWrapping="Wrap" Margin="0,8,0,0" />
				</Grid>
			</Border>
			<GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="{DynamicResource OperatorBorderBrush}" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" DragCompleted="OnLayoutSplitterDragCompleted" />

			<ScrollViewer x:Name="CenterWorkspace" Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="2.2*" MinWidth="610" />
					<ColumnDefinition Width="14" />
					<ColumnDefinition Width="1*" MinWidth="300" />
				</Grid.ColumnDefinitions>

				<StackPanel Grid.Column="0">
					<Border Style="{StaticResource OperatorPanel}" Margin="0,0,0,10"
						Visibility="{Binding Shell.MultiviewVisibility, RelativeSource={RelativeSource AncestorType={x:Type Window}}}">
						<StackPanel>
							<DockPanel Margin="0,0,0,8">
								<TextBlock Text="MULTIVIEW" Style="{StaticResource OperatorSectionTitle}" />
								<StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
									<Button Content="CLEAN PROGRAM" Command="{Binding ProgramOutput.StartCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Style="{StaticResource OperatorProgramButton}" MinHeight="26" Padding="8,2" Margin="0,0,5,0" ToolTip="Open clean Program monitoring on the selected display. This does not change physical Program output." />
									<Button Content="{Binding ProgramOutput.FullscreenAction, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Command="{Binding ProgramOutput.ToggleFullscreenCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Style="{StaticResource OperatorButton}" MinHeight="26" Padding="8,2" />
								</StackPanel>
							</DockPanel>
							<local:OperatorMultiviewControl
								PreviewImage="{Binding Monitoring.PreviewImage, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
								ProgramImage="{Binding Monitoring.ProgramImage, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
								PreviewState="{Binding Monitoring.PreviewState, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
								ProgramState="{Binding Monitoring.ProgramState, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
								Sources="{Binding Sources}" />
						</StackPanel>
					</Border>

					<Border Style="{StaticResource OperatorPanel}" Margin="0,0,0,10"
						Visibility="{Binding Shell.QuickControlsVisibility, RelativeSource={RelativeSource AncestorType={x:Type Window}}}">
						<StackPanel>
							<DockPanel Margin="0,0,0,8">
								<TextBlock Text="QUICK CONTROLS" Style="{StaticResource OperatorSectionTitle}" />
								<Button Content="CLEAR PINS" Command="{Binding QuickControls.ClearPinsCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Style="{StaticResource OperatorButton}" MinHeight="26" Padding="8,2" DockPanel.Dock="Right" />
							</DockPanel>
							<ItemsControl ItemsSource="{Binding QuickControls.Items, RelativeSource={RelativeSource AncestorType={x:Type Window}}}">
								<ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
								<ItemsControl.ItemTemplate>
									<DataTemplate>
										<Border Width="218" MinHeight="88" Padding="8" Margin="0,0,7,7" BorderThickness="1" BorderBrush="{DynamicResource OperatorBorderBrush}">
											<StackPanel>
												<DockPanel>
													<TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
													<Button Content="×" Command="{Binding RemoveCommand}" Style="{StaticResource OperatorButton}" MinWidth="25" MinHeight="22" Padding="3,0" DockPanel.Dock="Right" ToolTip="Remove Quick Control" />
												</DockPanel>
												<DockPanel Margin="0,5,0,6">
													<TextBlock Text="{Binding State}" Style="{StaticResource OperatorLabel}" />
													<TextBlock Text="{Binding Value}" Style="{StaticResource OperatorValue}" FontWeight="Bold" DockPanel.Dock="Right" />
												</DockPanel>
												<Grid>
													<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="5" /><ColumnDefinition Width="*" /><ColumnDefinition Width="5" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
													<Button Grid.Column="0" Content="−" Command="{Binding DecreaseCommand}" Style="{StaticResource OperatorButton}">
														<Button.Style><Style TargetType="Button" BasedOn="{StaticResource OperatorButton}"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding HasDecrease}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Button.Style>
													</Button>
													<Button Grid.Column="2" Content="{Binding ActionLabel}" Command="{Binding PrimaryCommand}" Style="{StaticResource OperatorAccentButton}">
														<Button.Style><Style TargetType="Button" BasedOn="{StaticResource OperatorAccentButton}"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding HasPrimary}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Button.Style>
													</Button>
													<Button Grid.Column="4" Content="+" Command="{Binding IncreaseCommand}" Style="{StaticResource OperatorButton}">
														<Button.Style><Style TargetType="Button" BasedOn="{StaticResource OperatorButton}"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding HasIncrease}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Button.Style>
													</Button>
												</Grid>
											</StackPanel>
										</Border>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
							<TextBlock Text="{Binding QuickControls.Status, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Style="{StaticResource OperatorLabel}" TextWrapping="Wrap" />
						</StackPanel>
					</Border>

					<Grid Margin="0,0,0,10"
						Visibility="{Binding Shell.StandardViewerVisibility, RelativeSource={RelativeSource AncestorType={x:Type Window}}}">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="{Binding Shell.PreviewViewerWidth, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
							<ColumnDefinition Width="{Binding Shell.ViewerGapWidth, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
							<ColumnDefinition Width="{Binding Shell.ProgramViewerWidth, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
						</Grid.ColumnDefinitions>

						<local:PreviewViewer Grid.Column="0"
							AllowDrop="True"
							DragOver="OnPreviewDragOver"
							Drop="OnPreviewDrop"
							Visibility="{Binding Shell.PreviewViewerVisibility, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
							Frame="{Binding Monitoring.PreviewImage, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
							SourceName="{Binding PreviewSourceName}"
							SourceId="{Binding PreviewSourceId}"
							Format="{Binding Monitoring.PreviewFormat, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
							State="{Binding Monitoring.PreviewState, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
							MaximizeCommand="{Binding Shell.MaximizePreviewCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />

						<local:ProgramViewer Grid.Column="2"
							Visibility="{Binding Shell.ProgramViewerVisibility, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
							Frame="{Binding Monitoring.ProgramImage, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
							SourceName="{Binding ProgramSourceName}"
							SourceId="{Binding ProgramSourceId}"
							Format="{Binding Monitoring.ProgramFormat, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
							State="{Binding Monitoring.ProgramState, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
							OutputState="{Binding ProgramOutput.ViewerOutputState, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
							RecordingStatus="{Binding RecordingStatus}"
							CommitStatus="{Binding CommitStatus}"
							TransitionStatus="{Binding TransitionStatus}"
							AudioLeftPeak="{Binding AudioLeftPeak, Mode=OneWay}"
							AudioRightPeak="{Binding AudioRightPeak, Mode=OneWay}"
							AudioLeftDb="{Binding AudioLeftDb}"
							AudioRightDb="{Binding AudioRightDb}"
							Clipping="{Binding AudioClipping}"
							MaximizeCommand="{Binding Shell.MaximizeProgramCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
					</Grid>

					<Border Style="{StaticResource OperatorPanel}" Margin="0,0,0,14"
						Visibility="{Binding Shell.ProductionControlsVisibility, RelativeSource={RelativeSource AncestorType={x:Type Window}}}">
						<StackPanel>
							<DockPanel Margin="0,0,0,10">
								<StackPanel Orientation="Horizontal">
									<TextBlock Text="PRODUCTION CONTROLS" Style="{StaticResource OperatorSectionTitle}" VerticalAlignment="Center" />
									<Border Style="{StaticResource OperatorStatusBadge}" Margin="10,0,0,0">
										<TextBlock Text="{Binding Shell.ViewerModeLabel, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" FontWeight="SemiBold" />
									</Border>
								</StackPanel>
								<Button Content="DUAL VIEW  Ctrl+0"
									Command="{Binding Shell.RestoreViewersCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
									Style="{StaticResource OperatorButton}"
									MinHeight="28"
									Padding="8,3"
									DockPanel.Dock="Right"
									ToolTip="Restore Preview and Program side by side." />
							</DockPanel>

							<Grid Margin="0,0,0,10">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="12" />
									<ColumnDefinition Width="*" />
								</Grid.ColumnDefinitions>
								<StackPanel>
									<TextBlock Text="SELECTED SOURCE" Style="{StaticResource OperatorLabel}" />
									<TextBlock Text="{Binding SelectedSource.Name, TargetNullValue=No source selected}" FontSize="17" FontWeight="SemiBold" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
								</StackPanel>
								<Border Grid.Column="2" Style="{StaticResource OperatorPreviewTally}">
									<StackPanel>
										<TextBlock Text="CONFIRMED PREVIEW / NEXT TAKE" Style="{StaticResource OperatorLabel}" Foreground="{DynamicResource OperatorPreviewBrush}" />
										<TextBlock Text="{Binding PreviewSourceName}" FontSize="17" FontWeight="SemiBold" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
									</StackPanel>
								</Border>
							</Grid>

							<Grid Margin="0,0,0,10">
