							<DockPanel Margin="0,0,0,6"><TextBlock Text="Uptime" Style="{StaticResource OperatorLabel}" /><TextBlock Text="{Binding Uptime}" Style="{StaticResource OperatorTimecode}" DockPanel.Dock="Right" /></DockPanel>
