<Window x:Class="rtaime.Operator.MainWindow"
	x:Name="RootWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:rtaime.Operator.Controls"
	xmlns:local="clr-namespace:rtaime.Operator"
	Title="rtaime Operator"
	Icon="{StaticResource RtaimeBrandAppIconImage}"
	Width="1600"
	Height="900"
	MinWidth="960"
	MinHeight="500"
	Background="{DynamicResource OperatorBackgroundBrush}"
	Foreground="{DynamicResource OperatorTextBrush}"
	FontFamily="{StaticResource OperatorFontFamily}"
	UseLayoutRounding="True"
	SnapsToDevicePixels="True"
	TextOptions.TextFormattingMode="Display"
	TextOptions.TextRenderingMode="ClearType"
	KeyboardNavigation.TabNavigation="Cycle"
	KeyboardNavigation.ControlTabNavigation="Cycle"
	WindowStartupLocation="CenterScreen">

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="{StaticResource OperatorTopBarGridLength}" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<Border x:Name="TopBar"
			Grid.Row="0"
			Background="{DynamicResource OperatorTopBarBrush}"
			BorderBrush="{DynamicResource OperatorBorderBrush}"
			BorderThickness="0,0,0,1"
			SnapsToDevicePixels="True">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="105" />
					<ColumnDefinition Width="1" />
					<ColumnDefinition Width="185" />
					<ColumnDefinition Width="190" />
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="82" />
					<ColumnDefinition Width="82" />
					<ColumnDefinition Width="110" />
					<ColumnDefinition Width="100" />
					<ColumnDefinition Width="1" />
					<ColumnDefinition Width="120" />
					<ColumnDefinition Width="70" />
					<ColumnDefinition Width="140" />
					<ColumnDefinition Width="46" />
				</Grid.ColumnDefinitions>

				<StackPanel Grid.Column="0"
					Orientation="Horizontal"
					HorizontalAlignment="Center"
					VerticalAlignment="Center">
					<Image Source="{StaticResource RtaimeBrandEmblemImage}"
						Width="28"
						Height="28"
						Stretch="Uniform"
						Margin="0,0,5,0" />
					<TextBlock Text="rtaime"
						FontSize="{StaticResource OperatorFontSizeProduct}"
						FontWeight="SemiBold"
						VerticalAlignment="Center" />
				</StackPanel>
				<Border Grid.Column="1" Background="{DynamicResource OperatorBorderBrush}" Margin="0,12" />

				<controls:RtaimeButton Grid.Column="2"
					Command="{Binding DemoProduction.OpenCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
					Background="Transparent"
					BorderBrush="Transparent"
					HorizontalContentAlignment="Stretch"
					Padding="12,6"
					ToolTip="Prepare the deterministic showcase state. Preview remains under operator TAKE control."
					AutomationProperties.Name="Open Demo Production">
					<StackPanel>
						<TextBlock Text="V1 PRODUCTION" FontWeight="SemiBold" />
						<TextBlock Text="{Binding DemoProduction.State, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Style="{StaticResource OperatorLabel}" Margin="0,2,0,0" />
					</StackPanel>
				</controls:RtaimeButton>

				<controls:RtaimeButton x:Name="SynchronizeButton"
					Grid.Column="3"
					Command="{Binding SynchronizeCommand}"
					Background="Transparent"
					BorderBrush="Transparent"
					HorizontalContentAlignment="Stretch"
					Padding="12,6"
					ToolTip="{Binding EngineLifecycleDetail}"
					AutomationProperties.Name="Synchronize authoritative state">
					<StackPanel>
						<TextBlock Text="ENGINE" Style="{StaticResource OperatorLabel}" />
						<StackPanel Orientation="Horizontal" Margin="0,2,0,0">
							<TextBlock Text="{Binding EngineLifecycleState}" FontWeight="Bold" />
							<TextBlock Text=" · " Style="{StaticResource OperatorLabel}" />
							<TextBlock Text="{Binding ConnectionState}" Style="{StaticResource OperatorLabel}" />
						</StackPanel>
					</StackPanel>
				</controls:RtaimeButton>

				<controls:RtaimeGlobalStatusButton
					Grid.Column="4"
					State="{Binding GlobalReadinessState}"
					StatusText="{Binding GlobalReadinessLabel}"
					Detail="{Binding GlobalReadinessSummary}"
					Command="{Binding Shell.SelectWorkspaceCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
					CommandParameter="SETTINGS"
					ToolTip="{Binding GlobalReadinessTooltip}"
					HorizontalAlignment="Right"
					VerticalAlignment="Center"
					MinWidth="0"
					MaxWidth="360"
					Margin="6,0"
					AutomationProperties.Name="Global runtime readiness and diagnostics" />

				<Border Grid.Column="5" BorderBrush="{DynamicResource OperatorBorderBrush}" BorderThickness="1,0,0,0" Padding="10,6" ToolTip="{Binding CpuDeviceName}">
					<StackPanel VerticalAlignment="Center">
						<TextBlock Text="CPU" Style="{StaticResource OperatorLabel}" />
						<TextBlock Text="{Binding CpuUtilization}" FontWeight="SemiBold" />
					</StackPanel>
				</Border>
				<Border Grid.Column="6" BorderBrush="{DynamicResource OperatorBorderBrush}" BorderThickness="1,0,0,0" Padding="10,6" ToolTip="{Binding GpuDeviceName}">
					<StackPanel VerticalAlignment="Center">
						<TextBlock Text="GPU" Style="{StaticResource OperatorLabel}" />
						<TextBlock Text="{Binding GpuUtilization}" FontWeight="SemiBold" />
					</StackPanel>
				</Border>
				<Border Grid.Column="7" BorderBrush="{DynamicResource OperatorBorderBrush}" BorderThickness="1,0,0,0" Padding="10,6" ToolTip="{Binding SystemMemory}">
					<StackPanel VerticalAlignment="Center">
						<TextBlock Text="MEMORY" Style="{StaticResource OperatorLabel}" />
						<TextBlock Text="{Binding SystemMemory}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
					</StackPanel>
				</Border>
				<Border Grid.Column="8" BorderBrush="{DynamicResource OperatorBorderBrush}" BorderThickness="1,0,0,0" Padding="10,6" ToolTip="Runtime render latency. Engineering target: ≤3 ms; hardware P95 ceiling: 5 ms.">
					<StackPanel VerticalAlignment="Center">
						<TextBlock Text="LATENCY" Style="{StaticResource OperatorLabel}" />
						<TextBlock Text="{Binding FrameTime}" FontWeight="SemiBold" />
					</StackPanel>
				</Border>
				<Border Grid.Column="9" Background="{DynamicResource OperatorBorderBrush}" Margin="0,12" />
				<StackPanel Grid.Column="10" VerticalAlignment="Center" HorizontalAlignment="Center">
					<TextBlock Text="TIMECODE" Style="{StaticResource OperatorLabel}" HorizontalAlignment="Center" />
					<controls:RtaimeTimecode Content="{Binding MediaDeck.Current, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" FontSize="{StaticResource OperatorFontSizeLargeTimecode}" HorizontalContentAlignment="Center" />
				</StackPanel>
				<controls:RtaimeStatusBadge Grid.Column="11"
					Status="{x:Static controls:RtaimeStatusKind.Warning}"
					Margin="8,0"
					VerticalAlignment="Center"
					ToolTip="External transmission/on-air state is not authoritative in the current V1 contract.">
					<StackPanel HorizontalAlignment="Center">
						<TextBlock Text="LIVE" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" />
						<TextBlock Text="UNVERIFIED" FontSize="8" HorizontalAlignment="Center" />
					</StackPanel>
				</controls:RtaimeStatusBadge>
				<controls:RtaimeStatusBadge Grid.Column="12"
					Status="{x:Static controls:RtaimeStatusKind.Program}"
					Margin="8,0"
					VerticalAlignment="Center"
					ToolTip="{Binding ProgramSourceId}">
					<StackPanel Orientation="Horizontal">
						<TextBlock Text="PGM " FontWeight="Bold" />
						<TextBlock Text="{Binding ProgramSourceName}" TextTrimming="CharacterEllipsis" MaxWidth="125" />
					</StackPanel>
				</controls:RtaimeStatusBadge>
				<controls:RtaimeIconButton Grid.Column="13"
					IconData="{StaticResource RtaimeIconSettingsGeometry}"
					Command="{Binding Shell.SelectWorkspaceCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
					CommandParameter="SETTINGS"
					Width="30"
					Height="30"
					HorizontalAlignment="Center"
					VerticalAlignment="Center"
					ToolTip="Settings and system status"
					AutomationProperties.Name="Settings workspace" />
			</Grid>
		</Border>

		<Grid Grid.Row="1" ClipToBounds="True">
			<Grid.RowDefinitions>
				<RowDefinition Height="*" />
				<RowDefinition Height="{Binding Shell.LowerRowHeight, ElementName=RootWindow, Mode=TwoWay}" MinHeight="0" />
			</Grid.RowDefinitions>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="{Binding Shell.NavigationRailWidth, ElementName=RootWindow}" />
				<ColumnDefinition Width="{StaticResource OperatorRegionGapGridLength}" />
				<ColumnDefinition Width="{Binding Shell.LeftColumnWidth, ElementName=RootWindow, Mode=TwoWay}" MinWidth="0" />
				<ColumnDefinition Width="{Binding Shell.LeftSplitterWidth, ElementName=RootWindow}" />
				<ColumnDefinition Width="*" MinWidth="0" />
				<ColumnDefinition Width="{Binding Shell.RightSplitterWidth, ElementName=RootWindow}" />
				<ColumnDefinition Width="{Binding Shell.RightColumnWidth, ElementName=RootWindow, Mode=TwoWay}" MinWidth="0" />
			</Grid.ColumnDefinitions>

			<Border x:Name="WorkspaceNavigation" Grid.RowSpan="2" Grid.Column="0" Style="{StaticResource OperatorNavigationRail}" Padding="0" ClipToBounds="True">
				<DockPanel LastChildFill="False">
					<StackPanel DockPanel.Dock="Top">
						<controls:RtaimeNavigationItem
							Label="Media"
							IconData="{StaticResource RtaimeIconMediaGeometry}"
							Command="{Binding Shell.SelectWorkspaceCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
							CommandParameter="MEDIA"
							ToolTip="Media workspace">
							<controls:RtaimeNavigationItem.Style>
								<Style TargetType="{x:Type controls:RtaimeNavigationItem}" BasedOn="{StaticResource {x:Type controls:RtaimeNavigationItem}}">
									<Style.Triggers><DataTrigger Binding="{Binding Shell.SelectedWorkspace, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="MEDIA"><Setter Property="IsActive" Value="True" /></DataTrigger></Style.Triggers>
								</Style>
							</controls:RtaimeNavigationItem.Style>
						</controls:RtaimeNavigationItem>
						<controls:RtaimeNavigationItem Label="Edit" IconData="{StaticResource RtaimeIconTimelineGeometry}" Command="{Binding Shell.SelectWorkspaceCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" CommandParameter="EDIT" ToolTip="Edit workspace">
							<controls:RtaimeNavigationItem.Style><Style TargetType="{x:Type controls:RtaimeNavigationItem}" BasedOn="{StaticResource {x:Type controls:RtaimeNavigationItem}}"><Style.Triggers><DataTrigger Binding="{Binding Shell.SelectedWorkspace, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="EDIT"><Setter Property="IsActive" Value="True" /></DataTrigger></Style.Triggers></Style></controls:RtaimeNavigationItem.Style>
						</controls:RtaimeNavigationItem>
						<controls:RtaimeNavigationItem Label="Live" IconData="{StaticResource RtaimeIconLiveGeometry}" Command="{Binding Shell.SelectWorkspaceCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" CommandParameter="LIVE" ToolTip="Live workspace">
							<controls:RtaimeNavigationItem.Style><Style TargetType="{x:Type controls:RtaimeNavigationItem}" BasedOn="{StaticResource {x:Type controls:RtaimeNavigationItem}}"><Style.Triggers><DataTrigger Binding="{Binding Shell.SelectedWorkspace, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="LIVE"><Setter Property="IsActive" Value="True" /></DataTrigger></Style.Triggers></Style></controls:RtaimeNavigationItem.Style>
						</controls:RtaimeNavigationItem>
						<controls:RtaimeNavigationItem Label="Scenes" IconData="{StaticResource RtaimeIconMediaGeometry}" Command="{Binding Shell.SelectWorkspaceCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" CommandParameter="SCENES" ToolTip="Scenes workspace">
							<controls:RtaimeNavigationItem.Style><Style TargetType="{x:Type controls:RtaimeNavigationItem}" BasedOn="{StaticResource {x:Type controls:RtaimeNavigationItem}}"><Style.Triggers><DataTrigger Binding="{Binding Shell.SelectedWorkspace, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="SCENES"><Setter Property="IsActive" Value="True" /></DataTrigger></Style.Triggers></Style></controls:RtaimeNavigationItem.Style>
						</controls:RtaimeNavigationItem>
						<controls:RtaimeNavigationItem Label="Comp" IconData="{StaticResource RtaimeIconCompositingGeometry}" Command="{Binding Shell.SelectWorkspaceCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" CommandParameter="COMPOSITING" ToolTip="Compositing workspace">
							<controls:RtaimeNavigationItem.Style><Style TargetType="{x:Type controls:RtaimeNavigationItem}" BasedOn="{StaticResource {x:Type controls:RtaimeNavigationItem}}"><Style.Triggers><DataTrigger Binding="{Binding Shell.SelectedWorkspace, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="COMPOSITING"><Setter Property="IsActive" Value="True" /></DataTrigger></Style.Triggers></Style></controls:RtaimeNavigationItem.Style>
						</controls:RtaimeNavigationItem>
						<controls:RtaimeNavigationItem Label="Outputs" IconData="{StaticResource RtaimeIconOutputGeometry}" Command="{Binding Shell.SelectWorkspaceCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" CommandParameter="OUTPUTS" ToolTip="Outputs workspace">
							<controls:RtaimeNavigationItem.Style><Style TargetType="{x:Type controls:RtaimeNavigationItem}" BasedOn="{StaticResource {x:Type controls:RtaimeNavigationItem}}"><Style.Triggers><DataTrigger Binding="{Binding Shell.SelectedWorkspace, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="OUTPUTS"><Setter Property="IsActive" Value="True" /></DataTrigger></Style.Triggers></Style></controls:RtaimeNavigationItem.Style>
						</controls:RtaimeNavigationItem>
					</StackPanel>
					<controls:RtaimeNavigationItem DockPanel.Dock="Bottom"
						Label="Settings"
						IconData="{StaticResource RtaimeIconSettingsGeometry}"
						Command="{Binding Shell.SelectWorkspaceCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
						CommandParameter="SETTINGS"
						ToolTip="Settings and system status">
						<controls:RtaimeNavigationItem.Style><Style TargetType="{x:Type controls:RtaimeNavigationItem}" BasedOn="{StaticResource {x:Type controls:RtaimeNavigationItem}}"><Style.Triggers><DataTrigger Binding="{Binding Shell.SelectedWorkspace, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="SETTINGS"><Setter Property="IsActive" Value="True" /></DataTrigger></Style.Triggers></Style></controls:RtaimeNavigationItem.Style>
					</controls:RtaimeNavigationItem>
				</DockPanel>
			</Border>

			<Border x:Name="LeftToolRegion"
				Grid.Column="2"
				Style="{StaticResource OperatorShellRegion}"
				Padding="11"
				Margin="0"
				Visibility="{Binding Shell.LeftRegionVisibility, RelativeSource={RelativeSource AncestorType={x:Type Window}}}">
				<Grid>
					<Grid Visibility="{Binding Shell.MediaLibraryLeftVisibility, RelativeSource={RelativeSource AncestorType={x:Type Window}}}">
						<Grid.RowDefinitions>
							<RowDefinition Height="34" />
							<RowDefinition Height="34" />
							<RowDefinition Height="32" />
							<RowDefinition Height="*" />
						</Grid.RowDefinitions>

						<Grid Grid.Row="0">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="Auto" />
							</Grid.ColumnDefinitions>
							<StackPanel VerticalAlignment="Center">
								<TextBlock Text="MEDIA LIBRARY" Style="{StaticResource OperatorSectionTitle}" />
								<TextBlock
									Text="{Binding MediaPool.SelectionSummary, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
									Style="{StaticResource OperatorLabel}"
									FontSize="10"
									TextTrimming="CharacterEllipsis" />
							</StackPanel>
							<StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
								<controls:RtaimeIconButton
									IconData="{StaticResource RtaimeIconAddGeometry}"
									Command="{Binding MediaPool.ImportCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
									Width="26"
									Height="26"
									Margin="0,0,4,0"
									ToolTip="Import media through the existing Media Deck path."
									AutomationProperties.Name="Import media" />
								<controls:RtaimeIconButton
									IconData="{StaticResource RtaimeIconGridGeometry}"
									Command="{Binding MediaPool.GridViewCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
									Width="26"
									Height="26"
									Margin="0,0,4,0"
									ToolTip="Grid view"
									AutomationProperties.Name="Media Library grid view" />
								<controls:RtaimeIconButton
									IconData="{StaticResource RtaimeIconListGeometry}"
									Command="{Binding MediaPool.ListViewCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
									Width="26"
									Height="26"
									Margin="0,0,4,0"
									ToolTip="List view"
									AutomationProperties.Name="Media Library list view" />
								<controls:RtaimeIconButton
									IconData="{StaticResource RtaimeIconChevronLeftGeometry}"
									Command="{Binding Shell.ToggleLeftPanelCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
									Width="26"
									Height="26"
									ToolTip="Collapse Media Library"
									AutomationProperties.Name="Collapse Media Library" />
							</StackPanel>
						</Grid>

						<Grid Grid.Row="1">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="6" />
								<ColumnDefinition Width="112" />
							</Grid.ColumnDefinitions>
							<controls:RtaimeSearchBox
								x:Name="MediaSearchBox"
								Grid.Column="0"
								IconData="{StaticResource RtaimeIconSearchGeometry}"
								Placeholder="Search media…"
								Text="{Binding MediaPool.SearchText, RelativeSource={RelativeSource AncestorType={x:Type Window}}, UpdateSourceTrigger=PropertyChanged}"
								VerticalAlignment="Center"
								ToolTip="Search loaded resource metadata (Ctrl+F)."
								AutomationProperties.Name="Media Pool search" />
							<controls:RtaimeComboBox
								Grid.Column="2"
								Height="30"
								ItemsSource="{Binding MediaPool.Categories, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
								SelectedItem="{Binding MediaPool.SelectedCategory, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Mode=TwoWay}"
								ToolTip="Resource category"
								AutomationProperties.Name="Media category" />
						</Grid>

						<controls:RtaimeListBox
							Grid.Row="2"
							Height="32"
							ItemsSource="{Binding MediaPool.Filters, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
							SelectedItem="{Binding MediaPool.SelectedFilter, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Mode=TwoWay}"
							ItemContainerStyle="{StaticResource RtaimeMediaFilterItem}"
							Background="Transparent"
							BorderThickness="0"
							ScrollViewer.HorizontalScrollBarVisibility="Disabled"
							ScrollViewer.VerticalScrollBarVisibility="Disabled"
							ToolTip="Media type and availability filters"
							AutomationProperties.Name="Media filters">
							<controls:RtaimeListBox.ItemsPanel>
								<ItemsPanelTemplate>
									<UniformGrid Rows="1" Columns="6" />
								</ItemsPanelTemplate>
							</controls:RtaimeListBox.ItemsPanel>
						</controls:RtaimeListBox>

						<Grid Grid.Row="3" Margin="0,10,0,0">
							<controls:RtaimeListBox
								x:Name="MediaAssetGrid"
								ItemsSource="{Binding MediaPool.FilteredItems, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
								SelectedItem="{Binding MediaPool.SelectedItem, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Mode=TwoWay}"
								SelectionMode="Extended"
								SelectionChanged="OnMediaPoolSelectionChanged"
								IsVisibleChanged="OnMediaPoolViewVisibilityChanged"
								ItemContainerStyle="{StaticResource RtaimeMediaTileContainer}"
								PreviewMouseLeftButtonDown="OnMediaPoolPreviewMouseLeftButtonDown"
								PreviewMouseMove="OnMediaPoolPreviewMouseMove"
								VirtualizingPanel.IsVirtualizing="True"
								VirtualizingPanel.VirtualizationMode="Recycling"
								ScrollViewer.CanContentScroll="True"
								AutomationProperties.Name="Media Library grid">
								<controls:RtaimeListBox.Style>
									<Style TargetType="{x:Type controls:RtaimeListBox}" BasedOn="{StaticResource RtaimeMediaAssetListBox}">
										<Setter Property="Visibility" Value="Collapsed" />
										<Style.Triggers>
											<DataTrigger Binding="{Binding MediaPool.IsGridView, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="True">
												<Setter Property="Visibility" Value="Visible" />
											</DataTrigger>
										</Style.Triggers>
									</Style>
								</controls:RtaimeListBox.Style>
								<controls:RtaimeListBox.ItemsPanel>
									<ItemsPanelTemplate>
										<local:VirtualizingWrapPanel
											IsItemsHost="True"
											ItemWidth="120"
											ItemHeight="104"
											HorizontalSpacing="8"
											VerticalSpacing="10" />
									</ItemsPanelTemplate>
								</controls:RtaimeListBox.ItemsPanel>
								<controls:RtaimeListBox.ItemTemplate>
									<DataTemplate>
										<controls:RtaimeMediaTile
											Thumbnail="{Binding Thumbnail}"
											AssetName="{Binding Name}"
											Duration="{Binding DurationLabel}"
											FileType="{Binding FileTypeLabel}"
											Availability="{Binding AvailabilityLabel}"
											IsOnline="{Binding IsOnline}"
											IsSelected="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type controls:RtaimeListBoxItem}}}">
											<controls:RtaimeMediaTile.ContextMenu>
												<controls:RtaimeContextMenu>
													<controls:RtaimeMenuItem Header="Open in Preview" Click="OnMediaPoolPreviewActionClick" />
													<controls:RtaimeMenuItem Header="Add to Timeline" Click="OnMediaPoolTimelineActionClick" />
													<controls:RtaimeMenuItem Header="Add Cue at Playhead" Click="OnMediaPoolCueActionClick" />
													<controls:RtaimeMenuSeparator />
													<controls:RtaimeMenuItem Header="Reveal in Explorer" Click="OnMediaPoolRevealActionClick" />
													<controls:RtaimeMenuItem Header="Properties" Click="OnMediaPoolPropertiesActionClick" />
												</controls:RtaimeContextMenu>
											</controls:RtaimeMediaTile.ContextMenu>
											<StackPanel Orientation="Horizontal">
												<controls:RtaimeButton
													Content="PVW"
													Click="OnMediaPoolPreviewActionClick"
													IsCompact="True"
													MinHeight="22"
													Padding="5,1"
													Margin="0,0,3,0"
													ToolTip="Open in Preview" />
												<controls:RtaimeButton
													Content="TL"
													Click="OnMediaPoolTimelineActionClick"
													IsCompact="True"
													MinHeight="22"
													Padding="5,1"
													ToolTip="Add to Timeline" />
											</StackPanel>
										</controls:RtaimeMediaTile>
									</DataTemplate>
								</controls:RtaimeListBox.ItemTemplate>
							</controls:RtaimeListBox>

							<controls:RtaimeListBox
								x:Name="MediaAssetList"
								ItemsSource="{Binding MediaPool.FilteredItems, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
								SelectedItem="{Binding MediaPool.SelectedItem, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Mode=TwoWay}"
								SelectionMode="Extended"
								SelectionChanged="OnMediaPoolSelectionChanged"
								IsVisibleChanged="OnMediaPoolViewVisibilityChanged"
								ItemContainerStyle="{StaticResource RtaimeMediaListRowContainer}"
								PreviewMouseLeftButtonDown="OnMediaPoolPreviewMouseLeftButtonDown"
								PreviewMouseMove="OnMediaPoolPreviewMouseMove"
								VirtualizingPanel.IsVirtualizing="True"
								VirtualizingPanel.VirtualizationMode="Recycling"
								ScrollViewer.CanContentScroll="True"
								AutomationProperties.Name="Media Library list">
								<controls:RtaimeListBox.Style>
									<Style TargetType="{x:Type controls:RtaimeListBox}" BasedOn="{StaticResource RtaimeMediaAssetListBox}">
										<Setter Property="Visibility" Value="Visible" />
										<Style.Triggers>
											<DataTrigger Binding="{Binding MediaPool.IsGridView, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="True">
												<Setter Property="Visibility" Value="Collapsed" />
											</DataTrigger>
										</Style.Triggers>
									</Style>
								</controls:RtaimeListBox.Style>
								<controls:RtaimeListBox.ItemsPanel>
									<ItemsPanelTemplate>
										<VirtualizingStackPanel IsItemsHost="True" />
									</ItemsPanelTemplate>
								</controls:RtaimeListBox.ItemsPanel>
								<controls:RtaimeListBox.ItemTemplate>
									<DataTemplate>
										<Grid>
											<Grid.ContextMenu>
												<controls:RtaimeContextMenu>
													<controls:RtaimeMenuItem Header="Open in Preview" Click="OnMediaPoolPreviewActionClick" />
													<controls:RtaimeMenuItem Header="Add to Timeline" Click="OnMediaPoolTimelineActionClick" />
													<controls:RtaimeMenuItem Header="Add Cue at Playhead" Click="OnMediaPoolCueActionClick" />
													<controls:RtaimeMenuSeparator />
													<controls:RtaimeMenuItem Header="Reveal in Explorer" Click="OnMediaPoolRevealActionClick" />
													<controls:RtaimeMenuItem Header="Properties" Click="OnMediaPoolPropertiesActionClick" />
												</controls:RtaimeContextMenu>
											</Grid.ContextMenu>
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="*" />
												<ColumnDefinition Width="Auto" />
											</Grid.ColumnDefinitions>
											<StackPanel>
												<TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
												<TextBlock Text="{Binding Detail}" Style="{StaticResource OperatorLabel}" FontSize="10" TextTrimming="CharacterEllipsis" />
											</StackPanel>
											<StackPanel Grid.Column="1" HorizontalAlignment="Right">
												<TextBlock Text="{Binding FileTypeLabel}" Style="{StaticResource OperatorLabel}" FontSize="10" HorizontalAlignment="Right" />
												<TextBlock Text="{Binding AvailabilityLabel}" Style="{StaticResource OperatorLabel}" FontSize="10" HorizontalAlignment="Right" />
											</StackPanel>
										</Grid>
									</DataTemplate>
								</controls:RtaimeListBox.ItemTemplate>
							</controls:RtaimeListBox>

							<TextBlock
								Text="{Binding MediaPool.EmptyState, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
								TextWrapping="Wrap"
								HorizontalAlignment="Center"
								VerticalAlignment="Center"
