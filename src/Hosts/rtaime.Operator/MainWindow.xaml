<Window x:Class="rtaime.Operator.MainWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="clr-namespace:rtaime.Operator"
	Title="rtaime Operator"
	Width="1600"
	Height="900"
	MinWidth="1100"
	MinHeight="640"
	Background="{DynamicResource OperatorBackgroundBrush}"
	Foreground="{DynamicResource OperatorTextBrush}"
	FontFamily="{StaticResource OperatorFontFamily}"
	UseLayoutRounding="True"
	SnapsToDevicePixels="True"
	TextOptions.TextFormattingMode="Display"
	TextOptions.TextRenderingMode="ClearType"
	WindowStartupLocation="CenterScreen">
	<Window.InputBindings>
		<KeyBinding Key="F5" Command="{Binding SynchronizeCommand}" />
		<KeyBinding Key="P" Modifiers="Control" Command="{Binding SetPreviewCommand}" />
		<KeyBinding Key="Space" Command="{Binding CutCommand}" />
		<KeyBinding Key="Space" Modifiers="Control" Command="{Binding DissolveCommand}" />
	</Window.InputBindings>

	<Grid Margin="{StaticResource OperatorWindowPadding}">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<Border Grid.Row="0" Style="{StaticResource OperatorToolbar}" Margin="0,0,0,14">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>
				<StackPanel>
					<TextBlock Text="rtaime V1 Operator" FontSize="24" FontWeight="SemiBold" />
					<TextBlock Text="Non-authoritative production control and monitoring surface" Style="{StaticResource OperatorLabel}" Margin="0,4,0,0" />
					<TextBlock Text="{Binding ConnectionDetail}" Foreground="{DynamicResource OperatorMutedTextBrush}" FontSize="12" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" />
				</StackPanel>
				<StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
					<Border Style="{StaticResource OperatorStatusBadge}" Margin="0,0,8,0">
						<TextBlock Text="{Binding ConnectionState}" FontWeight="Bold" />
					</Border>
					<Border Style="{StaticResource OperatorStatusBadge}" Margin="0,0,8,0">
						<TextBlock Text="{Binding Monitoring.State, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" FontWeight="Bold" />
					</Border>
					<Border Style="{StaticResource OperatorStatusBadge}" Margin="0,0,8,0">
						<TextBlock Text="{Binding RevisionLabel}" FontWeight="SemiBold" />
					</Border>
					<Button Content="Synchronize  F5" Command="{Binding SynchronizeCommand}" Style="{StaticResource OperatorAccentButton}" />
				</StackPanel>
			</Grid>
		</Border>

		<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="2.2*" MinWidth="610" />
					<ColumnDefinition Width="14" />
					<ColumnDefinition Width="1*" MinWidth="300" />
				</Grid.ColumnDefinitions>

				<StackPanel Grid.Column="0">
					<Grid Margin="0,0,0,14">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="12" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>

						<Border Grid.Column="0" Style="{StaticResource OperatorPreviewPanel}">
							<StackPanel>
								<Border Style="{StaticResource OperatorPreviewTally}" HorizontalAlignment="Left"><TextBlock Text="PREVIEW" Foreground="{DynamicResource OperatorPreviewBrush}" FontWeight="Bold" FontSize="13" /></Border>
								<TextBlock Text="{Binding PreviewSourceName}" FontSize="25" FontWeight="SemiBold" Margin="0,10,0,0" TextTrimming="CharacterEllipsis" />
								<TextBlock Text="{Binding PreviewSourceId}" Style="{StaticResource OperatorLabel}" Margin="0,2,0,12" TextTrimming="CharacterEllipsis" />
								<Grid Height="220" Background="#090C10" Margin="0,0,0,12" ClipToBounds="True">
									<Image Source="{Binding Monitoring.PreviewImage, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Stretch="Uniform" SnapsToDevicePixels="True" />
									<Border VerticalAlignment="Bottom" Background="#B0000000" Padding="8,5">
										<TextBlock Text="{Binding Monitoring.PreviewFormat, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" FontSize="11" Foreground="White" TextTrimming="CharacterEllipsis" />
									</Border>
								</Grid>
								<DockPanel Margin="0,0,0,6">
									<TextBlock Text="SIGNAL" Style="{StaticResource OperatorLabel}" />
									<TextBlock Text="{Binding InputStatus}" Style="{StaticResource OperatorValue}" HorizontalAlignment="Right" DockPanel.Dock="Right" />
								</DockPanel>
								<DockPanel>
									<TextBlock Text="TIMING" Style="{StaticResource OperatorLabel}" />
									<TextBlock Text="{Binding TimingStatus}" Style="{StaticResource OperatorValue}" HorizontalAlignment="Right" DockPanel.Dock="Right" />
								</DockPanel>
							</StackPanel>
						</Border>

						<Border Grid.Column="2" Style="{StaticResource OperatorProgramPanel}">
							<StackPanel>
								<Border Style="{StaticResource OperatorProgramTally}" HorizontalAlignment="Left"><TextBlock Text="PROGRAM" Foreground="{DynamicResource OperatorProgramBrush}" FontWeight="Bold" FontSize="13" /></Border>
								<TextBlock Text="{Binding ProgramSourceName}" FontSize="25" FontWeight="SemiBold" Margin="0,10,0,0" TextTrimming="CharacterEllipsis" />
								<TextBlock Text="{Binding ProgramSourceId}" Style="{StaticResource OperatorLabel}" Margin="0,2,0,12" TextTrimming="CharacterEllipsis" />
								<Grid Height="220" Background="#090C10" Margin="0,0,0,12" ClipToBounds="True">
									<Image Source="{Binding Monitoring.ProgramImage, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Stretch="Uniform" SnapsToDevicePixels="True" />
									<Border VerticalAlignment="Bottom" Background="#B0000000" Padding="8,5">
										<TextBlock Text="{Binding Monitoring.ProgramFormat, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" FontSize="11" Foreground="White" TextTrimming="CharacterEllipsis" />
									</Border>
								</Grid>
								<DockPanel Margin="0,0,0,6">
									<TextBlock Text="RUNTIME" Style="{StaticResource OperatorLabel}" />
									<TextBlock Text="{Binding RuntimeStatus}" Style="{StaticResource OperatorValue}" HorizontalAlignment="Right" DockPanel.Dock="Right" />
								</DockPanel>
								<DockPanel Margin="0,0,0,6">
									<TextBlock Text="COMMIT" Style="{StaticResource OperatorLabel}" />
									<TextBlock Text="{Binding CommitStatus}" Style="{StaticResource OperatorValue}" FontWeight="SemiBold" HorizontalAlignment="Right" DockPanel.Dock="Right" />
								</DockPanel>
								<DockPanel Margin="0,0,0,6">
									<TextBlock Text="TRANSITION" Style="{StaticResource OperatorLabel}" />
									<TextBlock Text="{Binding TransitionStatus}" Style="{StaticResource OperatorValue}" HorizontalAlignment="Right" DockPanel.Dock="Right" />
								</DockPanel>
								<DockPanel>
									<TextBlock Text="LAYER" Style="{StaticResource OperatorLabel}" />
									<TextBlock Text="{Binding VisualLayerStatus}" Style="{StaticResource OperatorValue}" HorizontalAlignment="Right" DockPanel.Dock="Right" />
								</DockPanel>
							</StackPanel>
						</Border>
					</Grid>

					<local:MediaDeckControl DataContext="{Binding MediaDeck, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Margin="0,0,0,14" />

					<Border Style="{StaticResource OperatorPanel}" Margin="0,0,0,14">
						<StackPanel>
							<DockPanel Margin="0,0,0,12">
								<TextBlock Text="SOURCE BIN" Style="{StaticResource OperatorSectionTitle}" />
								<TextBlock Text="Select a tile, then Set Preview / Ctrl+P" Style="{StaticResource OperatorLabel}" DockPanel.Dock="Right" VerticalAlignment="Center" />
							</DockPanel>
							<ListBox ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}" Style="{StaticResource OperatorSourceBank}" ItemContainerStyle="{StaticResource OperatorSourceItem}">
								<ListBox.ItemTemplate>
									<DataTemplate>
										<Grid MinHeight="138">
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="200" />
												<ColumnDefinition Width="14" />
												<ColumnDefinition Width="*" />
											</Grid.ColumnDefinitions>
											<Grid Grid.Column="0" Background="#090C10" ClipToBounds="True">
												<Image Source="{Binding Thumbnail}" Stretch="Uniform" SnapsToDevicePixels="True" />
												<Border VerticalAlignment="Bottom" Background="#B0000000" Padding="7,4">
													<TextBlock Text="{Binding ThumbnailFormat}" FontSize="10" Foreground="White" TextTrimming="CharacterEllipsis" />
												</Border>
											</Grid>
											<Grid Grid.Column="2">
												<Grid.RowDefinitions>
													<RowDefinition Height="Auto" />
													<RowDefinition Height="Auto" />
													<RowDefinition Height="*" />
													<RowDefinition Height="Auto" />
												</Grid.RowDefinitions>
												<Grid>
													<Grid.ColumnDefinitions>
														<ColumnDefinition Width="*" />
														<ColumnDefinition Width="Auto" />
													</Grid.ColumnDefinitions>
													<TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="17" TextTrimming="CharacterEllipsis" />
													<StackPanel Grid.Column="1" Orientation="Horizontal">
														<Border Margin="0,0,6,0">
															<Border.Style>
																<Style TargetType="Border" BasedOn="{StaticResource OperatorPreviewTally}">
																	<Setter Property="Visibility" Value="Collapsed" />
																	<Style.Triggers><DataTrigger Binding="{Binding IsPreview}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
																</Style>
															</Border.Style>
															<TextBlock Text="PVW" Foreground="{DynamicResource OperatorPreviewBrush}" FontWeight="Bold" />
														</Border>
														<Border>
															<Border.Style>
																<Style TargetType="Border" BasedOn="{StaticResource OperatorProgramTally}">
																	<Setter Property="Visibility" Value="Collapsed" />
																	<Style.Triggers><DataTrigger Binding="{Binding IsProgram}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
																</Style>
															</Border.Style>
															<TextBlock Text="PGM" Foreground="{DynamicResource OperatorProgramBrush}" FontWeight="Bold" />
														</Border>
													</StackPanel>
												</Grid>
												<TextBlock Grid.Row="1" Text="{Binding Id}" Style="{StaticResource OperatorLabel}" Margin="0,2,0,8" TextTrimming="CharacterEllipsis" />
												<Grid Grid.Row="2">
													<Grid.ColumnDefinitions>
														<ColumnDefinition Width="Auto" />
														<ColumnDefinition Width="12" />
														<ColumnDefinition Width="*" />
													</Grid.ColumnDefinitions>
													<Border Style="{StaticResource OperatorStatusBadge}" Padding="7,3" VerticalAlignment="Top">
														<TextBlock Text="{Binding Type}" FontWeight="Bold" />
													</Border>
													<StackPanel Grid.Column="2">
														<DockPanel Margin="0,0,0,4"><TextBlock Text="FORMAT" Style="{StaticResource OperatorLabel}" /><TextBlock Text="{Binding Format}" Style="{StaticResource OperatorValue}" DockPanel.Dock="Right" /></DockPanel>
														<DockPanel>
															<TextBlock Text="HEALTH" Style="{StaticResource OperatorLabel}" />
															<Border DockPanel.Dock="Right" Padding="7,2">
																<Border.Style>
																	<Style TargetType="Border" BasedOn="{StaticResource OperatorHealthyBadge}">
																		<Style.Triggers>
																			<DataTrigger Binding="{Binding Health}" Value="UNSTABLE"><Setter Property="BorderBrush" Value="{DynamicResource OperatorWarningBrush}" /></DataTrigger>
																			<DataTrigger Binding="{Binding Health}" Value="RECOVERING"><Setter Property="BorderBrush" Value="{DynamicResource OperatorWarningBrush}" /></DataTrigger>
																			<DataTrigger Binding="{Binding Health}" Value="LOST"><Setter Property="BorderBrush" Value="{DynamicResource OperatorErrorBrush}" /></DataTrigger>
																			<DataTrigger Binding="{Binding Health}" Value="ERROR"><Setter Property="BorderBrush" Value="{DynamicResource OperatorErrorBrush}" /></DataTrigger>
																		</Style.Triggers>
																	</Style>
																</Border.Style>
																<TextBlock Text="{Binding Health}" FontWeight="SemiBold" />
															</Border>
														</DockPanel>
													</StackPanel>
												</Grid>
												<DockPanel Grid.Row="3" Margin="0,8,0,0">
													<TextBlock Text="{Binding Detail}" Style="{StaticResource OperatorLabel}" TextTrimming="CharacterEllipsis" />
													<TextBlock Text="{Binding StateDetail}" Style="{StaticResource OperatorValue}" FontWeight="SemiBold" DockPanel.Dock="Right" />
												</DockPanel>
											</Grid>
										</Grid>
									</DataTemplate>
								</ListBox.ItemTemplate>
							</ListBox>
						</StackPanel>
					</Border>

					<Border Style="{StaticResource OperatorPanel}">
						<StackPanel>
							<TextBlock Text="TRANSITION" Style="{StaticResource OperatorSectionTitle}" Margin="0,0,0,12" />
							<Grid Margin="0,0,0,12">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="14" />
									<ColumnDefinition Width="*" />
								</Grid.ColumnDefinitions>
								<StackPanel>
									<TextBlock Text="SELECTED SOURCE" Style="{StaticResource OperatorLabel}" />
									<TextBlock Text="{Binding SelectedSource.Name, TargetNullValue=No source selected}" FontSize="18" FontWeight="SemiBold" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
								</StackPanel>
								<Border Grid.Column="2" Style="{StaticResource OperatorPreviewTally}">
									<StackPanel>
										<TextBlock Text="CONFIRMED PREVIEW / NEXT TAKE" Style="{StaticResource OperatorLabel}" Foreground="{DynamicResource OperatorPreviewBrush}" />
										<TextBlock Text="{Binding PreviewSourceName}" FontSize="18" FontWeight="SemiBold" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
									</StackPanel>
								</Border>
							</Grid>
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="10" />
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="10" />
									<ColumnDefinition Width="*" />
								</Grid.ColumnDefinitions>
								<Button Grid.Column="0" Content="SET SELECTED → PREVIEW&#x0a;Ctrl+P" Command="{Binding SetPreviewCommand}" Style="{StaticResource OperatorAccentButton}" />
								<Button Grid.Column="2" Content="CUT PREVIEW → PROGRAM&#x0a;Space" Command="{Binding CutCommand}" Style="{StaticResource OperatorProgramButton}" />
								<Button Grid.Column="4" Content="AUTO PREVIEW → PROGRAM&#x0a;Ctrl+Space" Command="{Binding DissolveCommand}" Style="{StaticResource OperatorButton}" />
							</Grid>
							<DockPanel Margin="0,12,0,0">
								<TextBlock Text="Dissolve duration" Style="{StaticResource OperatorLabel}" VerticalAlignment="Center" Margin="0,0,10,0" />
								<TextBox Text="{Binding TransitionFrames, UpdateSourceTrigger=PropertyChanged}" Width="90" Style="{StaticResource OperatorTextBox}" HorizontalAlignment="Left" />
								<TextBlock Text="frames" Style="{StaticResource OperatorLabel}" VerticalAlignment="Center" Margin="8,0,0,0" />
							</DockPanel>
						</StackPanel>
					</Border>
				</StackPanel>

				<StackPanel Grid.Column="2">
					<Border Style="{StaticResource OperatorPanel}" Margin="0,0,0,14">
						<StackPanel>
							<TextBlock Text="SYSTEM" Style="{StaticResource OperatorSectionTitle}" Margin="0,0,0,12" />
							<DockPanel Margin="0,0,0,8"><TextBlock Text="Runtime" Style="{StaticResource OperatorLabel}" /><TextBlock Text="{Binding RuntimeStatus}" Style="{StaticResource OperatorValue}" FontWeight="SemiBold" DockPanel.Dock="Right" /></DockPanel>
							<DockPanel Margin="0,0,0,8"><TextBlock Text="Timing" Style="{StaticResource OperatorLabel}" /><TextBlock Text="{Binding TimingStatus}" Style="{StaticResource OperatorValue}" DockPanel.Dock="Right" /></DockPanel>
							<DockPanel><TextBlock Text="Inputs" Style="{StaticResource OperatorLabel}" /><TextBlock Text="{Binding InputStatus}" Style="{StaticResource OperatorValue}" DockPanel.Dock="Right" /></DockPanel>
						</StackPanel>
					</Border>

					<Border Style="{StaticResource OperatorPanel}" Margin="0,0,0,14">
						<StackPanel>
							<TextBlock Text="MONITORING" Style="{StaticResource OperatorSectionTitle}" Margin="0,0,0,12" />
							<DockPanel Margin="0,0,0,8"><TextBlock Text="Plane" Style="{StaticResource OperatorLabel}" /><TextBlock Text="{Binding Monitoring.State, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Style="{StaticResource OperatorValue}" FontWeight="SemiBold" DockPanel.Dock="Right" /></DockPanel>
							<TextBlock Text="{Binding Monitoring.Detail, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Style="{StaticResource OperatorLabel}" TextWrapping="Wrap" />
						</StackPanel>
					</Border>

					<Border Style="{StaticResource OperatorPanel}" Margin="0,0,0,14">
						<StackPanel>
							<DockPanel Margin="0,0,0,12">
								<TextBlock Text="GRAPHICS / OVERLAY" Style="{StaticResource OperatorSectionTitle}" />
								<Border Style="{StaticResource OperatorStatusBadge}" DockPanel.Dock="Right"><TextBlock Text="{Binding GraphicsState}" FontWeight="Bold" /></Border>
							</DockPanel>
							<TextBlock Text="{Binding GraphicsAssetName}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
							<DockPanel Margin="0,3,0,12">
								<TextBlock Text="PNG / RGBA asset" Style="{StaticResource OperatorLabel}" />
								<TextBlock Text="{Binding GraphicsDimensions}" Style="{StaticResource OperatorValue}" DockPanel.Dock="Right" />
							</DockPanel>
							<Grid Margin="0,0,0,10">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="8" />
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="8" />
									<ColumnDefinition Width="*" />
								</Grid.ColumnDefinitions>
								<StackPanel Grid.Column="0">
									<TextBlock Text="X %" Style="{StaticResource OperatorLabel}" />
									<TextBox Text="{Binding GraphicsPositionX, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource OperatorTextBox}" />
								</StackPanel>
								<StackPanel Grid.Column="2">
									<TextBlock Text="Y %" Style="{StaticResource OperatorLabel}" />
									<TextBox Text="{Binding GraphicsPositionY, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource OperatorTextBox}" />
								</StackPanel>
								<StackPanel Grid.Column="4">
									<TextBlock Text="SCALE" Style="{StaticResource OperatorLabel}" />
									<TextBox Text="{Binding GraphicsScale, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource OperatorTextBox}" />
								</StackPanel>
							</Grid>
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="6" />
									<ColumnDefinition Width="*" />
								</Grid.ColumnDefinitions>
								<Button Grid.Column="0" Content="LOAD PNG" Command="{Binding LoadGraphicsCommand}" Style="{StaticResource OperatorAccentButton}" />
								<Button Grid.Column="2" Content="APPLY POSITION" Command="{Binding ApplyGraphicsCommand}" Style="{StaticResource OperatorButton}" />
							</Grid>
							<Grid Margin="0,6,0,0">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="6" />
									<ColumnDefinition Width="*" />
								</Grid.ColumnDefinitions>
								<Button Grid.Column="0" Content="SHOW / HIDE" Command="{Binding ToggleGraphicsCommand}" Style="{StaticResource OperatorProgramButton}" />
								<Button Grid.Column="2" Content="CLEAR" Command="{Binding ClearGraphicsCommand}" Style="{StaticResource OperatorButton}" />
							</Grid>
							<TextBlock Text="Graphics are composited in RuntimeHost after the transition and before Program monitoring / recording." Style="{StaticResource OperatorLabel}" TextWrapping="Wrap" Margin="0,10,0,0" />
						</StackPanel>
					</Border>

					<Border Style="{StaticResource OperatorPanel}" Margin="0,0,0,14">
						<StackPanel>
							<DockPanel Margin="0,0,0,12">
								<TextBlock Text="AUDIO / AFV" Style="{StaticResource OperatorSectionTitle}" />
								<Border Style="{StaticResource OperatorStatusBadge}" DockPanel.Dock="Right">
									<TextBlock Text="{Binding AudioHealth}" FontWeight="Bold" />
								</Border>
							</DockPanel>
							<DockPanel Margin="0,0,0,8">
								<TextBlock Text="AFV follows Program" Style="{StaticResource OperatorLabel}" />
								<TextBlock Text="{Binding AudioAfvSourceName}" Style="{StaticResource OperatorValue}" FontWeight="SemiBold" DockPanel.Dock="Right" TextTrimming="CharacterEllipsis" />
							</DockPanel>
							<DockPanel Margin="0,0,0,10">
								<TextBlock Text="Meter transport" Style="{StaticResource OperatorLabel}" />
								<TextBlock Text="{Binding AudioMeterStatus}" Style="{StaticResource OperatorValue}" DockPanel.Dock="Right" />
							</DockPanel>
							<Grid Margin="0,0,0,3">
								<Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /><ColumnDefinition Width="48" /></Grid.ColumnDefinitions>
								<TextBlock Text="L" Style="{StaticResource OperatorLabel}" VerticalAlignment="Center" />
								<ProgressBar Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding AudioLeftPeak}" Style="{StaticResource OperatorMeter}" VerticalAlignment="Center" />
								<TextBlock Grid.Column="2" Text="{Binding AudioLeftPeak, StringFormat={}{0:P0}}" Style="{StaticResource OperatorLabel}" HorizontalAlignment="Right" />
							</Grid>
							<Grid Margin="0,0,0,10">
								<Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /><ColumnDefinition Width="48" /></Grid.ColumnDefinitions>
								<TextBlock Text="R" Style="{StaticResource OperatorLabel}" VerticalAlignment="Center" />
								<ProgressBar Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding AudioRightPeak}" Style="{StaticResource OperatorMeter}" VerticalAlignment="Center" />
								<TextBlock Grid.Column="2" Text="{Binding AudioRightPeak, StringFormat={}{0:P0}}" Style="{StaticResource OperatorLabel}" HorizontalAlignment="Right" />
							</Grid>
							<DockPanel Margin="0,0,0,10">
								<TextBlock Text="MASTER" Style="{StaticResource OperatorLabel}" />
								<TextBlock Text="{Binding AudioPeakPercent}" Style="{StaticResource OperatorValue}" FontWeight="SemiBold" DockPanel.Dock="Right" />
							</DockPanel>
							<ProgressBar Minimum="0" Maximum="1" Value="{Binding AudioMasterPeak}" Style="{StaticResource OperatorMeter}" Margin="0,0,0,12" />
							<ListBox ItemsSource="{Binding AudioInputs}" SelectedItem="{Binding SelectedAudioInput}" Style="{StaticResource OperatorSourceBank}" MaxHeight="190" Margin="0,0,0,10">
								<ListBox.ItemContainerStyle><StaticResource ResourceKey="OperatorSourceItem" /></ListBox.ItemContainerStyle>
								<ListBox.ItemTemplate>
									<DataTemplate>
										<StackPanel>
											<DockPanel>
												<TextBlock Text="{Binding SourceName}" Style="{StaticResource OperatorValue}" FontWeight="SemiBold" />
												<TextBlock Text="{Binding AfvLabel}" Style="{StaticResource OperatorLabel}" DockPanel.Dock="Right" />
											</DockPanel>
											<DockPanel Margin="0,4,0,4">
												<TextBlock Text="{Binding SourceType}" Style="{StaticResource OperatorLabel}" />
												<TextBlock Text="{Binding Health}" Style="{StaticResource OperatorLabel}" DockPanel.Dock="Right" />
											</DockPanel>
											<Grid>
												<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="6" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
												<ProgressBar Grid.Column="0" Minimum="0" Maximum="1" Value="{Binding LeftPeak}" Style="{StaticResource OperatorMeter}" />
												<ProgressBar Grid.Column="2" Minimum="0" Maximum="1" Value="{Binding RightPeak}" Style="{StaticResource OperatorMeter}" />
											</Grid>
										</StackPanel>
									</DataTemplate>
								</ListBox.ItemTemplate>
							</ListBox>
							<Grid Margin="0,0,0,8">
								<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
								<StackPanel Grid.Column="0">
									<TextBlock Text="Selected gain 0.0–4.0x" Style="{StaticResource OperatorLabel}" />
									<TextBox Text="{Binding SelectedAudioInput.Gain, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource OperatorTextBox}" />
								</StackPanel>
								<StackPanel Grid.Column="2">
									<TextBlock Text="Confirmed mute" Style="{StaticResource OperatorLabel}" />
									<TextBlock Text="{Binding SelectedAudioInput.Muted}" Style="{StaticResource OperatorValue}" Margin="0,8,0,0" />
								</StackPanel>
							</Grid>
							<Grid>
								<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="6" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
								<Button Grid.Column="0" Content="APPLY GAIN" Command="{Binding ApplyAudioGainCommand}" Style="{StaticResource OperatorAccentButton}" />
								<Button Grid.Column="2" Content="{Binding SelectedAudioInput.MuteActionLabel}" Command="{Binding ToggleAudioMuteCommand}" Style="{StaticResource OperatorButton}" />
							</Grid>
							<DockPanel Margin="0,10,0,0">
								<TextBlock Text="Clip audio" Style="{StaticResource OperatorLabel}" />
								<TextBlock Text="{Binding ClipAudioStatus}" Style="{StaticResource OperatorLabel}" DockPanel.Dock="Right" TextTrimming="CharacterEllipsis" MaxWidth="230" />
							</DockPanel>
							<TextBlock Text="Meters are RuntimeHost observations; no WPF-generated meter animation is used." Style="{StaticResource OperatorLabel}" TextWrapping="Wrap" Margin="0,8,0,0" />
						</StackPanel>
					</Border>

					<Border Style="{StaticResource OperatorPanel}" Margin="0,0,0,14">
						<StackPanel>
							<TextBlock Text="ISOLATED SERVICES" Style="{StaticResource OperatorSectionTitle}" Margin="0,0,0,12" />
							<DockPanel Margin="0,0,0,8"><TextBlock Text="AI" Style="{StaticResource OperatorLabel}" /><TextBlock Text="{Binding AIStatus}" Style="{StaticResource OperatorValue}" DockPanel.Dock="Right" /></DockPanel>
							<DockPanel><TextBlock Text="Recording" Style="{StaticResource OperatorLabel}" /><TextBlock Text="{Binding RecordingStatus}" Style="{StaticResource OperatorValue}" DockPanel.Dock="Right" /></DockPanel>
						</StackPanel>
					</Border>

					<Border Style="{StaticResource OperatorPanel}">
						<StackPanel>
							<TextBlock Text="OPERATOR STATE" Style="{StaticResource OperatorSectionTitle}" Margin="0,0,0,12" />
							<DockPanel Margin="0,0,0,8"><TextBlock Text="Command" Style="{StaticResource OperatorLabel}" /><TextBlock Text="{Binding CommandStatus}" Style="{StaticResource OperatorValue}" FontWeight="SemiBold" DockPanel.Dock="Right" /></DockPanel>
														<DockPanel Margin="0,0,0,8"><TextBlock Text="Commit" Style="{StaticResource OperatorLabel}" /><TextBlock Text="{Binding CommitStatus}" Style="{StaticResource OperatorValue}" DockPanel.Dock="Right" /></DockPanel>
														<DockPanel Margin="0,0,0,8"><TextBlock Text="Transition" Style="{StaticResource OperatorLabel}" /><TextBlock Text="{Binding TransitionStatus}" Style="{StaticResource OperatorValue}" DockPanel.Dock="Right" /></DockPanel>
							<TextBlock Text="{Binding LastEvent}" Style="{StaticResource OperatorLabel}" TextWrapping="Wrap" />
						</StackPanel>
					</Border>
				</StackPanel>
			</Grid>
		</ScrollViewer>

		<Border Grid.Row="2" Style="{StaticResource OperatorPanel}" Margin="0,14,0,0" Padding="12,8">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="*" />
				</Grid.ColumnDefinitions>
				<TextBlock Text="EVENT / ERROR" Style="{StaticResource OperatorLabel}" VerticalAlignment="Center" Margin="0,0,12,0" />
				<TextBlock Grid.Column="1" Text="{Binding LastError, TargetNullValue=No active control error.}" TextWrapping="Wrap" VerticalAlignment="Center" />
			</Grid>
		</Border>
	</Grid>
</Window>
