							<TextBlock Text="{Binding Monitoring.Detail, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Style="{StaticResource OperatorLabel}" TextWrapping="Wrap" />
							<Border Height="1" Background="{DynamicResource OperatorBorderBrush}" Margin="0,14,0,14" />
							<DockPanel Margin="0,0,0,10">
								<TextBlock Text="PROGRAM OUTPUT / CLEAN FEED" Style="{StaticResource OperatorSectionTitle}" />
								<Border Style="{StaticResource OperatorStatusBadge}" DockPanel.Dock="Right">
									<TextBlock Text="{Binding ProgramOutput.Health, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" FontWeight="Bold" />
								</Border>
							</DockPanel>
							<TextBlock Text="Display" Style="{StaticResource OperatorLabel}" Margin="0,0,0,4" />
