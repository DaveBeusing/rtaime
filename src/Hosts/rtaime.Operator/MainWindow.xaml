<Window x:Class="rtaime.Operator.MainWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	Title="rtaime Operator"
	Width="1280"
	Height="800"
	MinWidth="980"
	MinHeight="640"
	Background="{DynamicResource OperatorBackgroundBrush}"
	Foreground="{DynamicResource OperatorTextBrush}"
	FontFamily="Segoe UI"
	UseLayoutRounding="True"
	WindowStartupLocation="CenterScreen">
	<Window.InputBindings>
		<KeyBinding Key="F5" Command="{Binding SynchronizeCommand}" />
		<KeyBinding Key="P" Modifiers="Control" Command="{Binding SetPreviewCommand}" />
		<KeyBinding Key="Space" Command="{Binding CutCommand}" />
		<KeyBinding Key="Space" Modifiers="Control" Command="{Binding DissolveCommand}" />
	</Window.InputBindings>

	<Grid Margin="20">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<Border Grid.Row="0" Style="{StaticResource OperatorPanel}" Margin="0,0,0,14">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>
				<StackPanel>
					<TextBlock Text="rtaime V1 Operator" FontSize="24" FontWeight="SemiBold" />
					<TextBlock Text="Non-authoritative production control surface" Style="{StaticResource OperatorLabel}" Margin="0,4,0,0" />
					<TextBlock Text="{Binding ConnectionDetail}" Foreground="{DynamicResource OperatorMutedTextBrush}" FontSize="12" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" />
				</StackPanel>
				<StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
					<Border Background="{DynamicResource OperatorRaisedSurfaceBrush}" BorderBrush="{DynamicResource OperatorBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,8,0">
						<TextBlock Text="{Binding ConnectionState}" FontWeight="Bold" />
					</Border>
					<Border Background="{DynamicResource OperatorRaisedSurfaceBrush}" BorderBrush="{DynamicResource OperatorBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,8,0">
						<TextBlock Text="{Binding RevisionLabel}" FontWeight="SemiBold" />
					</Border>
					<Button Content="Synchronize  F5" Command="{Binding SynchronizeCommand}" Style="{StaticResource OperatorAccentButton}" />
				</StackPanel>
			</Grid>
		</Border>

		<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="2.2*" MinWidth="610" />
					<ColumnDefinition Width="14" />
					<ColumnDefinition Width="1*" MinWidth="300" />
				</Grid.ColumnDefinitions>

				<StackPanel Grid.Column="0">
					<Grid Margin="0,0,0,14">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="12" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>

						<Border Grid.Column="0" Style="{StaticResource OperatorPanel}" BorderBrush="{DynamicResource OperatorPreviewBrush}">
							<StackPanel>
								<TextBlock Text="PREVIEW" Foreground="{DynamicResource OperatorPreviewBrush}" FontWeight="Bold" FontSize="13" />
								<TextBlock Text="{Binding PreviewSourceName}" FontSize="25" FontWeight="SemiBold" Margin="0,10,0,0" TextTrimming="CharacterEllipsis" />
								<TextBlock Text="{Binding PreviewSourceId}" Style="{StaticResource OperatorLabel}" Margin="0,2,0,12" TextTrimming="CharacterEllipsis" />
								<Border Background="#12161C" BorderBrush="{DynamicResource OperatorBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,12">
									<StackPanel>
										<TextBlock Text="{Binding MonitoringStatus}" Foreground="{DynamicResource OperatorWarningBrush}" FontWeight="SemiBold" HorizontalAlignment="Center" />
										<TextBlock Text="No production media is transported over management IPC." Style="{StaticResource OperatorLabel}" HorizontalAlignment="Center" Margin="0,4,0,0" />
									</StackPanel>
								</Border>
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="Auto" />
										<ColumnDefinition Width="*" />
									</Grid.ColumnDefinitions>
									<TextBlock Text="SIGNAL" Style="{StaticResource OperatorLabel}" />
									<TextBlock Grid.Column="1" Text="{Binding InputStatus}" Style="{StaticResource OperatorValue}" HorizontalAlignment="Right" />
									<TextBlock Grid.Row="1" Text="TIMING" Style="{StaticResource OperatorLabel}" Margin="0,6,0,0" />
									<TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TimingStatus}" Style="{StaticResource OperatorValue}" HorizontalAlignment="Right" Margin="0,6,0,0" />
								</Grid>
								<TextBlock Text="{Binding FormatStatus}" Style="{StaticResource OperatorLabel}" Margin="0,10,0,0" TextWrapping="Wrap" />
							</StackPanel>
						</Border>

						<Border Grid.Column="2" Style="{StaticResource OperatorPanel}" BorderBrush="{DynamicResource OperatorProgramBrush}">
							<StackPanel>
								<TextBlock Text="PROGRAM" Foreground="{DynamicResource OperatorProgramBrush}" FontWeight="Bold" FontSize="13" />
								<TextBlock Text="{Binding ProgramSourceName}" FontSize="25" FontWeight="SemiBold" Margin="0,10,0,0" TextTrimming="CharacterEllipsis" />
								<TextBlock Text="{Binding ProgramSourceId}" Style="{StaticResource OperatorLabel}" Margin="0,2,0,12" TextTrimming="CharacterEllipsis" />
								<Border Background="#12161C" BorderBrush="{DynamicResource OperatorBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,12">
									<StackPanel>
										<TextBlock Text="{Binding MonitoringStatus}" Foreground="{DynamicResource OperatorWarningBrush}" FontWeight="SemiBold" HorizontalAlignment="Center" />
										<TextBlock Text="Program continuity remains independent of this UI." Style="{StaticResource OperatorLabel}" HorizontalAlignment="Center" Margin="0,4,0,0" />
									</StackPanel>
								</Border>
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="Auto" />
										<ColumnDefinition Width="*" />
									</Grid.ColumnDefinitions>
									<TextBlock Text="RUNTIME" Style="{StaticResource OperatorLabel}" />
									<TextBlock Grid.Column="1" Text="{Binding RuntimeStatus}" Style="{StaticResource OperatorValue}" HorizontalAlignment="Right" />
									<TextBlock Grid.Row="1" Text="LAYER" Style="{StaticResource OperatorLabel}" Margin="0,6,0,0" />
									<TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding VisualLayerStatus}" Style="{StaticResource OperatorValue}" HorizontalAlignment="Right" Margin="0,6,0,0" />
								</Grid>
								<TextBlock Text="{Binding FormatStatus}" Style="{StaticResource OperatorLabel}" Margin="0,10,0,0" TextWrapping="Wrap" />
							</StackPanel>
						</Border>
					</Grid>

					<Border Style="{StaticResource OperatorPanel}" Margin="0,0,0,14">
						<StackPanel>
							<TextBlock Text="SOURCE BANK" Style="{StaticResource OperatorSectionTitle}" Margin="0,0,0,12" />
							<ListBox ItemsSource="{Binding Sources}"
								SelectedItem="{Binding SelectedSource}"
								Style="{StaticResource OperatorSourceBank}"
								ItemContainerStyle="{StaticResource OperatorSourceItem}">
								<ListBox.ItemTemplate>
									<DataTemplate>
										<Grid>
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="*" />
												<ColumnDefinition Width="Auto" />
											</Grid.ColumnDefinitions>
											<StackPanel>
												<TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" />
												<TextBlock Text="{Binding Id}" Style="{StaticResource OperatorLabel}" Margin="0,2,0,0" />
											</StackPanel>
											<TextBlock Grid.Column="1" Text="SELECT" Foreground="{DynamicResource OperatorAccentBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
										</Grid>
									</DataTemplate>
								</ListBox.ItemTemplate>
							</ListBox>
						</StackPanel>
					</Border>

					<Border Style="{StaticResource OperatorPanel}">
						<StackPanel>
							<TextBlock Text="TRANSITION" Style="{StaticResource OperatorSectionTitle}" Margin="0,0,0,12" />
							<TextBlock Text="Selected source" Style="{StaticResource OperatorLabel}" />
							<TextBlock Text="{Binding SelectedSource.Name, TargetNullValue=No source selected}" FontSize="18" FontWeight="SemiBold" Margin="0,3,0,12" />
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="10" />
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="10" />
									<ColumnDefinition Width="*" />
								</Grid.ColumnDefinitions>
								<Button Grid.Column="0" Content="SET PREVIEW&#x0a;Ctrl+P" Command="{Binding SetPreviewCommand}" Style="{StaticResource OperatorAccentButton}" />
								<Button Grid.Column="2" Content="CUT&#x0a;Space" Command="{Binding CutCommand}" Style="{StaticResource OperatorProgramButton}" />
								<Button Grid.Column="4" Content="AUTO / DISSOLVE&#x0a;Ctrl+Space" Command="{Binding DissolveCommand}" Style="{StaticResource OperatorButton}" />
							</Grid>
							<DockPanel Margin="0,12,0,0">
								<TextBlock Text="Dissolve duration" Style="{StaticResource OperatorLabel}" VerticalAlignment="Center" Margin="0,0,10,0" />
								<TextBox Text="{Binding TransitionFrames, UpdateSourceTrigger=PropertyChanged}" Width="90" Style="{StaticResource OperatorTextBox}" HorizontalAlignment="Left" />
								<TextBlock Text="frames" Style="{StaticResource OperatorLabel}" VerticalAlignment="Center" Margin="8,0,0,0" />
							</DockPanel>
						</StackPanel>
					</Border>
				</StackPanel>

				<StackPanel Grid.Column="2">
					<Border Style="{StaticResource OperatorPanel}" Margin="0,0,0,14">
						<StackPanel>
							<TextBlock Text="SYSTEM" Style="{StaticResource OperatorSectionTitle}" Margin="0,0,0,12" />
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="Auto" />
								</Grid.ColumnDefinitions>
								<TextBlock Text="Runtime" Style="{StaticResource OperatorLabel}" />
								<TextBlock Grid.Column="1" Text="{Binding RuntimeStatus}" Style="{StaticResource OperatorValue}" FontWeight="SemiBold" />
								<TextBlock Grid.Row="1" Text="Timing" Style="{StaticResource OperatorLabel}" Margin="0,8,0,0" />
								<TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TimingStatus}" Style="{StaticResource OperatorValue}" Margin="0,8,0,0" />
								<TextBlock Grid.Row="2" Text="Inputs" Style="{StaticResource OperatorLabel}" Margin="0,8,0,0" />
								<TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding InputStatus}" Style="{StaticResource OperatorValue}" Margin="0,8,0,0" />
							</Grid>
						</StackPanel>
					</Border>

					<Border Style="{StaticResource OperatorPanel}" Margin="0,0,0,14">
						<StackPanel>
							<TextBlock Text="ISOLATED SERVICES" Style="{StaticResource OperatorSectionTitle}" Margin="0,0,0,12" />
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="Auto" />
								</Grid.ColumnDefinitions>
								<TextBlock Text="AI" Style="{StaticResource OperatorLabel}" />
								<TextBlock Grid.Column="1" Text="{Binding AIStatus}" Style="{StaticResource OperatorValue}" />
								<TextBlock Grid.Row="1" Text="Recording" Style="{StaticResource OperatorLabel}" Margin="0,8,0,0" />
								<TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding RecordingStatus}" Style="{StaticResource OperatorValue}" Margin="0,8,0,0" />
								<TextBlock Grid.Row="2" Text="Audio peak" Style="{StaticResource OperatorLabel}" Margin="0,8,0,0" />
								<StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,8,0,0">
									<TextBlock Text="{Binding AudioPeakPercent}" Style="{StaticResource OperatorValue}" FontWeight="SemiBold" />
									<TextBlock Text="  (" Style="{StaticResource OperatorLabel}" />
									<TextBlock Text="{Binding AudioPeak}" Style="{StaticResource OperatorLabel}" />
									<TextBlock Text=")" Style="{StaticResource OperatorLabel}" />
								</StackPanel>
							</Grid>
						</StackPanel>
					</Border>

					<Border Style="{StaticResource OperatorPanel}">
						<StackPanel>
							<TextBlock Text="OPERATOR STATE" Style="{StaticResource OperatorSectionTitle}" Margin="0,0,0,12" />
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="Auto" />
								</Grid.ColumnDefinitions>
								<TextBlock Text="Command" Style="{StaticResource OperatorLabel}" />
								<TextBlock Grid.Column="1" Text="{Binding CommandStatus}" Style="{StaticResource OperatorValue}" FontWeight="SemiBold" />
								<TextBlock Grid.Row="1" Text="Busy" Style="{StaticResource OperatorLabel}" Margin="0,8,0,0" />
								<TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding IsBusy}" Style="{StaticResource OperatorValue}" Margin="0,8,0,0" />
								<TextBlock Grid.Row="2" Text="Snapshot stale" Style="{StaticResource OperatorLabel}" Margin="0,8,0,0" />
								<TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding IsStale}" Style="{StaticResource OperatorValue}" Margin="0,8,0,0" />
							</Grid>
						</StackPanel>
					</Border>
				</StackPanel>
			</Grid>
		</ScrollViewer>

		<Border Grid.Row="2" Style="{StaticResource OperatorPanel}" Margin="0,14,0,0" Padding="14,10">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="2*" />
					<ColumnDefinition Width="16" />
					<ColumnDefinition Width="3*" />
				</Grid.ColumnDefinitions>
				<StackPanel>
					<TextBlock Text="LAST EVENT" Style="{StaticResource OperatorLabel}" />
					<TextBlock Text="{Binding LastEvent}" Style="{StaticResource OperatorValue}" Margin="0,2,0,0" TextWrapping="Wrap" />
				</StackPanel>
				<StackPanel Grid.Column="2">
					<TextBlock Text="ERROR / REJECTION" Style="{StaticResource OperatorLabel}" />
					<TextBlock Text="{Binding LastError, TargetNullValue=No active errors.}" Foreground="{DynamicResource OperatorErrorBrush}" FontSize="13" Margin="0,2,0,0" TextWrapping="Wrap" />
				</StackPanel>
			</Grid>
		</Border>
	</Grid>
</Window>
