<Window x:Class="rtaime.Operator.MainWindow"
	x:Name="RootWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="clr-namespace:rtaime.Operator"
	Title="rtaime Operator"
	Width="1600"
	Height="900"
	MinWidth="1100"
	MinHeight="640"
	Background="{DynamicResource OperatorBackgroundBrush}"
	Foreground="{DynamicResource OperatorTextBrush}"
	FontFamily="{StaticResource OperatorFontFamily}"
	UseLayoutRounding="True"
	SnapsToDevicePixels="True"
	TextOptions.TextFormattingMode="Display"
	TextOptions.TextRenderingMode="ClearType"
	KeyboardNavigation.TabNavigation="Cycle"
	KeyboardNavigation.ControlTabNavigation="Cycle"
	WindowStartupLocation="CenterScreen">
	<Window.InputBindings>
		<KeyBinding Key="F5" Command="{Binding SynchronizeCommand}" />
		<KeyBinding Key="P" Modifiers="Control" Command="{Binding SetPreviewCommand}" />
		<KeyBinding Key="Space" Command="{Binding CutCommand}" />
		<KeyBinding Key="Space" Modifiers="Control" Command="{Binding DissolveCommand}" />
		<KeyBinding Key="F11" Command="{Binding Shell.ToggleFullscreenCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
		<KeyBinding Key="Escape" Command="{Binding Shell.ExitFullscreenCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
	</Window.InputBindings>

	<Grid Margin="{StaticResource OperatorWindowPadding}">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="{Binding Shell.LowerSplitterHeight, ElementName=RootWindow}" />
			<RowDefinition Height="{Binding Shell.LowerRowHeight, ElementName=RootWindow, Mode=TwoWay}" MinHeight="0" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<Border x:Name="TopBar" Grid.Row="0" Style="{StaticResource OperatorTopBar}" Margin="0,0,0,6">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>
				<StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
					<TextBlock Text="rtaime" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" />
					<TextBlock Text="  |  V1 Production" Style="{StaticResource OperatorLabel}" VerticalAlignment="Center" />
				</StackPanel>
				<StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
					<Border Style="{StaticResource OperatorLifecycleBadge}" Tag="{Binding EngineLifecycleState}" ToolTip="{Binding EngineLifecycleDetail}" AutomationProperties.Name="Engine lifecycle status">
						<StackPanel Orientation="Horizontal"><TextBlock Text="ENGINE " FontWeight="SemiBold" /><TextBlock Text="{Binding EngineLifecycleState}" FontWeight="Bold" /></StackPanel>
					</Border>
					<Border Style="{StaticResource OperatorStatusBadge}" Margin="6,0,0,0"><TextBlock Text="{Binding ConnectionState}" FontWeight="Bold" /></Border>
				</StackPanel>
				<StackPanel Grid.Column="2" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
					<TextBlock Text="TC " Style="{StaticResource OperatorLabel}" VerticalAlignment="Center" />
					<TextBlock Text="{Binding MediaDeck.Current, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Style="{StaticResource OperatorTimecode}" VerticalAlignment="Center" />
				</StackPanel>
				<StackPanel Grid.Column="3" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
					<TextBlock Text="{Binding CurrentFormat}" Style="{StaticResource OperatorValue}" VerticalAlignment="Center" />
					<Border Style="{StaticResource OperatorStatusBadge}" Margin="10,0,0,0"><StackPanel Orientation="Horizontal"><TextBlock Text="REC " FontWeight="SemiBold" /><TextBlock Text="{Binding RecordingStatus}" FontWeight="Bold" /></StackPanel></Border>
				</StackPanel>
				<StackPanel Grid.Column="4" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
					<Button Content="Open Demo Production" Command="{Binding DemoProduction.OpenCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Style="{StaticResource OperatorProgramButton}" MinHeight="28" Padding="8,3" Margin="0,0,6,0" ToolTip="Prepare the deterministic showcase state. Preview remains under operator TAKE control." AutomationProperties.Name="Open Demo Production" />
					<Button x:Name="SynchronizeButton" Content="SYNC  F5" Command="{Binding SynchronizeCommand}" Style="{StaticResource OperatorAccentButton}" MinHeight="28" Padding="8,3" ToolTip="Synchronize authoritative ControlHost state (F5)." AutomationProperties.Name="Synchronize authoritative state" />
				</StackPanel>
				<StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
					<Button Content="{Binding Shell.CenterModeLabel, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Command="{Binding Shell.ToggleCenterMaximizeCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Style="{StaticResource OperatorButton}" MinHeight="28" Padding="8,3" Margin="0,0,5,0" />
					<Button Content="{Binding Shell.FullscreenLabel, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Command="{Binding Shell.ToggleFullscreenCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Style="{StaticResource OperatorButton}" MinHeight="28" Padding="8,3" Margin="0,0,5,0" />
					<Button Content="LAYOUT RESET" Command="{Binding Shell.ResetLayoutCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Style="{StaticResource OperatorButton}" MinHeight="28" Padding="8,3" Margin="0,0,5,0" />
					<Button Content="HELP" Click="OnHelpClick" Style="{StaticResource OperatorButton}" MinHeight="28" Padding="8,3" />
				</StackPanel>
			</Grid>
		</Border>

		<Grid Grid.Row="1" ClipToBounds="True">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="{Binding Shell.LeftColumnWidth, ElementName=RootWindow, Mode=TwoWay}" MinWidth="0" />
				<ColumnDefinition Width="{Binding Shell.LeftSplitterWidth, ElementName=RootWindow}" />
				<ColumnDefinition Width="*" MinWidth="420" />
				<ColumnDefinition Width="{Binding Shell.RightSplitterWidth, ElementName=RootWindow}" />
				<ColumnDefinition Width="{Binding Shell.RightColumnWidth, ElementName=RootWindow, Mode=TwoWay}" MinWidth="0" />
			</Grid.ColumnDefinitions>

			<Border x:Name="LeftToolRegion" Grid.Column="0" Style="{StaticResource OperatorShellRegion}" Margin="0,0,6,0">
				<Grid>
					<Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
					<DockPanel Margin="0,0,0,10">
						<TextBlock Text="TOOLS / MEDIA" Style="{StaticResource OperatorSectionTitle}" />
						<Button Content="‹" Command="{Binding Shell.ToggleLeftPanelCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Style="{StaticResource OperatorButton}" MinWidth="30" MinHeight="26" Padding="6,2" DockPanel.Dock="Right" ToolTip="Collapse left tools" />
					</DockPanel>
					<StackPanel Grid.Row="1">
						<TextBlock Text="SELECTED SOURCE" Style="{StaticResource OperatorLabel}" />
						<TextBlock Text="{Binding SelectedSource.Name, TargetNullValue=No source selected}" FontWeight="SemiBold" Margin="0,4,0,12" TextTrimming="CharacterEllipsis" />
						<Button Content="OPEN LOCAL MP4" Command="{Binding MediaDeck.OpenCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Style="{StaticResource OperatorAccentButton}" Margin="0,0,0,6" />
						<Button Content="OPEN DEMO PRODUCTION" Command="{Binding DemoProduction.OpenCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Style="{StaticResource OperatorProgramButton}" Margin="0,0,0,12" />
						<Border Style="{StaticResource OperatorStatusBadge}" Margin="0,0,0,8"><StackPanel><TextBlock Text="MEDIA DECK" Style="{StaticResource OperatorLabel}" /><TextBlock Text="{Binding MediaDeck.State, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" FontWeight="Bold" Margin="0,3,0,0" /></StackPanel></Border>
						<Border Style="{StaticResource OperatorStatusBadge}"><StackPanel><TextBlock Text="WORKSPACE" Style="{StaticResource OperatorLabel}" /><TextBlock Text="{Binding Shell.SelectedWorkspace, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" FontWeight="SemiBold" Margin="0,3,0,0" /></StackPanel></Border>
					</StackPanel>
					<TextBlock Grid.Row="2" Text="Panel widths and visibility are local Operator preferences only." Style="{StaticResource OperatorLabel}" TextWrapping="Wrap" Margin="0,10,0,0" />
				</Grid>
			</Border>
			<GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="{DynamicResource OperatorBorderBrush}" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" DragCompleted="OnLayoutSplitterDragCompleted" />

			<ScrollViewer x:Name="CenterWorkspace" Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="2.2*" MinWidth="610" />
					<ColumnDefinition Width="14" />
					<ColumnDefinition Width="1*" MinWidth="300" />
				</Grid.ColumnDefinitions>

				<StackPanel Grid.Column="0">
					<Grid Margin="0,0,0,14">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="12" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>

						<Border Grid.Column="0" Style="{StaticResource OperatorPreviewPanel}">
							<StackPanel>
								<Border Style="{StaticResource OperatorPreviewTally}" HorizontalAlignment="Left"><TextBlock Text="PREVIEW" Foreground="{DynamicResource OperatorPreviewBrush}" FontWeight="Bold" FontSize="13" /></Border>
								<TextBlock Text="{Binding PreviewSourceName}" FontSize="25" FontWeight="SemiBold" Margin="0,10,0,0" TextTrimming="CharacterEllipsis" />
								<TextBlock Text="{Binding PreviewSourceId}" Style="{StaticResource OperatorLabel}" Margin="0,2,0,12" TextTrimming="CharacterEllipsis" />
								<Grid Height="220" Background="#090C10" Margin="0,0,0,12" ClipToBounds="True">
									<Image Source="{Binding Monitoring.PreviewImage, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Stretch="Uniform" SnapsToDevicePixels="True" />
									<Border VerticalAlignment="Bottom" Background="#B0000000" Padding="8,5">
										<TextBlock Text="{Binding Monitoring.PreviewFormat, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" FontSize="11" Foreground="White" TextTrimming="CharacterEllipsis" />
									</Border>
								</Grid>
								<DockPanel Margin="0,0,0,6">
									<TextBlock Text="SIGNAL" Style="{StaticResource OperatorLabel}" />
									<TextBlock Text="{Binding InputStatus}" Style="{StaticResource OperatorValue}" HorizontalAlignment="Right" DockPanel.Dock="Right" />
								</DockPanel>
								<DockPanel>
									<TextBlock Text="TIMING" Style="{StaticResource OperatorLabel}" />
									<TextBlock Text="{Binding TimingStatus}" Style="{StaticResource OperatorValue}" HorizontalAlignment="Right" DockPanel.Dock="Right" />
								</DockPanel>
							</StackPanel>
						</Border>

						<Border Grid.Column="2" Style="{StaticResource OperatorProgramPanel}">
							<StackPanel>
								<Border Style="{StaticResource OperatorProgramTally}" HorizontalAlignment="Left"><TextBlock Text="PROGRAM" Foreground="{DynamicResource OperatorProgramBrush}" FontWeight="Bold" FontSize="13" /></Border>
								<TextBlock Text="{Binding ProgramSourceName}" FontSize="25" FontWeight="SemiBold" Margin="0,10,0,0" TextTrimming="CharacterEllipsis" />
								<TextBlock Text="{Binding ProgramSourceId}" Style="{StaticResource OperatorLabel}" Margin="0,2,0,12" TextTrimming="CharacterEllipsis" />
								<Grid Height="220" Background="#090C10" Margin="0,0,0,12" ClipToBounds="True">
									<Image Source="{Binding Monitoring.ProgramImage, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Stretch="Uniform" SnapsToDevicePixels="True" />
									<Border VerticalAlignment="Bottom" Background="#B0000000" Padding="8,5">
										<TextBlock Text="{Binding Monitoring.ProgramFormat, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" FontSize="11" Foreground="White" TextTrimming="CharacterEllipsis" />
									</Border>
								</Grid>
								<DockPanel Margin="0,0,0,6">
									<TextBlock Text="RUNTIME" Style="{StaticResource OperatorLabel}" />
									<TextBlock Text="{Binding RuntimeStatus}" Style="{StaticResource OperatorValue}" HorizontalAlignment="Right" DockPanel.Dock="Right" />
								</DockPanel>
								<DockPanel Margin="0,0,0,6">
									<TextBlock Text="COMMIT" Style="{StaticResource OperatorLabel}" />
									<TextBlock Text="{Binding CommitStatus}" Style="{StaticResource OperatorValue}" FontWeight="SemiBold" HorizontalAlignment="Right" DockPanel.Dock="Right" />
								</DockPanel>
								<DockPanel Margin="0,0,0,6">
									<TextBlock Text="TRANSITION" Style="{StaticResource OperatorLabel}" />
									<TextBlock Text="{Binding TransitionStatus}" Style="{StaticResource OperatorValue}" HorizontalAlignment="Right" DockPanel.Dock="Right" />
								</DockPanel>
								<DockPanel>
									<TextBlock Text="LAYER" Style="{StaticResource OperatorLabel}" />
									<TextBlock Text="{Binding VisualLayerStatus}" Style="{StaticResource OperatorValue}" HorizontalAlignment="Right" DockPanel.Dock="Right" />
								</DockPanel>
							</StackPanel>
						</Border>
					</Grid>

					<local:MediaDeckControl DataContext="{Binding MediaDeck, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Margin="0,0,0,14" />

					<Border Style="{StaticResource OperatorPanel}" Margin="0,0,0,14">
						<StackPanel>
							<DockPanel Margin="0,0,0,12">
								<TextBlock Text="SOURCE BIN" Style="{StaticResource OperatorSectionTitle}" />
								<TextBlock Text="Select a tile, then Set Preview / Ctrl+P" Style="{StaticResource OperatorLabel}" DockPanel.Dock="Right" VerticalAlignment="Center" />
							</DockPanel>
							<Border Margin="0,0,0,10" IsHitTestVisible="False">
								<Border.Style>
									<Style TargetType="Border" BasedOn="{StaticResource OperatorEmptyState}">
										<Setter Property="Visibility" Value="Collapsed" />
										<Style.Triggers>
											<DataTrigger Binding="{Binding Sources.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
										</Style.Triggers>
									</Style>
								</Border.Style>
								<StackPanel>
									<TextBlock Text="No production sources available" FontWeight="SemiBold" />
									<TextBlock Text="Synchronize with ControlHost to populate the source bank." Style="{StaticResource OperatorLabel}" Margin="0,3,0,0" />
								</StackPanel>
							</Border>
							<ListBox AutomationProperties.Name="Production sources" ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}" Style="{StaticResource OperatorSourceBank}" ItemContainerStyle="{StaticResource OperatorSourceItem}">
								<ListBox.ItemTemplate>
									<DataTemplate>
										<Grid MinHeight="138">
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="200" />
												<ColumnDefinition Width="14" />
												<ColumnDefinition Width="*" />
											</Grid.ColumnDefinitions>
											<Grid Grid.Column="0" Background="#090C10" ClipToBounds="True">
												<Image Source="{Binding Thumbnail}" Stretch="Uniform" SnapsToDevicePixels="True" />
												<Border VerticalAlignment="Bottom" Background="#B0000000" Padding="7,4">
													<TextBlock Text="{Binding ThumbnailFormat}" FontSize="10" Foreground="White" TextTrimming="CharacterEllipsis" />
												</Border>
											</Grid>
											<Grid Grid.Column="2">
												<Grid.RowDefinitions>
													<RowDefinition Height="Auto" />
													<RowDefinition Height="Auto" />
													<RowDefinition Height="*" />
													<RowDefinition Height="Auto" />
												</Grid.RowDefinitions>
												<Grid>
													<Grid.ColumnDefinitions>
														<ColumnDefinition Width="*" />
														<ColumnDefinition Width="Auto" />
													</Grid.ColumnDefinitions>
													<TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="17" TextTrimming="CharacterEllipsis" />
													<StackPanel Grid.Column="1" Orientation="Horizontal">
														<Border Margin="0,0,6,0">
															<Border.Style>
																<Style TargetType="Border" BasedOn="{StaticResource OperatorPreviewTally}">
																	<Setter Property="Visibility" Value="Collapsed" />
																	<Style.Triggers><DataTrigger Binding="{Binding IsPreview}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
																</Style>
															</Border.Style>
															<TextBlock Text="PVW" Foreground="{DynamicResource OperatorPreviewBrush}" FontWeight="Bold" />
														</Border>
														<Border>
															<Border.Style>
																<Style TargetType="Border" BasedOn="{StaticResource OperatorProgramTally}">
																	<Setter Property="Visibility" Value="Collapsed" />
																	<Style.Triggers><DataTrigger Binding="{Binding IsProgram}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
																</Style>
															</Border.Style>
															<TextBlock Text="PGM" Foreground="{DynamicResource OperatorProgramBrush}" FontWeight="Bold" />
														</Border>
													</StackPanel>
												</Grid>
												<TextBlock Grid.Row="1" Text="{Binding Id}" Style="{StaticResource OperatorLabel}" Margin="0,2,0,8" TextTrimming="CharacterEllipsis" />
												<Grid Grid.Row="2">
													<Grid.ColumnDefinitions>
														<ColumnDefinition Width="Auto" />
														<ColumnDefinition Width="12" />
														<ColumnDefinition Width="*" />
													</Grid.ColumnDefinitions>
													<Border Style="{StaticResource OperatorStatusBadge}" Padding="7,3" VerticalAlignment="Top">
														<TextBlock Text="{Binding Type}" FontWeight="Bold" />
													</Border>
													<StackPanel Grid.Column="2">
														<DockPanel Margin="0,0,0,4"><TextBlock Text="FORMAT" Style="{StaticResource OperatorLabel}" /><TextBlock Text="{Binding Format}" Style="{StaticResource OperatorValue}" DockPanel.Dock="Right" /></DockPanel>
														<DockPanel>
															<TextBlock Text="HEALTH" Style="{StaticResource OperatorLabel}" />
															<Border DockPanel.Dock="Right" Padding="7,2">
																<Border.Style>
																	<Style TargetType="Border" BasedOn="{StaticResource OperatorHealthyBadge}">
																		<Style.Triggers>
																			<DataTrigger Binding="{Binding Health}" Value="UNSTABLE"><Setter Property="BorderBrush" Value="{DynamicResource OperatorWarningBrush}" /></DataTrigger>
																			<DataTrigger Binding="{Binding Health}" Value="RECOVERING"><Setter Property="BorderBrush" Value="{DynamicResource OperatorWarningBrush}" /></DataTrigger>
																			<DataTrigger Binding="{Binding Health}" Value="LOST"><Setter Property="BorderBrush" Value="{DynamicResource OperatorErrorBrush}" /></DataTrigger>
																			<DataTrigger Binding="{Binding Health}" Value="ERROR"><Setter Property="BorderBrush" Value="{DynamicResource OperatorErrorBrush}" /></DataTrigger>
																		</Style.Triggers>
																	</Style>
																</Border.Style>
																<TextBlock Text="{Binding Health}" FontWeight="SemiBold" />
															</Border>
														</DockPanel>
													</StackPanel>
												</Grid>
												<DockPanel Grid.Row="3" Margin="0,8,0,0">
													<TextBlock Text="{Binding Detail}" Style="{StaticResource OperatorLabel}" TextTrimming="CharacterEllipsis" />
													<TextBlock Text="{Binding StateDetail}" Style="{StaticResource OperatorValue}" FontWeight="SemiBold" DockPanel.Dock="Right" />
												</DockPanel>
											</Grid>
										</Grid>
									</DataTemplate>
								</ListBox.ItemTemplate>
							</ListBox>
						</StackPanel>
					</Border>

					<Border Style="{StaticResource OperatorPanel}">
						<StackPanel>
							<TextBlock Text="TRANSITION" Style="{StaticResource OperatorSectionTitle}" Margin="0,0,0,12" />
							<Grid Margin="0,0,0,12">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="14" />
									<ColumnDefinition Width="*" />
								</Grid.ColumnDefinitions>
								<StackPanel>
									<TextBlock Text="SELECTED SOURCE" Style="{StaticResource OperatorLabel}" />
									<TextBlock Text="{Binding SelectedSource.Name, TargetNullValue=No source selected}" FontSize="18" FontWeight="SemiBold" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
								</StackPanel>
								<Border Grid.Column="2" Style="{StaticResource OperatorPreviewTally}">
									<StackPanel>
										<TextBlock Text="CONFIRMED PREVIEW / NEXT TAKE" Style="{StaticResource OperatorLabel}" Foreground="{DynamicResource OperatorPreviewBrush}" />
										<TextBlock Text="{Binding PreviewSourceName}" FontSize="18" FontWeight="SemiBold" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
									</StackPanel>
								</Border>
							</Grid>
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="10" />
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="10" />
									<ColumnDefinition Width="*" />
								</Grid.ColumnDefinitions>
								<Button Grid.Column="0" Content="SET SELECTED → PREVIEW&#x0a;Ctrl+P" Command="{Binding SetPreviewCommand}" Style="{StaticResource OperatorAccentButton}" ToolTip="Route the selected source to confirmed Preview (Ctrl+P)." AutomationProperties.Name="Set selected source to Preview" />
								<Button Grid.Column="2" Content="CUT PREVIEW → PROGRAM&#x0a;Space" Command="{Binding CutCommand}" Style="{StaticResource OperatorProgramButton}" ToolTip="CUT the confirmed Preview source to Program (Space)." AutomationProperties.Name="Cut Preview to Program" />
								<Button Grid.Column="4" Content="AUTO PREVIEW → PROGRAM&#x0a;Ctrl+Space" Command="{Binding DissolveCommand}" Style="{StaticResource OperatorButton}" ToolTip="Dissolve the confirmed Preview source to Program (Ctrl+Space)." AutomationProperties.Name="Dissolve Preview to Program" />
							</Grid>
							<DockPanel Margin="0,12,0,0">
								<TextBlock Text="Dissolve duration" Style="{StaticResource OperatorLabel}" VerticalAlignment="Center" Margin="0,0,10,0" />
								<TextBox Text="{Binding TransitionFrames, UpdateSourceTrigger=PropertyChanged}" Width="90" Style="{StaticResource OperatorTextBox}" HorizontalAlignment="Left" />
								<TextBlock Text="frames" Style="{StaticResource OperatorLabel}" VerticalAlignment="Center" Margin="8,0,0,0" />
							</DockPanel>
						</StackPanel>
					</Border>
				</StackPanel>

				<StackPanel Grid.Column="2">
					<Border Style="{StaticResource OperatorPanel}" Margin="0,0,0,14">
						<StackPanel>
							<DockPanel Margin="0,0,0,12">
								<TextBlock Text="SYSTEM STATUS" Style="{StaticResource OperatorSectionTitle}" />
								<Border Style="{StaticResource OperatorEvidenceBadge}" Tag="{Binding EngineHealth}" DockPanel.Dock="Right">
									<TextBlock Text="{Binding EngineHealth}" FontWeight="Bold" />
								</Border>
							</DockPanel>
							<TextBlock Text="{Binding EngineHealthDetail}" Style="{StaticResource OperatorLabel}" TextWrapping="Wrap" Margin="0,0,0,12" />
							<DockPanel Margin="0,0,0,6"><TextBlock Text="Lifecycle" Style="{StaticResource OperatorLabel}" /><Border Style="{StaticResource OperatorLifecycleBadge}" Tag="{Binding EngineLifecycleState}" DockPanel.Dock="Right"><TextBlock Text="{Binding EngineLifecycleState}" FontWeight="Bold" /></Border></DockPanel>
							<DockPanel Margin="0,0,0,6"><TextBlock Text="Program Safety" Style="{StaticResource OperatorLabel}" /><TextBlock Text="{Binding ProgramSafety}" Style="{StaticResource OperatorValue}" FontWeight="SemiBold" DockPanel.Dock="Right" /></DockPanel>
							<DockPanel Margin="0,0,0,12"><TextBlock Text="Affected" Style="{StaticResource OperatorLabel}" /><TextBlock Text="{Binding AffectedComponent}" Style="{StaticResource OperatorValue}" DockPanel.Dock="Right" /></DockPanel>
							<Grid Margin="0,0,0,12">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="6" />
									<ColumnDefinition Width="*" />
								</Grid.ColumnDefinitions>
								<StackPanel Grid.Column="0">
									<DockPanel Margin="0,0,0,6"><TextBlock Text="Control" Style="{StaticResource OperatorLabel}" /><Border Style="{StaticResource OperatorEvidenceBadge}" Tag="{Binding ControlHealth}" DockPanel.Dock="Right"><TextBlock Text="{Binding ControlHealth}" FontWeight="Bold" /></Border></DockPanel>
									<DockPanel Margin="0,0,0,6"><TextBlock Text="Runtime" Style="{StaticResource OperatorLabel}" /><Border Style="{StaticResource OperatorEvidenceBadge}" Tag="{Binding RuntimeHealth}" DockPanel.Dock="Right"><TextBlock Text="{Binding RuntimeHealth}" FontWeight="Bold" /></Border></DockPanel>
									<DockPanel><TextBlock Text="Media" Style="{StaticResource OperatorLabel}" /><Border Style="{StaticResource OperatorEvidenceBadge}" Tag="{Binding MediaHealth}" DockPanel.Dock="Right"><TextBlock Text="{Binding MediaHealth}" FontWeight="Bold" /></Border></DockPanel>
								</StackPanel>
								<StackPanel Grid.Column="2">
									<DockPanel Margin="0,0,0,6"><TextBlock Text="Providers" Style="{StaticResource OperatorLabel}" /><Border Style="{StaticResource OperatorEvidenceBadge}" Tag="{Binding ProviderHealth}" DockPanel.Dock="Right"><TextBlock Text="{Binding ProviderHealth}" FontWeight="Bold" /></Border></DockPanel>
									<DockPanel Margin="0,0,0,6"><TextBlock Text="GPU Provider" Style="{StaticResource OperatorLabel}" /><Border Style="{StaticResource OperatorEvidenceBadge}" Tag="{Binding GpuProviderHealth}" DockPanel.Dock="Right"><TextBlock Text="{Binding GpuProviderHealth}" FontWeight="Bold" /></Border></DockPanel>
									<DockPanel Margin="0,0,0,6"><TextBlock Text="AI" Style="{StaticResource OperatorLabel}" /><Border Style="{StaticResource OperatorStatusBadge}" DockPanel.Dock="Right"><TextBlock Text="{Binding AIStatus}" FontWeight="Bold" /></Border></DockPanel>
									<DockPanel><TextBlock Text="Recording" Style="{StaticResource OperatorLabel}" /><Border Style="{StaticResource OperatorStatusBadge}" DockPanel.Dock="Right"><TextBlock Text="{Binding RecordingStatus}" FontWeight="Bold" /></Border></DockPanel>
								</StackPanel>
							</Grid>
							<TextBlock Text="{Binding RecoveryAction}" Style="{StaticResource OperatorLabel}" TextWrapping="Wrap" Margin="0,0,0,12" />
							<Border Height="1" Background="{DynamicResource OperatorBorderBrush}" Margin="0,0,0,12" />
							<DockPanel Margin="0,0,0,6"><TextBlock Text="Current Format" Style="{StaticResource OperatorLabel}" /><TextBlock Text="{Binding CurrentFormat}" Style="{StaticResource OperatorValue}" DockPanel.Dock="Right" /></DockPanel>
