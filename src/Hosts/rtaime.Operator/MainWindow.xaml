							</DockPanel>
							<Grid Margin="0,0,0,3">
								<Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /><ColumnDefinition Width="48" /></Grid.ColumnDefinitions>
								<TextBlock Text="L" Style="{StaticResource OperatorLabel}" VerticalAlignment="Center" />
								<ProgressBar Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding AudioLeftPeak, Mode=OneWay}" Style="{StaticResource OperatorMeter}" VerticalAlignment="Center" />
								<TextBlock Grid.Column="2" Text="{Binding AudioLeftPeak, StringFormat={}{0:P0}}" Style="{StaticResource OperatorLabel}" HorizontalAlignment="Right" />
							</Grid>
							<Grid Margin="0,0,0,10">
								<Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /><ColumnDefinition Width="48" /></Grid.ColumnDefinitions>
								<TextBlock Text="R" Style="{StaticResource OperatorLabel}" VerticalAlignment="Center" />
								<ProgressBar Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding AudioRightPeak, Mode=OneWay}" Style="{StaticResource OperatorMeter}" VerticalAlignment="Center" />
								<TextBlock Grid.Column="2" Text="{Binding AudioRightPeak, StringFormat={}{0:P0}}" Style="{StaticResource OperatorLabel}" HorizontalAlignment="Right" />
							</Grid>
							<DockPanel Margin="0,0,0,10">
								<TextBlock Text="MASTER" Style="{StaticResource OperatorLabel}" />
								<TextBlock Text="{Binding AudioPeakPercent}" Style="{StaticResource OperatorValue}" FontWeight="SemiBold" DockPanel.Dock="Right" />
							</DockPanel>
							<ProgressBar Minimum="0" Maximum="1" Value="{Binding AudioMasterPeak, Mode=OneWay}" Style="{StaticResource OperatorMeter}" Margin="0,0,0,12" />
							<ListBox ItemsSource="{Binding AudioInputs}" SelectedItem="{Binding SelectedAudioInput}" Style="{StaticResource OperatorSourceBank}" MaxHeight="190" Margin="0,0,0,10">
								<ListBox.ItemContainerStyle><StaticResource ResourceKey="OperatorSourceItem" /></ListBox.ItemContainerStyle>
								<ListBox.ItemTemplate>
									<DataTemplate>
										<StackPanel>
											<DockPanel>
												<TextBlock Text="{Binding SourceName}" Style="{StaticResource OperatorValue}" FontWeight="SemiBold" />
												<TextBlock Text="{Binding AfvLabel}" Style="{StaticResource OperatorLabel}" DockPanel.Dock="Right" />
											</DockPanel>
											<DockPanel Margin="0,4,0,4">
												<TextBlock Text="{Binding SourceType}" Style="{StaticResource OperatorLabel}" />
												<TextBlock Text="{Binding Health}" Style="{StaticResource OperatorLabel}" DockPanel.Dock="Right" />
											</DockPanel>
											<Grid>
												<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="6" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
												<ProgressBar Grid.Column="0" Minimum="0" Maximum="1" Value="{Binding LeftPeak, Mode=OneWay}" Style="{StaticResource OperatorMeter}" />
												<ProgressBar Grid.Column="2" Minimum="0" Maximum="1" Value="{Binding RightPeak, Mode=OneWay}" Style="{StaticResource OperatorMeter}" />
											</Grid>
										</StackPanel>
									</DataTemplate>
								</ListBox.ItemTemplate>
							</ListBox>
							<Grid Margin="0,0,0,8">
								<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
								<StackPanel Grid.Column="0">
									<TextBlock Text="Selected gain 0.0–4.0x" Style="{StaticResource OperatorLabel}" />
									<TextBox Text="{Binding SelectedAudioInput.Gain, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource OperatorTextBox}" />
								</StackPanel>
								<StackPanel Grid.Column="2">
									<TextBlock Text="Confirmed mute" Style="{StaticResource OperatorLabel}" />
									<TextBlock Text="{Binding SelectedAudioInput.Muted}" Style="{StaticResource OperatorValue}" Margin="0,8,0,0" />
								</StackPanel>
							</Grid>
							<Grid>
								<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="6" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
								<Button Grid.Column="0" Content="APPLY GAIN" Command="{Binding ApplyAudioGainCommand}" Style="{StaticResource OperatorAccentButton}" />
								<Button Grid.Column="2" Content="{Binding SelectedAudioInput.MuteActionLabel}" Command="{Binding ToggleAudioMuteCommand}" Style="{StaticResource OperatorButton}" />
							</Grid>
							<DockPanel Margin="0,10,0,0">
								<TextBlock Text="Clip audio" Style="{StaticResource OperatorLabel}" />
								<TextBlock Text="{Binding ClipAudioStatus}" Style="{StaticResource OperatorLabel}" DockPanel.Dock="Right" TextTrimming="CharacterEllipsis" MaxWidth="230" />
							</DockPanel>
							<TextBlock Text="Meters are RuntimeHost observations; no WPF-generated meter animation is used." Style="{StaticResource OperatorLabel}" TextWrapping="Wrap" Margin="0,8,0,0" />
						</StackPanel>
					</Border>

					<Border Style="{StaticResource OperatorPanel}" Margin="0,0,0,14">
						<StackPanel>
							<DockPanel Margin="0,0,0,12">
								<TextBlock Text="PROGRAM RECORDING" Style="{StaticResource OperatorSectionTitle}" />
								<Border Style="{StaticResource OperatorStatusBadge}" DockPanel.Dock="Right">
									<StackPanel Orientation="Horizontal">
										<TextBlock Text="REC · " FontWeight="Bold" />
										<TextBlock Text="{Binding RecordingStatus}" FontWeight="Bold" />
									</StackPanel>
								</Border>
							</DockPanel>
							<TextBlock Text="{Binding RecordingElapsed}" Style="{StaticResource OperatorTimecode}" FontSize="24" FontWeight="Bold" Margin="0,0,0,12" />
							<TextBlock Text="DESTINATION" Style="{StaticResource OperatorLabel}" />
							<TextBox Text="{Binding RecordingDestination, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource OperatorTextBox}" Margin="0,4,0,10" />
							<TextBlock Text="FILE NAME" Style="{StaticResource OperatorLabel}" />
							<TextBox Text="{Binding RecordingFileName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource OperatorTextBox}" Margin="0,4,0,10" />
							<Grid Margin="0,0,0,10">
								<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="6" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
								<Button Grid.Column="0" Content="START REC" Command="{Binding StartRecordingCommand}" Style="{StaticResource OperatorProgramButton}" ToolTip="Start recording confirmed Program video/audio/graphics." />
								<Button Grid.Column="2" Content="STOP REC" Command="{Binding StopRecordingCommand}" Style="{StaticResource OperatorButton}" ToolTip="Stop and finalize the active Program recording." />
							</Grid>
							<DockPanel Margin="0,0,0,6">
								<TextBlock Text="Samples" Style="{StaticResource OperatorLabel}" />
								<TextBlock Text="{Binding RecordingStatistics}" Style="{StaticResource OperatorLabel}" DockPanel.Dock="Right" />
							</DockPanel>
							<TextBlock Text="Final file" Style="{StaticResource OperatorLabel}" />
							<TextBlock Text="{Binding RecordingFinalPath}" Style="{StaticResource OperatorValue}" TextWrapping="Wrap" Margin="0,4,0,0" />
							<TextBlock Text="{Binding RecordingError}" Foreground="{DynamicResource OperatorErrorBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
						</StackPanel>
					</Border>

					<Border Style="{StaticResource OperatorPanel}" Margin="0,0,0,14"
						Visibility="{Binding Shell.AIVisibility, RelativeSource={RelativeSource AncestorType={x:Type Window}}}">
						<StackPanel>
							<DockPanel Margin="0,0,0,12">
								<TextBlock Text="AI / PERSON SEGMENTATION" Style="{StaticResource OperatorSectionTitle}" />
								<Border Style="{StaticResource OperatorStatusBadge}" DockPanel.Dock="Right">
									<TextBlock Text="{Binding AIStatus}" FontWeight="Bold" />
								</Border>
							</DockPanel>
							<TextBlock Text="{Binding AIFeature}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />
							<DockPanel Margin="0,0,0,6"><TextBlock Text="Enabled" Style="{StaticResource OperatorLabel}" /><TextBlock Text="{Binding AIEnabled}" Style="{StaticResource OperatorValue}" DockPanel.Dock="Right" /></DockPanel>
							<DockPanel Margin="0,0,0,6"><TextBlock Text="Provider" Style="{StaticResource OperatorLabel}" /><TextBlock Text="{Binding AIProvider}" Style="{StaticResource OperatorValue}" DockPanel.Dock="Right" TextTrimming="CharacterEllipsis" MaxWidth="230" /></DockPanel>
							<DockPanel Margin="0,0,0,6"><TextBlock Text="Inference Time" Style="{StaticResource OperatorLabel}" /><TextBlock Text="{Binding AIInferenceTime}" Style="{StaticResource OperatorTimecode}" DockPanel.Dock="Right" /></DockPanel>
							<DockPanel Margin="0,0,0,6"><TextBlock Text="Person Regions" Style="{StaticResource OperatorLabel}" /><TextBlock Text="{Binding AIPersonRegions}" Style="{StaticResource OperatorValue}" FontWeight="SemiBold" DockPanel.Dock="Right" /></DockPanel>
							<DockPanel Margin="0,0,0,6"><TextBlock Text="Confidence" Style="{StaticResource OperatorLabel}" /><TextBlock Text="{Binding AIConfidence}" Style="{StaticResource OperatorValue}" DockPanel.Dock="Right" /></DockPanel>
							<DockPanel Margin="0,0,0,10"><TextBlock Text="Synchronization" Style="{StaticResource OperatorLabel}" /><TextBlock Text="{Binding AISynchronization}" Style="{StaticResource OperatorLabel}" DockPanel.Dock="Right" /></DockPanel>
							<Grid>
								<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="6" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
								<Button Grid.Column="0" Content="AI ON" Command="{Binding EnableAIShowcaseCommand}" Style="{StaticResource OperatorAccentButton}" ToolTip="Enable the governed Person Segmentation Highlight through AIHost." />
								<Button Grid.Column="2" Content="AI OFF" Command="{Binding DisableAIShowcaseCommand}" Style="{StaticResource OperatorButton}" ToolTip="Disable the AI showcase effect without interrupting Program." />
							</Grid>
							<TextBlock Text="{Binding AIError}" Foreground="{DynamicResource OperatorWarningBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
							<TextBlock Text="Inference executes in AIHost. RuntimeHost applies only synchronized segmentation results; failure falls back to clean Program." Style="{StaticResource OperatorLabel}" TextWrapping="Wrap" Margin="0,8,0,0" />
						</StackPanel>
					</Border>

					<Border Style="{StaticResource OperatorPanel}"
						Visibility="{Binding Shell.OperatorStateVisibility, RelativeSource={RelativeSource AncestorType={x:Type Window}}}">
						<StackPanel>
							<TextBlock Text="OPERATOR STATE" Style="{StaticResource OperatorSectionTitle}" Margin="0,0,0,12" />
							<DockPanel Margin="0,0,0,8"><TextBlock Text="Command" Style="{StaticResource OperatorLabel}" /><TextBlock Text="{Binding CommandStatus}" Style="{StaticResource OperatorValue}" FontWeight="SemiBold" DockPanel.Dock="Right" /></DockPanel>
														<DockPanel Margin="0,0,0,8"><TextBlock Text="Commit" Style="{StaticResource OperatorLabel}" /><TextBlock Text="{Binding CommitStatus}" Style="{StaticResource OperatorValue}" DockPanel.Dock="Right" /></DockPanel>
														<DockPanel Margin="0,0,0,8"><TextBlock Text="Transition" Style="{StaticResource OperatorLabel}" /><TextBlock Text="{Binding TransitionStatus}" Style="{StaticResource OperatorValue}" DockPanel.Dock="Right" /></DockPanel>
							<TextBlock Text="{Binding LastEvent}" Style="{StaticResource OperatorLabel}" TextWrapping="Wrap" />
						</StackPanel>
					</Border>
				</StackPanel>
			</Grid>
		</ScrollViewer>
			<GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch" Background="{DynamicResource OperatorBorderBrush}" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" DragCompleted="OnLayoutSplitterDragCompleted" />
			<Border x:Name="RightInspectorRegion" Grid.Column="4" Style="{StaticResource OperatorShellRegion}" Margin="6,0,0,0">
				<Grid>
					<Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
					<DockPanel Margin="0,0,0,10">
						<TextBlock Text="INSPECTOR" Style="{StaticResource OperatorSectionTitle}" />
						<Button Content="›" Command="{Binding Shell.ToggleRightPanelCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Style="{StaticResource OperatorButton}" MinWidth="30" MinHeight="26" Padding="6,2" DockPanel.Dock="Right" ToolTip="Collapse inspector" />
					</DockPanel>

					<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
						<StackPanel>
							<TextBlock Text="No selection. Select a Media Pool resource, timeline item or cue to inspect its context."
								TextWrapping="Wrap" Margin="0,0,0,10">
								<TextBlock.Style>
									<Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource OperatorLabel}">
										<Setter Property="Visibility" Value="Visible" />
										<Style.Triggers>
											<DataTrigger Binding="{Binding MediaPool.HasSelection, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="True">
												<Setter Property="Visibility" Value="Collapsed" />
											</DataTrigger>
										</Style.Triggers>
									</Style>
								</TextBlock.Style>
							</TextBlock>

							<StackPanel>
								<StackPanel.Style>
									<Style TargetType="{x:Type StackPanel}">
										<Setter Property="Visibility" Value="Collapsed" />
										<Style.Triggers>
											<DataTrigger Binding="{Binding MediaPool.HasSelection, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="True">
												<Setter Property="Visibility" Value="Visible" />
											</DataTrigger>
										</Style.Triggers>
									</Style>
								</StackPanel.Style>

								<TextBlock Text="{Binding MediaPool.InspectorTitle, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
									FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
								<TextBlock Text="{Binding MediaPool.InspectorDetail, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
									Style="{StaticResource OperatorLabel}" TextWrapping="Wrap" Margin="0,3,0,10" />

								<ItemsControl ItemsSource="{Binding MediaPool.InspectorProperties, RelativeSource={RelativeSource AncestorType={x:Type Window}}}">
									<ItemsControl.ItemTemplate>
										<DataTemplate>
											<Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource OperatorBorderBrush}" Padding="0,5">
												<Grid>
													<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
													<StackPanel>
														<TextBlock Text="{Binding Label}" Style="{StaticResource OperatorLabel}" />
														<TextBlock Text="{Binding Value}" Style="{StaticResource OperatorValue}" TextWrapping="Wrap" />
													</StackPanel>
													<StackPanel Grid.Column="1" HorizontalAlignment="Right">
														<TextBlock Text="{Binding State}" Style="{StaticResource OperatorLabel}" HorizontalAlignment="Right" />
														<Button Content="PIN"
															Command="{Binding QuickControls.TogglePinCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
															CommandParameter="{Binding}"
															Style="{StaticResource OperatorButton}"
															HorizontalAlignment="Right"
															MinHeight="22"
															Padding="5,1"
															ToolTip="{Binding PropertyId}">
															<Button.Style>
																<Style TargetType="{x:Type Button}" BasedOn="{StaticResource OperatorButton}">
																	<Setter Property="Visibility" Value="Collapsed" />
																	<Style.Triggers><DataTrigger Binding="{Binding IsPinnable}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
																</Style>
															</Button.Style>
														</Button>
													</StackPanel>
												</Grid>
											</Border>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>

								<StackPanel Margin="0,12,0,0">
									<StackPanel.Style>
										<Style TargetType="{x:Type StackPanel}">
											<Setter Property="Visibility" Value="Collapsed" />
											<Style.Triggers><DataTrigger Binding="{Binding MediaPool.IsClipSelection, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
										</Style>
									</StackPanel.Style>
									<TextBlock Text="DESIRED CONFIGURATION" Style="{StaticResource OperatorSectionTitle}" Margin="0,0,0,6" />
									<CheckBox Content="Auto Play on Program" IsChecked="{Binding MediaDeck.AutoPlayOnProgram, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Mode=TwoWay}" Margin="0,0,0,6" />
									<ComboBox ItemsSource="{Binding MediaDeck.EndBehaviors, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
										SelectedItem="{Binding MediaDeck.EndBehavior, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Mode=TwoWay}" Margin="0,0,0,6" />
									<Button Content="APPLY PLAYBACK POLICY"
										Command="{Binding MediaDeck.ApplyPlaybackPolicyCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
										Style="{StaticResource OperatorAccentButton}" />
									<TextBlock Text="Committed range and playback state update only from the confirmed Media Deck snapshot." Style="{StaticResource OperatorLabel}" TextWrapping="Wrap" Margin="0,6,0,0" />
								</StackPanel>

								<StackPanel Margin="0,12,0,0">
									<StackPanel.Style>
										<Style TargetType="{x:Type StackPanel}">
											<Setter Property="Visibility" Value="Collapsed" />
											<Style.Triggers><DataTrigger Binding="{Binding MediaPool.IsCueSelection, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
										</Style>
									</StackPanel.Style>
									<TextBlock Text="CUE EDITING" Style="{StaticResource OperatorSectionTitle}" Margin="0,0,0,6" />
									<TextBox Text="{Binding MediaDeck.CueName, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource OperatorTextBox}" Margin="0,0,0,6" />
									<Grid>
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="*" />
											<ColumnDefinition Width="5" />
											<ColumnDefinition Width="*" />
											<ColumnDefinition Width="5" />
											<ColumnDefinition Width="*" />
										</Grid.ColumnDefinitions>
										<Button Grid.Column="0" Content="JUMP" Command="{Binding MediaDeck.JumpCueCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Style="{StaticResource OperatorButton}" />
										<Button Grid.Column="2" Content="RENAME" Command="{Binding MediaDeck.RenameCueCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Style="{StaticResource OperatorAccentButton}" />
										<Button Grid.Column="4" Content="DELETE" Command="{Binding MediaDeck.DeleteCueCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Style="{StaticResource OperatorButton}" />
									</Grid>
									<TextBlock Text="Cue mutations remain explicit Media Deck marker commands." Style="{StaticResource OperatorLabel}" TextWrapping="Wrap" Margin="0,6,0,0" />
								</StackPanel>

								<StackPanel Margin="0,12,0,0">
									<StackPanel.Style>
										<Style TargetType="{x:Type StackPanel}">
											<Setter Property="Visibility" Value="Collapsed" />
											<Style.Triggers><DataTrigger Binding="{Binding MediaPool.IsAudioSelection, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
										</Style>
									</StackPanel.Style>
									<TextBlock Text="DESIRED CONFIGURATION" Style="{StaticResource OperatorSectionTitle}" Margin="0,0,0,6" />
									<TextBlock Text="Gain 0.0–4.0x" Style="{StaticResource OperatorLabel}" />
									<TextBox Text="{Binding SelectedAudioInput.Gain, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource OperatorTextBox}" Margin="0,3,0,6" />
									<Grid>
										<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="6" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
										<Button Grid.Column="0" Content="APPLY GAIN" Command="{Binding ApplyAudioGainCommand}" Style="{StaticResource OperatorAccentButton}" />
										<Button Grid.Column="2" Content="{Binding SelectedAudioInput.MuteActionLabel}" Command="{Binding ToggleAudioMuteCommand}" Style="{StaticResource OperatorButton}" />
									</Grid>
								</StackPanel>

								<StackPanel Margin="0,12,0,0">
									<StackPanel.Style>
										<Style TargetType="{x:Type StackPanel}">
											<Setter Property="Visibility" Value="Collapsed" />
											<Style.Triggers><DataTrigger Binding="{Binding MediaPool.IsGraphicsSelection, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
										</Style>
									</StackPanel.Style>
									<TextBlock Text="DESIRED CONFIGURATION" Style="{StaticResource OperatorSectionTitle}" Margin="0,0,0,6" />
									<TextBlock Text="Position X %" Style="{StaticResource OperatorLabel}" />
									<TextBox Text="{Binding GraphicsPositionX, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource OperatorTextBox}" Margin="0,3,0,5" />
									<TextBlock Text="Position Y %" Style="{StaticResource OperatorLabel}" />
									<TextBox Text="{Binding GraphicsPositionY, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource OperatorTextBox}" Margin="0,3,0,5" />
									<TextBlock Text="Scale" Style="{StaticResource OperatorLabel}" />
									<TextBox Text="{Binding GraphicsScale, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource OperatorTextBox}" Margin="0,3,0,6" />
									<Button Content="APPLY GRAPHICS" Command="{Binding ApplyGraphicsCommand}" Style="{StaticResource OperatorAccentButton}" />
								</StackPanel>

								<StackPanel Margin="0,12,0,0">
									<StackPanel.Style>
										<Style TargetType="{x:Type StackPanel}">
											<Setter Property="Visibility" Value="Collapsed" />
											<Style.Triggers><DataTrigger Binding="{Binding MediaPool.IsCompositionSelection, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
										</Style>
									</StackPanel.Style>
									<TextBlock Text="AI EFFECT CONTROL" Style="{StaticResource OperatorSectionTitle}" Margin="0,0,0,6" />
									<Grid>
										<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="6" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
										<Button Grid.Column="0" Content="AI ON" Command="{Binding EnableAIShowcaseCommand}" Style="{StaticResource OperatorAccentButton}" />
										<Button Grid.Column="2" Content="AI OFF" Command="{Binding DisableAIShowcaseCommand}" Style="{StaticResource OperatorButton}" />
									</Grid>
									<TextBlock Text="Feature, provider, confidence and fallback above are confirmed observations." Style="{StaticResource OperatorLabel}" TextWrapping="Wrap" Margin="0,6,0,0" />
								</StackPanel>
							</StackPanel>
							</StackPanel>
						</ScrollViewer>

					<TextBlock Grid.Row="2"
						Text="METADATA is read-only. DESIRED edits are local until APPLY succeeds and authoritative state is re-observed as COMMITTED."
						Style="{StaticResource OperatorLabel}" TextWrapping="Wrap" Margin="0,10,0,0" />
				</Grid>
			</Border>
		</Grid>

		<GridSplitter Grid.Row="2" Height="{Binding Shell.LowerSplitterHeight, ElementName=RootWindow}" VerticalAlignment="Stretch" Background="{DynamicResource OperatorBorderBrush}" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" DragCompleted="OnLayoutSplitterDragCompleted" />
		<Border x:Name="LowerTimelineRegion" Grid.Row="3" Style="{StaticResource OperatorShellRegion}" Margin="0,6,0,6" ClipToBounds="True"
			Visibility="{Binding Shell.TimelineRegionVisibility, RelativeSource={RelativeSource AncestorType={x:Type Window}}}">
			<Grid>
				<Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
				<DockPanel Margin="0,0,0,8">
					<TextBlock Text="TIMELINE / CUES" Style="{StaticResource OperatorSectionTitle}" />
					<TextBlock Text="{Binding MediaDeck.StatusDetail, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Style="{StaticResource OperatorLabel}" DockPanel.Dock="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="760" />
				</DockPanel>
				<local:MediaTimelineControl Grid.Row="1"
					AllowDrop="True"
					DragOver="OnTimelineDragOver"
					Drop="OnTimelineDrop"
					DataContext="{Binding Timeline, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
			</Grid>
		</Border>

		<Border x:Name="BottomTransportRegion" Grid.Row="4" Style="{StaticResource OperatorTransportBar}">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>
				<StackPanel Grid.Column="0" Orientation="Horizontal">
					<Button Content="PLAY / PAUSE  Space" Command="{Binding MediaDeck.TogglePlayPauseCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Style="{StaticResource OperatorAccentButton}" MinHeight="28" Padding="10,3" Margin="0,0,6,0" />
					<Button Content="STOP  K / S" Command="{Binding MediaDeck.StopCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Style="{StaticResource OperatorButton}" MinHeight="28" Padding="10,3" />
				</StackPanel>
				<StackPanel Grid.Column="1" Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
					<TextBlock Text="{Binding MediaDeck.Current, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Style="{StaticResource OperatorTimecode}" FontSize="16" FontWeight="Bold" />
					<TextBlock Text="{Binding MediaDeck.Countdown, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Style="{StaticResource OperatorTimecode}" Margin="12,0,0,0" />
				</StackPanel>
				<Border Grid.Column="2" Style="{StaticResource OperatorStatusBadge}" Margin="14,0,0,0" VerticalAlignment="Center"><TextBlock Text="{Binding MediaDeck.ProgramDeckState, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" FontWeight="Bold" /></Border>
				<TextBlock Grid.Column="3" Text="{Binding LastEvent}" Margin="14,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
				<Border Grid.Column="4" MaxWidth="420" ToolTip="{Binding LastError}">
					<Border.Style><Style TargetType="Border" BasedOn="{StaticResource OperatorErrorBadge}"><Style.Triggers><DataTrigger Binding="{Binding LastError}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger><DataTrigger Binding="{Binding LastError}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Border.Style>
					<TextBlock Text="{Binding LastError}" Foreground="{DynamicResource OperatorErrorBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
				</Border>
				<Button Grid.Column="5" Content="{Binding Shell.FullscreenLabel, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Command="{Binding Shell.ToggleFullscreenCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Style="{StaticResource OperatorButton}" MinHeight="28" Padding="8,3" Margin="8,0,0,0" />
			</Grid>
		</Border>

		<Border Grid.RowSpan="5" Panel.ZIndex="100" Background="{DynamicResource OperatorSurfaceBrush}" BorderBrush="{DynamicResource OperatorBorderBrush}" BorderThickness="1">
			<Border.Style>
				<Style TargetType="Border">
					<Setter Property="Visibility" Value="Visible" />
					<Style.Triggers>
						<DataTrigger Binding="{Binding StartupComplete}" Value="True">
							<Setter Property="Visibility" Value="Collapsed" />
						</DataTrigger>
					</Style.Triggers>
				</Style>
			</Border.Style>
			<Grid MaxWidth="620" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="32">
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>
				<StackPanel>
					<TextBlock Text="rtaime" FontSize="36" FontWeight="SemiBold" HorizontalAlignment="Center" />
					<TextBlock Text="Production-grade real-time AI media platform." Style="{StaticResource OperatorLabel}" HorizontalAlignment="Center" Margin="0,6,0,24" />
					<Border Style="{StaticResource OperatorLifecycleBadge}" Tag="{Binding EngineLifecycleState}" HorizontalAlignment="Center" Margin="0,0,0,14">
						<StackPanel Orientation="Horizontal">
							<TextBlock Text="ENGINE " FontWeight="SemiBold" />
							<TextBlock Text="{Binding EngineLifecycleState}" FontWeight="Bold" />
						</StackPanel>
					</Border>
					<TextBlock Text="{Binding EngineLifecycleDetail}" FontSize="16" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,22" />
				</StackPanel>
				<Grid Grid.Row="1" Margin="70,0">
					<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
					<Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
					<TextBlock Text="Control" Style="{StaticResource OperatorLabel}" Margin="0,4" />
					<TextBlock Grid.Column="1" Text="{Binding ControlHealth}" FontWeight="SemiBold" Margin="20,4,0,4" />
					<TextBlock Grid.Row="1" Text="Runtime" Style="{StaticResource OperatorLabel}" Margin="0,4" />
					<TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding RuntimeHealth}" FontWeight="SemiBold" Margin="20,4,0,4" />
					<TextBlock Grid.Row="2" Text="AI" Style="{StaticResource OperatorLabel}" Margin="0,4" />
					<TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding AIStatus}" FontWeight="SemiBold" Margin="20,4,0,4" />
					<TextBlock Grid.Row="3" Text="Operator" Style="{StaticResource OperatorLabel}" Margin="0,4" />
					<TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ConnectionState}" FontWeight="SemiBold" Margin="20,4,0,4" />
				</Grid>
				<TextBlock Grid.Row="2" Text="{Binding RecoveryAction}" Style="{StaticResource OperatorLabel}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,22,0,0" />
			</Grid>
		</Border>
	</Grid>
</Window>
