<local:MonitorView x:Class="rtaime.Operator.ProgramViewer"
	x:Name="Root"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="clr-namespace:rtaime.Operator"
	xmlns:controls="clr-namespace:rtaime.Operator.Controls"
	UseLayoutRounding="True"
	SnapsToDevicePixels="True"
	Focusable="True">
	<controls:RtaimeMonitorPresentation
		Style="{StaticResource RtaimeMonitorPresentation}"
		Monitor="{Binding ElementName=Root}"
		RoleText="PROGRAM"
		RoleBrush="{DynamicResource OperatorProgramBrush}"
		RoleStatus="{x:Static controls:RtaimeStatusKind.Program}"
		PlaceholderState="{Binding WorkspaceStates.Program.State, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
		PlaceholderTitle="{Binding WorkspaceStates.Program.Title, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
		PlaceholderDetail="{Binding WorkspaceStates.Program.Detail, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
		FrameUnavailableText="Program frame unavailable · production authority remains remote">

		<controls:RtaimeMonitorPresentation.HeaderContent>
			<controls:RtaimeStatusBadge
				Status="{x:Static controls:RtaimeStatusKind.Program}"
				Content="ON AIR"
				Margin="4,0,0,0"
				VerticalAlignment="Center">
				<controls:RtaimeStatusBadge.Style>
					<Style TargetType="{x:Type controls:RtaimeStatusBadge}" BasedOn="{StaticResource {x:Type controls:RtaimeStatusBadge}}">
						<Setter Property="Visibility" Value="Collapsed" />
						<Style.Triggers>
							<DataTrigger Binding="{Binding State, ElementName=Root}" Value="LIVE">
								<Setter Property="Visibility" Value="Visible" />
							</DataTrigger>
						</Style.Triggers>
					</Style>
				</controls:RtaimeStatusBadge.Style>
			</controls:RtaimeStatusBadge>
		</controls:RtaimeMonitorPresentation.HeaderContent>

		<controls:RtaimeMonitorPresentation.StatusContent>
			<controls:RtaimeStatusBadge Status="{x:Static controls:RtaimeStatusKind.Neutral}" Content="{Binding OutputState, ElementName=Root}" />
		</controls:RtaimeMonitorPresentation.StatusContent>

		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>


			<StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8,0">
				<TextBlock Text="COMMIT" Style="{StaticResource OperatorLabel}" FontSize="{StaticResource OperatorFontSizeMicro}" VerticalAlignment="Center" />
				<TextBlock Text="{Binding CommitStatus, ElementName=Root}" Style="{StaticResource OperatorValue}" FontSize="{StaticResource OperatorFontSizeMicro}" FontWeight="SemiBold" Margin="4,0,0,0" MaxWidth="112" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
				<TextBlock Text=" · TRANS " Style="{StaticResource OperatorLabel}" FontSize="{StaticResource OperatorFontSizeMicro}" VerticalAlignment="Center" />
				<TextBlock Text="{Binding TransitionStatus, ElementName=Root}" Style="{StaticResource OperatorValue}" FontSize="{StaticResource OperatorFontSizeMicro}" MaxWidth="80" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
			</StackPanel>
		</Grid>
	</controls:RtaimeMonitorPresentation>
</local:MonitorView>
