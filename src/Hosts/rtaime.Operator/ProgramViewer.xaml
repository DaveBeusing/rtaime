<local:MonitorView x:Class="rtaime.Operator.ProgramViewer"
	x:Name="Root"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="clr-namespace:rtaime.Operator"
	xmlns:controls="clr-namespace:rtaime.Operator.Controls"
	UseLayoutRounding="True"
	SnapsToDevicePixels="True"
	Focusable="True">
	<Border Style="{StaticResource RtaimeMonitorPanel}">
		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition Height="40" />
				<RowDefinition Height="*" />
				<RowDefinition Height="42" />
			</Grid.RowDefinitions>

			<Border Grid.Row="0" Style="{StaticResource RtaimeMonitorHeader}">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>
					<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
						<TextBlock Text="PROGRAM" Foreground="{DynamicResource OperatorProgramBrush}" FontSize="12" FontWeight="Bold" />
						<TextBlock Text="{Binding SourceName, ElementName=Root}" Margin="10,0,0,0" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="190" />
					</StackPanel>
					<StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8,0">
						<TextBlock Text="{Binding ProductionFormat, ElementName=Root}" Style="{StaticResource OperatorLabel}" VerticalAlignment="Center" />
						<TextBlock Text=" · " Style="{StaticResource OperatorLabel}" VerticalAlignment="Center" />
						<TextBlock Text="{Binding ZoomMode, ElementName=Root}" Style="{StaticResource OperatorLabel}" FontWeight="SemiBold" VerticalAlignment="Center" />
					</StackPanel>
					<controls:RtaimeStatusBadge
						Grid.Column="2"
						Status="{x:Static controls:RtaimeStatusKind.Program}"
						Content="ON AIR"
						Margin="4,0,0,0"
						VerticalAlignment="Center">
						<controls:RtaimeStatusBadge.Style>
							<Style TargetType="{x:Type controls:RtaimeStatusBadge}" BasedOn="{StaticResource {x:Type controls:RtaimeStatusBadge}}">
								<Setter Property="Visibility" Value="Collapsed" />
								<Style.Triggers>
									<DataTrigger Binding="{Binding State, ElementName=Root}" Value="LIVE">
										<Setter Property="Visibility" Value="Visible" />
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</controls:RtaimeStatusBadge.Style>
					</controls:RtaimeStatusBadge>
				</Grid>
			</Border>

			<Grid Grid.Row="1" Background="#05080B" ClipToBounds="True">
				<Viewbox Stretch="{Binding ImageStretch, ElementName=Root}" StretchDirection="Both" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
					<Image Source="{Binding Frame, ElementName=Root}" SnapsToDevicePixels="True">
						<Image.LayoutTransform>
							<ScaleTransform ScaleX="{Binding ImageScale, ElementName=Root}" ScaleY="{Binding ImageScale, ElementName=Root}" />
						</Image.LayoutTransform>
					</Image>
				</Viewbox>

				<Grid IsHitTestVisible="False">
					<Grid.Style>
						<Style TargetType="Grid">
							<Setter Property="Visibility" Value="Collapsed" />
							<Style.Triggers>
								<DataTrigger Binding="{Binding ShowGrid, ElementName=Root}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
							</Style.Triggers>
						</Style>
					</Grid.Style>
					<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
					<Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="*" /><RowDefinition Height="*" /></Grid.RowDefinitions>
					<Border Grid.Column="0" Grid.RowSpan="3" BorderBrush="#55FFFFFF" BorderThickness="0,0,1,0" />
					<Border Grid.Column="1" Grid.RowSpan="3" BorderBrush="#55FFFFFF" BorderThickness="0,0,1,0" />
					<Border Grid.Row="0" Grid.ColumnSpan="3" BorderBrush="#55FFFFFF" BorderThickness="0,0,0,1" />
					<Border Grid.Row="1" Grid.ColumnSpan="3" BorderBrush="#55FFFFFF" BorderThickness="0,0,0,1" />
				</Grid>

				<Grid IsHitTestVisible="False">
					<Grid.Style>
						<Style TargetType="Grid">
							<Setter Property="Visibility" Value="Collapsed" />
							<Style.Triggers>
								<DataTrigger Binding="{Binding ShowSafeArea, ElementName=Root}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
							</Style.Triggers>
						</Style>
					</Grid.Style>
					<Border Margin="22" BorderBrush="#B0FFFFFF" BorderThickness="1" />
					<Border Margin="44" BorderBrush="#70FFFFFF" BorderThickness="1" />
				</Grid>

				<Grid IsHitTestVisible="False">
					<Grid.Style>
						<Style TargetType="Grid">
							<Setter Property="Visibility" Value="Collapsed" />
							<Style.Triggers>
								<DataTrigger Binding="{Binding ShowCenterMark, ElementName=Root}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
							</Style.Triggers>
						</Style>
					</Grid.Style>
					<Border Width="1" Height="28" Background="#C0FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
					<Border Width="28" Height="1" Background="#C0FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
				</Grid>

				<StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8">
					<controls:RtaimeStatusBadge Status="{x:Static controls:RtaimeStatusKind.Program}" Content="{Binding State, ElementName=Root}" Margin="0,0,4,0" />
					<controls:RtaimeStatusBadge Status="{x:Static controls:RtaimeStatusKind.Neutral}" Content="{Binding OutputState, ElementName=Root}" />
				</StackPanel>

				<Border VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="8" Padding="5,2" Background="#CC071017" CornerRadius="2">
					<controls:RtaimeTimecode Content="{Binding DisplayTimecode, ElementName=Root}" FontSize="13" />
				</Border>

				<Border VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="8" Padding="5,2" Background="#CC071017" CornerRadius="2">
					<StackPanel Orientation="Horizontal">
						<TextBlock Text="{Binding Format, ElementName=Root}" FontSize="10" Foreground="White" MaxWidth="180" TextTrimming="CharacterEllipsis" />
						<TextBlock Text=" · " FontSize="10" Foreground="White" />
						<TextBlock Text="{Binding ZoomMode, ElementName=Root}" FontSize="10" Foreground="White" />
					</StackPanel>
				</Border>

				<Border Background="#D0071017">
					<Border.Style>
						<Style TargetType="Border">
							<Setter Property="Visibility" Value="Collapsed" />
							<Style.Triggers>
								<DataTrigger Binding="{Binding Frame, ElementName=Root}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
							</Style.Triggers>
						</Style>
					</Border.Style>
					<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
						<TextBlock Text="{Binding State, ElementName=Root}" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" />
						<TextBlock Text="Program frame unavailable · production authority remains remote" Style="{StaticResource OperatorLabel}" Margin="0,3,0,0" />
					</StackPanel>
				</Border>
			</Grid>

			<Border Grid.Row="2" Style="{StaticResource RtaimeMonitorTransport}">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>
					<controls:RtaimeIconButton Grid.Column="0" IconData="{StaticResource RtaimeIconFitGeometry}" Command="{Binding FitCommand, ElementName=Root}" Width="28" Height="28" Margin="0,0,3,0" ToolTip="Fit Program" AutomationProperties.Name="Fit Program" />
					<controls:RtaimeIconButton Grid.Column="1" IconData="{StaticResource RtaimeIconZoomGeometry}" Command="{Binding Zoom50Command, ElementName=Root}" Width="28" Height="28" Margin="0,0,3,0" ToolTip="Program 50 percent" AutomationProperties.Name="Program 50 percent" />
					<controls:RtaimeIconButton Grid.Column="2" IconData="{StaticResource RtaimeIconZoomGeometry}" Command="{Binding Zoom100Command, ElementName=Root}" Width="28" Height="28" Margin="0,0,3,0" ToolTip="Program 100 percent" AutomationProperties.Name="Program 100 percent" />
					<controls:RtaimeIconButton Grid.Column="3" IconData="{StaticResource RtaimeIconMaximizeGeometry}" Command="{Binding MaximizeCommand, ElementName=Root}" Width="28" Height="28" Margin="0,0,3,0" ToolTip="Maximize Program" AutomationProperties.Name="Maximize Program" />
					<controls:RtaimeIconButton Grid.Column="4" IconData="{StaticResource RtaimeIconFullscreenGeometry}" Command="{Binding FullscreenCommand, ElementName=Root}" Width="28" Height="28" ToolTip="Fullscreen Program" AutomationProperties.Name="Fullscreen Program" />

					<StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8,0">
						<TextBlock Text="COMMIT" Style="{StaticResource OperatorLabel}" FontSize="9" VerticalAlignment="Center" />
						<TextBlock Text="{Binding CommitStatus, ElementName=Root}" Style="{StaticResource OperatorValue}" FontSize="9" FontWeight="SemiBold" Margin="4,0,0,0" MaxWidth="112" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
						<TextBlock Text=" · TRANS " Style="{StaticResource OperatorLabel}" FontSize="9" VerticalAlignment="Center" />
						<TextBlock Text="{Binding TransitionStatus, ElementName=Root}" Style="{StaticResource OperatorValue}" FontSize="9" MaxWidth="80" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
					</StackPanel>

					<StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
						<controls:RtaimeToggleButton Content="SAFE" IsChecked="{Binding ShowSafeArea, ElementName=Root, Mode=TwoWay}" IsCompact="True" Margin="0,0,3,0" ToolTip="Safe area" />
						<controls:RtaimeToggleButton Content="CTR" IsChecked="{Binding ShowCenterMark, ElementName=Root, Mode=TwoWay}" IsCompact="True" Margin="0,0,3,0" ToolTip="Center mark" />
						<controls:RtaimeToggleButton Content="GRID" IsChecked="{Binding ShowGrid, ElementName=Root, Mode=TwoWay}" IsCompact="True" ToolTip="Thirds grid" />
					</StackPanel>
				</Grid>
			</Border>
		</Grid>
	</Border>
</local:MonitorView>
