<local:MonitorView x:Class="rtaime.Operator.ProgramViewer"
	x:Name="Root"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="clr-namespace:rtaime.Operator"
	UseLayoutRounding="True"
	SnapsToDevicePixels="True">
	<Border Style="{StaticResource OperatorProgramPanel}">
		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>

			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>

				<Border Style="{StaticResource OperatorProgramTally}" HorizontalAlignment="Left">
					<StackPanel Orientation="Horizontal">
						<TextBlock Text="PGM" Foreground="{DynamicResource OperatorProgramBrush}" FontWeight="Bold" FontSize="13" />
						<TextBlock Text="  PROGRAM / AUTHORITATIVE OUTPUT" Foreground="{DynamicResource OperatorTextBrush}" FontWeight="SemiBold" FontSize="13" />
					</StackPanel>
				</Border>

				<StackPanel Grid.Column="2" Orientation="Horizontal">
					<Button Content="FIT" Command="{Binding FitCommand, ElementName=Root}" Style="{StaticResource OperatorButton}" MinHeight="26" Padding="7,2" Margin="0,0,4,0" ToolTip="Fit the monitoring surface to the viewer." />
					<Button Content="50%" Command="{Binding Zoom50Command, ElementName=Root}" Style="{StaticResource OperatorButton}" MinHeight="26" Padding="7,2" Margin="0,0,4,0" ToolTip="Show the monitoring surface at 50 percent pixel scale." />
					<Button Content="100%" Command="{Binding Zoom100Command, ElementName=Root}" Style="{StaticResource OperatorButton}" MinHeight="26" Padding="7,2" Margin="0,0,4,0" ToolTip="Show the monitoring surface at 100 percent pixel scale." />
					<Button Content="MAX  Ctrl+2" Command="{Binding MaximizeCommand, ElementName=Root}" Style="{StaticResource OperatorButton}" MinHeight="26" Padding="7,2" Margin="0,0,4,0" ToolTip="Maximize Program inside the current Operator layout." />
					<Button Content="FULL" Command="{Binding FullscreenCommand, ElementName=Root}" Style="{StaticResource OperatorButton}" MinHeight="26" Padding="7,2" ToolTip="Present Program fullscreen without creating another playback instance." />
				</StackPanel>
			</Grid>

			<Grid Grid.Row="1" Margin="0,9,0,9">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>
				<StackPanel>
					<TextBlock Text="{Binding SourceName, ElementName=Root}" FontSize="24" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
					<TextBlock Text="{Binding SourceId, ElementName=Root}" Style="{StaticResource OperatorLabel}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
				</StackPanel>
				<StackPanel Grid.Column="1" HorizontalAlignment="Right">
					<TextBlock Text="{Binding ProductionFormat, ElementName=Root}" Style="{StaticResource OperatorValue}" HorizontalAlignment="Right" />
					<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,2,0,0">
						<TextBlock Text="COLOR SPACE " Style="{StaticResource OperatorLabel}" />
						<TextBlock Text="{Binding ColorSpace, ElementName=Root}" Style="{StaticResource OperatorLabel}" />
						<TextBlock Text="  ·  " Style="{StaticResource OperatorLabel}" />
						<TextBlock Text="{Binding ZoomMode, ElementName=Root}" Style="{StaticResource OperatorLabel}" />
					</StackPanel>
				</StackPanel>
			</Grid>

			<Grid Grid.Row="2" MinHeight="245">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="10" />
					<ColumnDefinition Width="84" />
				</Grid.ColumnDefinitions>

				<Grid Background="#090C10" ClipToBounds="True">
					<Viewbox Stretch="{Binding ImageStretch, ElementName=Root}" StretchDirection="Both">
						<Image Source="{Binding Frame, ElementName=Root}" SnapsToDevicePixels="True">
							<Image.LayoutTransform>
								<ScaleTransform ScaleX="{Binding ImageScale, ElementName=Root}" ScaleY="{Binding ImageScale, ElementName=Root}" />
							</Image.LayoutTransform>
						</Image>
					</Viewbox>

					<Grid IsHitTestVisible="False">
						<Grid.Style>
							<Style TargetType="Grid">
								<Setter Property="Visibility" Value="Collapsed" />
								<Style.Triggers>
									<DataTrigger Binding="{Binding ShowGrid, ElementName=Root}" Value="True">
										<Setter Property="Visibility" Value="Visible" />
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</Grid.Style>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>
						<Grid.RowDefinitions>
							<RowDefinition Height="*" />
							<RowDefinition Height="*" />
							<RowDefinition Height="*" />
						</Grid.RowDefinitions>
						<Border Grid.Column="0" Grid.RowSpan="3" BorderBrush="#55FFFFFF" BorderThickness="0,0,1,0" />
						<Border Grid.Column="1" Grid.RowSpan="3" BorderBrush="#55FFFFFF" BorderThickness="0,0,1,0" />
						<Border Grid.Row="0" Grid.ColumnSpan="3" BorderBrush="#55FFFFFF" BorderThickness="0,0,0,1" />
						<Border Grid.Row="1" Grid.ColumnSpan="3" BorderBrush="#55FFFFFF" BorderThickness="0,0,0,1" />
					</Grid>

					<Grid IsHitTestVisible="False">
						<Grid.Style>
							<Style TargetType="Grid">
								<Setter Property="Visibility" Value="Collapsed" />
								<Style.Triggers>
									<DataTrigger Binding="{Binding ShowSafeArea, ElementName=Root}" Value="True">
										<Setter Property="Visibility" Value="Visible" />
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</Grid.Style>
						<Border Margin="24" BorderBrush="#B0FFFFFF" BorderThickness="1" />
						<Border Margin="48" BorderBrush="#70FFFFFF" BorderThickness="1" />
					</Grid>

					<Grid IsHitTestVisible="False">
						<Grid.Style>
							<Style TargetType="Grid">
								<Setter Property="Visibility" Value="Collapsed" />
								<Style.Triggers>
									<DataTrigger Binding="{Binding ShowCenterMark, ElementName=Root}" Value="True">
										<Setter Property="Visibility" Value="Visible" />
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</Grid.Style>
						<Border Width="1" Height="34" Background="#C0FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
						<Border Width="34" Height="1" Background="#C0FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
					</Grid>

					<StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8">
						<Border Style="{StaticResource OperatorProgramTally}" Margin="0,0,6,0">
							<TextBlock Text="PROGRAM" Foreground="{DynamicResource OperatorProgramBrush}" FontWeight="Bold" />
						</Border>
						<Border Margin="0,0,6,0" Padding="7,3" ToolTip="ON AIR here means the local Clean Program Output is running. External transmission remains separately unverified.">
							<Border.Style>
								<Style TargetType="Border" BasedOn="{StaticResource OperatorStatusBadge}">
									<Style.Triggers>
										<DataTrigger Binding="{Binding OutputState, ElementName=Root}" Value="OUTPUT LIVE">
											<Setter Property="BorderBrush" Value="{DynamicResource OperatorProgramBrush}" />
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</Border.Style>
							<TextBlock FontWeight="Bold">
								<TextBlock.Style>
									<Style TargetType="TextBlock">
										<Setter Property="Text" Value="PROGRAM STANDBY" />
										<Style.Triggers>
											<DataTrigger Binding="{Binding OutputState, ElementName=Root}" Value="OUTPUT LIVE">
												<Setter Property="Text" Value="ON AIR" />
												<Setter Property="Foreground" Value="{DynamicResource OperatorProgramBrush}" />
											</DataTrigger>
										</Style.Triggers>
									</Style>
								</TextBlock.Style>
							</TextBlock>
						</Border>
						<Border Style="{StaticResource OperatorStatusBadge}" Margin="0,0,6,0">
							<StackPanel Orientation="Horizontal">
								<TextBlock Text="REC " FontWeight="SemiBold" />
								<TextBlock Text="{Binding RecordingStatus, ElementName=Root}" FontWeight="Bold" />
							</StackPanel>
						</Border>
						<Border Style="{StaticResource OperatorStatusBadge}">
							<TextBlock Text="{Binding OutputState, ElementName=Root}" FontWeight="Bold" />
						</Border>
					</StackPanel>

					<Border VerticalAlignment="Top" HorizontalAlignment="Right" Background="#B0000000" Padding="7,4" Margin="8">
						<StackPanel>
							<TextBlock Text="{Binding DisplayTimecode, ElementName=Root}" Style="{StaticResource OperatorTimecode}" FontSize="15" Foreground="White" HorizontalAlignment="Right" />
							<TextBlock Text="{Binding State, ElementName=Root}" FontSize="10" FontWeight="Bold" Foreground="White" HorizontalAlignment="Right" Margin="0,2,0,0" />
						</StackPanel>
					</Border>

					<Border VerticalAlignment="Bottom" Background="#B0000000" Padding="8,5">
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="Auto" />
							</Grid.ColumnDefinitions>
							<TextBlock Text="{Binding Format, ElementName=Root}" FontSize="11" Foreground="White" TextTrimming="CharacterEllipsis" />
							<TextBlock Grid.Column="1" Text="{Binding ZoomMode, ElementName=Root}" FontSize="11" Foreground="White" Margin="12,0,0,0" />
						</Grid>
					</Border>

					<Border Background="#D0090C10">
						<Border.Style>
							<Style TargetType="Border">
								<Setter Property="Visibility" Value="Collapsed" />
								<Style.Triggers>
									<DataTrigger Binding="{Binding Frame, ElementName=Root}" Value="{x:Null}">
										<Setter Property="Visibility" Value="Visible" />
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</Border.Style>
						<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
							<TextBlock Text="{Binding State, ElementName=Root}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
							<TextBlock Text="Program monitoring frame unavailable; production authority remains remote." Style="{StaticResource OperatorLabel}" Margin="0,4,0,0" />
						</StackPanel>
					</Border>
				</Grid>

				<Border Grid.Column="2" Style="{StaticResource OperatorStatusBadge}" Padding="7">
					<Grid>
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="*" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
						</Grid.RowDefinitions>
						<TextBlock Text="PROGRAM AUDIO" Style="{StaticResource OperatorLabel}" HorizontalAlignment="Center" />
						<Grid Grid.Row="1" Margin="0,7,0,5">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="26" />
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="5" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<Grid Grid.Column="0" Margin="0,0,4,0">
								<Grid.RowDefinitions>
									<RowDefinition Height="*" />
									<RowDefinition Height="*" />
									<RowDefinition Height="*" />
									<RowDefinition Height="*" />
									<RowDefinition Height="*" />
								</Grid.RowDefinitions>
								<TextBlock Grid.Row="0" Text="0" Style="{StaticResource OperatorLabel}" HorizontalAlignment="Right" VerticalAlignment="Top" />
								<TextBlock Grid.Row="1" Text="-6" Style="{StaticResource OperatorLabel}" HorizontalAlignment="Right" />
								<TextBlock Grid.Row="2" Text="-12" Style="{StaticResource OperatorLabel}" HorizontalAlignment="Right" />
								<TextBlock Grid.Row="3" Text="-24" Style="{StaticResource OperatorLabel}" HorizontalAlignment="Right" />
								<TextBlock Grid.Row="4" Text="-60" Style="{StaticResource OperatorLabel}" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
							</Grid>
							<ProgressBar Grid.Column="1" Orientation="Vertical" Minimum="0" Maximum="1" Value="{Binding AudioLeftPeak, ElementName=Root, Mode=OneWay}" />
							<ProgressBar Grid.Column="3" Orientation="Vertical" Minimum="0" Maximum="1" Value="{Binding AudioRightPeak, ElementName=Root, Mode=OneWay}" />
						</Grid>
						<StackPanel Grid.Row="2">
							<TextBlock Text="{Binding AudioLeftDb, ElementName=Root}" Style="{StaticResource OperatorTimecode}" HorizontalAlignment="Center" />
							<TextBlock Text="{Binding AudioRightDb, ElementName=Root}" Style="{StaticResource OperatorTimecode}" HorizontalAlignment="Center" />
							<TextBlock Text="dBFS" Style="{StaticResource OperatorLabel}" HorizontalAlignment="Center" />
						</StackPanel>
						<Border Grid.Row="3" Margin="0,6,0,0" Padding="4,2">
							<Border.Style>
								<Style TargetType="Border" BasedOn="{StaticResource OperatorStatusBadge}">
									<Style.Triggers>
										<DataTrigger Binding="{Binding Clipping, ElementName=Root}" Value="True">
											<Setter Property="BorderBrush" Value="{DynamicResource OperatorErrorBrush}" />
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</Border.Style>
							<TextBlock HorizontalAlignment="Center" FontWeight="Bold">
								<TextBlock.Style>
									<Style TargetType="TextBlock">
										<Setter Property="Text" Value="AUDIO OK" />
										<Style.Triggers>
											<DataTrigger Binding="{Binding Clipping, ElementName=Root}" Value="True">
												<Setter Property="Text" Value="CLIP" />
												<Setter Property="Foreground" Value="{DynamicResource OperatorErrorBrush}" />
											</DataTrigger>
										</Style.Triggers>
									</Style>
								</TextBlock.Style>
							</TextBlock>
						</Border>
					</Grid>
				</Border>
			</Grid>

			<Grid Grid.Row="3" Margin="0,8,0,0">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>
				<StackPanel Orientation="Horizontal">
					<ToggleButton Content="SAFE" IsChecked="{Binding ShowSafeArea, ElementName=Root, Mode=TwoWay}" Style="{StaticResource OperatorToggleButton}" Padding="7,2" Margin="0,0,4,0" ToolTip="Toggle safe-area overlays." />
					<ToggleButton Content="CENTER" IsChecked="{Binding ShowCenterMark, ElementName=Root, Mode=TwoWay}" Style="{StaticResource OperatorToggleButton}" Padding="7,2" Margin="0,0,4,0" ToolTip="Toggle center mark." />
					<ToggleButton Content="GRID" IsChecked="{Binding ShowGrid, ElementName=Root, Mode=TwoWay}" Style="{StaticResource OperatorToggleButton}" Padding="7,2" ToolTip="Toggle thirds grid." />
				</StackPanel>
				<StackPanel Grid.Column="1" Orientation="Horizontal">
					<TextBlock Text="TC " Style="{StaticResource OperatorLabel}" VerticalAlignment="Center" />
					<TextBlock Text="{Binding DisplayTimecode, ElementName=Root}" Style="{StaticResource OperatorTimecode}" FontSize="15" VerticalAlignment="Center" />
				</StackPanel>
			</Grid>

			<Grid Grid.Row="4" Margin="0,10,0,0">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="18" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>
				<StackPanel>
					<TextBlock Text="COMMITTED PROGRAM" Style="{StaticResource OperatorLabel}" />
					<TextBlock Text="{Binding State, ElementName=Root}" Style="{StaticResource OperatorValue}" FontWeight="SemiBold" />
				</StackPanel>
				<StackPanel Grid.Column="1">
					<TextBlock Text="COMMIT" Style="{StaticResource OperatorLabel}" />
					<TextBlock Text="{Binding CommitStatus, ElementName=Root}" Style="{StaticResource OperatorValue}" FontWeight="SemiBold" />
				</StackPanel>
				<StackPanel Grid.Column="3">
					<TextBlock Text="TRANSITION" Style="{StaticResource OperatorLabel}" />
					<TextBlock Text="{Binding TransitionStatus, ElementName=Root}" Style="{StaticResource OperatorValue}" />
				</StackPanel>
			</Grid>
		</Grid>
	</Border>
</local:MonitorView>