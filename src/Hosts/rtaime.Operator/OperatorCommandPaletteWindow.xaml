<Window x:Class="rtaime.Operator.OperatorCommandPaletteWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:rtaime.Operator.Controls"
 Title="rtaime — Commands and Shortcuts" Width="720" Height="620" MinWidth="320" MinHeight="280"
 Background="{DynamicResource OperatorBackgroundBrush}" Foreground="{DynamicResource OperatorTextBrush}"
 FontFamily="{StaticResource OperatorFontFamily}" WindowStartupLocation="CenterOwner"
 UseLayoutRounding="True" SnapsToDevicePixels="True" ShowInTaskbar="False"
 KeyboardNavigation.TabNavigation="Cycle">
 <Grid Margin="12">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
   <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <TextBlock Text="COMMANDS · Ctrl+K" FontWeight="SemiBold" Margin="0,0,0,8"/>
  <controls:RtaimeTextBox x:Name="SearchBox" Grid.Row="1" MaxLength="128"
   Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"
   AutomationProperties.Name="Search commands" ToolTip="Search labels, command IDs and categories. Up/Down selects; Escape closes."/>
  <controls:RtaimeListBox x:Name="CommandResults" Grid.Row="2" Visibility="{Binding ResultsVisibility}" ItemsSource="{Binding Results}"
   SelectedItem="{Binding Selected, Mode=TwoWay}" ScrollViewer.CanContentScroll="True"
   VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
   ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Matching commands">
   <controls:RtaimeListBox.ItemContainerStyle>
    <Style TargetType="{x:Type controls:RtaimeListBoxItem}" BasedOn="{StaticResource {x:Type controls:RtaimeListBoxItem}}">
     <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
     <Setter Property="AutomationProperties.Name" Value="{Binding AutomationLabel}"/>
    </Style>
   </controls:RtaimeListBox.ItemContainerStyle>
   <controls:RtaimeListBox.ItemTemplate>
    <DataTemplate>
     <Grid Margin="4">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel>
       <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
       <TextBlock Text="{Binding Category}" Style="{StaticResource OperatorLabel}"/>
       <TextBlock Text="{Binding State}" TextWrapping="Wrap" FontSize="{StaticResource OperatorFontSizeCompact}"/>
      </StackPanel>
      <TextBlock Grid.Column="1" Text="{Binding Gesture}" Margin="8,0,0,0"/>
     </Grid>
    </DataTemplate>
   </controls:RtaimeListBox.ItemTemplate>
  </controls:RtaimeListBox>
  <StackPanel Grid.Row="3" Margin="0,8,0,0">
   <TextBlock Text="{Binding SelectedState}" TextWrapping="Wrap" MaxHeight="48" ToolTip="{Binding SelectedState}"/>
   <WrapPanel Margin="0,6,0,0">
    <controls:RtaimeButton x:Name="ExecuteButton" Content="Execute" Command="{Binding ExecuteCommand}" IsDefault="False" Margin="0,0,8,4" AutomationProperties.Name="Execute selected command"/>
    <controls:RtaimeButton Content="Shortcut profiles" Command="{Binding ToggleProfilesCommand}" Margin="0,0,8,4" AutomationProperties.Name="Edit shortcut profiles"/>
    <controls:RtaimeButton Content="Close (Esc)" Click="OnCloseClick" Margin="0,0,0,4" AutomationProperties.Name="Close command palette"/>
   </WrapPanel>
  </StackPanel>
  <controls:RtaimeScrollViewer Grid.Row="2" Visibility="{Binding ProfilesVisibility}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel Margin="0,8,0,0">
    <TextBlock Text="SHORTCUT PROFILE" FontWeight="SemiBold"/>
    <controls:RtaimeTextBox Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}" MaxLength="64" Margin="0,4" AutomationProperties.Name="Shortcut profile name"/>
    <controls:RtaimeComboBox ItemsSource="{Binding EditableShortcuts}" SelectedItem="{Binding EditingShortcut, Mode=TwoWay}" DisplayMemberPath="Label" Margin="0,4" AutomationProperties.Name="Command to customize"/>
    <WrapPanel>
     <controls:RtaimeComboBox ItemsSource="{Binding AllowedModifiers}" SelectedItem="{Binding EditingModifiers, Mode=TwoWay}" Width="160" Margin="0,4,8,4" AutomationProperties.Name="Shortcut modifiers"/>
     <controls:RtaimeComboBox ItemsSource="{Binding AllowedKeys}" SelectedItem="{Binding EditingKey, Mode=TwoWay}" Width="100" Margin="0,4" AutomationProperties.Name="Shortcut key"/>
    </WrapPanel>
    <WrapPanel>
     <controls:RtaimeButton Content="Assign" Command="{Binding AssignShortcutCommand}" Margin="0,0,6,4"/>
     <controls:RtaimeButton Content="Remove override" Command="{Binding RemoveOverrideCommand}" Margin="0,0,6,4"/>
     <controls:RtaimeButton Content="Reset defaults" Command="{Binding ResetShortcutsCommand}" Margin="0,0,6,4"/>
     <controls:RtaimeButton Content="Import" Command="{Binding ImportCommand}" Margin="0,0,6,4"/>
     <controls:RtaimeButton Content="Export" Command="{Binding ExportCommand}" Margin="0,0,0,4"/>
    </WrapPanel>
    <TextBlock Text="TAKE, recording, GO, recovery and system keys stay reserved. Conflicts reject the entire profile. Overrides retain their focus and readiness rules." TextWrapping="Wrap"/>
   </StackPanel>
  </controls:RtaimeScrollViewer>
  <TextBlock Grid.Row="4" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,8,0,0" MaxHeight="60" ToolTip="{Binding Status}" AutomationProperties.LiveSetting="Polite"/>
 </Grid>
</Window>
