<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<SolidColorBrush x:Key="OperatorBackgroundBrush" Color="#101318" />
	<SolidColorBrush x:Key="OperatorSurfaceBrush" Color="#171C23" />
	<SolidColorBrush x:Key="OperatorRaisedSurfaceBrush" Color="#202731" />
	<SolidColorBrush x:Key="OperatorBorderBrush" Color="#303A47" />
	<SolidColorBrush x:Key="OperatorTextBrush" Color="#F3F6FA" />
	<SolidColorBrush x:Key="OperatorMutedTextBrush" Color="#9AA8B8" />
	<SolidColorBrush x:Key="OperatorAccentBrush" Color="#4DA3FF" />
	<SolidColorBrush x:Key="OperatorPreviewBrush" Color="#3FBF7F" />
	<SolidColorBrush x:Key="OperatorProgramBrush" Color="#E55757" />
	<SolidColorBrush x:Key="OperatorWarningBrush" Color="#E4B84A" />
	<SolidColorBrush x:Key="OperatorErrorBrush" Color="#FF6B6B" />
	<SolidColorBrush x:Key="OperatorDisabledBrush" Color="#596575" />

	<Style x:Key="OperatorPanel" TargetType="Border">
		<Setter Property="Background" Value="{DynamicResource OperatorSurfaceBrush}" />
		<Setter Property="BorderBrush" Value="{DynamicResource OperatorBorderBrush}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="CornerRadius" Value="8" />
		<Setter Property="Padding" Value="16" />
	</Style>

	<Style x:Key="OperatorSectionTitle" TargetType="TextBlock">
		<Setter Property="Foreground" Value="{DynamicResource OperatorTextBrush}" />
		<Setter Property="FontSize" Value="16" />
		<Setter Property="FontWeight" Value="SemiBold" />
	</Style>

	<Style x:Key="OperatorLabel" TargetType="TextBlock">
		<Setter Property="Foreground" Value="{DynamicResource OperatorMutedTextBrush}" />
		<Setter Property="FontSize" Value="11" />
		<Setter Property="FontWeight" Value="SemiBold" />
	</Style>

	<Style x:Key="OperatorValue" TargetType="TextBlock">
		<Setter Property="Foreground" Value="{DynamicResource OperatorTextBrush}" />
		<Setter Property="FontSize" Value="13" />
	</Style>

	<Style x:Key="OperatorButton" TargetType="Button">
		<Setter Property="Background" Value="{DynamicResource OperatorRaisedSurfaceBrush}" />
		<Setter Property="Foreground" Value="{DynamicResource OperatorTextBrush}" />
		<Setter Property="BorderBrush" Value="{DynamicResource OperatorBorderBrush}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="Padding" Value="14,10" />
		<Setter Property="FontWeight" Value="SemiBold" />
		<Setter Property="Cursor" Value="Hand" />
		<Style.Triggers>
			<Trigger Property="IsMouseOver" Value="True">
				<Setter Property="BorderBrush" Value="{DynamicResource OperatorAccentBrush}" />
			</Trigger>
			<Trigger Property="IsPressed" Value="True">
				<Setter Property="Opacity" Value="0.82" />
			</Trigger>
			<Trigger Property="IsEnabled" Value="False">
				<Setter Property="Foreground" Value="{DynamicResource OperatorDisabledBrush}" />
				<Setter Property="Opacity" Value="0.6" />
			</Trigger>
		</Style.Triggers>
	</Style>

	<Style x:Key="OperatorAccentButton" TargetType="Button" BasedOn="{StaticResource OperatorButton}">
		<Setter Property="Background" Value="#243C59" />
		<Setter Property="BorderBrush" Value="{DynamicResource OperatorAccentBrush}" />
	</Style>

	<Style x:Key="OperatorProgramButton" TargetType="Button" BasedOn="{StaticResource OperatorButton}">
		<Setter Property="Background" Value="#482426" />
		<Setter Property="BorderBrush" Value="{DynamicResource OperatorProgramBrush}" />
		<Setter Property="FontSize" Value="16" />
	</Style>

	<Style x:Key="OperatorSourceBank" TargetType="ListBox">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="BorderThickness" Value="0" />
		<Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
	</Style>

	<Style x:Key="OperatorSourceItem" TargetType="ListBoxItem">
		<Setter Property="Background" Value="{DynamicResource OperatorRaisedSurfaceBrush}" />
		<Setter Property="Foreground" Value="{DynamicResource OperatorTextBrush}" />
		<Setter Property="BorderBrush" Value="{DynamicResource OperatorBorderBrush}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="Padding" Value="12" />
		<Setter Property="Margin" Value="0,0,0,8" />
		<Setter Property="HorizontalContentAlignment" Value="Stretch" />
		<Style.Triggers>
			<Trigger Property="IsMouseOver" Value="True">
				<Setter Property="BorderBrush" Value="{DynamicResource OperatorAccentBrush}" />
			</Trigger>
			<Trigger Property="IsSelected" Value="True">
				<Setter Property="Background" Value="#253A50" />
				<Setter Property="BorderBrush" Value="{DynamicResource OperatorAccentBrush}" />
			</Trigger>
		</Style.Triggers>
	</Style>

	<Style x:Key="OperatorTextBox" TargetType="TextBox">
		<Setter Property="Background" Value="{DynamicResource OperatorRaisedSurfaceBrush}" />
		<Setter Property="Foreground" Value="{DynamicResource OperatorTextBrush}" />
		<Setter Property="CaretBrush" Value="{DynamicResource OperatorTextBrush}" />
		<Setter Property="BorderBrush" Value="{DynamicResource OperatorBorderBrush}" />
		<Setter Property="Padding" Value="8,6" />
	</Style>
</ResourceDictionary>
