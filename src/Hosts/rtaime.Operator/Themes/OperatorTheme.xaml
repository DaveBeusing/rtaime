<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<ResourceDictionary.MergedDictionaries>
		<ResourceDictionary Source="OperatorTokens.xaml" />
	</ResourceDictionary.MergedDictionaries>

	<!-- Brushes derived from the shared tokens. -->
	<SolidColorBrush x:Key="OperatorBackgroundBrush" Color="{StaticResource OperatorColorBackground}" />
	<SolidColorBrush x:Key="OperatorSurfaceBrush" Color="{StaticResource OperatorColorSurface}" />
	<SolidColorBrush x:Key="OperatorRaisedSurfaceBrush" Color="{StaticResource OperatorColorRaisedSurface}" />
	<SolidColorBrush x:Key="OperatorRaisedHoverBrush" Color="{StaticResource OperatorColorRaisedHover}" />
	<SolidColorBrush x:Key="OperatorBorderBrush" Color="{StaticResource OperatorColorBorder}" />
	<SolidColorBrush x:Key="OperatorTextBrush" Color="{StaticResource OperatorColorText}" />
	<SolidColorBrush x:Key="OperatorMutedTextBrush" Color="{StaticResource OperatorColorMutedText}" />
	<SolidColorBrush x:Key="OperatorDisabledBrush" Color="{StaticResource OperatorColorDisabled}" />
	<SolidColorBrush x:Key="OperatorAccentBrush" Color="{StaticResource OperatorColorAccent}" />
	<SolidColorBrush x:Key="OperatorFocusBrush" Color="{StaticResource OperatorColorFocus}" />
	<SolidColorBrush x:Key="OperatorPreviewBrush" Color="{StaticResource OperatorColorPreview}" />
	<SolidColorBrush x:Key="OperatorProgramBrush" Color="{StaticResource OperatorColorProgram}" />
	<SolidColorBrush x:Key="OperatorArmedBrush" Color="{StaticResource OperatorColorArmed}" />
	<SolidColorBrush x:Key="OperatorHealthyBrush" Color="{StaticResource OperatorColorHealthy}" />
	<SolidColorBrush x:Key="OperatorWarningBrush" Color="{StaticResource OperatorColorWarning}" />
	<SolidColorBrush x:Key="OperatorErrorBrush" Color="{StaticResource OperatorColorError}" />
	<SolidColorBrush x:Key="OperatorMeterSafeBrush" Color="{StaticResource OperatorColorMeterSafe}" />
	<SolidColorBrush x:Key="OperatorMeterWarningBrush" Color="{StaticResource OperatorColorMeterWarning}" />
	<SolidColorBrush x:Key="OperatorMeterClipBrush" Color="{StaticResource OperatorColorMeterClip}" />

	<Style x:Key="OperatorFocusVisual" TargetType="{x:Type Control}">
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type Control}">
					<Rectangle Margin="2" Stroke="{DynamicResource OperatorFocusBrush}" StrokeThickness="{StaticResource OperatorFocusThickness}" RadiusX="3" RadiusY="3" SnapsToDevicePixels="True" />
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style x:Key="OperatorPanel" TargetType="Border">
		<Setter Property="Background" Value="{DynamicResource OperatorSurfaceBrush}" />
		<Setter Property="BorderBrush" Value="{DynamicResource OperatorBorderBrush}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="CornerRadius" Value="{StaticResource OperatorRadiusPanel}" />
		<Setter Property="Padding" Value="{StaticResource OperatorPanelPadding}" />
		<Setter Property="SnapsToDevicePixels" Value="True" />
	</Style>

	<Style x:Key="OperatorToolbar" TargetType="Border" BasedOn="{StaticResource OperatorPanel}">
		<Setter Property="Padding" Value="14,10" />
	</Style>

	<Style x:Key="OperatorPreviewPanel" TargetType="Border" BasedOn="{StaticResource OperatorPanel}">
		<Setter Property="BorderBrush" Value="{DynamicResource OperatorPreviewBrush}" />
		<Setter Property="BorderThickness" Value="2" />
	</Style>

	<Style x:Key="OperatorProgramPanel" TargetType="Border" BasedOn="{StaticResource OperatorPanel}">
		<Setter Property="BorderBrush" Value="{DynamicResource OperatorProgramBrush}" />
		<Setter Property="BorderThickness" Value="2" />
	</Style>

	<Style x:Key="OperatorStatusBadge" TargetType="Border">
		<Setter Property="Background" Value="{DynamicResource OperatorRaisedSurfaceBrush}" />
		<Setter Property="BorderBrush" Value="{DynamicResource OperatorBorderBrush}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="CornerRadius" Value="{StaticResource OperatorRadiusStatus}" />
		<Setter Property="Padding" Value="{StaticResource OperatorStatusPadding}" />
		<Setter Property="SnapsToDevicePixels" Value="True" />
	</Style>

	<Style x:Key="OperatorPreviewTally" TargetType="Border" BasedOn="{StaticResource OperatorStatusBadge}">
		<Setter Property="BorderBrush" Value="{DynamicResource OperatorPreviewBrush}" />
		<Setter Property="Background" Value="#183B2A" />
	</Style>

	<Style x:Key="OperatorProgramTally" TargetType="Border" BasedOn="{StaticResource OperatorStatusBadge}">
		<Setter Property="BorderBrush" Value="{DynamicResource OperatorProgramBrush}" />
		<Setter Property="Background" Value="#442326" />
	</Style>

	<Style x:Key="OperatorArmedBadge" TargetType="Border" BasedOn="{StaticResource OperatorStatusBadge}">
		<Setter Property="BorderBrush" Value="{DynamicResource OperatorArmedBrush}" />
		<Setter Property="Background" Value="#3A321C" />
	</Style>

	<Style x:Key="OperatorHealthyBadge" TargetType="Border" BasedOn="{StaticResource OperatorStatusBadge}">
		<Setter Property="BorderBrush" Value="{DynamicResource OperatorHealthyBrush}" />
	</Style>

	<Style x:Key="OperatorWarningBadge" TargetType="Border" BasedOn="{StaticResource OperatorStatusBadge}">
		<Setter Property="BorderBrush" Value="{DynamicResource OperatorWarningBrush}" />
	</Style>

	<Style x:Key="OperatorErrorBadge" TargetType="Border" BasedOn="{StaticResource OperatorStatusBadge}">
		<Setter Property="BorderBrush" Value="{DynamicResource OperatorErrorBrush}" />
	</Style>

	<Style x:Key="OperatorSectionTitle" TargetType="TextBlock">
		<Setter Property="Foreground" Value="{DynamicResource OperatorTextBrush}" />
		<Setter Property="FontSize" Value="{StaticResource OperatorFontSizeSection}" />
		<Setter Property="FontWeight" Value="SemiBold" />
	</Style>

	<Style x:Key="OperatorLabel" TargetType="TextBlock">
		<Setter Property="Foreground" Value="{DynamicResource OperatorMutedTextBrush}" />
		<Setter Property="FontSize" Value="{StaticResource OperatorFontSizeCaption}" />
		<Setter Property="FontWeight" Value="SemiBold" />
	</Style>

	<Style x:Key="OperatorValue" TargetType="TextBlock">
		<Setter Property="Foreground" Value="{DynamicResource OperatorTextBrush}" />
		<Setter Property="FontSize" Value="{StaticResource OperatorFontSizeBody}" />
	</Style>

	<Style x:Key="OperatorTimecode" TargetType="TextBlock" BasedOn="{StaticResource OperatorValue}">
		<Setter Property="FontFamily" Value="{StaticResource OperatorTimecodeFontFamily}" />
		<Setter Property="FontWeight" Value="SemiBold" />
	</Style>

	<Style x:Key="OperatorButton" TargetType="Button">
		<Setter Property="Background" Value="{DynamicResource OperatorRaisedSurfaceBrush}" />
		<Setter Property="Foreground" Value="{DynamicResource OperatorTextBrush}" />
		<Setter Property="BorderBrush" Value="{DynamicResource OperatorBorderBrush}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="Padding" Value="{StaticResource OperatorControlPadding}" />
		<Setter Property="MinHeight" Value="{StaticResource OperatorControlHeight}" />
		<Setter Property="FontSize" Value="{StaticResource OperatorFontSizeControl}" />
		<Setter Property="FontWeight" Value="SemiBold" />
		<Setter Property="Cursor" Value="Hand" />
		<Setter Property="FocusVisualStyle" Value="{StaticResource OperatorFocusVisual}" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type Button}">
					<Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource OperatorRadiusControl}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
						<ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True" />
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="Chrome" Property="Background" Value="{DynamicResource OperatorRaisedHoverBrush}" />
							<Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource OperatorAccentBrush}" />
						</Trigger>
						<Trigger Property="IsKeyboardFocused" Value="True">
							<Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource OperatorFocusBrush}" />
							<Setter TargetName="Chrome" Property="BorderThickness" Value="2" />
						</Trigger>
						<Trigger Property="IsPressed" Value="True">
							<Setter TargetName="Chrome" Property="Opacity" Value="0.78" />
						</Trigger>
						<Trigger Property="IsEnabled" Value="False">
							<Setter Property="Foreground" Value="{DynamicResource OperatorDisabledBrush}" />
							<Setter TargetName="Chrome" Property="Opacity" Value="0.55" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style x:Key="OperatorAccentButton" TargetType="Button" BasedOn="{StaticResource OperatorButton}">
		<Setter Property="Background" Value="#233C57" />
		<Setter Property="BorderBrush" Value="{DynamicResource OperatorAccentBrush}" />
	</Style>

	<Style x:Key="OperatorProgramButton" TargetType="Button" BasedOn="{StaticResource OperatorButton}">
		<Setter Property="Background" Value="#442326" />
		<Setter Property="BorderBrush" Value="{DynamicResource OperatorProgramBrush}" />
		<Setter Property="FontSize" Value="15" />
	</Style>

	<Style x:Key="OperatorToggleButton" TargetType="ToggleButton">
		<Setter Property="Background" Value="{DynamicResource OperatorRaisedSurfaceBrush}" />
		<Setter Property="Foreground" Value="{DynamicResource OperatorTextBrush}" />
		<Setter Property="BorderBrush" Value="{DynamicResource OperatorBorderBrush}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="Padding" Value="{StaticResource OperatorControlPadding}" />
		<Setter Property="MinHeight" Value="{StaticResource OperatorControlHeight}" />
		<Setter Property="FontWeight" Value="SemiBold" />
		<Setter Property="FocusVisualStyle" Value="{StaticResource OperatorFocusVisual}" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type ToggleButton}">
					<Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource OperatorRadiusControl}" Padding="{TemplateBinding Padding}">
						<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsChecked" Value="True">
							<Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource OperatorArmedBrush}" />
							<Setter TargetName="Chrome" Property="Background" Value="#3A321C" />
						</Trigger>
						<Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource OperatorAccentBrush}" /></Trigger>
						<Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource OperatorFocusBrush}" /><Setter TargetName="Chrome" Property="BorderThickness" Value="2" /></Trigger>
						<Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.55" /></Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style x:Key="OperatorSourceBank" TargetType="ListBox">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="BorderThickness" Value="0" />
		<Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
		<Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Continue" />
	</Style>

	<Style x:Key="OperatorSourceItem" TargetType="ListBoxItem">
		<Setter Property="Background" Value="{DynamicResource OperatorRaisedSurfaceBrush}" />
		<Setter Property="Foreground" Value="{DynamicResource OperatorTextBrush}" />
		<Setter Property="BorderBrush" Value="{DynamicResource OperatorBorderBrush}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="Padding" Value="12" />
		<Setter Property="Margin" Value="0,0,0,8" />
		<Setter Property="HorizontalContentAlignment" Value="Stretch" />
		<Setter Property="FocusVisualStyle" Value="{StaticResource OperatorFocusVisual}" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type ListBoxItem}">
					<Border x:Name="Tile" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource OperatorRadiusControl}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
						<ContentPresenter />
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tile" Property="Background" Value="{DynamicResource OperatorRaisedHoverBrush}" /><Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource OperatorAccentBrush}" /></Trigger>
						<Trigger Property="IsSelected" Value="True"><Setter TargetName="Tile" Property="Background" Value="#22384D" /><Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource OperatorAccentBrush}" /><Setter TargetName="Tile" Property="BorderThickness" Value="2" /></Trigger>
						<Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource OperatorFocusBrush}" /><Setter TargetName="Tile" Property="BorderThickness" Value="2" /></Trigger>
						<Trigger Property="IsEnabled" Value="False"><Setter TargetName="Tile" Property="Opacity" Value="0.55" /></Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style x:Key="OperatorTextBox" TargetType="TextBox">
		<Setter Property="Background" Value="{DynamicResource OperatorRaisedSurfaceBrush}" />
		<Setter Property="Foreground" Value="{DynamicResource OperatorTextBrush}" />
		<Setter Property="CaretBrush" Value="{DynamicResource OperatorTextBrush}" />
		<Setter Property="BorderBrush" Value="{DynamicResource OperatorBorderBrush}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="Padding" Value="8,6" />
		<Setter Property="MinHeight" Value="{StaticResource OperatorCompactControlHeight}" />
		<Setter Property="FocusVisualStyle" Value="{StaticResource OperatorFocusVisual}" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type TextBox}">
					<Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource OperatorRadiusControl}" Padding="{TemplateBinding Padding}">
						<ScrollViewer x:Name="PART_ContentHost" />
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource OperatorFocusBrush}" /><Setter TargetName="Chrome" Property="BorderThickness" Value="2" /></Trigger>
						<Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.55" /></Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style x:Key="OperatorMeter" TargetType="ProgressBar">
		<Setter Property="Height" Value="8" />
		<Setter Property="Background" Value="{DynamicResource OperatorRaisedSurfaceBrush}" />
		<Setter Property="Foreground" Value="{DynamicResource OperatorMeterSafeBrush}" />
		<Setter Property="BorderThickness" Value="0" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type ProgressBar}">
					<Grid x:Name="PART_Track" SnapsToDevicePixels="True">
						<Border Background="{TemplateBinding Background}" CornerRadius="{StaticResource OperatorRadiusMeter}" />
						<Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="{StaticResource OperatorRadiusMeter}" />
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style x:Key="OperatorTimelineSlider" TargetType="Slider">
		<Setter Property="Height" Value="34" />
		<Setter Property="Foreground" Value="{DynamicResource OperatorAccentBrush}" />
		<Setter Property="Background" Value="{DynamicResource OperatorRaisedSurfaceBrush}" />
		<Setter Property="FocusVisualStyle" Value="{StaticResource OperatorFocusVisual}" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type Slider}">
					<Border x:Name="FocusRing" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="{StaticResource OperatorRadiusControl}">
						<Grid Margin="8,0" SnapsToDevicePixels="True">
							<Border Height="4" Background="{TemplateBinding Background}" CornerRadius="2" VerticalAlignment="Center" />
							<Track x:Name="PART_Track" VerticalAlignment="Center" Orientation="Horizontal">
								<Track.DecreaseRepeatButton><RepeatButton Command="{x:Static Slider.DecreaseLarge}" Background="Transparent" BorderThickness="0" Focusable="False" Opacity="0" /></Track.DecreaseRepeatButton>
								<Track.Thumb>
									<Thumb Width="14" Height="22" Background="{DynamicResource OperatorAccentBrush}" BorderBrush="{DynamicResource OperatorFocusBrush}" BorderThickness="1">
										<Thumb.Template><ControlTemplate TargetType="{x:Type Thumb}"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" /></ControlTemplate></Thumb.Template>
									</Thumb>
								</Track.Thumb>
								<Track.IncreaseRepeatButton><RepeatButton Command="{x:Static Slider.IncreaseLarge}" Background="Transparent" BorderThickness="0" Focusable="False" Opacity="0" /></Track.IncreaseRepeatButton>
							</Track>
						</Grid>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource OperatorFocusBrush}" /><Setter TargetName="FocusRing" Property="BorderThickness" Value="2" /></Trigger>
						<Trigger Property="IsEnabled" Value="False"><Setter TargetName="FocusRing" Property="Opacity" Value="0.45" /></Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
</ResourceDictionary>
