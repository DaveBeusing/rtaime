<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:rtaime.Operator.Controls">

	<Style TargetType="{x:Type controls:RtaimeOutputRow}">
		<Setter Property="Height" Value="54" />
		<Setter Property="Foreground" Value="{DynamicResource OperatorTextBrush}" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type controls:RtaimeOutputRow}">
					<Border
						Background="{DynamicResource OperatorSurfaceBrush}"
						BorderBrush="{DynamicResource OperatorBorderBrush}"
						BorderThickness="0,0,0,1"
						Padding="7,0"
						SnapsToDevicePixels="True">
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="14" />
								<ColumnDefinition Width="64" />
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="88" />
								<ColumnDefinition x:Name="OverflowColumn" Width="0" />
							</Grid.ColumnDefinitions>

							<Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{DynamicResource OperatorWarningBrush}" VerticalAlignment="Center" />

							<Border Grid.Column="1" Width="56" Height="32" Background="#090C10" BorderBrush="{DynamicResource OperatorBorderBrush}" BorderThickness="1" VerticalAlignment="Center">
								<Image Source="{TemplateBinding Thumbnail}" Stretch="UniformToFill" SnapsToDevicePixels="True" />
							</Border>

							<Grid Grid.Column="2" Margin="5,0,6,0" VerticalAlignment="Center">
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
								</Grid.RowDefinitions>
								<DockPanel>
									<TextBlock Text="{TemplateBinding OutputName}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" />
									<TextBlock Text="{TemplateBinding AssignedSource}" FontSize="10" FontWeight="SemiBold" DockPanel.Dock="Right" TextTrimming="CharacterEllipsis" MaxWidth="150" />
								</DockPanel>
								<StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,2,0,0">
									<TextBlock Text="{TemplateBinding Target}" Style="{StaticResource OperatorLabel}" FontSize="9" TextTrimming="CharacterEllipsis" MaxWidth="96" />
									<TextBlock Text=" · " Style="{StaticResource OperatorLabel}" FontSize="9" />
									<TextBlock Text="{TemplateBinding Resolution}" Style="{StaticResource OperatorLabel}" FontSize="9" />
									<TextBlock Text=" · " Style="{StaticResource OperatorLabel}" FontSize="9" />
									<TextBlock Text="{TemplateBinding FrameRate}" Style="{StaticResource OperatorLabel}" FontSize="9" />
									<TextBlock Text=" · " Style="{StaticResource OperatorLabel}" FontSize="9" />
									<TextBlock Text="{TemplateBinding ColorSpace}" Style="{StaticResource OperatorLabel}" FontSize="9" />
								</StackPanel>
							</Grid>

							<TextBlock Grid.Column="3" Text="{TemplateBinding RouteState}" Style="{StaticResource OperatorValue}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

							<controls:RtaimeIconButton x:Name="OverflowButton"
								Grid.Column="4"
								IconData="{StaticResource RtaimeIconMoreGeometry}"
								Command="{TemplateBinding OverflowCommand}"
								Width="26"
								Height="26"
								Visibility="Collapsed"
								ToolTip="Output actions" />
						</Grid>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="EvidenceState" Value="PASS"><Setter TargetName="StatusDot" Property="Fill" Value="{DynamicResource OperatorHealthyBrush}" /></Trigger>
						<Trigger Property="EvidenceState" Value="FAIL"><Setter TargetName="StatusDot" Property="Fill" Value="{DynamicResource OperatorErrorBrush}" /></Trigger>
						<Trigger Property="ShowOverflow" Value="True">
							<Setter TargetName="OverflowColumn" Property="Width" Value="30" />
							<Setter TargetName="OverflowButton" Property="Visibility" Value="Visible" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style TargetType="{x:Type controls:RtaimeHealthRow}">
		<Setter Property="Height" Value="29" />
		<Setter Property="Foreground" Value="{DynamicResource OperatorTextBrush}" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type controls:RtaimeHealthRow}">
					<Border BorderBrush="{DynamicResource OperatorBorderBrush}" BorderThickness="0,0,0,1" Background="Transparent">
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="18" />
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="Auto" />
							</Grid.ColumnDefinitions>
							<Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{DynamicResource OperatorWarningBrush}" VerticalAlignment="Center" />
							<TextBlock Grid.Column="1" Text="{TemplateBinding SubsystemName}" Style="{StaticResource OperatorLabel}" VerticalAlignment="Center" />
							<TextBlock Grid.Column="2" Text="{TemplateBinding State}" Style="{StaticResource OperatorValue}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" />
						</Grid>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="EvidenceState" Value="PASS"><Setter TargetName="StatusDot" Property="Fill" Value="{DynamicResource OperatorHealthyBrush}" /></Trigger>
						<Trigger Property="EvidenceState" Value="OK"><Setter TargetName="StatusDot" Property="Fill" Value="{DynamicResource OperatorHealthyBrush}" /></Trigger>
						<Trigger Property="EvidenceState" Value="FAIL"><Setter TargetName="StatusDot" Property="Fill" Value="{DynamicResource OperatorErrorBrush}" /></Trigger>
						<Trigger Property="EvidenceState" Value="ERROR"><Setter TargetName="StatusDot" Property="Fill" Value="{DynamicResource OperatorErrorBrush}" /></Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style TargetType="{x:Type controls:RtaimeAlertRow}">
		<Setter Property="Height" Value="38" />
		<Setter Property="Foreground" Value="{DynamicResource OperatorTextBrush}" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type controls:RtaimeAlertRow}">
					<Border BorderBrush="{DynamicResource OperatorBorderBrush}" BorderThickness="0,0,0,1" Background="Transparent">
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="18" />
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="Auto" />
							</Grid.ColumnDefinitions>
							<Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{DynamicResource OperatorWarningBrush}" VerticalAlignment="Center" />
							<StackPanel Grid.Column="1" VerticalAlignment="Center">
								<TextBlock Text="{TemplateBinding SubsystemName}" FontSize="10" FontWeight="SemiBold" />
								<TextBlock Text="{TemplateBinding Detail}" Style="{StaticResource OperatorLabel}" FontSize="9" TextTrimming="CharacterEllipsis" />
							</StackPanel>
							<TextBlock Grid.Column="2" Text="{TemplateBinding State}" Style="{StaticResource OperatorValue}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Right" />
						</Grid>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="EvidenceState" Value="PASS"><Setter TargetName="StatusDot" Property="Fill" Value="{DynamicResource OperatorHealthyBrush}" /></Trigger>
						<Trigger Property="EvidenceState" Value="OK"><Setter TargetName="StatusDot" Property="Fill" Value="{DynamicResource OperatorHealthyBrush}" /></Trigger>
						<Trigger Property="EvidenceState" Value="FAIL"><Setter TargetName="StatusDot" Property="Fill" Value="{DynamicResource OperatorErrorBrush}" /></Trigger>
						<Trigger Property="EvidenceState" Value="ERROR"><Setter TargetName="StatusDot" Property="Fill" Value="{DynamicResource OperatorErrorBrush}" /></Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style TargetType="{x:Type controls:RtaimeMetricDial}">
		<Setter Property="Width" Value="58" />
		<Setter Property="Height" Value="58" />
		<Setter Property="RingThickness" Value="5" />
		<Setter Property="Foreground" Value="{DynamicResource OperatorAccentBrush}" />
		<Setter Property="BorderBrush" Value="{DynamicResource OperatorBorderStrongBrush}" />
	</Style>

	<Style TargetType="{x:Type controls:RtaimeSparkline}">
		<Setter Property="Height" Value="24" />
		<Setter Property="MinWidth" Value="92" />
		<Setter Property="Foreground" Value="{DynamicResource OperatorAccentBrush}" />
		<Setter Property="Background" Value="#0A141C" />
		<Setter Property="LineThickness" Value="1" />
	</Style>
</ResourceDictionary>
