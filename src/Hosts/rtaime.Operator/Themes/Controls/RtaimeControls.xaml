<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:rtaime.Operator.Controls">

	<Style TargetType="{x:Type controls:RtaimeButton}">
		<Setter Property="Background" Value="{DynamicResource OperatorRaisedSurfaceBrush}" />
		<Setter Property="Foreground" Value="{DynamicResource OperatorTextBrush}" />
		<Setter Property="BorderBrush" Value="{DynamicResource OperatorBorderBrush}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="MinHeight" Value="{DynamicResource OperatorControlHeight}" />
		<Setter Property="Padding" Value="{DynamicResource OperatorControlPadding}" />
		<Setter Property="FontSize" Value="{DynamicResource OperatorFontSizeControl}" />
		<Setter Property="FontWeight" Value="SemiBold" />
		<Setter Property="HorizontalContentAlignment" Value="Center" />
		<Setter Property="VerticalContentAlignment" Value="Center" />
		<Setter Property="Cursor" Value="Hand" />
		<Setter Property="FocusVisualStyle" Value="{x:Null}" />
		<Setter Property="ToolTipService.InitialShowDelay" Value="300" />
		<Setter Property="ToolTipService.ShowDuration" Value="15000" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type controls:RtaimeButton}">
					<Border x:Name="Chrome"
						Background="{TemplateBinding Background}"
						BorderBrush="{TemplateBinding BorderBrush}"
						BorderThickness="{TemplateBinding BorderThickness}"
						CornerRadius="{DynamicResource OperatorRadiusControl}"
						Padding="{TemplateBinding Padding}"
						SnapsToDevicePixels="True">
						<ContentPresenter
							HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
							VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
							RecognizesAccessKey="True" />
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsCompact" Value="True">
							<Setter Property="MinHeight" Value="{DynamicResource OperatorCompactControlHeight}" />
							<Setter Property="Padding" Value="{DynamicResource OperatorCompactControlPadding}" />
						</Trigger>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="Chrome" Property="Background" Value="{DynamicResource OperatorRaisedHoverBrush}" />
							<Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource OperatorAccentBrush}" />
						</Trigger>
						<Trigger Property="IsKeyboardFocused" Value="True">
							<Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource OperatorFocusBrush}" />
						</Trigger>
						<Trigger Property="IsPressed" Value="True">
							<Setter TargetName="Chrome" Property="Background" Value="{DynamicResource OperatorAlternateSurfaceBrush}" />
							<Setter TargetName="Chrome" Property="Opacity" Value="0.78" />
						</Trigger>
						<Trigger Property="IsEnabled" Value="False">
							<Setter Property="Foreground" Value="{DynamicResource OperatorDisabledBrush}" />
							<Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style TargetType="{x:Type controls:RtaimeIconButton}">
		<Setter Property="Width" Value="28" />
		<Setter Property="Height" Value="28" />
		<Setter Property="Background" Value="{DynamicResource OperatorRaisedSurfaceBrush}" />
		<Setter Property="Foreground" Value="{DynamicResource OperatorTextBrush}" />
		<Setter Property="BorderBrush" Value="{DynamicResource OperatorBorderBrush}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="Padding" Value="0" />
		<Setter Property="Cursor" Value="Hand" />
		<Setter Property="FocusVisualStyle" Value="{x:Null}" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type controls:RtaimeIconButton}">
					<Border x:Name="Chrome"
						Background="{TemplateBinding Background}"
						BorderBrush="{TemplateBinding BorderBrush}"
						BorderThickness="{TemplateBinding BorderThickness}"
						CornerRadius="{DynamicResource OperatorRadiusControl}"
						SnapsToDevicePixels="True">
						<Path
							Width="16"
							Height="16"
							Data="{TemplateBinding IconData}"
							Fill="{TemplateBinding Foreground}"
							Stretch="Uniform"
							HorizontalAlignment="Center"
							VerticalAlignment="Center"
							SnapsToDevicePixels="True" />
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="Chrome" Property="Background" Value="{DynamicResource OperatorRaisedHoverBrush}" />
							<Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource OperatorAccentBrush}" />
						</Trigger>
						<Trigger Property="IsKeyboardFocused" Value="True">
							<Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource OperatorFocusBrush}" />
						</Trigger>
						<Trigger Property="IsPressed" Value="True">
							<Setter TargetName="Chrome" Property="Background" Value="{DynamicResource OperatorAlternateSurfaceBrush}" />
							<Setter TargetName="Chrome" Property="Opacity" Value="0.78" />
						</Trigger>
						<Trigger Property="IsEnabled" Value="False">
							<Setter Property="Foreground" Value="{DynamicResource OperatorDisabledBrush}" />
							<Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

