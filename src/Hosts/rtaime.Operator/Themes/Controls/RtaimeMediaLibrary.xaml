<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:rtaime.Operator.Controls">
	<SolidColorBrush x:Key="RtaimeMediaDurationOverlayBrush" Color="#D9071017" />
	<SolidColorBrush x:Key="RtaimeMediaOfflineOverlayBrush" Color="#C9071017" />

	<ControlTemplate x:Key="RtaimeMediaTextContentHostTemplate" TargetType="{x:Type ScrollViewer}">
		<ScrollContentPresenter />
	</ControlTemplate>

	<Style TargetType="{x:Type controls:RtaimeSearchBox}">
		<Setter Property="Background" Value="{DynamicResource OperatorRaisedSurfaceBrush}" />
		<Setter Property="Foreground" Value="{DynamicResource OperatorTextBrush}" />
		<Setter Property="CaretBrush" Value="{DynamicResource OperatorTextBrush}" />
		<Setter Property="SelectionBrush" Value="{DynamicResource OperatorAccentBrush}" />
		<Setter Property="BorderBrush" Value="{DynamicResource OperatorBorderBrush}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="Height" Value="30" />
		<Setter Property="Padding" Value="0" />
		<Setter Property="FontSize" Value="{DynamicResource OperatorFontSizeControl}" />
		<Setter Property="FocusVisualStyle" Value="{x:Null}" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type controls:RtaimeSearchBox}">
					<Border x:Name="Chrome"
						Background="{TemplateBinding Background}"
						BorderBrush="{TemplateBinding BorderBrush}"
						BorderThickness="{TemplateBinding BorderThickness}"
						CornerRadius="{DynamicResource OperatorRadiusControl}"
						SnapsToDevicePixels="True">
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="28" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<Path
								Width="14"
								Height="14"
								Data="{TemplateBinding IconData}"
								Fill="{DynamicResource OperatorSecondaryTextBrush}"
								Stretch="Uniform"
								HorizontalAlignment="Center"
								VerticalAlignment="Center" />
							<ScrollViewer
								x:Name="PART_ContentHost"
								Grid.Column="1"
								Margin="0,0,7,0"
								HorizontalScrollBarVisibility="Hidden"
								VerticalScrollBarVisibility="Hidden"
								FocusVisualStyle="{x:Null}"
								Template="{StaticResource RtaimeMediaTextContentHostTemplate}" />
							<TextBlock x:Name="Placeholder"
								Grid.Column="1"
								Margin="0,0,7,0"
								Text="{TemplateBinding Placeholder}"
								Foreground="{DynamicResource OperatorMutedTextBrush}"
								FontSize="{DynamicResource OperatorFontSizeControl}"
								VerticalAlignment="Center"
								IsHitTestVisible="False"
								Visibility="Collapsed" />
						</Grid>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="Text" Value="">
							<Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
						</Trigger>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource OperatorBorderStrongBrush}" />
						</Trigger>
						<Trigger Property="IsKeyboardFocused" Value="True">
							<Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource OperatorFocusBrush}" />
						</Trigger>
						<Trigger Property="IsEnabled" Value="False">
							<Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style TargetType="{x:Type controls:RtaimeMediaTile}">
		<Setter Property="Width" Value="120" />
		<Setter Property="Height" Value="104" />
		<Setter Property="Background" Value="{DynamicResource OperatorSurfaceBrush}" />
		<Setter Property="Foreground" Value="{DynamicResource OperatorTextBrush}" />
		<Setter Property="BorderBrush" Value="{DynamicResource OperatorBorderBrush}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="FocusVisualStyle" Value="{x:Null}" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type controls:RtaimeMediaTile}">
					<Border x:Name="TileChrome"
						Width="{TemplateBinding Width}"
						Height="{TemplateBinding Height}"
						Background="{TemplateBinding Background}"
						BorderBrush="{TemplateBinding BorderBrush}"
						BorderThickness="{TemplateBinding BorderThickness}"
						CornerRadius="{DynamicResource OperatorRadiusControl}"
						ClipToBounds="True"
						SnapsToDevicePixels="True">
						<Grid>
							<Grid.RowDefinitions>
								<RowDefinition Height="68" />
								<RowDefinition Height="18" />
								<RowDefinition Height="18" />
							</Grid.RowDefinitions>
							<Grid Grid.Row="0" Background="{DynamicResource OperatorBackgroundBrush}" ClipToBounds="True">
								<Image Source="{TemplateBinding Thumbnail}" Stretch="UniformToFill" />
								<Border x:Name="DurationBadge"
									HorizontalAlignment="Right"
									VerticalAlignment="Bottom"
									Margin="0,0,4,4"
									Padding="4,1"
									Background="{StaticResource RtaimeMediaDurationOverlayBrush}"
									CornerRadius="2">
									<TextBlock
										Text="{TemplateBinding Duration}"
										FontFamily="{DynamicResource OperatorTimecodeFontFamily}"
										FontSize="10"
										FontWeight="SemiBold" />
								</Border>
								<Border x:Name="OfflineOverlay"
									Background="{StaticResource RtaimeMediaOfflineOverlayBrush}"
									Visibility="Collapsed">
									<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
										<controls:RtaimeIcon
											Data="{DynamicResource RtaimeIconWarningGeometry}"
											Foreground="{DynamicResource OperatorWarningBrush}"
											Style="{StaticResource RtaimeIcon16}"
											HorizontalAlignment="Center" />
										<TextBlock
											Text="OFFLINE"
											Foreground="{DynamicResource OperatorWarningBrush}"
											FontSize="10"
											FontWeight="Bold"
											Margin="0,3,0,0"
											HorizontalAlignment="Center" />
									</StackPanel>
								</Border>
								<ContentPresenter x:Name="HoverActions"
									Content="{TemplateBinding Content}"
									ContentTemplate="{TemplateBinding ContentTemplate}"
									HorizontalAlignment="Right"
									VerticalAlignment="Top"
									Margin="4"
									Visibility="Collapsed" />
							</Grid>
							<TextBlock Grid.Row="1"
								Text="{TemplateBinding AssetName}"
								Foreground="{TemplateBinding Foreground}"
								FontSize="11"
								FontWeight="SemiBold"
								Margin="5,2,5,0"
								TextTrimming="CharacterEllipsis"
								VerticalAlignment="Center" />
							<Grid Grid.Row="2" Margin="5,0">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="Auto" />
								</Grid.ColumnDefinitions>
								<TextBlock
									Text="{TemplateBinding FileType}"
									Style="{StaticResource OperatorLabel}"
									FontSize="10"
									VerticalAlignment="Center" />
								<TextBlock Grid.Column="1"
									Text="{TemplateBinding Availability}"
									Style="{StaticResource OperatorLabel}"
									FontSize="10"
									VerticalAlignment="Center" />
							</Grid>
							<Border x:Name="SelectionAccent"
								Width="2"
								HorizontalAlignment="Left"
								Background="Transparent" />
						</Grid>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="Duration" Value="">
							<Setter TargetName="DurationBadge" Property="Visibility" Value="Collapsed" />
						</Trigger>
						<Trigger Property="IsOnline" Value="False">
							<Setter TargetName="OfflineOverlay" Property="Visibility" Value="Visible" />
						</Trigger>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="TileChrome" Property="Background" Value="{DynamicResource OperatorRaisedHoverBrush}" />
							<Setter TargetName="HoverActions" Property="Visibility" Value="Visible" />
						</Trigger>
						<Trigger Property="IsSelected" Value="True">
							<Setter TargetName="TileChrome" Property="BorderBrush" Value="{DynamicResource OperatorAccentBrush}" />
							<Setter TargetName="SelectionAccent" Property="Background" Value="{DynamicResource OperatorAccentBrush}" />
						</Trigger>
						<Trigger Property="IsEnabled" Value="False">
							<Setter TargetName="TileChrome" Property="Opacity" Value="0.45" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style TargetType="{x:Type controls:RtaimeContextMenu}">
		<Setter Property="Background" Value="{DynamicResource OperatorSurfaceBrush}" />
		<Setter Property="BorderBrush" Value="{DynamicResource OperatorBorderStrongBrush}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="Padding" Value="4" />
		<Setter Property="HasDropShadow" Value="False" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type controls:RtaimeContextMenu}">
					<Border
						Background="{TemplateBinding Background}"
						BorderBrush="{TemplateBinding BorderBrush}"
						BorderThickness="{TemplateBinding BorderThickness}"
						CornerRadius="{DynamicResource OperatorRadiusControl}"
						Padding="{TemplateBinding Padding}"
						SnapsToDevicePixels="True">
						<StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
					</Border>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style TargetType="{x:Type controls:RtaimeMenuItem}">
		<Setter Property="Foreground" Value="{DynamicResource OperatorTextBrush}" />
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="Padding" Value="9,5" />
		<Setter Property="MinHeight" Value="28" />
		<Setter Property="FontSize" Value="{DynamicResource OperatorFontSizeControl}" />
		<Setter Property="FocusVisualStyle" Value="{x:Null}" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type controls:RtaimeMenuItem}">
					<Border x:Name="Chrome"
						Background="{TemplateBinding Background}"
						CornerRadius="{DynamicResource OperatorRadiusControl}"
						Padding="{TemplateBinding Padding}">
						<ContentPresenter
							ContentSource="Header"
							RecognizesAccessKey="True"
							VerticalAlignment="Center" />
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsHighlighted" Value="True">
							<Setter TargetName="Chrome" Property="Background" Value="{DynamicResource OperatorRaisedHoverBrush}" />
						</Trigger>
						<Trigger Property="IsEnabled" Value="False">
							<Setter Property="Foreground" Value="{DynamicResource OperatorDisabledBrush}" />
							<Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style TargetType="{x:Type controls:RtaimeMenuSeparator}">
		<Setter Property="Height" Value="1" />
		<Setter Property="Margin" Value="5,4" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type controls:RtaimeMenuSeparator}">
					<Border Height="1" Background="{DynamicResource OperatorBorderBrush}" />
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style x:Key="RtaimeMediaOverlayScrollViewer" TargetType="{x:Type controls:RtaimeScrollViewer}">
		<Setter Property="FocusVisualStyle" Value="{x:Null}" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type controls:RtaimeScrollViewer}">
					<Grid SnapsToDevicePixels="True">
						<ScrollContentPresenter
							x:Name="PART_ScrollContentPresenter"
							Content="{TemplateBinding Content}"
							ContentTemplate="{TemplateBinding ContentTemplate}"
							CanContentScroll="{TemplateBinding CanContentScroll}"
							Margin="{TemplateBinding Padding}" />
						<controls:RtaimeScrollBar
							x:Name="PART_VerticalScrollBar"
							Width="8"
							HorizontalAlignment="Right"
							Maximum="{TemplateBinding ScrollableHeight}"
							Orientation="Vertical"
							ViewportSize="{TemplateBinding ViewportHeight}"
							Value="{Binding VerticalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"
							Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style x:Key="RtaimeMediaAssetListBox" TargetType="{x:Type controls:RtaimeListBox}">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="Foreground" Value="{DynamicResource OperatorTextBrush}" />
		<Setter Property="BorderThickness" Value="0" />
		<Setter Property="Padding" Value="0" />
		<Setter Property="HorizontalContentAlignment" Value="Stretch" />
		<Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
		<Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
		<Setter Property="FocusVisualStyle" Value="{x:Null}" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type controls:RtaimeListBox}">
					<controls:RtaimeScrollViewer
						Style="{StaticResource RtaimeMediaOverlayScrollViewer}"
						CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}"
						HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
						VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
						<ItemsPresenter />
					</controls:RtaimeScrollViewer>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style x:Key="RtaimeMediaTileContainer" TargetType="{x:Type controls:RtaimeListBoxItem}">
		<Setter Property="Width" Value="120" />
		<Setter Property="Height" Value="104" />
		<Setter Property="Padding" Value="0" />
		<Setter Property="Margin" Value="0" />
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="BorderThickness" Value="0" />
		<Setter Property="HorizontalContentAlignment" Value="Stretch" />
		<Setter Property="VerticalContentAlignment" Value="Stretch" />
		<Setter Property="FocusVisualStyle" Value="{x:Null}" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type controls:RtaimeListBoxItem}">
					<ContentPresenter
						HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
						VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style x:Key="RtaimeMediaListRowContainer" TargetType="{x:Type controls:RtaimeListBoxItem}">
		<Setter Property="Padding" Value="7,5" />
		<Setter Property="Margin" Value="0,0,0,2" />
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="Foreground" Value="{DynamicResource OperatorTextBrush}" />
		<Setter Property="BorderBrush" Value="Transparent" />
		<Setter Property="BorderThickness" Value="2,0,0,0" />
		<Setter Property="HorizontalContentAlignment" Value="Stretch" />
		<Setter Property="FocusVisualStyle" Value="{x:Null}" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type controls:RtaimeListBoxItem}">
					<Border x:Name="Chrome"
						Background="{TemplateBinding Background}"
						BorderBrush="{TemplateBinding BorderBrush}"
						BorderThickness="{TemplateBinding BorderThickness}"
						Padding="{TemplateBinding Padding}">
						<ContentPresenter />
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="Chrome" Property="Background" Value="{DynamicResource OperatorRaisedHoverBrush}" />
						</Trigger>
						<Trigger Property="IsSelected" Value="True">
							<Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource OperatorAccentBrush}" />
							<Setter TargetName="Chrome" Property="Background" Value="{DynamicResource OperatorSelectionSurfaceBrush}" />
						</Trigger>
						<Trigger Property="IsKeyboardFocused" Value="True">
							<Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource OperatorFocusBrush}" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style x:Key="RtaimeMediaFilterItem" TargetType="{x:Type controls:RtaimeListBoxItem}">
		<Setter Property="Padding" Value="4,4" />
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="Foreground" Value="{DynamicResource OperatorSecondaryTextBrush}" />
		<Setter Property="BorderBrush" Value="Transparent" />
		<Setter Property="BorderThickness" Value="0,0,0,2" />
		<Setter Property="HorizontalContentAlignment" Value="Center" />
		<Setter Property="VerticalContentAlignment" Value="Center" />
		<Setter Property="FontSize" Value="10" />
		<Setter Property="FontWeight" Value="SemiBold" />
		<Setter Property="FocusVisualStyle" Value="{x:Null}" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type controls:RtaimeListBoxItem}">
					<Border x:Name="Chrome"
						Background="{TemplateBinding Background}"
						BorderBrush="{TemplateBinding BorderBrush}"
						BorderThickness="{TemplateBinding BorderThickness}"
						Padding="{TemplateBinding Padding}">
						<ContentPresenter
							HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
							VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="Chrome" Property="Background" Value="{DynamicResource OperatorRaisedHoverBrush}" />
							<Setter Property="Foreground" Value="{DynamicResource OperatorTextBrush}" />
						</Trigger>
						<Trigger Property="IsSelected" Value="True">
							<Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource OperatorAccentBrush}" />
							<Setter Property="Foreground" Value="{DynamicResource OperatorTextBrush}" />
						</Trigger>
						<Trigger Property="IsKeyboardFocused" Value="True">
							<Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource OperatorFocusBrush}" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
</ResourceDictionary>
