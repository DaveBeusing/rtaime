<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:rtaime.Operator.Controls">

	<Style x:Key="RtaimeMonitorPanel" TargetType="Border">
		<Setter Property="Background" Value="{DynamicResource OperatorSurfaceBrush}" />
		<Setter Property="BorderBrush" Value="{DynamicResource OperatorBorderBrush}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="CornerRadius" Value="{DynamicResource OperatorRadiusPanel}" />
		<Setter Property="SnapsToDevicePixels" Value="True" />
		<Setter Property="ClipToBounds" Value="True" />
	</Style>

	<Style x:Key="RtaimeMonitorHeader" TargetType="Border">
		<Setter Property="Height" Value="40" />
		<Setter Property="Background" Value="{DynamicResource OperatorAlternateSurfaceBrush}" />
		<Setter Property="BorderBrush" Value="{DynamicResource OperatorBorderBrush}" />
		<Setter Property="BorderThickness" Value="0,0,0,1" />
		<Setter Property="Padding" Value="10,0" />
		<Setter Property="SnapsToDevicePixels" Value="True" />
	</Style>

	<Style x:Key="RtaimeMonitorTransport" TargetType="Border">
		<Setter Property="Height" Value="42" />
		<Setter Property="Background" Value="{DynamicResource OperatorAlternateSurfaceBrush}" />
		<Setter Property="BorderBrush" Value="{DynamicResource OperatorBorderBrush}" />
		<Setter Property="BorderThickness" Value="0,1,0,0" />
		<Setter Property="Padding" Value="7,5" />
		<Setter Property="SnapsToDevicePixels" Value="True" />
	</Style>

	<Style x:Key="RtaimeProductionLowerPanel" TargetType="Border">
		<Setter Property="Background" Value="{DynamicResource OperatorSurfaceBrush}" />
		<Setter Property="BorderBrush" Value="{DynamicResource OperatorBorderBrush}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="CornerRadius" Value="{DynamicResource OperatorRadiusPanel}" />
		<Setter Property="Padding" Value="10" />
		<Setter Property="SnapsToDevicePixels" Value="True" />
	</Style>

	<Style x:Key="RtaimeProductionRow" TargetType="Border">
		<Setter Property="Height" Value="54" />
		<Setter Property="Background" Value="{DynamicResource OperatorRaisedSurfaceBrush}" />
		<Setter Property="BorderBrush" Value="Transparent" />
		<Setter Property="BorderThickness" Value="2,0,0,0" />
		<Setter Property="Padding" Value="7,5" />
		<Setter Property="Margin" Value="0,0,0,4" />
		<Setter Property="CornerRadius" Value="{DynamicResource OperatorRadiusControl}" />
	</Style>

	<Style x:Key="RtaimeProductionSceneItem" TargetType="{x:Type controls:RtaimeListBoxItem}">
		<Setter Property="Height" Value="50" />
		<Setter Property="Padding" Value="0" />
		<Setter Property="Margin" Value="0,0,0,4" />
		<Setter Property="Background" Value="{DynamicResource OperatorRaisedSurfaceBrush}" />
		<Setter Property="BorderBrush" Value="Transparent" />
		<Setter Property="BorderThickness" Value="2,0,0,0" />
		<Setter Property="HorizontalContentAlignment" Value="Stretch" />
		<Setter Property="VerticalContentAlignment" Value="Stretch" />
		<Setter Property="FocusVisualStyle" Value="{x:Null}" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type controls:RtaimeListBoxItem}">
					<Border x:Name="Chrome"
						Background="{TemplateBinding Background}"
						BorderBrush="{TemplateBinding BorderBrush}"
						BorderThickness="{TemplateBinding BorderThickness}"
						CornerRadius="{DynamicResource OperatorRadiusControl}"
						Padding="{TemplateBinding Padding}"
						SnapsToDevicePixels="True">
						<ContentPresenter />
					</Border>
					<ControlTemplate.Triggers>
						<DataTrigger Binding="{Binding IsProgram}" Value="True">
							<Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource OperatorAccentBrush}" />
							<Setter TargetName="Chrome" Property="Background" Value="{DynamicResource OperatorSelectionSurfaceBrush}" />
						</DataTrigger>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="Chrome" Property="Background" Value="{DynamicResource OperatorRaisedHoverBrush}" />
						</Trigger>
						<Trigger Property="IsSelected" Value="True">
							<Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource OperatorAccentBrush}" />
							<Setter TargetName="Chrome" Property="Background" Value="{DynamicResource OperatorSelectionSurfaceBrush}" />
						</Trigger>
						<Trigger Property="IsKeyboardFocused" Value="True">
							<Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource OperatorFocusBrush}" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style x:Key="RtaimeProductionStatusDot" TargetType="Ellipse">
		<Setter Property="Width" Value="7" />
		<Setter Property="Height" Value="7" />
		<Setter Property="Fill" Value="{DynamicResource OperatorWarningBrush}" />
		<Setter Property="VerticalAlignment" Value="Center" />
		<Setter Property="Margin" Value="0,0,6,0" />
	</Style>
</ResourceDictionary>
