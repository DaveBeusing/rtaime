<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:sys="clr-namespace:System;assembly=System.Runtime">
	<!-- Typography -->
	<FontFamily x:Key="OperatorFontFamily">Segoe UI Variable Text, Segoe UI</FontFamily>
	<FontFamily x:Key="OperatorTimecodeFontFamily">Cascadia Mono, Consolas</FontFamily>
	<sys:Double x:Key="OperatorFontSizeFinePrint">8</sys:Double>
	<sys:Double x:Key="OperatorFontSizeMicro">9</sys:Double>
	<sys:Double x:Key="OperatorFontSizeCompact">10</sys:Double>
	<sys:Double x:Key="OperatorFontSizeCaption">11</sys:Double>
	<sys:Double x:Key="OperatorFontSizeBody">12</sys:Double>
	<sys:Double x:Key="OperatorFontSizeControl">12</sys:Double>
	<sys:Double x:Key="OperatorFontSizeMetadata">13</sys:Double>
	<sys:Double x:Key="OperatorFontSizeSection">14</sys:Double>
	<sys:Double x:Key="OperatorFontSizeWorkspaceHeader">15</sys:Double>
	<sys:Double x:Key="OperatorFontSizeSubheading">16</sys:Double>
	<sys:Double x:Key="OperatorFontSizeProminent">17</sys:Double>
	<sys:Double x:Key="OperatorFontSizeLargeTimecode">18</sys:Double>
	<sys:Double x:Key="OperatorFontSizeMediaTitle">19</sys:Double>
	<sys:Double x:Key="OperatorFontSizeDisplay">20</sys:Double>
	<sys:Double x:Key="OperatorFontSizeDisplayLarge">22</sys:Double>
	<sys:Double x:Key="OperatorFontSizeProduct">24</sys:Double>
	<sys:Double x:Key="OperatorFontSizeTitle">24</sys:Double>
	<sys:Double x:Key="OperatorFontSizeHero">40</sys:Double>

	<!-- Reference geometry: 1920x1080 at 100 percent. -->
	<sys:Double x:Key="OperatorReferenceWidth">1920</sys:Double>
	<sys:Double x:Key="OperatorReferenceHeight">1080</sys:Double>
	<sys:Double x:Key="OperatorTopBarHeight">60</sys:Double>
	<sys:Double x:Key="OperatorNavigationWidth">92</sys:Double>
	<sys:Double x:Key="OperatorMediaPanelWidth">400</sys:Double>
	<sys:Double x:Key="OperatorCenterWidth">1070</sys:Double>
	<sys:Double x:Key="OperatorInspectorWidth">340</sys:Double>
	<sys:Double x:Key="OperatorUpperWorkspaceHeight">700</sys:Double>
	<sys:Double x:Key="OperatorTimelineHeight">320</sys:Double>
	<sys:Double x:Key="OperatorRegionGap">6</sys:Double>
	<GridLength x:Key="OperatorTopBarGridLength">60</GridLength>
	<GridLength x:Key="OperatorRegionGapGridLength">6</GridLength>

	<!-- Spacing and control metrics. -->
	<sys:Double x:Key="OperatorSpacing4">4</sys:Double>
	<sys:Double x:Key="OperatorSpacing6">6</sys:Double>
	<sys:Double x:Key="OperatorSpacing8">8</sys:Double>
	<sys:Double x:Key="OperatorSpacing12">12</sys:Double>
	<sys:Double x:Key="OperatorSpacing16">16</sys:Double>
	<sys:Double x:Key="OperatorSpacing24">24</sys:Double>
	<sys:Double x:Key="OperatorControlHeight">30</sys:Double>
	<sys:Double x:Key="OperatorCompactControlHeight">26</sys:Double>
	<sys:Double x:Key="OperatorFocusThickness">1</sys:Double>
	<Thickness x:Key="OperatorWindowPadding">6</Thickness>
	<Thickness x:Key="OperatorPanelPadding">8</Thickness>
	<Thickness x:Key="OperatorControlPadding">8,4</Thickness>
	<Thickness x:Key="OperatorCompactControlPadding">6,3</Thickness>
	<Thickness x:Key="OperatorStatusPadding">8,4</Thickness>
	<Thickness x:Key="OperatorCompactOverlayPadding">7,4</Thickness>
	<Thickness x:Key="OperatorMonitorLabelPadding">8,5</Thickness>
	<Thickness x:Key="OperatorMonitorFooterPadding">10,7</Thickness>
	<CornerRadius x:Key="OperatorRadiusPanel">4</CornerRadius>
	<CornerRadius x:Key="OperatorRadiusControl">3</CornerRadius>
	<CornerRadius x:Key="OperatorRadiusStatus">3</CornerRadius>
	<CornerRadius x:Key="OperatorRadiusMeter">2</CornerRadius>

	<!-- Binding mockup palette. -->
	<Color x:Key="OperatorColorBackground">#071017</Color>
	<Color x:Key="OperatorColorStartupGradientStart">#05070B</Color>
	<Color x:Key="OperatorColorStartupGradientMiddle">#071017</Color>
	<Color x:Key="OperatorColorStartupGradientEnd">#0B1722</Color>
	<Color x:Key="OperatorColorTopBar">#09131B</Color>
	<Color x:Key="OperatorColorNavigation">#0B151E</Color>
	<Color x:Key="OperatorColorSurface">#101B24</Color>
	<Color x:Key="OperatorColorAlternateSurface">#121F29</Color>
	<Color x:Key="OperatorColorRaisedSurface">#16242F</Color>
	<Color x:Key="OperatorColorRaisedHover">#1C2D38</Color>
	<Color x:Key="OperatorColorBorder">#25343F</Color>
	<Color x:Key="OperatorColorBorderStrong">#314553</Color>
	<Color x:Key="OperatorColorText">#EEF3F6</Color>
	<Color x:Key="OperatorColorSecondaryText">#9AA8B4</Color>
	<Color x:Key="OperatorColorMutedText">#6F7D89</Color>
	<Color x:Key="OperatorColorDisabled">#6F7D89</Color>
	<Color x:Key="OperatorColorAccent">#16CDD3</Color>
	<Color x:Key="OperatorColorAccentSurface">#121F29</Color>
	<Color x:Key="OperatorColorSelectionSurface">#16242F</Color>
	<Color x:Key="OperatorColorFocus">#16CDD3</Color>
	<Color x:Key="OperatorColorTimeline">#3478D4</Color>
	<Color x:Key="OperatorColorGraphics">#7259D7</Color>
	<Color x:Key="OperatorColorAudio">#22A977</Color>

	<!-- Shared media, monitor and overlay presentation. -->
	<Color x:Key="OperatorColorMediaCanvas">#05080B</Color>
	<Color x:Key="OperatorColorThumbnailCanvas">#090C10</Color>
	<Color x:Key="OperatorColorDiagnosticSurface">#0A141C</Color>
	<Color x:Key="OperatorColorTimelineSurface">#0C151D</Color>
	<Color x:Key="OperatorColorTimelineTrack">#111D26</Color>
	<Color x:Key="OperatorColorTimelineTrackOverlay">#E0111D26</Color>
	<Color x:Key="OperatorColorOverlayScrimSoft">#B0000000</Color>
	<Color x:Key="OperatorColorOverlayScrim">#C0000000</Color>
	<Color x:Key="OperatorColorOverlayText">#FFFFFFFF</Color>
	<Color x:Key="OperatorColorGuideSubtle">#55FFFFFF</Color>
	<Color x:Key="OperatorColorGuideMedium">#70FFFFFF</Color>
	<Color x:Key="OperatorColorGuideStrong">#B0FFFFFF</Color>
	<Color x:Key="OperatorColorGuidePrimary">#C0FFFFFF</Color>
	<Color x:Key="OperatorColorMonitorHeaderOverlay">#CC071017</Color>
	<Color x:Key="OperatorColorMonitorFooterOverlay">#D0071017</Color>
	<Color x:Key="OperatorColorMultiviewHeaderOverlay">#DC071017</Color>
	<Color x:Key="OperatorColorMultiviewOverlay">#D8071017</Color>
	<Color x:Key="OperatorColorMultiviewOverlayMuted">#C8071017</Color>
	<Color x:Key="OperatorColorMultiviewOverlayStrong">#F2071017</Color>
	<Color x:Key="OperatorColorGraphSurface">#13222C</Color>
	<Color x:Key="OperatorColorGraphSurfaceRaised">#1B303C</Color>
	<Color x:Key="OperatorColorGraphOverlay">#D00A141C</Color>
	<Color x:Key="OperatorColorTimelineStatusText">#D8FFFFFF</Color>

	<!-- Production semantics. Program and Preview remain intentionally distinct. -->
	<Color x:Key="OperatorColorPreview">#29D38B</Color>
	<Color x:Key="OperatorColorPreviewSurface">#121F29</Color>
	<Color x:Key="OperatorColorProgram">#FF4D52</Color>
	<Color x:Key="OperatorColorProgramSurface">#121F29</Color>
	<Color x:Key="OperatorColorArmed">#F6B84A</Color>
	<Color x:Key="OperatorColorArmedSurface">#121F29</Color>
	<Color x:Key="OperatorColorHealthy">#29D38B</Color>
	<Color x:Key="OperatorColorWarning">#F6B84A</Color>
	<Color x:Key="OperatorColorError">#FF4D52</Color>
	<Color x:Key="OperatorColorMeterSafe">#29D38B</Color>
	<Color x:Key="OperatorColorMeterWarning">#F6B84A</Color>
	<Color x:Key="OperatorColorMeterClip">#FF4D52</Color>
</ResourceDictionary>
