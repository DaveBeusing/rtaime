<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<!-- Typography -->
	<FontFamily x:Key="OperatorFontFamily">Segoe UI</FontFamily>
	<FontFamily x:Key="OperatorTimecodeFontFamily">Cascadia Mono, Consolas</FontFamily>
	<x:Double x:Key="OperatorFontSizeCaption">11</x:Double>
	<x:Double x:Key="OperatorFontSizeBody">13</x:Double>
	<x:Double x:Key="OperatorFontSizeControl">13</x:Double>
	<x:Double x:Key="OperatorFontSizeSection">15</x:Double>
	<x:Double x:Key="OperatorFontSizeTitle">24</x:Double>

	<!-- Geometry and spacing. WPF device-independent units keep these stable across DPI changes. -->
	<x:Double x:Key="OperatorControlHeight">36</x:Double>
	<x:Double x:Key="OperatorCompactControlHeight">30</x:Double>
	<x:Double x:Key="OperatorFocusThickness">2</x:Double>
	<Thickness x:Key="OperatorWindowPadding">20</Thickness>
	<Thickness x:Key="OperatorPanelPadding">16</Thickness>
	<Thickness x:Key="OperatorControlPadding">14,9</Thickness>
	<Thickness x:Key="OperatorCompactControlPadding">9,5</Thickness>
	<Thickness x:Key="OperatorStatusPadding">10,6</Thickness>
	<CornerRadius x:Key="OperatorRadiusPanel">8</CornerRadius>
	<CornerRadius x:Key="OperatorRadiusControl">5</CornerRadius>
	<CornerRadius x:Key="OperatorRadiusStatus">6</CornerRadius>
	<CornerRadius x:Key="OperatorRadiusMeter">2</CornerRadius>

	<!-- Neutral production palette -->
	<Color x:Key="OperatorColorBackground">#0D1117</Color>
	<Color x:Key="OperatorColorSurface">#151B23</Color>
	<Color x:Key="OperatorColorRaisedSurface">#1D2631</Color>
	<Color x:Key="OperatorColorRaisedHover">#263342</Color>
	<Color x:Key="OperatorColorBorder">#344252</Color>
	<Color x:Key="OperatorColorText">#F3F6FA</Color>
	<Color x:Key="OperatorColorMutedText">#9AA8B8</Color>
	<Color x:Key="OperatorColorDisabled">#667386</Color>
	<Color x:Key="OperatorColorAccent">#54A9FF</Color>
	<Color x:Key="OperatorColorFocus">#CFE7FF</Color>

	<!-- Production semantics. Program and Preview are intentionally never interchangeable. -->
	<Color x:Key="OperatorColorPreview">#43C785</Color>
	<Color x:Key="OperatorColorProgram">#F05A5A</Color>
	<Color x:Key="OperatorColorArmed">#E7B84B</Color>
	<Color x:Key="OperatorColorHealthy">#49C98A</Color>
	<Color x:Key="OperatorColorWarning">#E7B84B</Color>
	<Color x:Key="OperatorColorError">#FF6B6B</Color>
	<Color x:Key="OperatorColorMeterSafe">#49C98A</Color>
	<Color x:Key="OperatorColorMeterWarning">#E7B84B</Color>
	<Color x:Key="OperatorColorMeterClip">#F05A5A</Color>
</ResourceDictionary>
