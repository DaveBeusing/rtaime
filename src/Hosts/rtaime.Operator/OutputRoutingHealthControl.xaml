<UserControl x:Class="rtaime.Operator.OutputRoutingHealthControl"
	x:Name="Root"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:rtaime.Operator.Controls"
	xmlns:local="clr-namespace:rtaime.Operator"
	MinWidth="320">
	<UserControl.Resources>
		<Style x:Key="OutputRowStyle" TargetType="{x:Type controls:RtaimeOutputRow}" BasedOn="{StaticResource {x:Type controls:RtaimeOutputRow}}">
			<Setter Property="Thumbnail" Value="{Binding ProgramImage, RelativeSource={RelativeSource AncestorType={x:Type local:OutputRoutingHealthControl}}}" />
			<Style.Triggers>
				<DataTrigger Binding="{Binding Id}" Value="preview">
					<Setter Property="Thumbnail" Value="{Binding PreviewImage, RelativeSource={RelativeSource AncestorType={x:Type local:OutputRoutingHealthControl}}}" />
				</DataTrigger>
				<DataTrigger Binding="{Binding Id}" Value="aux">
					<Setter Property="Thumbnail" Value="{x:Null}" />
				</DataTrigger>
			</Style.Triggers>
		</Style>

		<DataTemplate x:Key="OutputRowTemplate">
			<controls:RtaimeOutputRow
				Style="{StaticResource OutputRowStyle}"
				OutputName="{Binding Name}"
				AssignedSource="{Binding AssignedSource}"
				Target="{Binding Target}"
				Resolution="{Binding Resolution}"
				FrameRate="{Binding FrameRate}"
				ColorSpace="{Binding ColorSpace}"
				RouteState="{Binding Status}"
				EvidenceState="{Binding EvidenceState}"
				ToolTip="{Binding Detail}" />
		</DataTemplate>

		<DataTemplate x:Key="HealthRowTemplate">
			<controls:RtaimeHealthRow
				SubsystemName="{Binding Name}"
				State="{Binding Status}"
				EvidenceState="{Binding EvidenceState}" />
		</DataTemplate>
	</UserControl.Resources>

	<Grid>
		<Grid x:Name="CompactLiveOutput" Height="270" Background="{DynamicResource OperatorPanelBrush}">
			<Grid.Style>
				<Style TargetType="Grid">
					<Setter Property="Visibility" Value="Collapsed" />
					<Style.Triggers>
						<DataTrigger Binding="{Binding CompactMode, ElementName=Root}" Value="True">
							<Setter Property="Visibility" Value="Visible" />
						</DataTrigger>
					</Style.Triggers>
				</Style>
			</Grid.Style>
			<Grid.RowDefinitions>
				<RowDefinition Height="27" />
				<RowDefinition Height="216" />
				<RowDefinition Height="27" />
			</Grid.RowDefinitions>

			<Border Grid.Row="0"
				Background="{DynamicResource OperatorAlternateSurfaceBrush}"
				BorderBrush="{DynamicResource OperatorBorderBrush}"
				BorderThickness="1,1,1,0"
				Padding="8,0">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>
					<TextBlock Text="OUTPUT ROUTING" Style="{StaticResource OperatorSectionTitle}" VerticalAlignment="Center" />
					<StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
						<TextBlock Text="{Binding AccessState}" Style="{StaticResource OperatorLabel}" FontWeight="SemiBold" />
						<TextBlock Text=" · " Style="{StaticResource OperatorLabel}" />
						<TextBlock Text="{Binding AccessEvidenceState}" Style="{StaticResource OperatorLabel}" />
					</StackPanel>
				</Grid>
			</Border>

			<controls:RtaimeListBox Grid.Row="1"
				ItemsSource="{Binding Outputs}"
				SelectedItem="{Binding SelectedOutput, Mode=TwoWay}"
				ItemTemplate="{StaticResource OutputRowTemplate}"
				Background="Transparent"
				BorderBrush="{DynamicResource OperatorBorderBrush}"
				BorderThickness="1,0,1,0"
				ScrollViewer.HorizontalScrollBarVisibility="Disabled"
				ScrollViewer.VerticalScrollBarVisibility="Disabled"
				AutomationProperties.Name="Compact output routing">
				<controls:RtaimeListBox.ItemContainerStyle>
					<Style TargetType="{x:Type controls:RtaimeListBoxItem}">
						<Setter Property="Height" Value="54" />
						<Setter Property="Padding" Value="0" />
						<Setter Property="Margin" Value="0" />
						<Setter Property="Background" Value="Transparent" />
						<Setter Property="BorderThickness" Value="0" />
						<Setter Property="HorizontalContentAlignment" Value="Stretch" />
						<Setter Property="VerticalContentAlignment" Value="Stretch" />
					</Style>
				</controls:RtaimeListBox.ItemContainerStyle>
			</controls:RtaimeListBox>

			<Border Grid.Row="2"
				Background="{DynamicResource OperatorAlternateSurfaceBrush}"
				BorderBrush="{DynamicResource OperatorBorderBrush}"
				BorderThickness="1,0,1,1"
				Padding="5,0">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>
					<TextBlock Text="{Binding AccessDetail}" Style="{StaticResource OperatorLabel}" FontSize="9" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
					<controls:RtaimeButton Grid.Column="1"
						Content="TAKE PVW → PGM"
						Command="{Binding RoutePreviewToProgramCommand}"
						IsCompact="True"
						Height="26"
						Background="{DynamicResource OperatorAccentBrush}"
						BorderBrush="{DynamicResource OperatorAccentBrush}"
						Foreground="{DynamicResource OperatorBackgroundBrush}"
						Margin="6,0,0,0"
						ToolTip="Uses the existing authoritative CUT command." />
				</Grid>
			</Border>
		</Grid>

		<StackPanel x:Name="FullOutputSurface">
			<StackPanel.Style>
				<Style TargetType="StackPanel">
					<Setter Property="Visibility" Value="Visible" />
					<Style.Triggers>
						<DataTrigger Binding="{Binding CompactMode, ElementName=Root}" Value="True">
							<Setter Property="Visibility" Value="Collapsed" />
						</DataTrigger>
					</Style.Triggers>
				</Style>
			</StackPanel.Style>

			<Border Style="{StaticResource OperatorPanel}" Margin="0,0,0,14">
				<StackPanel>
					<DockPanel Margin="0,0,0,8">
						<StackPanel>
							<TextBlock Text="OUTPUT ROUTING" Style="{StaticResource OperatorSectionTitle}" />
							<TextBlock Text="Authoritative Program state and local monitoring outputs" Style="{StaticResource OperatorLabel}" Margin="0,2,0,0" />
						</StackPanel>
						<controls:RtaimeStatusBadge
							Status="{x:Static controls:RtaimeStatusKind.Neutral}"
							Content="{Binding AccessState}"
							ShowIndicator="True"
							DockPanel.Dock="Right" />
					</DockPanel>

					<controls:RtaimeListBox
						ItemsSource="{Binding Outputs}"
						SelectedItem="{Binding SelectedOutput, Mode=TwoWay}"
						ItemTemplate="{StaticResource OutputRowTemplate}"
						Background="Transparent"
						BorderBrush="{DynamicResource OperatorBorderBrush}"
						BorderThickness="1,1,1,0"
						ScrollViewer.HorizontalScrollBarVisibility="Disabled"
						ScrollViewer.VerticalScrollBarVisibility="Disabled">
						<controls:RtaimeListBox.ItemContainerStyle>
							<Style TargetType="{x:Type controls:RtaimeListBoxItem}">
								<Setter Property="Height" Value="54" />
								<Setter Property="Padding" Value="0" />
								<Setter Property="Margin" Value="0" />
								<Setter Property="Background" Value="Transparent" />
								<Setter Property="BorderThickness" Value="0" />
								<Setter Property="HorizontalContentAlignment" Value="Stretch" />
								<Setter Property="VerticalContentAlignment" Value="Stretch" />
							</Style>
						</controls:RtaimeListBox.ItemContainerStyle>
					</controls:RtaimeListBox>

					<controls:RtaimeButton
						Content="TAKE PREVIEW → PROGRAM"
						Command="{Binding RoutePreviewToProgramCommand}"
						MinHeight="30"
						Margin="0,8,0,0"
						Background="{DynamicResource OperatorAccentBrush}"
						BorderBrush="{DynamicResource OperatorAccentBrush}"
						Foreground="{DynamicResource OperatorBackgroundBrush}"
						ToolTip="Uses the existing authoritative CUT command. Disabled automatically when routing is not safe." />
				</StackPanel>
			</Border>

			<Border Style="{StaticResource OperatorPanel}" Margin="0,0,0,14">
				<StackPanel>
					<TextBlock Text="SYSTEM HEALTH" Style="{StaticResource OperatorSectionTitle}" Margin="0,0,0,6" />
					<ItemsControl ItemsSource="{Binding SystemHealth}" ItemTemplate="{StaticResource HealthRowTemplate}" />
					<TextBlock Text="Health reuses existing Control/Runtime evidence; no workspace-specific thresholds are applied." Style="{StaticResource OperatorLabel}" TextWrapping="Wrap" Margin="0,7,0,0" />
				</StackPanel>
			</Border>

			<Border Style="{StaticResource OperatorPanel}" Margin="0,0,0,14">
				<StackPanel>
					<DockPanel Margin="0,0,0,8">
						<TextBlock Text="SELECTED OUTPUT" Style="{StaticResource OperatorSectionTitle}" />
						<controls:RtaimeStatusBadge
							Status="{x:Static controls:RtaimeStatusKind.Neutral}"
							Content="{Binding SelectedOutput.Status}"
							ShowIndicator="True"
							DockPanel.Dock="Right" />
					</DockPanel>

					<TextBlock Text="{Binding SelectedOutput.Name}" FontSize="15" FontWeight="SemiBold" />
					<TextBlock Text="{Binding SelectedOutput.Detail}" Style="{StaticResource OperatorLabel}" TextWrapping="Wrap" Margin="0,2,0,9" />

					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="10" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>
						<StackPanel Grid.Column="0">
							<DockPanel Height="24"><TextBlock Text="Source" Style="{StaticResource OperatorLabel}" /><TextBlock Text="{Binding SelectedOutput.AssignedSource}" Style="{StaticResource OperatorValue}" DockPanel.Dock="Right" TextTrimming="CharacterEllipsis" MaxWidth="190" /></DockPanel>
							<DockPanel Height="24"><TextBlock Text="Resolution" Style="{StaticResource OperatorLabel}" /><TextBlock Text="{Binding SelectedOutput.Resolution}" Style="{StaticResource OperatorValue}" DockPanel.Dock="Right" /></DockPanel>
							<DockPanel Height="24"><TextBlock Text="Frame Rate" Style="{StaticResource OperatorLabel}" /><TextBlock Text="{Binding SelectedOutput.FrameRate}" Style="{StaticResource OperatorValue}" DockPanel.Dock="Right" /></DockPanel>
							<DockPanel Height="24"><TextBlock Text="Pixel Format" Style="{StaticResource OperatorLabel}" /><TextBlock Text="{Binding SelectedOutput.PixelFormat}" Style="{StaticResource OperatorValue}" DockPanel.Dock="Right" /></DockPanel>
						</StackPanel>
						<StackPanel Grid.Column="2">
							<DockPanel Height="24"><TextBlock Text="Color Space" Style="{StaticResource OperatorLabel}" /><TextBlock Text="{Binding SelectedOutput.ColorSpace}" Style="{StaticResource OperatorValue}" DockPanel.Dock="Right" /></DockPanel>
							<DockPanel Height="24"><TextBlock Text="Recording" Style="{StaticResource OperatorLabel}" /><TextBlock Text="{Binding SelectedOutput.RecordingStatus}" Style="{StaticResource OperatorValue}" DockPanel.Dock="Right" /></DockPanel>
							<DockPanel Height="24"><TextBlock Text="Streaming" Style="{StaticResource OperatorLabel}" /><TextBlock Text="{Binding SelectedOutput.StreamingStatus}" Style="{StaticResource OperatorValue}" DockPanel.Dock="Right" /></DockPanel>
							<DockPanel Height="24"><TextBlock Text="Target" Style="{StaticResource OperatorLabel}" /><TextBlock Text="{Binding SelectedOutput.Target}" Style="{StaticResource OperatorValue}" DockPanel.Dock="Right" TextTrimming="CharacterEllipsis" MaxWidth="190" /></DockPanel>
						</StackPanel>
					</Grid>
				</StackPanel>
			</Border>

			<Border Style="{StaticResource OperatorPanel}">
				<StackPanel>
					<TextBlock Text="PERFORMANCE" Style="{StaticResource OperatorSectionTitle}" Margin="0,0,0,6" />
					<ItemsControl ItemsSource="{Binding Metrics}">
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<Grid Height="52" ToolTip="{Binding Detail}">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="108" />
										<ColumnDefinition Width="74" />
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="104" />
									</Grid.ColumnDefinitions>
									<TextBlock Text="{Binding Name}" Style="{StaticResource OperatorLabel}" VerticalAlignment="Center" />
									<StackPanel Grid.Column="1" VerticalAlignment="Center">
										<TextBlock Text="{Binding Value}" Style="{StaticResource OperatorValue}" FontSize="10" FontWeight="SemiBold" />
										<TextBlock Text="{Binding Status}" Style="{StaticResource OperatorLabel}" FontSize="8" />
									</StackPanel>
									<controls:RtaimeMetricBar
										Grid.Column="2"
										Minimum="0"
										Maximum="100"
										Value="{Binding GaugeValue}"
										HasValue="{Binding HasGaugeSample}"
										Height="4"
										Margin="8,0"
										VerticalAlignment="Center" />
									<controls:RtaimeSparkline
										Grid.Column="3"
										Points="{Binding HistoryPoints}"
										HasValue="{Binding HasGaugeSample}"
										Height="24"
										Margin="4,0,0,0"
										VerticalAlignment="Center" />
								</Grid>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
					<TextBlock Text="Unavailable telemetry remains explicitly UNAVAILABLE. No local probing or extra sampling loop is introduced." Style="{StaticResource OperatorLabel}" TextWrapping="Wrap" Margin="0,7,0,0" />
				</StackPanel>
			</Border>
		</StackPanel>
	</Grid>
</UserControl>
