<UserControl x:Class="rtaime.Operator.AudioMixerControl"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:rtaime.Operator.Controls"
	AutomationProperties.Name="Bounded audio mixer">
	<Border Style="{StaticResource OperatorPanel}">
		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
			</Grid.RowDefinitions>

			<StackPanel Grid.Row="0" Margin="0,0,0,10">
				<DockPanel Margin="0,0,0,5">
					<TextBlock Text="AUDIO MIXER" Style="{StaticResource OperatorSectionTitle}" />
					<Border Style="{StaticResource OperatorStatusBadge}" DockPanel.Dock="Right">
						<TextBlock Text="{Binding MutationState}" FontWeight="Bold" />
					</Border>
				</DockPanel>
				<DockPanel Margin="0,0,0,3">
					<TextBlock Text="{Binding BoundsLabel}" Style="{StaticResource OperatorLabel}" />
					<TextBlock Text="{Binding Availability}" Style="{StaticResource OperatorValue}" DockPanel.Dock="Right" />
				</DockPanel>
				<TextBlock Text="{Binding DisabledReason}" Style="{StaticResource OperatorLabel}" TextWrapping="Wrap" />
			</StackPanel>

			<controls:RtaimeScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
				<StackPanel Margin="0,0,2,0">
					<Border BorderBrush="{DynamicResource OperatorBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="9" Margin="0,0,0,10">
						<StackPanel>
							<DockPanel Margin="0,0,0,6">
								<TextBlock Text="ROUTING AUTHORITY" Style="{StaticResource OperatorLabel}" FontWeight="SemiBold" />
								<TextBlock Text="{Binding Owner.AudioRoutingMode}" Style="{StaticResource OperatorValue}" DockPanel.Dock="Right" />
							</DockPanel>
							<DockPanel Margin="0,0,0,8">
								<TextBlock Text="Confirmed source" Style="{StaticResource OperatorLabel}" />
								<TextBlock Text="{Binding Owner.AudioRoutingSourceName}" Style="{StaticResource OperatorValue}" DockPanel.Dock="Right" TextTrimming="CharacterEllipsis" MaxWidth="190" />
							</DockPanel>
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="6" />
									<ColumnDefinition Width="*" />
								</Grid.ColumnDefinitions>
								<controls:RtaimeButton Grid.Column="0" Content="FOLLOW VIDEO" Command="{Binding Owner.SetAudioFollowVideoCommand}" IsCompact="True" />
								<controls:RtaimeButton Grid.Column="2" Content="BREAKAWAY SELECTED" Command="{Binding Owner.SetAudioBreakawayCommand}" IsCompact="True"
									Background="{DynamicResource OperatorAccentSurfaceBrush}" BorderBrush="{DynamicResource OperatorAccentBrush}" />
							</Grid>
						</StackPanel>
					</Border>

					<DockPanel Margin="0,0,0,7">
						<TextBlock Text="SOURCE STRIPS" Style="{StaticResource OperatorSectionTitle}" />
						<TextBlock Text="{Binding MeteringLabel}" Style="{StaticResource OperatorLabel}" DockPanel.Dock="Right" />
					</DockPanel>
					<controls:RtaimeListBox
						ItemsSource="{Binding Sources}"
						SelectedItem="{Binding SelectedSource, Mode=TwoWay}"
						Style="{StaticResource RtaimeSourceBank}"
						ItemContainerStyle="{StaticResource OperatorSourceItem}"
						AutomationProperties.Name="Audio source strips"
						Margin="0,0,0,10">
						<controls:RtaimeListBox.ItemTemplate>
							<DataTemplate>
								<StackPanel>
									<DockPanel Margin="0,0,0,4">
										<StackPanel>
											<TextBlock Text="{Binding SourceName}" Style="{StaticResource OperatorValue}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
											<TextBlock Text="{Binding SourceId}" Style="{StaticResource OperatorLabel}" TextTrimming="CharacterEllipsis" MaxWidth="235" />
										</StackPanel>
										<StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
											<TextBlock Text="{Binding RuntimeState}" Style="{StaticResource OperatorLabel}" HorizontalAlignment="Right" />
											<TextBlock Text="{Binding DraftState}" Style="{StaticResource OperatorValue}" HorizontalAlignment="Right" />
										</StackPanel>
									</DockPanel>

									<Grid Margin="0,0,0,5">
										<Grid.ColumnDefinitions><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /><ColumnDefinition Width="42" /></Grid.ColumnDefinitions>
										<TextBlock Text="L" Style="{StaticResource OperatorLabel}" />
										<controls:RtaimeMetricBar Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding LeftPeak}" Height="4" Foreground="{DynamicResource OperatorAudioBrush}" />
										<TextBlock Grid.Column="2" Text="{Binding LeftPeak, StringFormat={}{0:P0}}" Style="{StaticResource OperatorLabel}" HorizontalAlignment="Right" />
									</Grid>
									<Grid Margin="0,0,0,7">
										<Grid.ColumnDefinitions><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /><ColumnDefinition Width="42" /></Grid.ColumnDefinitions>
										<TextBlock Text="R" Style="{StaticResource OperatorLabel}" />
										<controls:RtaimeMetricBar Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding RightPeak}" Height="4" Foreground="{DynamicResource OperatorAudioBrush}" />
										<TextBlock Grid.Column="2" Text="{Binding RightPeak, StringFormat={}{0:P0}}" Style="{StaticResource OperatorLabel}" HorizontalAlignment="Right" />
									</Grid>

									<DockPanel Margin="0,0,0,6">
										<TextBlock Text="{Binding ContributionLabel}" Style="{StaticResource OperatorLabel}" />
										<TextBlock Text="{Binding BusSummary}" Style="{StaticResource OperatorValue}" DockPanel.Dock="Right" />
									</DockPanel>
									<Grid Margin="0,0,0,6">
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="*" />
											<ColumnDefinition Width="6" />
											<ColumnDefinition Width="*" />
											<ColumnDefinition Width="6" />
											<ColumnDefinition Width="*" />
										</Grid.ColumnDefinitions>
										<StackPanel Grid.Column="0">
											<TextBlock Text="GAIN 0–4x" Style="{StaticResource OperatorLabel}" />
											<controls:RtaimeTextBox Text="{Binding Gain, UpdateSourceTrigger=PropertyChanged}" />
										</StackPanel>
										<controls:RtaimeButton Grid.Column="2" Content="{Binding MuteActionLabel}" Command="{Binding ToggleMuteCommand}" IsCompact="True" VerticalAlignment="Bottom" />
										<controls:RtaimeButton Grid.Column="4" Content="{Binding ContributionLabel}" Command="{Binding ToggleContributionCommand}" IsCompact="True" VerticalAlignment="Bottom" />
									</Grid>

									<TextBlock Text="SOURCE → BUS" Style="{StaticResource OperatorLabel}" FontWeight="SemiBold" Margin="0,1,0,4" />
									<ItemsControl ItemsSource="{Binding Assignments}">
										<ItemsControl.ItemsPanel>
											<ItemsPanelTemplate>
												<WrapPanel Orientation="Horizontal" />
											</ItemsPanelTemplate>
										</ItemsControl.ItemsPanel>
										<ItemsControl.ItemTemplate>
											<DataTemplate>
												<StackPanel Margin="0,0,6,5">
													<controls:RtaimeToggleButton
														Content="{Binding BusLabel}"
														IsChecked="{Binding IsAssigned, Mode=OneWay}"
														Command="{Binding ToggleCommand}"
														IsCompact="True"
														MinWidth="62" />
													<TextBlock Text="{Binding State}" Style="{StaticResource OperatorLabel}" HorizontalAlignment="Center" />
												</StackPanel>
											</DataTemplate>
										</ItemsControl.ItemTemplate>
									</ItemsControl>

									<Border BorderBrush="{DynamicResource OperatorBorderBrush}" BorderThickness="0,1,0,0" Padding="0,7,0,0" Margin="0,2,0,0">
										<StackPanel>
											<TextBlock Text="TYPED 3-BAND SOURCE EQ" Style="{StaticResource OperatorLabel}" FontWeight="SemiBold" Margin="0,0,0,5" />
											<Grid Margin="0,0,0,5">
												<Grid.ColumnDefinitions>
													<ColumnDefinition Width="64" />
													<ColumnDefinition Width="*" />
													<ColumnDefinition Width="6" />
													<ColumnDefinition Width="*" />
												</Grid.ColumnDefinitions>
												<controls:RtaimeToggleButton Grid.Column="0" Content="LOW" IsChecked="{Binding LowEnabled, Mode=TwoWay}" IsCompact="True" />
												<controls:RtaimeTextBox Grid.Column="1" Text="{Binding LowFrequencyHz, UpdateSourceTrigger=PropertyChanged}" ToolTip="Low shelf frequency 20–20000 Hz" />
												<controls:RtaimeTextBox Grid.Column="3" Text="{Binding LowGainDb, UpdateSourceTrigger=PropertyChanged}" ToolTip="Low shelf gain -18..18 dB" />
											</Grid>
											<Grid Margin="0,0,0,5">
												<Grid.ColumnDefinitions>
													<ColumnDefinition Width="64" />
													<ColumnDefinition Width="*" />
													<ColumnDefinition Width="6" />
													<ColumnDefinition Width="*" />
													<ColumnDefinition Width="6" />
													<ColumnDefinition Width="*" />
												</Grid.ColumnDefinitions>
												<controls:RtaimeToggleButton Grid.Column="0" Content="MID" IsChecked="{Binding MidEnabled, Mode=TwoWay}" IsCompact="True" />
												<controls:RtaimeTextBox Grid.Column="1" Text="{Binding MidFrequencyHz, UpdateSourceTrigger=PropertyChanged}" ToolTip="Bell frequency 20–20000 Hz" />
												<controls:RtaimeTextBox Grid.Column="3" Text="{Binding MidGainDb, UpdateSourceTrigger=PropertyChanged}" ToolTip="Bell gain -18..18 dB" />
												<controls:RtaimeTextBox Grid.Column="5" Text="{Binding MidQ, UpdateSourceTrigger=PropertyChanged}" ToolTip="Bell Q 0.1–10" />
											</Grid>
											<Grid Margin="0,0,0,6">
												<Grid.ColumnDefinitions>
													<ColumnDefinition Width="64" />
													<ColumnDefinition Width="*" />
													<ColumnDefinition Width="6" />
													<ColumnDefinition Width="*" />
												</Grid.ColumnDefinitions>
												<controls:RtaimeToggleButton Grid.Column="0" Content="HIGH" IsChecked="{Binding HighEnabled, Mode=TwoWay}" IsCompact="True" />
												<controls:RtaimeTextBox Grid.Column="1" Text="{Binding HighFrequencyHz, UpdateSourceTrigger=PropertyChanged}" ToolTip="High shelf frequency 20–20000 Hz" />
												<controls:RtaimeTextBox Grid.Column="3" Text="{Binding HighGainDb, UpdateSourceTrigger=PropertyChanged}" ToolTip="High shelf gain -18..18 dB" />
											</Grid>
											<controls:RtaimeButton Content="APPLY SOURCE / EQ DRAFT" Command="{Binding ApplyCommand}" IsCompact="True"
												Background="{DynamicResource OperatorAccentSurfaceBrush}" BorderBrush="{DynamicResource OperatorAccentBrush}" />
										</StackPanel>
									</Border>
								</StackPanel>
							</DataTemplate>
						</controls:RtaimeListBox.ItemTemplate>
					</controls:RtaimeListBox>

					<TextBlock Text="BUS STRIPS" Style="{StaticResource OperatorSectionTitle}" Margin="0,0,0,7" />
					<controls:RtaimeListBox
						ItemsSource="{Binding Buses}"
						Style="{StaticResource RtaimeSourceBank}"
						ItemContainerStyle="{StaticResource OperatorSourceItem}"
						AutomationProperties.Name="Audio bus strips"
						Margin="0,0,0,10">
						<controls:RtaimeListBox.ItemTemplate>
							<DataTemplate>
								<StackPanel>
									<DockPanel Margin="0,0,0,5">
										<TextBlock Text="{Binding BusLabel}" Style="{StaticResource OperatorValue}" FontWeight="SemiBold" />
										<StackPanel DockPanel.Dock="Right">
											<TextBlock Text="{Binding OutputRoles}" Style="{StaticResource OperatorValue}" HorizontalAlignment="Right" />
											<TextBlock Text="{Binding DraftState}" Style="{StaticResource OperatorLabel}" HorizontalAlignment="Right" />
										</StackPanel>
									</DockPanel>
									<Grid Margin="0,0,0,4">
										<Grid.ColumnDefinitions><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /><ColumnDefinition Width="42" /></Grid.ColumnDefinitions>
										<TextBlock Text="L" Style="{StaticResource OperatorLabel}" />
										<controls:RtaimeMetricBar Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding LeftPeak}" Height="4" Foreground="{DynamicResource OperatorAudioBrush}" />
										<TextBlock Grid.Column="2" Text="{Binding LeftPeak, StringFormat={}{0:P0}}" Style="{StaticResource OperatorLabel}" HorizontalAlignment="Right" />
									</Grid>
									<Grid Margin="0,0,0,7">
										<Grid.ColumnDefinitions><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /><ColumnDefinition Width="42" /></Grid.ColumnDefinitions>
										<TextBlock Text="R" Style="{StaticResource OperatorLabel}" />
										<controls:RtaimeMetricBar Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding RightPeak}" Height="4" Foreground="{DynamicResource OperatorAudioBrush}" />
										<TextBlock Grid.Column="2" Text="{Binding RightPeak, StringFormat={}{0:P0}}" Style="{StaticResource OperatorLabel}" HorizontalAlignment="Right" />
									</Grid>
									<Grid Margin="0,0,0,6">
										<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="6" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
										<DockPanel Grid.Column="0">
											<TextBlock Text="COMP" Style="{StaticResource OperatorLabel}" />
											<TextBlock Text="{Binding CompressorActivity}" Style="{StaticResource OperatorValue}" DockPanel.Dock="Right" />
										</DockPanel>
										<DockPanel Grid.Column="2">
											<TextBlock Text="LIMIT" Style="{StaticResource OperatorLabel}" />
											<TextBlock Text="{Binding LimiterActivity}" Style="{StaticResource OperatorValue}" DockPanel.Dock="Right" />
										</DockPanel>
									</Grid>
									<DockPanel Margin="0,0,0,6">
										<TextBlock Text="{Binding EvidenceState}" Style="{StaticResource OperatorLabel}" />
										<TextBlock Text="{Binding MissingSources, StringFormat={}Missing {0}}" Style="{StaticResource OperatorValue}" DockPanel.Dock="Right" />
									</DockPanel>

									<Grid Margin="0,0,0,6">
										<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="6" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
										<StackPanel Grid.Column="0">
											<TextBlock Text="MASTER 0–4x" Style="{StaticResource OperatorLabel}" />
											<controls:RtaimeTextBox Text="{Binding MasterGain, UpdateSourceTrigger=PropertyChanged}" />
										</StackPanel>
										<controls:RtaimeButton Grid.Column="2" Content="{Binding MuteActionLabel}" Command="{Binding ToggleMuteCommand}" IsCompact="True" VerticalAlignment="Bottom" />
									</Grid>

									<Border BorderBrush="{DynamicResource OperatorBorderBrush}" BorderThickness="0,1,0,0" Padding="0,7,0,0">
										<StackPanel>
											<DockPanel Margin="0,0,0,5">
												<TextBlock Text="COMPRESSOR" Style="{StaticResource OperatorLabel}" FontWeight="SemiBold" />
												<controls:RtaimeToggleButton Content="ENABLED" IsChecked="{Binding CompressorEnabled, Mode=TwoWay}" IsCompact="True" DockPanel.Dock="Right" />
											</DockPanel>
											<Grid Margin="0,0,0,5">
												<Grid.ColumnDefinitions>
													<ColumnDefinition Width="*" /><ColumnDefinition Width="5" />
													<ColumnDefinition Width="*" /><ColumnDefinition Width="5" />
													<ColumnDefinition Width="*" />
												</Grid.ColumnDefinitions>
												<StackPanel Grid.Column="0"><TextBlock Text="THRESH dBFS" Style="{StaticResource OperatorLabel}" /><controls:RtaimeTextBox Text="{Binding CompressorThresholdDbFs, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
												<StackPanel Grid.Column="2"><TextBlock Text="RATIO" Style="{StaticResource OperatorLabel}" /><controls:RtaimeTextBox Text="{Binding CompressorRatio, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
												<StackPanel Grid.Column="4"><TextBlock Text="MAKEUP dB" Style="{StaticResource OperatorLabel}" /><controls:RtaimeTextBox Text="{Binding CompressorMakeupGainDb, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
											</Grid>
											<Grid Margin="0,0,0,7">
												<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="6" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
												<StackPanel Grid.Column="0"><TextBlock Text="ATTACK ms" Style="{StaticResource OperatorLabel}" /><controls:RtaimeTextBox Text="{Binding CompressorAttackMilliseconds, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
												<StackPanel Grid.Column="2"><TextBlock Text="RELEASE ms" Style="{StaticResource OperatorLabel}" /><controls:RtaimeTextBox Text="{Binding CompressorReleaseMilliseconds, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
											</Grid>
											<DockPanel Margin="0,0,0,5">
												<TextBlock Text="SAMPLE-PEAK LIMITER" Style="{StaticResource OperatorLabel}" FontWeight="SemiBold" />
												<controls:RtaimeToggleButton Content="ENABLED" IsChecked="{Binding LimiterEnabled, Mode=TwoWay}" IsCompact="True" DockPanel.Dock="Right" />
											</DockPanel>
											<Grid Margin="0,0,0,7">
												<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="6" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
												<StackPanel Grid.Column="0"><TextBlock Text="CEILING dBFS" Style="{StaticResource OperatorLabel}" /><controls:RtaimeTextBox Text="{Binding LimiterCeilingDbFs, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
												<StackPanel Grid.Column="2"><TextBlock Text="RELEASE ms" Style="{StaticResource OperatorLabel}" /><controls:RtaimeTextBox Text="{Binding LimiterReleaseMilliseconds, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
											</Grid>
											<controls:RtaimeButton Content="APPLY BUS / DYNAMICS DRAFT" Command="{Binding ApplyCommand}" IsCompact="True"
												Background="{DynamicResource OperatorAccentSurfaceBrush}" BorderBrush="{DynamicResource OperatorAccentBrush}" />
										</StackPanel>
									</Border>
								</StackPanel>
							</DataTemplate>
						</controls:RtaimeListBox.ItemTemplate>
					</controls:RtaimeListBox>

					<Border BorderBrush="{DynamicResource OperatorBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="9">
						<StackPanel>
							<TextBlock Text="TRANSITIONS / DUCKING / DIAGNOSTICS" Style="{StaticResource OperatorLabel}" FontWeight="SemiBold" Margin="0,0,0,6" />
							<DockPanel Margin="0,0,0,4"><TextBlock Text="Crossfade" Style="{StaticResource OperatorLabel}" /><TextBlock Text="{Binding Owner.AudioCrossfadeStatus}" Style="{StaticResource OperatorValue}" DockPanel.Dock="Right" /></DockPanel>
							<Grid Margin="0,0,0,5">
								<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="6" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
								<controls:RtaimeTextBox Grid.Column="0" Text="{Binding Owner.AudioCrossfadeStartSample, UpdateSourceTrigger=PropertyChanged}" ToolTip="Absolute 48 kHz start sample" />
								<controls:RtaimeTextBox Grid.Column="2" Text="{Binding Owner.AudioCrossfadeDurationSamples, UpdateSourceTrigger=PropertyChanged}" ToolTip="Crossfade duration in samples" />
							</Grid>
							<controls:RtaimeButton Content="START EQUAL-POWER CROSSFADE" Command="{Binding Owner.StartAudioCrossfadeCommand}" IsCompact="True" Margin="0,0,0,8" />

							<DockPanel Margin="0,0,0,4"><TextBlock Text="Ducking" Style="{StaticResource OperatorLabel}" /><TextBlock Text="{Binding Owner.AudioDuckingStatus}" Style="{StaticResource OperatorValue}" DockPanel.Dock="Right" /></DockPanel>
							<Grid Margin="0,0,0,5">
								<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="6" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
								<controls:RtaimeTextBox Grid.Column="0" Text="{Binding Owner.AudioDuckingThreshold, UpdateSourceTrigger=PropertyChanged}" ToolTip="Ducking threshold 0..1" />
								<controls:RtaimeTextBox Grid.Column="2" Text="{Binding Owner.AudioDuckingAttenuation, UpdateSourceTrigger=PropertyChanged}" ToolTip="Ducking target gain 0..1" />
							</Grid>
							<controls:RtaimeButton Content="{Binding Owner.AudioDuckingActionLabel}" Command="{Binding Owner.ToggleAudioDuckingCommand}" IsCompact="True" Margin="0,0,0,8" />
							<Grid>
								<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="6" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
								<controls:RtaimeButton Grid.Column="0" Content="{Binding Owner.SelectedAudioInput.TestSignalActionLabel}" Command="{Binding Owner.CycleAudioTestSignalCommand}" IsCompact="True" />
								<TextBlock Grid.Column="2" Text="Meters and dynamics evidence are synchronized RuntimeHost observations. No WPF audio analysis or meter animation is performed." Style="{StaticResource OperatorLabel}" TextWrapping="Wrap" />
							</Grid>
						</StackPanel>
					</Border>
				</StackPanel>
			</controls:RtaimeScrollViewer>
		</Grid>
	</Border>
</UserControl>
