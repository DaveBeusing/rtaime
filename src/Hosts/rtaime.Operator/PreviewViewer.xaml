<local:MonitorView x:Class="rtaime.Operator.PreviewViewer"
	x:Name="Root"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="clr-namespace:rtaime.Operator"
	UseLayoutRounding="True"
	SnapsToDevicePixels="True"
	Focusable="True">
	<Border Style="{StaticResource OperatorPreviewPanel}">
		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>

			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>

				<Border Style="{StaticResource OperatorPreviewTally}" HorizontalAlignment="Left">
					<StackPanel Orientation="Horizontal">
						<TextBlock Text="PVW" Foreground="{DynamicResource OperatorPreviewBrush}" FontWeight="Bold" FontSize="13" />
						<TextBlock Text="  PREVIEW" Foreground="{DynamicResource OperatorTextBrush}" FontWeight="SemiBold" FontSize="13" />
					</StackPanel>
				</Border>

				<StackPanel Grid.Column="2" Orientation="Horizontal">
					<Button Content="FIT" Command="{Binding FitCommand, ElementName=Root}" Style="{StaticResource OperatorButton}" MinHeight="26" Padding="7,2" Margin="0,0,4,0" ToolTip="Fit the monitoring surface to the viewer." />
					<Button Content="50%" Command="{Binding Zoom50Command, ElementName=Root}" Style="{StaticResource OperatorButton}" MinHeight="26" Padding="7,2" Margin="0,0,4,0" ToolTip="Show the monitoring surface at 50 percent pixel scale." />
					<Button Content="100%" Command="{Binding Zoom100Command, ElementName=Root}" Style="{StaticResource OperatorButton}" MinHeight="26" Padding="7,2" Margin="0,0,4,0" ToolTip="Show the monitoring surface at 100 percent pixel scale." />
					<Button Content="MAX  Ctrl+1" Command="{Binding MaximizeCommand, ElementName=Root}" Style="{StaticResource OperatorButton}" MinHeight="26" Padding="7,2" Margin="0,0,4,0" ToolTip="Maximize Preview inside the current Operator layout." />
					<Button Content="FULL" Command="{Binding FullscreenCommand, ElementName=Root}" Style="{StaticResource OperatorButton}" MinHeight="26" Padding="7,2" ToolTip="Present Preview fullscreen without creating another playback instance." />
				</StackPanel>
			</Grid>

			<Grid Grid.Row="1" Margin="0,9,0,9">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>
				<StackPanel>
					<TextBlock Text="{Binding SourceName, ElementName=Root}" FontSize="22" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
					<TextBlock Text="{Binding SourceId, ElementName=Root}" Style="{StaticResource OperatorLabel}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
				</StackPanel>
				<StackPanel Grid.Column="1" HorizontalAlignment="Right">
					<TextBlock Text="{Binding ProductionFormat, ElementName=Root}" Style="{StaticResource OperatorValue}" HorizontalAlignment="Right" />
					<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,2,0,0">
						<TextBlock Text="COLOR SPACE " Style="{StaticResource OperatorLabel}" />
						<TextBlock Text="{Binding ColorSpace, ElementName=Root}" Style="{StaticResource OperatorLabel}" />
						<TextBlock Text="  ·  " Style="{StaticResource OperatorLabel}" />
						<TextBlock Text="{Binding ZoomMode, ElementName=Root}" Style="{StaticResource OperatorLabel}" />
					</StackPanel>
				</StackPanel>
			</Grid>

			<Grid Grid.Row="2" MinHeight="220" Background="#090C10" ClipToBounds="True">
				<Viewbox Stretch="{Binding ImageStretch, ElementName=Root}" StretchDirection="Both">
					<Image Source="{Binding Frame, ElementName=Root}" SnapsToDevicePixels="True">
						<Image.LayoutTransform>
							<ScaleTransform ScaleX="{Binding ImageScale, ElementName=Root}" ScaleY="{Binding ImageScale, ElementName=Root}" />
						</Image.LayoutTransform>
					</Image>
				</Viewbox>

				<Grid IsHitTestVisible="False">
					<Grid.Style>
						<Style TargetType="Grid">
							<Setter Property="Visibility" Value="Collapsed" />
							<Style.Triggers>
								<DataTrigger Binding="{Binding ShowGrid, ElementName=Root}" Value="True">
									<Setter Property="Visibility" Value="Visible" />
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</Grid.Style>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>
					<Grid.RowDefinitions>
						<RowDefinition Height="*" />
						<RowDefinition Height="*" />
						<RowDefinition Height="*" />
					</Grid.RowDefinitions>
					<Border Grid.Column="0" Grid.RowSpan="3" BorderBrush="#55FFFFFF" BorderThickness="0,0,1,0" />
					<Border Grid.Column="1" Grid.RowSpan="3" BorderBrush="#55FFFFFF" BorderThickness="0,0,1,0" />
					<Border Grid.Row="0" Grid.ColumnSpan="3" BorderBrush="#55FFFFFF" BorderThickness="0,0,0,1" />
					<Border Grid.Row="1" Grid.ColumnSpan="3" BorderBrush="#55FFFFFF" BorderThickness="0,0,0,1" />
				</Grid>

				<Grid IsHitTestVisible="False">
					<Grid.Style>
						<Style TargetType="Grid">
							<Setter Property="Visibility" Value="Collapsed" />
							<Style.Triggers>
								<DataTrigger Binding="{Binding ShowSafeArea, ElementName=Root}" Value="True">
									<Setter Property="Visibility" Value="Visible" />
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</Grid.Style>
					<Border Margin="24" BorderBrush="#B0FFFFFF" BorderThickness="1" />
					<Border Margin="48" BorderBrush="#70FFFFFF" BorderThickness="1" />
				</Grid>

				<Grid IsHitTestVisible="False">
					<Grid.Style>
						<Style TargetType="Grid">
							<Setter Property="Visibility" Value="Collapsed" />
							<Style.Triggers>
								<DataTrigger Binding="{Binding ShowCenterMark, ElementName=Root}" Value="True">
									<Setter Property="Visibility" Value="Visible" />
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</Grid.Style>
					<Border Width="1" Height="34" Background="#C0FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
					<Border Width="34" Height="1" Background="#C0FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
				</Grid>

				<StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="8">
					<Border Style="{StaticResource OperatorPreviewTally}" Margin="0,0,6,0">
						<TextBlock Text="PREVIEW" Foreground="{DynamicResource OperatorPreviewBrush}" FontWeight="Bold" />
					</Border>
					<Border Style="{StaticResource OperatorStatusBadge}">
						<TextBlock Text="{Binding State, ElementName=Root}" FontWeight="Bold" />
					</Border>
				</StackPanel>

				<Border VerticalAlignment="Top" HorizontalAlignment="Right" Background="#B0000000" Padding="7,4" Margin="8">
					<TextBlock Text="{Binding DisplayTimecode, ElementName=Root}" Style="{StaticResource OperatorTimecode}" FontSize="15" Foreground="White" />
				</Border>

				<Border VerticalAlignment="Bottom" Background="#B0000000" Padding="8,5">
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
						<TextBlock Text="{Binding Format, ElementName=Root}" FontSize="11" Foreground="White" TextTrimming="CharacterEllipsis" />
						<TextBlock Grid.Column="1" Text="{Binding ZoomMode, ElementName=Root}" FontSize="11" Foreground="White" Margin="12,0,0,0" />
					</Grid>
				</Border>

				<Border Background="#D0090C10">
					<Border.Style>
						<Style TargetType="Border">
							<Setter Property="Visibility" Value="Collapsed" />
							<Style.Triggers>
								<DataTrigger Binding="{Binding Frame, ElementName=Root}" Value="{x:Null}">
									<Setter Property="Visibility" Value="Visible" />
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</Border.Style>
					<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
						<TextBlock Text="{Binding State, ElementName=Root}" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" />
						<TextBlock Text="Preview monitoring frame unavailable." Style="{StaticResource OperatorLabel}" Margin="0,4,0,0" />
					</StackPanel>
				</Border>
			</Grid>

			<Grid Grid.Row="3" Margin="0,8,0,0">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>

				<StackPanel Orientation="Horizontal">
					<ToggleButton Content="SAFE" IsChecked="{Binding ShowSafeArea, ElementName=Root, Mode=TwoWay}" Style="{StaticResource OperatorToggleButton}" Padding="7,2" Margin="0,0,4,0" ToolTip="Toggle safe-area overlays." />
					<ToggleButton Content="CENTER" IsChecked="{Binding ShowCenterMark, ElementName=Root, Mode=TwoWay}" Style="{StaticResource OperatorToggleButton}" Padding="7,2" Margin="0,0,4,0" ToolTip="Toggle center mark." />
					<ToggleButton Content="GRID" IsChecked="{Binding ShowGrid, ElementName=Root, Mode=TwoWay}" Style="{StaticResource OperatorToggleButton}" Padding="7,2" ToolTip="Toggle thirds grid." />
				</StackPanel>

				<Border Grid.Column="1" Style="{StaticResource OperatorStatusBadge}" Padding="8,3">
					<TextBlock Text="{Binding TransportState, ElementName=Root}" FontWeight="SemiBold" />
				</Border>
			</Grid>

			<Border Grid.Row="4" Style="{StaticResource OperatorTransportBar}" Margin="0,8,0,0" Padding="7">
				<Grid IsEnabled="{Binding IsTransportSource, ElementName=Root}">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>

					<Button Grid.Column="0" Content="◀ CUE" Command="{Binding PreviousCueCommand, ElementName=Root}" Style="{StaticResource OperatorButton}" Padding="7,2" Margin="0,0,4,0" ToolTip="Jump to previous cue." />
					<Button Grid.Column="1" Content="IN ◀" Command="{Binding JumpInCommand, ElementName=Root}" Style="{StaticResource OperatorButton}" Padding="7,2" Margin="0,0,4,0" ToolTip="Jump to IN." />
					<Button Grid.Column="2" Content="SET IN" Command="{Binding SetInCommand, ElementName=Root}" Style="{StaticResource OperatorButton}" Padding="7,2" Margin="0,0,4,0" ToolTip="Set IN at current Preview transport position." />
					<Button Grid.Column="3" Content="▶ / ❚❚  Space" Command="{Binding PlayPauseCommand, ElementName=Root}" Style="{StaticResource OperatorAccentButton}" Padding="9,2" Margin="0,0,4,0" ToolTip="Play or pause the loaded Preview media source." />
					<Button Grid.Column="4" Content="■" Command="{Binding StopCommand, ElementName=Root}" Style="{StaticResource OperatorButton}" Padding="9,2" Margin="0,0,4,0" ToolTip="Stop Preview transport." />
					<Button Grid.Column="5" Content="SET OUT" Command="{Binding SetOutCommand, ElementName=Root}" Style="{StaticResource OperatorButton}" Padding="7,2" Margin="0,0,4,0" ToolTip="Set OUT at current Preview transport position." />
					<Button Grid.Column="6" Content="▶ OUT" Command="{Binding JumpOutCommand, ElementName=Root}" Style="{StaticResource OperatorButton}" Padding="7,2" Margin="0,0,4,0" ToolTip="Jump to OUT." />
					<Button Grid.Column="7" Content="CUE ▶" Command="{Binding NextCueCommand, ElementName=Root}" Style="{StaticResource OperatorButton}" Padding="7,2" ToolTip="Jump to next cue." />

					<StackPanel Grid.Column="9" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
						<TextBlock Text="TC " Style="{StaticResource OperatorLabel}" VerticalAlignment="Center" />
						<TextBlock Text="{Binding DisplayTimecode, ElementName=Root}" Style="{StaticResource OperatorTimecode}" FontSize="15" VerticalAlignment="Center" />
					</StackPanel>
				</Grid>
			</Border>
		</Grid>
	</Border>
</local:MonitorView>