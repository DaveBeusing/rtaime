<local:MonitorView x:Class="rtaime.Operator.PreviewViewer"
	x:Name="Root"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="clr-namespace:rtaime.Operator"
	xmlns:controls="clr-namespace:rtaime.Operator.Controls"
	UseLayoutRounding="True"
	SnapsToDevicePixels="True"
	Focusable="True">
	<controls:RtaimeMonitorPresentation
		Style="{StaticResource RtaimeMonitorPresentation}"
		Monitor="{Binding ElementName=Root}"
		RoleText="PREVIEW"
		RoleBrush="{DynamicResource OperatorPreviewBrush}"
		RoleStatus="{x:Static controls:RtaimeStatusKind.Preview}"
		PlaceholderState="{Binding WorkspaceStates.Preview.State, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
		PlaceholderTitle="{Binding WorkspaceStates.Preview.Title, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
		PlaceholderDetail="{Binding WorkspaceStates.Preview.Detail, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
		FrameUnavailableText="Preview frame unavailable"
		OverlayControlsEnabled="{Binding IsTransportSource, ElementName=Root}">

		<controls:RtaimeMonitorPresentation.HeaderContent>
			<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
				<controls:RtaimeIconButton IconData="{StaticResource RtaimeIconFitGeometry}" Command="{Binding FitCommand, ElementName=Root}" Width="26" Height="26" Margin="0,0,3,0" ToolTip="Fit Preview" AutomationProperties.Name="Fit Preview" />
				<controls:RtaimeIconButton IconData="{StaticResource RtaimeIconMaximizeGeometry}" Command="{Binding MaximizeCommand, ElementName=Root}" Width="26" Height="26" Margin="0,0,3,0" ToolTip="Maximize Preview" AutomationProperties.Name="Maximize Preview" />
				<controls:RtaimeIconButton IconData="{StaticResource RtaimeIconFullscreenGeometry}" Command="{Binding FullscreenCommand, ElementName=Root}" Width="26" Height="26" ToolTip="Fullscreen Preview" AutomationProperties.Name="Fullscreen Preview" />
			</StackPanel>
		</controls:RtaimeMonitorPresentation.HeaderContent>

		<Grid IsEnabled="{Binding IsTransportSource, ElementName=Root}">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>
			<controls:RtaimeIconButton Grid.Column="0" IconData="{StaticResource RtaimeIconPreviousGeometry}" Command="{Binding PreviousCueCommand, ElementName=Root}" Width="28" Height="28" Margin="0,0,3,0" ToolTip="Previous cue" AutomationProperties.Name="Previous cue" />
			<controls:RtaimeIconButton Grid.Column="1" IconData="{StaticResource RtaimeIconChevronLeftGeometry}" Command="{Binding JumpInCommand, ElementName=Root}" Width="28" Height="28" Margin="0,0,3,0" ToolTip="Jump to IN" AutomationProperties.Name="Jump to IN" />
			<controls:RtaimeIconButton Grid.Column="2" IconData="{StaticResource RtaimeIconMarkInGeometry}" Command="{Binding SetInCommand, ElementName=Root}" Width="28" Height="28" Margin="0,0,3,0" ToolTip="Set IN" AutomationProperties.Name="Set IN" />
			<controls:RtaimeIconButton Grid.Column="3" IconData="{StaticResource RtaimeIconPlayGeometry}" Command="{Binding PlayPauseCommand, ElementName=Root}" Width="30" Height="28" Margin="0,0,3,0" ToolTip="Play or pause" AutomationProperties.Name="Play or pause" />
			<controls:RtaimeIconButton Grid.Column="4" IconData="{StaticResource RtaimeIconStopGeometry}" Command="{Binding StopCommand, ElementName=Root}" Width="28" Height="28" Margin="0,0,3,0" ToolTip="Stop" AutomationProperties.Name="Stop Preview" />
			<controls:RtaimeIconButton Grid.Column="5" IconData="{StaticResource RtaimeIconMarkOutGeometry}" Command="{Binding SetOutCommand, ElementName=Root}" Width="28" Height="28" Margin="0,0,3,0" ToolTip="Set OUT" AutomationProperties.Name="Set OUT" />
			<controls:RtaimeIconButton Grid.Column="6" IconData="{StaticResource RtaimeIconChevronRightGeometry}" Command="{Binding JumpOutCommand, ElementName=Root}" Width="28" Height="28" Margin="0,0,3,0" ToolTip="Jump to OUT" AutomationProperties.Name="Jump to OUT" />
			<controls:RtaimeIconButton Grid.Column="7" IconData="{StaticResource RtaimeIconNextGeometry}" Command="{Binding NextCueCommand, ElementName=Root}" Width="28" Height="28" ToolTip="Next cue" AutomationProperties.Name="Next cue" />
		</Grid>
	</controls:RtaimeMonitorPresentation>
</local:MonitorView>
