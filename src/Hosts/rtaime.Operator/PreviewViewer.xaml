<UserControl x:Class="rtaime.Operator.PreviewViewer"
	x:Name="Root"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	UseLayoutRounding="True"
	SnapsToDevicePixels="True">
	<Border Style="{StaticResource OperatorPreviewPanel}">
		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>

			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>
				<Border Style="{StaticResource OperatorPreviewTally}" HorizontalAlignment="Left">
					<StackPanel Orientation="Horizontal">
						<TextBlock Text="PVW" Foreground="{DynamicResource OperatorPreviewBrush}" FontWeight="Bold" FontSize="13" />
						<TextBlock Text="  PREVIEW" Foreground="{DynamicResource OperatorTextBrush}" FontWeight="SemiBold" FontSize="13" />
					</StackPanel>
				</Border>
				<Button Grid.Column="1"
					Content="MAX PREVIEW  Ctrl+1"
					Command="{Binding MaximizeCommand, ElementName=Root}"
					Style="{StaticResource OperatorButton}"
					MinHeight="26"
					Padding="7,2"
					ToolTip="Maximize Preview without changing production routing." />
			</Grid>

			<StackPanel Grid.Row="1" Margin="0,10,0,10">
				<TextBlock Text="{Binding SourceName, ElementName=Root}" FontSize="23" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
				<TextBlock Text="{Binding SourceId, ElementName=Root}" Style="{StaticResource OperatorLabel}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
			</StackPanel>

			<Grid Grid.Row="2" MinHeight="220" Background="#090C10" ClipToBounds="True">
				<Image Source="{Binding Frame, ElementName=Root}" Stretch="Uniform" SnapsToDevicePixels="True" />
				<Border VerticalAlignment="Top" HorizontalAlignment="Right" Background="#B0000000" Padding="7,4" Margin="8">
					<TextBlock Text="{Binding State, ElementName=Root}" FontSize="11" FontWeight="Bold" Foreground="White" />
				</Border>
				<Border VerticalAlignment="Bottom" Background="#B0000000" Padding="8,5">
					<TextBlock Text="{Binding Format, ElementName=Root}" FontSize="11" Foreground="White" TextTrimming="CharacterEllipsis" />
				</Border>
				<Border Background="#D0090C10">
					<Border.Style>
						<Style TargetType="Border">
							<Setter Property="Visibility" Value="Collapsed" />
							<Style.Triggers>
								<DataTrigger Binding="{Binding Frame, ElementName=Root}" Value="{x:Null}">
									<Setter Property="Visibility" Value="Visible" />
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</Border.Style>
					<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
						<TextBlock Text="{Binding State, ElementName=Root}" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" />
						<TextBlock Text="Preview monitoring frame unavailable." Style="{StaticResource OperatorLabel}" Margin="0,4,0,0" />
					</StackPanel>
				</Border>
			</Grid>

			<DockPanel Grid.Row="3" Margin="0,10,0,0">
				<TextBlock Text="NEXT PREPARED STATE" Style="{StaticResource OperatorLabel}" />
				<TextBlock Text="{Binding State, ElementName=Root}" Style="{StaticResource OperatorValue}" FontWeight="SemiBold" DockPanel.Dock="Right" />
			</DockPanel>
		</Grid>
	</Border>
</UserControl>