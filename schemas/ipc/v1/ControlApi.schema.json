{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$comment": "Copyright (c) Dave Beusing <david.beusing@gmail.com>.",
	"title": "rtaime Control Remote API V1",
	"type": "object",
	"required": ["messages"],
	"properties": {
		"messages": {
			"type": "array",
			"prefixItems": [],
			"items": {
				"enum": [
					"control.ping",
					"control.snapshot.get",
					"control.ai_showcase.set",
					"control.preview.select",
					"control.program.cut",
					"control.program.dissolve",
					"control.mutation.response",
					"control.media_deck.snapshot.get",
					"control.media_deck.open",
					"control.media_deck.transport",
					"control.media_deck.marker",
					"control.media_deck.close"
				]
			}
		}
	}
}
