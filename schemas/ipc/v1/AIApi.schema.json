{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$comment": "Copyright (c) Dave Beusing <david.beusing@gmail.com>.",
	"title": "rtaime AI Remote API V1",
	"type": "object",
	"required": ["messages"],
	"properties": {
		"messages": {
			"type": "array",
			"items": {
				"enum": [
					"ai.ping",
					"ai.capabilities.get",
					"ai.snapshot.get",
					"ai.inference.execute"
				]
			}
		}
	}
}
