{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://rtaime.local/schemas/release/v1/artifact-manifest.schema.json",
	"$comment": "Copyright (c) Dave Beusing <david.beusing@gmail.com>.",
	"title": "rtaime Artifact Manifest v1",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"copyright",
		"schemaVersion",
		"productName",
		"productVersion",
		"releaseStage",
		"sourceCommit",
		"buildCommit",
		"buildId",
		"hashAlgorithm",
		"artifacts"
	],
	"properties": {
		"copyright": { "type": "string", "minLength": 1 },
		"schemaVersion": { "const": "1.0" },
		"productName": { "const": "rtaime" },
		"productVersion": { "type": "string", "minLength": 1 },
		"releaseStage": {
			"enum": ["DEV", "PREVIEW", "RELEASE_CANDIDATE", "STABLE", "VALIDATED", "CERTIFIED"]
		},
		"sourceCommit": { "type": "string", "pattern": "^[0-9a-fA-F]{40,64}$" },
		"buildCommit": { "type": "string", "pattern": "^[0-9a-fA-F]{40,64}$" },
		"buildId": { "type": "string", "minLength": 1 },
		"hashAlgorithm": { "const": "SHA256" },
		"artifacts": {
			"type": "array",
			"minItems": 1,
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["path", "size", "sha256"],
				"properties": {
					"path": { "type": "string", "minLength": 1 },
					"size": { "type": "integer", "minimum": 0 },
					"sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
				}
			}
		}
	}
}
