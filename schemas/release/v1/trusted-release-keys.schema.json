{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://rtaime.local/schemas/release/v1/trusted-release-keys.schema.json",
	"$comment": "Copyright (c) Dave Beusing <david.beusing@gmail.com>.",
	"title": "rtaime Trusted Release Keys v1",
	"type": "object",
	"additionalProperties": false,
	"required": ["copyright", "schemaVersion", "keys"],
	"properties": {
		"copyright": { "type": "string", "minLength": 1 },
		"schemaVersion": { "const": "1.0" },
		"keys": {
			"type": "array",
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["fingerprint", "purpose", "status", "owner", "notBeforeUtc"],
				"properties": {
					"fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
					"purpose": { "const": "SOFTWARE_RELEASE" },
					"status": { "enum": ["ACTIVE", "REVOKED"] },
					"owner": { "type": "string", "minLength": 1 },
					"notBeforeUtc": { "type": "string", "format": "date-time" },
					"revokedAtUtc": { "type": ["string", "null"], "format": "date-time" }
				}
			}
		}
	}
}
