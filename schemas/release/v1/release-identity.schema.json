{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://rtaime.local/schemas/release/v1/release-identity.schema.json",
	"$comment": "Copyright (c) Dave Beusing <david.beusing@gmail.com>.",
	"title": "rtaime Release Identity v1",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"copyright",
		"schemaVersion",
		"channel",
		"productName",
		"productVersion",
		"releaseStage",
		"tag",
		"sourceCommit",
		"buildCommit",
		"buildId",
		"signingPolicy"
	],
	"properties": {
		"copyright": { "type": "string", "minLength": 1 },
		"schemaVersion": { "const": "1.0" },
		"channel": { "enum": ["QUALIFICATION", "PREVIEW", "STABLE"] },
		"productName": { "const": "rtaime" },
		"productVersion": { "type": "string", "minLength": 1 },
		"releaseStage": { "enum": ["DEV", "PREVIEW", "STABLE"] },
		"tag": { "type": ["string", "null"] },
		"sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
		"buildCommit": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
		"buildId": { "type": "string", "minLength": 1 },
		"signingPolicy": {
			"type": "object",
			"additionalProperties": false,
			"required": ["allowedSignerClasses", "requireTrustedProductionKey", "publicationEligible"],
			"properties": {
				"allowedSignerClasses": {
					"type": "array",
					"minItems": 1,
					"uniqueItems": true,
					"items": { "enum": ["TEST_EPHEMERAL", "EXTERNAL_CONTROLLED"] }
				},
				"requireTrustedProductionKey": { "type": "boolean" },
				"publicationEligible": { "type": "boolean" }
			}
		}
	}
}
