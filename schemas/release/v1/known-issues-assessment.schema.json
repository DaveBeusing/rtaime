{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rtaime.dev/schemas/release/v1/known-issues-assessment.schema.json",
  "$comment": "Copyright (c) Dave Beusing <david.beusing@gmail.com>.",
  "title": "rtaime Known Issues Assessment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "copyright",
    "schemaVersion",
    "assessmentId",
    "productName",
    "productVersion",
    "releaseStage",
    "sourceCommit",
    "buildCommit",
    "buildId",
    "status",
    "assessedAtUtc",
    "assessorRole",
    "issues"
  ],
  "properties": {
    "copyright": { "type": "string", "minLength": 1 },
    "schemaVersion": { "const": "1.0" },
    "assessmentId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "productName": { "const": "rtaime" },
    "productVersion": { "type": "string", "minLength": 1 },
    "releaseStage": { "enum": ["DEV", "PREVIEW", "RELEASE_CANDIDATE", "STABLE"] },
    "sourceCommit": { "type": "string", "pattern": "^[0-9a-fA-F]{40,64}$" },
    "buildCommit": { "type": "string", "pattern": "^[0-9a-fA-F]{40,64}$" },
    "buildId": { "type": "string", "minLength": 1 },
    "status": { "enum": ["PASS", "FAIL", "UNVERIFIED"] },
    "assessedAtUtc": { "type": "string", "format": "date-time" },
    "assessorRole": { "type": "string", "minLength": 1, "maxLength": 128 },
    "issues": {
      "type": "array",
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "severity",
          "summary",
          "disposition",
          "releaseNoteRequired"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 128 },
          "severity": { "enum": ["BLOCKER", "CRITICAL", "MAJOR", "MINOR", "INFORMATIONAL"] },
          "summary": { "type": "string", "minLength": 1, "maxLength": 1024 },
          "disposition": { "enum": ["OPEN", "ACCEPTED", "CLOSED"] },
          "releaseNoteRequired": { "type": "boolean" },
          "workaround": { "type": ["string", "null"], "maxLength": 2048 }
        }
      }
    }
  }
}
