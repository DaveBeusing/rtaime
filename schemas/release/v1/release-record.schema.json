{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://rtaime.local/schemas/release/v1/release-record.schema.json",
	"$comment": "Copyright (c) Dave Beusing <david.beusing@gmail.com>.",
	"title": "rtaime Release Record v1",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"copyright",
		"schemaVersion",
		"recordType",
		"recordIdAlgorithm",
		"recordId",
		"productName",
		"productVersion",
		"releaseStage",
		"sourceCommit",
		"buildCommit",
		"buildId",
		"releaseEvidence",
		"attestation"
	],
	"properties": {
		"copyright": { "type": "string", "minLength": 1 },
		"schemaVersion": { "const": "1.0" },
		"recordType": { "const": "rtaime.release-record.v1" },
		"recordIdAlgorithm": { "const": "SHA256" },
		"recordId": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
		"productName": { "const": "rtaime" },
		"productVersion": { "type": "string", "minLength": 1 },
		"releaseStage": {
			"enum": ["DEV", "PREVIEW", "RELEASE_CANDIDATE", "STABLE", "VALIDATED", "CERTIFIED"]
		},
		"sourceCommit": { "type": "string", "pattern": "^[0-9a-fA-F]{40,64}$" },
		"buildCommit": { "type": "string", "pattern": "^[0-9a-fA-F]{40,64}$" },
		"buildId": { "type": "string", "minLength": 1 },
		"releaseEvidence": { "$ref": "#/$defs/hashReference" },
		"attestation": {
			"type": "object",
			"additionalProperties": false,
			"required": ["path", "sha256", "keyFingerprint", "signerClass"],
			"properties": {
				"path": { "const": "release-attestation.json" },
				"sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
				"keyFingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
				"signerClass": { "enum": ["TEST_EPHEMERAL", "EXTERNAL_CONTROLLED"] }
			}
		}
	},
	"$defs": {
		"hashReference": {
			"type": "object",
			"additionalProperties": false,
			"required": ["path", "sha256"],
			"properties": {
				"path": { "const": "release-evidence.json" },
				"sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
			}
		}
	}
}
