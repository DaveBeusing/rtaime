{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://rtaime.local/schemas/release/v1/qualification-evidence-manifest.schema.json",
	"$comment": "Copyright (c) Dave Beusing <david.beusing@gmail.com>.",
	"title": "rtaime Qualification Evidence Manifest v1",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"copyright",
		"schemaVersion",
		"repository",
		"sourceCommit",
		"generatedAtUtc",
		"requirements"
	],
	"properties": {
		"copyright": { "type": "string", "minLength": 1 },
		"schemaVersion": { "const": "1.0" },
		"repository": { "const": "DaveBeusing/rtaime" },
		"sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
		"generatedAtUtc": { "type": "string", "format": "date-time" },
		"requirements": {
			"type": "array",
			"minItems": 1,
			"items": {
				"oneOf": [
					{
						"type": "object",
						"additionalProperties": false,
						"required": ["requirement", "status"],
						"properties": {
							"requirement": { "type": "string", "minLength": 1 },
							"status": { "const": "UNVERIFIED" }
						}
					},
					{
						"type": "object",
						"additionalProperties": false,
						"required": ["requirement", "status", "qualificationType", "binding", "payload", "workflow"],
						"properties": {
							"requirement": { "type": "string", "minLength": 1 },
							"status": { "const": "PASSED" },
							"qualificationType": {
								"enum": ["CUDA_REFERENCE", "MEDIA_IO_REFERENCE", "TIMING_REFERENCE_SOAK"]
							},
							"binding": { "$ref": "#/$defs/hashReference" },
							"payload": { "$ref": "#/$defs/hashReference" },
							"workflow": {
								"type": "object",
								"additionalProperties": false,
								"required": ["runId", "runAttempt"],
								"properties": {
									"runId": { "type": "string", "minLength": 1 },
									"runAttempt": { "type": "integer", "minimum": 1 }
								}
							}
						}
					}
				]
			}
		}
	},
	"$defs": {
		"hashReference": {
			"type": "object",
			"additionalProperties": false,
			"required": ["path", "sha256"],
			"properties": {
				"path": { "type": "string", "minLength": 1 },
				"sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
			}
		}
	}
}
