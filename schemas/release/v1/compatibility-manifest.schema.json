{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://rtaime.local/schemas/release/v1/compatibility-manifest.schema.json",
	"$comment": "Copyright (c) Dave Beusing <david.beusing@gmail.com>.",
	"title": "rtaime Compatibility Manifest v1",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"copyright",
		"schemaVersion",
		"product",
		"source",
		"managedPlatform",
		"contracts",
		"ipc",
		"hardwareQualification"
	],
	"properties": {
		"copyright": { "type": "string", "minLength": 1 },
		"schemaVersion": { "const": "1.0" },
		"product": {
			"type": "object",
			"additionalProperties": false,
			"required": ["name", "version", "releaseStage"],
			"properties": {
				"name": { "const": "rtaime" },
				"version": { "type": "string", "minLength": 1 },
				"releaseStage": {
					"enum": ["DEV", "PREVIEW", "RELEASE_CANDIDATE", "STABLE", "VALIDATED", "CERTIFIED"]
				}
			}
		},
		"source": {
			"type": "object",
			"additionalProperties": false,
			"required": ["sourceCommit", "buildCommit", "buildId"],
			"properties": {
				"sourceCommit": { "type": "string", "pattern": "^[0-9a-fA-F]{40,64}$" },
				"buildCommit": { "type": "string", "pattern": "^[0-9a-fA-F]{40,64}$" },
				"buildId": { "type": "string", "minLength": 1 }
			}
		},
		"managedPlatform": {
			"type": "object",
			"additionalProperties": false,
			"required": ["osFamily", "sdkVersion", "targetFrameworks"],
			"properties": {
				"osFamily": { "const": "Windows" },
				"sdkVersion": { "type": "string", "minLength": 1 },
				"targetFrameworks": {
					"type": "array",
					"minItems": 1,
					"uniqueItems": true,
					"items": { "type": "string", "minLength": 1 }
				}
			}
		},
		"contracts": {
			"type": "array",
			"minItems": 1,
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["name", "compatibilityPolicy", "supportedVersions"],
				"properties": {
					"name": { "type": "string", "minLength": 1 },
					"compatibilityPolicy": { "const": "EXACT_DECLARED" },
					"supportedVersions": {
						"type": "array",
						"minItems": 1,
						"uniqueItems": true,
						"items": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" }
					}
				}
			}
		},
		"ipc": {
			"type": "object",
			"additionalProperties": false,
			"required": ["compatibilityPolicy", "protocolVersions", "schemaSet"],
			"properties": {
				"compatibilityPolicy": { "const": "EXACT_DECLARED" },
				"protocolVersions": {
					"type": "array",
					"minItems": 1,
					"uniqueItems": true,
					"items": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" }
				},
				"schemaSet": { "type": "string", "minLength": 1 }
			}
		},
		"hardwareQualification": {
			"type": "array",
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["requirement", "status"],
				"properties": {
					"requirement": { "type": "string", "minLength": 1 },
					"status": { "enum": ["PASS", "FAIL", "NOT_APPLICABLE", "UNVERIFIED"] }
				}
			}
		}
	}
}
