{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://rtaime.local/schemas/release/v1/release-channel-policy.schema.json",
	"$comment": "Copyright (c) Dave Beusing <david.beusing@gmail.com>.",
	"title": "rtaime Release Channel Policy v1",
	"type": "object",
	"additionalProperties": false,
	"required": ["copyright", "schemaVersion", "channels", "candidate"],
	"properties": {
		"copyright": { "type": "string", "minLength": 1 },
		"schemaVersion": { "const": "1.0" },
		"channels": {
			"type": "object",
			"additionalProperties": false,
			"required": ["QUALIFICATION", "PREVIEW", "STABLE"],
			"properties": {
				"QUALIFICATION": { "$ref": "#/$defs/channel" },
				"PREVIEW": { "$ref": "#/$defs/channel" },
				"STABLE": { "$ref": "#/$defs/channel" }
			}
		},
		"candidate": {
			"type": "object",
			"additionalProperties": false,
			"required": ["hashAlgorithm", "manifestSchemaVersion"],
			"properties": {
				"hashAlgorithm": { "const": "SHA256" },
				"manifestSchemaVersion": { "const": "1.0" }
			}
		}
	},
	"$defs": {
		"channel": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"releaseStage",
				"tagRequired",
				"versionPattern",
				"tagPattern",
				"allowedSignerClasses",
				"requireTrustedProductionKey",
				"publicationEligible"
			],
			"properties": {
				"releaseStage": { "enum": ["DEV", "PREVIEW", "STABLE"] },
				"tagRequired": { "type": "boolean" },
				"versionPattern": { "type": "string", "minLength": 1 },
				"tagPattern": { "type": ["string", "null"] },
				"allowedSignerClasses": {
					"type": "array",
					"minItems": 1,
					"uniqueItems": true,
					"items": { "enum": ["TEST_EPHEMERAL", "EXTERNAL_CONTROLLED"] }
				},
				"requireTrustedProductionKey": { "type": "boolean" },
				"publicationEligible": { "type": "boolean" }
			}
		}
	}
}
