{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://rtaime.local/schemas/update/v1/update-discovery.schema.json",
	"$comment": "Copyright (c) Dave Beusing <david.beusing@gmail.com>.",
	"title": "rtaime Update Discovery v1",
	"type": "object",
	"additionalProperties": false,
	"required": ["copyright", "schemaVersion", "repository", "channel", "version", "tag", "releaseId", "releaseUrl", "apiUrl", "prerelease", "draft", "descriptorAssetName", "assets", "discoveredAtUtc"],
	"properties": {
		"copyright": { "type": "string", "minLength": 1 },
		"schemaVersion": { "const": "1.0" },
		"repository": { "const": "DaveBeusing/rtaime" },
		"channel": { "enum": ["PREVIEW", "STABLE"] },
		"version": { "type": "string", "minLength": 1 },
		"tag": { "type": "string", "pattern": "^v" },
		"releaseId": { "type": "integer", "minimum": 1 },
		"releaseUrl": { "type": "string", "pattern": "^https://github\\.com/DaveBeusing/rtaime/releases/tag/" },
		"apiUrl": { "type": "string", "pattern": "^https://api\\.github\\.com/repos/DaveBeusing/rtaime/releases/" },
		"prerelease": { "type": "boolean" },
		"draft": { "const": false },
		"descriptorAssetName": { "enum": ["rtaime-channel-preview.json", "rtaime-channel-stable.json"] },
		"assets": {
			"type": "array",
			"minItems": 1,
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["name", "size", "browserDownloadUrl"],
				"properties": {
					"name": { "type": "string", "minLength": 1 },
					"size": { "type": "integer", "minimum": 0 },
					"browserDownloadUrl": { "type": "string", "pattern": "^https://github\\.com/DaveBeusing/rtaime/releases/download/" }
				}
			}
		},
		"discoveredAtUtc": { "type": "string", "format": "date-time" }
	}
}
