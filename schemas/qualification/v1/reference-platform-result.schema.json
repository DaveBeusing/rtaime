{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://rtaime.local/schemas/qualification/v1/reference-platform-result.schema.json",
	"$comment": "Copyright (c) Dave Beusing <david.beusing@gmail.com>.",
	"title": "rtaime V1 Reference Platform Qualification Result",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"copyright",
		"schemaVersion",
		"profile",
		"capturedAtUtc",
		"sourceCommit",
		"status",
		"softwareStatus",
		"hardwareStatus",
		"platformStatus",
		"counts",
		"environmentPath",
		"scenarios",
		"hardwareRequirements"
	],
	"properties": {
		"copyright": {
			"const": "Copyright (c) Dave Beusing <david.beusing@gmail.com>."
		},
		"schemaVersion": {
			"const": "1.0"
		},
		"profile": {
			"const": "rtaime-v1-reference-platform"
		},
		"capturedAtUtc": {
			"type": "string",
			"format": "date-time"
		},
		"sourceCommit": {
			"type": "string",
			"pattern": "^(?:[0-9a-f]{40}|UNAVAILABLE)$"
		},
		"status": {
			"$ref": "#/$defs/qualificationStatus"
		},
		"softwareStatus": {
			"$ref": "#/$defs/qualificationStatus"
		},
		"hardwareStatus": {
			"$ref": "#/$defs/qualificationStatus"
		},
		"platformStatus": {
			"enum": [
				"PASS",
				"FAIL"
			]
		},
		"counts": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"PASS",
				"FAIL",
				"NOT_APPLICABLE",
				"UNVERIFIED"
			],
			"properties": {
				"PASS": {
					"type": "integer",
					"minimum": 0
				},
				"FAIL": {
					"type": "integer",
					"minimum": 0
				},
				"NOT_APPLICABLE": {
					"type": "integer",
					"minimum": 0
				},
				"UNVERIFIED": {
					"type": "integer",
					"minimum": 0
				}
			}
		},
		"environmentPath": {
			"type": "string",
			"minLength": 1
		},
		"scenarios": {
			"type": "array",
			"minItems": 10,
			"maxItems": 10,
			"items": {
				"$ref": "#/$defs/softwareScenarioResult"
			}
		},
		"hardwareRequirements": {
			"type": "array",
			"minItems": 12,
			"maxItems": 12,
			"items": {
				"$ref": "#/$defs/hardwareRequirementResult"
			}
		}
	},
	"$defs": {
		"qualificationStatus": {
			"enum": [
				"PASS",
				"FAIL",
				"NOT_APPLICABLE",
				"UNVERIFIED"
			]
		},
		"softwareScenarioResult": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"id",
				"name",
				"mandatory",
				"evidenceGroup",
				"status",
				"detail",
				"testProject",
				"filter",
				"durationMilliseconds",
				"evidencePath",
				"proves"
			],
			"properties": {
				"id": {
					"type": "string",
					"pattern": "^Q(?:0[1-9]|10)$"
				},
				"name": {
					"type": "string",
					"minLength": 1
				},
				"mandatory": {
					"type": "boolean"
				},
				"evidenceGroup": {
					"type": "string",
					"minLength": 1
				},
				"status": {
					"$ref": "#/$defs/qualificationStatus"
				},
				"detail": {
					"type": "string",
					"minLength": 1
				},
				"testProject": {
					"type": "string",
					"minLength": 1
				},
				"filter": {
					"type": "string",
					"minLength": 1
				},
				"durationMilliseconds": {
					"type": "number",
					"minimum": 0
				},
				"evidencePath": {
					"type": "string"
				},
				"proves": {
					"type": "array",
					"minItems": 1,
					"items": {
						"type": "string",
						"minLength": 1
					}
				}
			}
		},
		"hardwareRequirementResult": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"id",
				"requirement",
				"mandatory",
				"qualificationType",
				"status",
				"detail",
				"evidencePath"
			],
			"properties": {
				"id": {
					"type": "string",
					"pattern": "^H(?:0[1-9]|1[0-2])$"
				},
				"requirement": {
					"enum": [
						"CUDA_GPU_EXECUTION",
						"GPU_FRAME_LATENCY",
						"GPU_SURFACE_LIFETIME",
						"PROFESSIONAL_MEDIA_IO",
						"SUSTAINED_FRAME_CADENCE",
						"DROPPED_FRAME_BEHAVIOR",
						"SYSTEM_TELEMETRY_CONTINUITY",
						"TIMING_REFERENCE_LOCK",
						"AUDIO_VIDEO_SYNCHRONIZATION",
						"RECOVERY_UNDER_LOAD",
						"PHYSICAL_END_TO_END_LATENCY",
						"LONG_SOAK_STABILITY"
					]
				},
				"mandatory": {
					"type": "boolean"
				},
				"qualificationType": {
					"enum": [
						"CUDA_REFERENCE",
						"MEDIA_IO_REFERENCE",
						"TIMING_REFERENCE_SOAK"
					]
				},
				"status": {
					"$ref": "#/$defs/qualificationStatus"
				},
				"detail": {
					"type": "string",
					"minLength": 1
				},
				"evidencePath": {
					"type": "string"
				}
			}
		}
	}
}
