{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://rtaime.local/schemas/qualification/v1/reference-platform.schema.json",
	"$comment": "Copyright (c) Dave Beusing <david.beusing@gmail.com>.",
	"title": "rtaime V1 Reference Platform Qualification Profile",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"copyright",
		"schemaVersion",
		"profile",
		"description",
		"platform",
		"softwareScenarios",
		"hardwareRequirements"
	],
	"properties": {
		"copyright": {
			"const": "Copyright (c) Dave Beusing <david.beusing@gmail.com>."
		},
		"schemaVersion": {
			"const": "1.0"
		},
		"profile": {
			"const": "rtaime-v1-reference-platform"
		},
		"description": {
			"type": "string",
			"minLength": 1
		},
		"platform": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"operatingSystemFamily",
				"architecture",
				"dotnetSdk",
				"developmentFormats",
				"requiredHosts",
				"gpuClass",
				"mediaIoClass"
			],
			"properties": {
				"operatingSystemFamily": {
					"const": "Windows"
				},
				"architecture": {
					"const": "x64"
				},
				"dotnetSdk": {
					"const": "10.0.401"
				},
				"developmentFormats": {
					"type": "array",
					"minItems": 2,
					"maxItems": 2,
					"uniqueItems": true,
					"items": {
						"enum": [
							"1080p50",
							"1080p59.94"
						]
					}
				},
				"requiredHosts": {
					"type": "array",
					"minItems": 4,
					"uniqueItems": true,
					"items": {
						"type": "string",
						"minLength": 1
					}
				},
				"gpuClass": {
					"type": "string",
					"minLength": 1
				},
				"mediaIoClass": {
					"type": "string",
					"minLength": 1
				}
			}
		},
		"softwareScenarios": {
			"type": "array",
			"minItems": 10,
			"maxItems": 10,
			"items": {
				"$ref": "#/$defs/softwareScenario"
			}
		},
		"hardwareRequirements": {
			"type": "array",
			"minItems": 12,
			"maxItems": 12,
			"items": {
				"$ref": "#/$defs/hardwareRequirement"
			}
		}
	},
	"$defs": {
		"softwareScenario": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"id",
				"name",
				"mandatory",
				"evidenceGroup",
				"testProject",
				"filter",
				"proves"
			],
			"properties": {
				"id": {
					"type": "string",
					"pattern": "^Q(?:0[1-9]|10)$"
				},
				"name": {
					"type": "string",
					"minLength": 1
				},
				"mandatory": {
					"type": "boolean"
				},
				"evidenceGroup": {
					"type": "string",
					"minLength": 1
				},
				"testProject": {
					"type": "string",
					"minLength": 1
				},
				"filter": {
					"type": "string",
					"minLength": 1
				},
				"proves": {
					"type": "array",
					"minItems": 1,
					"items": {
						"type": "string",
						"minLength": 1
					}
				}
			}
		},
		"hardwareRequirement": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"id",
				"requirement",
				"mandatory",
				"qualificationType",
				"bindingFile"
			],
			"properties": {
				"id": {
					"type": "string",
					"pattern": "^H(?:0[1-9]|1[0-2])$"
				},
				"requirement": {
					"enum": [
						"CUDA_GPU_EXECUTION",
						"GPU_FRAME_LATENCY",
						"GPU_SURFACE_LIFETIME",
						"PROFESSIONAL_MEDIA_IO",
						"SUSTAINED_FRAME_CADENCE",
						"DROPPED_FRAME_BEHAVIOR",
						"SYSTEM_TELEMETRY_CONTINUITY",
						"TIMING_REFERENCE_LOCK",
						"AUDIO_VIDEO_SYNCHRONIZATION",
						"RECOVERY_UNDER_LOAD",
						"PHYSICAL_END_TO_END_LATENCY",
						"LONG_SOAK_STABILITY"
					]
				},
				"mandatory": {
					"type": "boolean"
				},
				"qualificationType": {
					"enum": [
						"CUDA_REFERENCE",
						"MEDIA_IO_REFERENCE",
						"TIMING_REFERENCE_SOAK"
					]
				},
				"bindingFile": {
					"type": "string",
					"minLength": 1
				}
			}
		}
	}
}
