{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rtaime.dev/schemas/support/v1/stable-readiness.schema.json",
  "$comment": "Copyright (c) Dave Beusing <david.beusing@gmail.com>.",
  "title": "rtaime Stable Readiness Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "product",
    "overallStatus",
    "releasePromotionPerformed",
    "domains"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "generatedAtUtc": { "type": "string", "format": "date-time" },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "releaseStage"],
      "properties": {
        "name": { "const": "rtaime" },
        "version": { "type": "string", "minLength": 1 },
        "releaseStage": { "enum": ["DEV", "PREVIEW", "STABLE"] }
      }
    },
    "overallStatus": { "enum": ["PASS", "FAIL", "UNVERIFIED", "NOT_APPLICABLE"] },
    "releasePromotionPerformed": { "const": false },
    "domains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status", "source", "details"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "status": { "enum": ["PASS", "FAIL", "UNVERIFIED", "NOT_APPLICABLE"] },
          "source": { "type": "string", "minLength": 1 },
          "details": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
