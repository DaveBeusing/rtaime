{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rtaime.dev/schemas/support/v1/platform-support-matrix.schema.json",
  "$comment": "Copyright (c) Dave Beusing <david.beusing@gmail.com>.",
  "title": "rtaime Platform Support Matrix",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "copyright",
    "schemaVersion",
    "matrixStatus",
    "evidencePolicy",
    "compatibilityRules",
    "configurations"
  ],
  "properties": {
    "copyright": {
      "type": "string",
      "minLength": 1
    },
    "schemaVersion": {
      "const": "1.0"
    },
    "matrixStatus": {
      "enum": [
        "PASS",
        "FAIL",
        "UNVERIFIED"
      ]
    },
    "evidencePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "supportedRequiresEvidence",
        "materialChangeInvalidatesEvidence"
      ],
      "properties": {
        "supportedRequiresEvidence": {
          "const": true
        },
        "materialChangeInvalidatesEvidence": {
          "const": true
        }
      }
    },
    "compatibilityRules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "driverRangePolicy",
        "providerSdkPolicy",
        "firmwarePolicy",
        "materialChangePolicy"
      ],
      "properties": {
        "driverRangePolicy": {
          "enum": [
            "EXACT",
            "TESTED_RANGE",
            "EVIDENCE_BOUND"
          ]
        },
        "providerSdkPolicy": {
          "enum": [
            "PINNED_WHERE_REQUIRED",
            "EVIDENCE_BOUND"
          ]
        },
        "firmwarePolicy": {
          "enum": [
            "EVIDENCE_BOUND",
            "NOT_APPLICABLE"
          ]
        },
        "materialChangePolicy": {
          "const": "REQUALIFY"
        }
      }
    },
    "configurations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "supportStatus",
          "platform",
          "runtimeRequirements",
          "gpu",
          "mediaIo",
          "networkProviders",
          "qualificationEvidence",
          "knownLimitations"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "supportStatus": {
            "enum": [
              "SUPPORTED",
              "UNVERIFIED",
              "UNSUPPORTED",
              "EOL"
            ]
          },
          "platform": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "osFamily",
              "edition",
              "versionFamily",
              "architecture",
              "rid"
            ],
            "properties": {
              "osFamily": {
                "const": "Windows"
              },
              "edition": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1
              },
              "versionFamily": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1
              },
              "architecture": {
                "const": "x64"
              },
              "rid": {
                "const": "win-x64"
              }
            }
          },
          "runtimeRequirements": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "majorMinor",
                "minimumVersion",
                "source"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "majorMinor": {
                  "type": "string",
                  "pattern": "^[0-9]+\\.[0-9]+$"
                },
                "minimumVersion": {
                  "type": "string",
                  "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$"
                },
                "source": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "gpu": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "class",
              "driverRange",
              "provider",
              "qualificationStatus"
            ],
            "properties": {
              "class": {
                "type": "string",
                "minLength": 1
              },
              "driverRange": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1
              },
              "provider": {
                "type": "string",
                "minLength": 1
              },
              "qualificationStatus": {
                "enum": [
                  "PASS",
                  "FAIL",
                  "UNVERIFIED"
                ]
              }
            }
          },
          "mediaIo": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "provider",
              "device",
              "driverRange",
              "providerSdkPinSource",
              "firmware",
              "qualificationStatus"
            ],
            "properties": {
              "provider": {
                "type": "string",
                "minLength": 1
              },
              "device": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1
              },
              "driverRange": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1
              },
              "providerSdkPinSource": {
                "type": "string",
                "minLength": 1
              },
              "firmware": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1
              },
              "qualificationStatus": {
                "enum": [
                  "PASS",
                  "FAIL",
                  "UNVERIFIED"
                ]
              }
            }
          },
          "networkProviders": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "provider",
                "supportStatus",
                "qualificationEvidence"
              ],
              "properties": {
                "provider": {
                  "type": "string",
                  "minLength": 1
                },
                "supportStatus": {
                  "enum": [
                    "SUPPORTED",
                    "UNVERIFIED",
                    "UNSUPPORTED",
                    "EOL"
                  ]
                },
                "qualificationEvidence": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "supportStatus": {
                        "const": "SUPPORTED"
                      }
                    },
                    "required": [
                      "supportStatus"
                    ]
                  },
                  "then": {
                    "properties": {
                      "qualificationEvidence": {
                        "minItems": 1
                      }
                    }
                  }
                }
              ]
            }
          },
          "qualificationEvidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "knownLimitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "supportStatus": {
                  "const": "SUPPORTED"
                }
              },
              "required": [
                "supportStatus"
              ]
            },
            "then": {
              "properties": {
                "platform": {
                  "properties": {
                    "edition": {
                      "type": "string",
                      "minLength": 1
                    },
                    "versionFamily": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "gpu": {
                  "properties": {
                    "driverRange": {
                      "type": "string",
                      "minLength": 1
                    },
                    "qualificationStatus": {
                      "const": "PASS"
                    }
                  }
                },
                "mediaIo": {
                  "properties": {
                    "device": {
                      "type": "string",
                      "minLength": 1
                    },
                    "driverRange": {
                      "type": "string",
                      "minLength": 1
                    },
                    "qualificationStatus": {
                      "const": "PASS"
                    }
                  }
                },
                "qualificationEvidence": {
                  "minItems": 1
                }
              }
            }
          }
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "matrixStatus": {
            "const": "PASS"
          }
        },
        "required": [
          "matrixStatus"
        ]
      },
      "then": {
        "properties": {
          "configurations": {
            "contains": {
              "properties": {
                "supportStatus": {
                  "const": "SUPPORTED"
                }
              },
              "required": [
                "supportStatus"
              ]
            },
            "minContains": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "configurations": {
            "contains": {
              "properties": {
                "supportStatus": {
                  "const": "SUPPORTED"
                }
              },
              "required": [
                "supportStatus"
              ]
            }
          }
        },
        "required": [
          "configurations"
        ]
      },
      "then": {
        "properties": {
          "matrixStatus": {
            "const": "PASS"
          }
        }
      }
    }
  ]
}
