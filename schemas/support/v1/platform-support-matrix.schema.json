{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rtaime.dev/schemas/support/v1/platform-support-matrix.schema.json",
  "$comment": "Copyright (c) Dave Beusing <david.beusing@gmail.com>.",
  "title": "rtaime Platform Support Matrix",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "matrixStatus", "evidencePolicy", "compatibilityRules", "configurations"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "matrixStatus": { "enum": ["PASS", "FAIL", "UNVERIFIED"] },
    "evidencePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supportedRequiresEvidence", "materialChangeInvalidatesEvidence"],
      "properties": {
        "supportedRequiresEvidence": { "const": true },
        "materialChangeInvalidatesEvidence": { "const": true }
      }
    },
    "compatibilityRules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "driverRangePolicy",
        "providerSdkPolicy",
        "firmwarePolicy",
        "materialChangePolicy"
      ],
      "properties": {
        "driverRangePolicy": { "enum": ["EXACT", "TESTED_RANGE", "EVIDENCE_BOUND"] },
        "providerSdkPolicy": { "enum": ["PINNED_WHERE_REQUIRED", "EVIDENCE_BOUND"] },
        "firmwarePolicy": { "enum": ["EVIDENCE_BOUND", "NOT_APPLICABLE"] },
        "materialChangePolicy": { "const": "REQUALIFY" }
      }
    },
    "configurations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "supportStatus",
          "platform",
          "runtimeRequirements",
          "gpu",
          "mediaIo",
          "networkProviders",
          "qualificationEvidence",
          "knownLimitations"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
          "supportStatus": { "enum": ["SUPPORTED", "UNVERIFIED", "UNSUPPORTED", "EOL"] },
          "platform": {
            "type": "object",
            "additionalProperties": false,
            "required": ["osFamily", "edition", "versionFamily", "architecture", "rid"],
            "properties": {
              "osFamily": { "const": "Windows" },
              "edition": { "type": ["string", "null"] },
              "versionFamily": { "type": ["string", "null"] },
              "architecture": { "const": "x64" },
              "rid": { "const": "win-x64" }
            }
          },
          "runtimeRequirements": { "type": "array", "minItems": 1 },
          "gpu": { "type": "object" },
          "mediaIo": { "type": "object" },
          "networkProviders": { "type": "array" },
          "qualificationEvidence": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "knownLimitations": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
