<Project>
  <Target Name="RtaimeValidateArchitectureReferences" BeforeTargets="PrepareForBuild">
    <ItemGroup>
      <_RtaimeProductionToTests Include="@(ProjectReference)" Condition="'$(RtaimeIsTestProject)' != 'true' and ('%(ProjectReference.Filename)' == 'rtaime.TestInfrastructure' or '%(ProjectReference.Filename)' == 'rtaime.Tests.Unit' or '%(ProjectReference.Filename)' == 'rtaime.Tests.Contracts' or '%(ProjectReference.Filename)' == 'rtaime.Tests.Architecture' or '%(ProjectReference.Filename)' == 'rtaime.Tests.Integration' or '%(ProjectReference.Filename)' == 'rtaime.Tests.Behavioral' or '%(ProjectReference.Filename)' == 'rtaime.Tests.Failure' or '%(ProjectReference.Filename)' == 'rtaime.Tests.Performance')" />
      <_RtaimeCoreReference Include="@(ProjectReference)" Condition="'$(MSBuildProjectName)' == 'rtaime.Core'" />
      <_RtaimeControlForbidden Include="@(ProjectReference)" Condition="'$(MSBuildProjectName)' == 'rtaime.Control' and ('%(ProjectReference.Filename)' == 'rtaime.Runtime' or '%(ProjectReference.Filename)' == 'rtaime.Media' or '%(ProjectReference.Filename)' == 'rtaime.AI' or '%(ProjectReference.Filename)' == 'rtaime.Persistence' or '%(ProjectReference.Filename)' == 'rtaime.Provider.VirtualMedia' or '%(ProjectReference.Filename)' == 'rtaime.Provider.Gpu' or '%(ProjectReference.Filename)' == 'rtaime.Provider.Inference' or '%(ProjectReference.Filename)' == 'rtaime.Operator')" />
      <_RtaimeRuntimeForbidden Include="@(ProjectReference)" Condition="'$(MSBuildProjectName)' == 'rtaime.Runtime' and ('%(ProjectReference.Filename)' == 'rtaime.Control' or '%(ProjectReference.Filename)' == 'rtaime.Persistence' or '%(ProjectReference.Filename)' == 'rtaime.Operator' or '%(ProjectReference.Filename)' == 'rtaime.Provider.VirtualMedia' or '%(ProjectReference.Filename)' == 'rtaime.Provider.Gpu' or '%(ProjectReference.Filename)' == 'rtaime.Provider.Inference')" />
      <_RtaimeOperatorForbidden Include="@(ProjectReference)" Condition="'$(MSBuildProjectName)' == 'rtaime.Operator' and '%(ProjectReference.Filename)' != 'rtaime.Client' and '%(ProjectReference.Filename)' != 'rtaime.Core'" />
      <_RtaimeHostToHost Include="@(ProjectReference)" Condition="('$(MSBuildProjectName)' == 'rtaime.ControlHost' or '$(MSBuildProjectName)' == 'rtaime.RuntimeHost' or '$(MSBuildProjectName)' == 'rtaime.AIHost' or '$(MSBuildProjectName)' == 'rtaime.Operator') and ('%(ProjectReference.Filename)' == 'rtaime.ControlHost' or '%(ProjectReference.Filename)' == 'rtaime.RuntimeHost' or '%(ProjectReference.Filename)' == 'rtaime.AIHost' or '%(ProjectReference.Filename)' == 'rtaime.Operator')" />
      <_RtaimeControlContractsForbidden Include="@(ProjectReference)" Condition="'$(MSBuildProjectName)' == 'rtaime.Control.Contracts' and '%(ProjectReference.Filename)' != 'rtaime.Core'" />
      <_RtaimeMediaContractsForbidden Include="@(ProjectReference)" Condition="'$(MSBuildProjectName)' == 'rtaime.Media.Contracts' and '%(ProjectReference.Filename)' != 'rtaime.Core'" />
      <_RtaimeProviderContractsForbidden Include="@(ProjectReference)" Condition="'$(MSBuildProjectName)' == 'rtaime.Provider.Contracts' and '%(ProjectReference.Filename)' != 'rtaime.Core' and '%(ProjectReference.Filename)' != 'rtaime.Media.Contracts'" />
      <_RtaimeAIContractsForbidden Include="@(ProjectReference)" Condition="'$(MSBuildProjectName)' == 'rtaime.AI.Contracts' and '%(ProjectReference.Filename)' != 'rtaime.Core' and '%(ProjectReference.Filename)' != 'rtaime.Media.Contracts'" />
      <_RtaimeRuntimeContractsForbidden Include="@(ProjectReference)" Condition="'$(MSBuildProjectName)' == 'rtaime.Runtime.Contracts' and '%(ProjectReference.Filename)' != 'rtaime.Core' and '%(ProjectReference.Filename)' != 'rtaime.Media.Contracts' and '%(ProjectReference.Filename)' != 'rtaime.Provider.Contracts'" />
    </ItemGroup>
    <Error Condition="'@(_RtaimeProductionToTests)' != ''" Text="RTAIME001: Production project '$(MSBuildProjectName)' must not reference test project(s): @(_RtaimeProductionToTests->'%(Filename)', ', ')." />
    <Error Condition="'@(_RtaimeCoreReference)' != ''" Text="RTAIME002: rtaime.Core must remain dependency-neutral. Forbidden reference(s): @(_RtaimeCoreReference->'%(Filename)', ', ')." />
    <Error Condition="'@(_RtaimeControlForbidden)' != ''" Text="RTAIME003: rtaime.Control may depend on contracts/capabilities only. Forbidden reference(s): @(_RtaimeControlForbidden->'%(Filename)', ', ')." />
    <Error Condition="'@(_RtaimeRuntimeForbidden)' != ''" Text="RTAIME004: rtaime.Runtime must not depend on Control/Persistence/Operator/concrete providers. Forbidden reference(s): @(_RtaimeRuntimeForbidden->'%(Filename)', ', ')." />
    <Error Condition="'@(_RtaimeOperatorForbidden)' != ''" Text="RTAIME005: rtaime.Operator must reach production only through rtaime.Client; dependency-neutral rtaime.Core cross-cutting services are allowed. Forbidden reference(s): @(_RtaimeOperatorForbidden->'%(Filename)', ', ')." />
    <Error Condition="'@(_RtaimeHostToHost)' != ''" Text="RTAIME006: Host-to-host ProjectReference is forbidden. Source '$(MSBuildProjectName)', target(s): @(_RtaimeHostToHost->'%(Filename)', ', ')." />
    <Error Condition="'@(_RtaimeControlContractsForbidden)' != '' or '@(_RtaimeMediaContractsForbidden)' != '' or '@(_RtaimeProviderContractsForbidden)' != '' or '@(_RtaimeAIContractsForbidden)' != '' or '@(_RtaimeRuntimeContractsForbidden)' != ''" Text="RTAIME007: Contract dependency direction violated in '$(MSBuildProjectName)'." />
    <ItemGroup Condition="'$(RtaimeIsTestProject)' != 'true' and ('$(MSBuildProjectName)' == 'rtaime.Core' or '$(MSBuildProjectName)' == 'rtaime.Control.Contracts' or '$(MSBuildProjectName)' == 'rtaime.Runtime.Contracts' or '$(MSBuildProjectName)' == 'rtaime.Media.Contracts' or '$(MSBuildProjectName)' == 'rtaime.AI.Contracts' or '$(MSBuildProjectName)' == 'rtaime.Provider.Contracts')">
      <_RtaimeExplicitPackageReference Include="@(PackageReference)" Condition="'%(PackageReference.IsImplicitlyDefined)' != 'true'" />
    </ItemGroup>
    <Error Condition="'@(_RtaimeExplicitPackageReference)' != ''" Text="RTAIME008: Core and contract projects must remain explicitly package-neutral in the bootstrap. Source '$(MSBuildProjectName)', package(s): @(_RtaimeExplicitPackageReference->'%(Identity)', ', ')." />
    <Error Condition="'$(MSBuildProjectName)' == 'rtaime.Operator' and '$(TargetFramework)' != '$(RtaimeWindowsTargetFramework)'" Text="RTAIME009: rtaime.Operator must target $(RtaimeWindowsTargetFramework), actual '$(TargetFramework)'." />
    <Error Condition="'$(MSBuildProjectName)' == 'rtaime.Operator' and '$(UseWPF)' != 'true'" Text="RTAIME010: rtaime.Operator must set UseWPF=true." />
  </Target>
</Project>
